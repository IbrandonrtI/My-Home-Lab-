        for p, s in SERVE:
            want = "http://%s:%d" % (Ctx.lan, PORTS[s])
            if cur.get(p, "").rstrip("/") != want:
                rc, txt = act(["tailscale", "serve", "--bg", "--https=%d" % p, want], timeout=60)
