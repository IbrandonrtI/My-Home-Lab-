HELP = """homelab-setup %s - build this machine into the home lab from the GitHub repo.

  sudo homelab-setup                  show the checklist (what is done, what is left)
  sudo homelab-setup install          set everything up (asks first; safe to run again)
  sudo homelab-setup install --dry-run   show what it would do and change nothing
  sudo homelab-setup refresh          check again and continue whatever is now possible
  sudo homelab-setup fill             walk through the logins and keys that need you
  sudo homelab-setup done STEP        mark a by-hand step as done      (skip STEP = not wanted)
  sudo homelab-setup secrets          show the passwords and keys it generated
  homelab-setup progress | version | help

Options for install:  --yes  --backup FOLDER  --no-restore  --repo FOLDER  --force-existing
It never formats or changes a drive, and it never saves the admin password you type.
"""


def main(argv):
    import signal
    try:
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    except (AttributeError, ValueError):
        pass
    args = list(argv[1:])
    i = 0
    cmd = None
    pos = []
    while i < len(args):
        a = args[i]
        if a in ("--dry-run", "-n"):
            Opt.dry = True
        elif a in ("--yes", "-y"):
            Opt.yes = True
        elif a == "--no-restore":
            Opt.no_restore = True
        elif a == "--force-existing":
            Opt.force_existing = True
        elif a == "--backup" and i + 1 < len(args):
            i += 1
            Opt.backup = args[i]
        elif a == "--repo" and i + 1 < len(args):
            i += 1
            Opt.repo = args[i]
        elif a in ("-h", "--help", "help"):
            out(HELP % VERSION)
            return 0
        elif a in ("--version", "version"):
            out("homelab-setup " + VERSION)
            return 0
        elif a == "--quiet":
            pass
        elif a in ("--all", "-a"):
            Opt.all = True
        elif a.startswith("-"):
            out("Unknown option %s. Try: homelab-setup help" % a)
            return 1
        else:
            pos.append(a)
        i += 1
    cmd = pos[0] if pos else "checklist"
    if cmd not in ("checklist", "check", "install", "refresh", "fill", "done", "skip", "secrets", "progress"):
        out("Unknown command '%s'. Try: homelab-setup help" % cmd)
        return 1
    ensure_root()
    try:
        if cmd in ("checklist", "check"):
            cmd_checklist()
        elif cmd == "install":
            cmd_install()
        elif cmd == "refresh":
            cmd_refresh()
        elif cmd == "fill":
            cmd_fill()
        elif cmd in ("done", "skip"):
            if len(pos) < 2:
                out("Which step? Example: homelab-setup %s reboot-test" % cmd)
                return 1
            cmd_mark("ack" if cmd == "done" else "skip", pos[1])
        elif cmd == "secrets":
            cmd_secrets()
        elif cmd == "progress":
            cmd_progress()
    except Abort as e:
        out("")
        bad(str(e))
        return 1
    except KeyboardInterrupt:
        out("")
        say("Stopped. Everything that was finished stays finished; run the same command again to continue.")
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
