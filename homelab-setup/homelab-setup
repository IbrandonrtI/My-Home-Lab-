# ---------------------------------------------------------------- running commands
def run(args, input_text=None, timeout=None, check=False, env=None, quiet=False, shell=False):
    """Run a command. Returns (returncode, stdout+stderr). In dry-run mode, changing commands are not run."""
    shown = args if isinstance(args, str) else " ".join(args)
    log("RUN " + shown[:200])
    try:
        p = subprocess.run(args, input=input_text, capture_output=True, text=True, timeout=timeout,
                           env=env, shell=shell)
        text = (p.stdout or "") + (p.stderr or "")
        rc = p.returncode
    except FileNotFoundError:
        rc, text = 127, "command not found: %s" % (args if isinstance(args, str) else args[0])
    except subprocess.TimeoutExpired:
        rc, text = 124, "timed out after %ss: %s" % (timeout, shown[:80])
    if check and rc != 0:
        raise Abort("Command failed (%s): %s\n%s" % (rc, shown[:120], text.strip()[-600:]))
    return rc, text


def act(args, **kw):
    """Run a command that CHANGES the machine. Dry-run prints it instead."""
    if Opt.dry:
        out("      would run: %s" % (args if isinstance(args, str) else " ".join(args)))
        return 0, ""
    return run(args, **kw)


def have(cmd):
    return shutil.which(cmd) is not None


def docker(*args, **kw):
    return run(["docker"] + list(args), **kw)


def apt_install(pkgs):
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    act(["apt-get", "install", "-y", "-q"] + list(pkgs), env=env, check=True, timeout=1800)


# ---------------------------------------------------------------- files
def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def write_file(path, text, mode=None, owner=None):
    if Opt.dry:
        out("      would write: %s" % path)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp-hls"
    with open(tmp, "w") as f:
        f.write(text)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)
    if owner:
        chown(path, *owner)


def chown(path, uid, gid, recursive=False):
    if FAKE or Opt.dry:
        return
    try:
        if recursive and os.path.isdir(path):
            for dp, dn, fn in os.walk(path):
                os.chown(dp, uid, gid)
                for n in fn:
                    try:
                        os.chown(os.path.join(dp, n), uid, gid)
                    except OSError:
                        pass
        os.chown(path, uid, gid)
    except OSError:
        pass


def mkdirs(path, uid=None, gid=None, mode=0o755):
    if Opt.dry:
        if not os.path.isdir(path):
            out("      would create folder: %s" % path)
        return
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass
    if uid is not None:
        chown(path, uid, gid)


def sha(path):
    try:
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    except OSError:
        return ""


# ---------------------------------------------------------------- random values
ALNUM = string.ascii_letters + string.digits


def rand_alnum(n=24):
    return "".join(pysecrets.choice(ALNUM) for _ in range(n))


def rand_hex(n=24):
    return pysecrets.token_hex(n)


def rand_app_key():
    return "base64:" + base64.b64encode(pysecrets.token_bytes(32)).decode()


# ---------------------------------------------------------------- HTTP
def http(method, url, body=None, headers=None, timeout=20, form=None, raw=False):
    """Returns (status, data, headers). status 0 = could not connect. data = parsed JSON, else text."""
    hdr = dict(headers or {})
    data = None
    if form is not None:
        boundary = "----hls" + rand_alnum(16)
        parts = []
        for k, v in form.items():
            parts.append("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n" % (boundary, k, v))
        parts.append("--%s--\r\n" % boundary)
        data = "".join(parts).encode()
        hdr["Content-Type"] = "multipart/form-data; boundary=%s" % boundary
    elif body is not None:
        data = json.dumps(body).encode()
        hdr.setdefault("Content-Type", "application/json")
    req = urllib.request.Request(url, data=data, method=method, headers=hdr)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            txt = r.read().decode("utf-8", "replace")
            st, hd = r.status, dict(r.headers)
    except urllib.error.HTTPError as e:
        txt = e.read().decode("utf-8", "replace") if e.fp else ""
        st, hd = e.code, dict(e.headers or {})
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as e:
        return 0, str(e), {}
    if raw:
        return st, txt, hd
    try:
        return st, json.loads(txt), hd
    except ValueError:
        return st, txt, hd


def wait_for(fn, what, timeout=300, every=3, quiet=False):
    """Poll fn() until it returns something true."""
    end = time.time() + timeout
    n = 0
    while True:
        try:
            v = fn()
        except Abort:
            raise
        except Exception:
            v = None
        if v:
            if n and Live.active:
                Live.set_note("")
            return v
        if time.time() > end:
            raise Abort("Timed out after %d seconds waiting for %s." % (timeout, what))
        if not quiet and n == 0:
            if Live.active:
                Live.set_note("waiting for %s" % what)
            else:
                out("      waiting for %s ..." % what)
        n += 1
        time.sleep(every if not FAKE else 0.05)


# ---------------------------------------------------------------- questions
def interactive():
    return sys.stdin.isatty()


def stdin_line():
    """Read one line from a pipe WITHOUT reading ahead, so a program we start (the restore tool) can read the rest."""
    buf = b""
    while True:
        ch = os.read(0, 1)
        if not ch:
            break
        buf += ch
        if ch == b"\n":
            break
    return buf.decode("utf-8", "replace")


def ask(prompt, default=""):
    if Opt.yes and default != "":
        return default
    with Live.pause():
        return _ask(prompt, default)


def _ask(prompt, default=""):
    try:
        if interactive():
            v = input("  %s%s: " % (prompt, (" [%s]" % default) if default else ""))
        else:
            sys.stdout.write("  %s%s: " % (prompt, (" [%s]" % default) if default else ""))
            sys.stdout.flush()
            v = stdin_line()
            if v == "":
                raise EOFError
            v = v.rstrip("\n")
            out("")
    except EOFError:
        raise Abort("An answer is required for: %s (no input was available)." % prompt)
    return v.strip() or default


def ask_secret(prompt):
    with Live.pause():
        return _ask_secret(prompt)


def _ask_secret(prompt):
    try:
        if interactive():
            return getpass.getpass("  %s: " % prompt)
        sys.stdout.write("  %s: " % prompt)
        sys.stdout.flush()
        v = stdin_line()
        if v == "":
            raise EOFError
        out("")
        return v.rstrip("\n")
    except EOFError:
        raise Abort("An answer is required for: %s (no input was available)." % prompt)


def yesno(prompt, default=False):
    if Opt.yes:
        return True
    v = ask(prompt + (" [Y/n]" if default else " [y/N]"), "").lower()
    if v == "":
        return default
    return v in ("y", "yes")


def typed(word, prompt):
    if Opt.yes:
        return True
    return ask(prompt).strip() == word


# ================================================================ state, answers, secrets
class State:
    """Non-secret facts: the answers given, which one-time actions ran, and what was acknowledged."""
    data = {}

    @classmethod
    def load(cls):
        try:
            cls.data = json.loads(read_file(STATE_FILE, "{}") or "{}")
        except ValueError:
            cls.data = {}
        cls.data.setdefault("answers", {})
        cls.data.setdefault("ran", {})
        cls.data.setdefault("ack", {})
        cls.data.setdefault("skip", {})
        cls.data.setdefault("notes", {})

    readonly = False

    @classmethod
    def save(cls):
        if Opt.dry or cls.readonly:
            return
        os.makedirs(STATE_DIR, exist_ok=True)
        write_file(STATE_FILE, json.dumps(cls.data, indent=1, sort_keys=True) + "\n", 0o600)

    @classmethod
    def exists(cls):
        return os.path.exists(STATE_FILE)

    @classmethod
    def ran(cls, key):
        return key in cls.data["ran"]

    @classmethod
    def mark(cls, key):
        cls.data["ran"][key] = time.strftime("%F %T")
        cls.save()

    @classmethod
    def note(cls, key, text=None):
        if text is None:
            return cls.data["notes"].get(key, "")
        if text:
            cls.data["notes"][key] = text
        else:
            cls.data["notes"].pop(key, None)
        cls.save()


class Secrets:
    """The one root-only file (mode 600). Generated passwords and keys. Never the password you type."""
    vals = {}

    @classmethod
    def load(cls):
        cls.vals = {}
        for line in read_file(SECRET_FILE).splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                cls.vals[k.strip()] = v.strip()

    @classmethod
    def get(cls, key, default=""):
        return cls.vals.get(key, default)

    @classmethod
    def set(cls, key, value):
        cls.vals[key] = value
        cls.save()

    @classmethod
    def save(cls):
        if Opt.dry:
            return
        os.makedirs(SECRET_DIR, exist_ok=True)
        os.chmod(SECRET_DIR, 0o700)
        body = ["# homelab-setup secrets (root only, mode 600). Copy these into a password manager.",
                "# Never commit this file to a repository and never share it."]
        body += ["%s=%s" % (k, cls.vals[k]) for k in sorted(cls.vals)]
        write_file(SECRET_FILE, "\n".join(body) + "\n", 0o600)


class Runtime:
    """Lives only in memory while the program runs. The typed password is never written to a file by the installer."""
    password = None
    hide = []          # other secret words that must never reach the log file


def need_password(why):
    """Ask for the shared password once per run, when a step really needs it.
    Every typed password is checked: against the Portainer admin when that account exists, otherwise by typing it twice.
    (A typo here would quietly give some apps a different password than the others.)"""
    if Runtime.password:
        return Runtime.password
    out("")
    say("This step needs the admin password (%s). It is used for this run only and is not saved." % why)
    for _ in range(3):
        pw = ask_secret("Admin password")
        problem = password_problem(pw)
        if problem:
            warn(problem)
            continue
        if Portainer.admin_state() == 204:
            if not Portainer.login(pw):
                warn("That is not the password of the Portainer admin account (%s). Enter the password chosen at the start of the installation." % Ctx.admin)
                continue
        elif ask_secret("Type it again") != pw:
            warn("The two entries did not match.")
            continue
        Runtime.password = pw
        return pw
    raise Abort("No matching admin password was entered. Setup stopped before configuring any further logins. Run `sudo homelab-setup refresh` to try again.")


def password_problem(pw):
    if len(pw) < 12:
        return "The password must be at least 12 characters (Portainer requires it)."
    if not re.fullmatch(r"[A-Za-z0-9]+", pw):
        return "Use letters and digits only. Other characters can break the stack files and the Homepage configuration."
    return ""


# ================================================================ the machine
class Ctx:
    """Facts about THIS machine and the answers given at the start."""
    user = uid = gid = home = ""
    lan = gateway = tz = hostname = ""
    admin = email = ""
    fqdn = tailnet = ts_id = ""
    repo = ""
    os_id = os_name = os_codename = os_version = ""

    @classmethod
    def detect(cls):
        a = State.data["answers"]
        cls.user = a.get("user") or detect_user()
        try:
            pw = pwd.getpwnam(cls.user)
            cls.uid, cls.gid, cls.home = pw.pw_uid, pw.pw_gid, pw.pw_dir
        except KeyError:
            cls.uid = cls.gid = 1000
            cls.home = "/home/" + cls.user
        if ROOT and not os.path.isabs(cls.home):
            cls.home = "/home/" + cls.user
        if FAKE:
            cls.uid, cls.gid, cls.home = 1000, 1000, "/home/" + cls.user
        cls.lan = a.get("lan") or detect_lan()
        cls.gateway = detect_gateway()
        cls.tz = a.get("tz") or detect_tz()
        cls.hostname = socket.gethostname()
        cls.admin = a.get("admin", "")
        cls.email = a.get("email", "")
        cls.repo = Opt.repo or State.data.get("repo") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        cls.refresh_tailscale()
        cls.read_os()

    @classmethod
    def read_os(cls):
        info = {}
        for line in read_file(P("/etc/os-release")).splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                info[k] = v.strip().strip('"')
        cls.os_id = info.get("ID", "")
        cls.os_like = info.get("ID_LIKE", "")
        cls.os_name = info.get("PRETTY_NAME", cls.os_id)
        cls.os_version = info.get("VERSION_ID", "")
        cls.os_codename = info.get("UBUNTU_CODENAME") or info.get("VERSION_CODENAME", "")

    @classmethod
    def refresh_tailscale(cls):
        js = ts_status()
        cls.fqdn = cls.tailnet = cls.ts_id = ""
        if js and js.get("BackendState") == "Running":
            me = js.get("Self") or {}
            cls.fqdn = (me.get("DNSName") or "").rstrip(".")
            cls.ts_id = me.get("ID", "")
            if cls.fqdn.count(".") >= 2:
                cls.tailnet = cls.fqdn.split(".", 1)[1]


def detect_user():
    if os.environ.get("HLS_USER"):
        return os.environ["HLS_USER"]
    u = os.environ.get("SUDO_USER")
    if u and u != "root":
        return u
    try:
        names = [p.pw_name for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and os.path.isdir(p.pw_dir)]
    except Exception:
        names = []
    return names[0] if names else (os.environ.get("USER") or "root")


def detect_lan():
    if os.environ.get("HLS_LAN"):
        return os.environ["HLS_LAN"]
    rc, txt = run(["ip", "-4", "route", "get", "1.1.1.1"])
    m = re.search(r"\bsrc (\d+\.\d+\.\d+\.\d+)", txt)
    if m:
        return m.group(1)
    rc, txt = run(["hostname", "-I"])
    for tok in txt.split():
        if re.match(r"^(10|192\.168|172\.(1[6-9]|2\d|3[01]))\.", tok):
            return tok
    return ""


def detect_gateway():
    if os.environ.get("HLS_GATEWAY"):
        return os.environ["HLS_GATEWAY"]
    rc, txt = run(["ip", "-4", "route", "show", "default"])
    m = re.search(r"default via (\d+\.\d+\.\d+\.\d+)", txt)
    return m.group(1) if m else ""


def detect_tz():
    rc, txt = run(["timedatectl", "show", "-p", "Timezone", "--value"])
    if rc == 0 and txt.strip():
        return txt.strip()
    return read_file(P("/etc/timezone")).strip() or "UTC"


