HP_CARDS = {   # card id -> (widget type, the fields that hold secrets)
    "adguard-card": ("adguard", ["username", "password"]),
    "tailscale-card": ("tailscale", ["deviceid", "key"]),
    "beszel-card": ("beszel", ["username", "password"]),
