def ask_answers():
    a = State.data["answers"]
    out("")
    say("I need a few answers first. Nothing is sent anywhere; they only fill in the config files on this machine.")
    out("")
    a["admin"] = ask("Admin name for every service", a.get("admin") or Ctx.user.capitalize())
    a["email"] = ask("Your email address (used as the login for Immich and Beszel)", a.get("email", ""))
    while not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", a["email"]):
        a["email"] = ask("That does not look like an email address. Try again", "")
    a["tz"] = ask("Time zone", a.get("tz") or Ctx.tz)
    a["lan"] = ask("This machine's address on your network (it should be reserved in your router)", a.get("lan") or Ctx.lan)
    if not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", a["lan"]):
        raise Abort("That is not an IPv4 address.")
    State.save()
    Ctx.detect()
    if not Runtime.password:
        password_warning()
        out("")
        for _ in range(3):
            p1 = ask_secret("Choose the admin password (12+ letters and numbers, typed once, never saved)")
            problem = password_problem(p1)
            if problem:
                warn(problem)
                continue
            if ask_secret("Type it again") != p1:
                warn("They did not match.")
                continue
            Runtime.password = p1
            break
        else:
            raise Abort("No valid password was entered.")


