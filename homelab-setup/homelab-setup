def port53_listeners():
    rc, txt = run(["ss", "-H", "-tulpn", "sport = :53"])
    procs = []
    for line in txt.splitlines():
        m = re.search(r'users:\(\("([^"]+)"', line)
        procs.append(m.group(1) if m else "unknown")
    return procs


@step
class Port53(Step):
    id, group, title = "port53", "Network", "Port 53 is free for AdGuard Home"
    needs = ("docker",)

    def probe(self):
        procs = port53_listeners()
        return "done" if all(p.lower().startswith("adguard") for p in procs) else "todo"

    def run(self):
        if ssh_peers_over_tailscale():
            raise Abort("You are connected through Tailscale. This step restarts Tailscale and would drop your session. "
                        "Connect with  ssh %s@%s  (the local address) and run  sudo homelab-setup refresh  again." %
                        (Ctx.user, Ctx.lan))
        gw = Ctx.gateway or "1.1.1.1"
        out("")
        say("To let AdGuard Home answer DNS, I must stop the built-in DNS helper (systemd-resolved), which holds port 53. "
            "While I do this, this computer asks your router (%s) for names. Your DNS design stays the same: "
            "AdGuard Home on this machine, set on each device by hand." % gw)
        if not Opt.dry and not Opt.yes and not yesno("Free port 53 now?", False):
            raise Abort("You chose not to free port 53. Run  sudo homelab-setup refresh  when you are ready.")
        # pull the image first, while DNS still works
        act(["docker", "pull", "adguard/adguardhome:v0.107.79"], timeout=900)
        act(["systemctl", "disable", "systemd-resolved"])
        act(["systemctl", "stop", "systemd-resolved"])
        if have("tailscale"):
            # Tailscale must not take /etc/resolv.conf over: its own resolver (100.100.100.100) has no upstream after a
            # reboot or an update and the machine then cannot look up names (your F6 on the server, found again on the VM).
            act(["tailscale", "set", "--accept-dns=false"])
        if not Opt.dry:
            try:
                os.remove(P("/etc/resolv.conf"))
            except OSError:
                pass
            write_file(P("/etc/resolv.conf"), "nameserver %s\n" % gw, 0o644)
        if run(["systemctl", "is-active", "tailscaled"])[1].strip() == "active":
            act(["systemctl", "restart", "tailscaled"])
        if not Opt.dry:
            time.sleep(2 if not FAKE else 0)
            others = [p for p in port53_listeners() if not p.lower().startswith("adguard")]
            if others:
                raise Abort("Something still uses port 53: %s" % ", ".join(sorted(set(others))))


@step
