        except ValueError:
            js = {}
        found = {}
        for k, v in (js.get("Web") or {}).items():
            m = re.search(r":(\d+)$", k)
            if m:
                prox = ((v.get("Handlers") or {}).get("/") or {}).get("Proxy", "")
                found[int(m.group(1))] = prox
        return found

