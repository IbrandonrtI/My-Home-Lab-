S_OK, S_TODO, S_BAD, S_WAIT, S_NA, S_RULE, S_DOT = (
    ("✓", "○", "✗", "·", "–", "─", "·") if _utf else ("+", "o", "x", ".", "-", "-", "-"))


def term_cols():
    try:
        c = int(os.environ.get("COLUMNS", "") or shutil.get_terminal_size((80, 24)).columns)
    except ValueError:
        c = 80
    return max(c, 40)


def out(msg=""):
    with Live.lock:
        Live.clear()
        print(msg, flush=True)
        Live.draw()


def rule(title):
    w = min(term_cols(), 76)
    n = max(w - len(title) - 8, 3)
    out("")
    out("  %s%s%s%s %s%s%s %s%s%s" % (D, S_RULE, S_RULE, N, B, title, N, D, S_RULE * n, N))
    out("")


NBSP = "\u00a0"
_MARK = re.compile(r"`([^`]+)`|(https?://[^\s)`]*[^\s).,;:`])")


def _protect(text):
    """Keep a `command` on one line: its spaces become non-breaking until the line is drawn."""
    return re.sub(r"`([^`]+)`", lambda m: "`" + m.group(1).replace(" ", NBSP) + "`", text)


def wrap(text, indent, width=None):
    width = (width or min(term_cols(), 100)) - indent
    lines = []
    for para in _protect(text).split("\n"):
        if not para.strip():
            lines.append("")
            continue
        cur = ""
        for word in para.split(" "):
            if cur and len(cur) + 1 + len(word) > width:
                lines.append(cur)
                cur = word
            else:
                cur = (cur + " " + word) if cur else word
        lines.append(cur)
    return [" " * indent + l if l else "" for l in lines]


def mark(line, base=""):
    """Highlight `commands` and links in a finished line. `base` is the colour to return to afterwards."""
    def sub(m):
        if m.group(1) is not None:
            txt = m.group(1)
            return (N + C + txt + N + base) if _tty else "`" + txt + "`"
        return (N + U + m.group(2) + N + base) if _tty else m.group(2)
    return _MARK.sub(sub, line).replace(NBSP, " ")


def styled(text, indent, base=""):
    """Wrap text and highlight commands and links. A paragraph that starts with "$ " is a command line,
    shown on its own line and never wrapped."""
    out_lines = []
    for para in text.split("\n"):
        if para.startswith("$ "):
            out_lines.append(" " * indent + "%s$%s %s%s%s" % (D, N, C, para[2:], N))
            continue
        for l in wrap(para, indent):
            out_lines.append((base + mark(l, base) + N) if base else mark(l))
    return out_lines


def say(msg, indent=2):
    for l in styled(msg, indent):
        out(l)


def good(msg):
    out("  %s%s%s %s" % (G, S_OK, N, msg))


def warn(msg):
    for i, l in enumerate(styled(msg, 4)):
        out(("  %s!%s " % (Y, N) + l[4:]) if i == 0 else l)


def bad(msg):
    for i, l in enumerate(styled(msg, 4)):
        out(("  %s%s%s " % (R, S_BAD, N) + l[4:]) if i == 0 else l)


def log(msg):
    try:
        for word in [Runtime.password] + list(Runtime.hide):
            if word and len(word) >= 6:
                msg = msg.replace(word, "********")
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write("%s %s\n" % (time.strftime("%F %T"), msg))
    except OSError:
        pass


# ---------------------------------------------------------------- live progress line
def fmt_time(sec):
    sec = int(sec)
    if sec < 60:
        return "%ds" % sec
    if sec < 3600:
        return "%dm %02ds" % (sec // 60, sec % 60)
    return "%dh %02dm" % (sec // 3600, (sec % 3600) // 60)


class Live:
    """One status line at the bottom of the screen while a step runs: a spinner, the step, a detail
    (for example which image is downloading), a bar for the whole install and the elapsed time.
    It is only drawn on a real terminal (HLS_LIVE=1 forces it for tests). Every normal line printed
    through out() first wipes the status line and draws it again below, so nothing overlaps.
    When there is no terminal (a pipe, a log file) nothing is animated: each step prints a plain line instead."""
    lock = threading.RLock()
    enabled = ((sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb") or os.environ.get("HLS_LIVE") == "1")
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏" if _utf else "|/-\\"
    FULL, EMPTY = ("█", "░") if _utf else ("#", "-")
    active = False          # a step is running and the line is shown
    paused = 0              # >0 while a question or an external program owns the screen
    shown = False           # the status line is currently on screen
    title = ""
    note = ""
    t_step = 0.0
    t_all = None            # start of the whole run (for the total elapsed time)
    total = 0
    done = 0
    frame = 0
    thread = None
    stop = False
    own_clock = False       # show this step's own time, not the time of the whole run

    @classmethod
    def begin_run(cls, total):
        with cls.lock:
            cls.total, cls.done = total, 0
            cls.t_all = time.time()

    @classmethod
    def elapsed_total(cls):
        return time.time() - cls.t_all if cls.t_all else 0.0

    @classmethod
    def begin(cls, title, own_clock=False):
        with cls.lock:
            cls.title, cls.note, cls.t_step = title, "", time.time()
            cls.own_clock = own_clock
            if not cls.enabled:
                return
            cls.active = True
            cls.stop = False
            if cls.thread is None or not cls.thread.is_alive():
                cls.thread = threading.Thread(target=cls._loop, daemon=True)
                cls.thread.start()
            cls.draw()

    @classmethod
    def end(cls):
        """Stop the line and return how many seconds the step took."""
        with cls.lock:
            cls.clear()
            cls.active = False
            return time.time() - cls.t_step

    @classmethod
    def set_note(cls, text):
        with cls.lock:
            cls.note = text
            cls.draw()

    @classmethod
    def advance(cls):
        with cls.lock:
            cls.done += 1

    @classmethod
    def _loop(cls):
        while not cls.stop:
            time.sleep(0.12)
            with cls.lock:
                if cls.active and not cls.paused:
                    cls.frame += 1
                    cls.draw()

    @classmethod
    def clear(cls):
        if cls.shown:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()
            cls.shown = False

    @classmethod
    def line(cls, cols):
        spin = cls.FRAMES[cls.frame % len(cls.FRAMES)]
        bar = ""
        if cls.total:
            width = 10 if cols < 90 else 14
            n = min(cls.total, max(cls.done, 0))
            filled = int(round(width * n / float(cls.total)))
            bar = "%s%s%s%s%s%s  %d of %d" % (G, cls.FULL * filled, D, cls.EMPTY * (width - filled), N, "", n, cls.total)
            bar_plain = " " * (width + 2 + len("%d of %d" % (n, cls.total)))
        else:
            bar_plain = ""
        clock = fmt_time(time.time() - (cls.t_step if cls.own_clock or not cls.t_all else cls.t_all))
        tail_plain = ("   " + bar_plain if bar_plain else "") + "   " + clock
        tail = ("   " + bar if bar else "") + "   " + D + clock + N
        room = cols - 1 - len("  x ") - len(tail_plain)
        title = cls.title
        text = cls.note
        avail = room - len(title) - 4                     # what is left for the detail after "  . "
        if text and len(text) > avail:
            text = (text[:avail - 3] + "...") if avail >= 15 else ""
        note = ("  " + D + S_DOT + " " + text + N) if text else ""
        note_plain = ("  " + S_DOT + " " + text) if text else ""
        if len(title) > room:
            title = title[:max(room - 3, 1)] + "..."
        pad = " " * max(room - len(title) - len(note_plain), 0)
        return "  %s%s%s %s%s%s%s%s" % (C, spin, N, title, note, pad, tail, "")

    @classmethod
    def draw(cls):
        if not (cls.enabled and cls.active) or cls.paused:
            return
        cls.clear()
        sys.stdout.write(cls.line(term_cols()))
        sys.stdout.flush()
        cls.shown = True

    class _Paused:
        def __enter__(self):
            with Live.lock:
                Live.clear()
                Live.paused += 1

        def __exit__(self, *a):
            with Live.lock:
                Live.paused -= 1
                Live.draw()

    @classmethod
    def pause(cls):
        """Hand the screen to a question or to another program for a while."""
        return cls._Paused()


class Abort(Exception):
    """A step that cannot continue. The message is shown to the person."""


