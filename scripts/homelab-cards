# ---------------------------------------------------------------- where things are
def lab_user():
    name = os.environ.get("HOMELAB_USER") or os.environ.get("SUDO_USER")
    if name and name != "root":
        return name
    try:
        return pwd.getpwuid(1000).pw_name
    except KeyError:
        return ""


def lab_home():
    u = lab_user()
    try:
        return pwd.getpwnam(u).pw_dir if u else os.path.expanduser("~")
    except KeyError:
        return os.path.expanduser("~")


HP = os.environ.get("HP_DIR") or os.path.join(lab_home(), "homepage-config")
STATE_DIR = os.environ.get("HOMELAB_STATE_DIR", "/var/lib/homelab")
SERVICES = os.path.join(HP, "services.yaml")
CSS = os.path.join(HP, "custom.css")
STATE_FILE = os.path.join(STATE_DIR, "cards.json")
SUMMARY_FILE = os.path.join(STATE_DIR, "cards-summary")
LOG_FILE = os.environ.get("HOMELAB_CARDS_LOG", "/var/log/homelab-cards.log")
LOCK_FILE = os.environ.get("HOMELAB_CARDS_LOCK", "/var/lock/homelab-cards.lock")
DOCKER = os.environ.get("HOMELAB_DOCKER", "docker")
TAILSCALE = os.environ.get("HOMELAB_TAILSCALE", "tailscale")
PROBE_HOST = os.environ.get("HOMELAB_PROBE_HOST", "127.0.0.1")

QUIET = False
DRY = False
CHANGES = []


def say(msg=""):
    if not QUIET:
        print(msg)


def note(msg):
    """Something that changed: always logged, shown unless quiet."""
    CHANGES.append(msg)
    say(msg)
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write("%s %s%s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), "(dry run) " if DRY else "", msg))
    except OSError:
        pass


def run(cmd, timeout=30):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def write_text(path, text, like=None):
    """Write atomically; the new file keeps the owner and permissions of `like` (or of the old file)."""
    like = like or path
    try:
        st = os.stat(like)
    except OSError:
        st = None
    tmp = path + ".homelab-cards.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    if st:
        os.chmod(tmp, st.st_mode & 0o777)
        try:
            os.chown(tmp, st.st_uid, st.st_gid)
        except OSError:
            pass
    os.replace(tmp, path)


def backup_once(path, suffix=".before-cards"):
    if os.path.exists(path) and not os.path.exists(path + suffix):
        shutil.copy2(path, path + suffix)


# ---------------------------------------------------------------- state
def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    st.setdefault("managed", {})
    st.setdefault("ignore", [])
    return st


def save_state(st):
    if DRY:
        return
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=1, sort_keys=True)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATE_FILE)
    lines = []
    for name, m in sorted(st["managed"].items()):
        lines.append("managed|%s|%s|%s|%d|%d" % (name, m["card"], m["section"], 1 if m.get("unsure") else 0, int(m.get("added", 0))))
    tmp = SUMMARY_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))
    os.chmod(tmp, 0o644)
    os.replace(tmp, SUMMARY_FILE)


# ---------------------------------------------------------------- containers
def containers():
    """[{name, status, image, project, labels, ports: [host ports, tcp]}] for every container, or None when Docker does not answer."""
    rc, ids = run([DOCKER, "ps", "-aq"])
    if rc != 0:
        return None
    ids = ids.split()
    if not ids:
        return []
    rc, txt = run([DOCKER, "inspect"] + ids, timeout=60)
    if rc != 0:
        return None
    try:
        data = json.loads(txt)
    except ValueError:
        return None
    out = []
    for c in data:
        labels = (c.get("Config") or {}).get("Labels") or {}
        ports = []
        for key, binds in ((c.get("HostConfig") or {}).get("PortBindings") or {}).items():
            if not key.endswith("/tcp"):
                continue
            for b in binds or []:
                hp = str(b.get("HostPort", ""))
                if hp.isdigit() and int(hp) not in ports:
                    ports.append(int(hp))
        out.append({"name": (c.get("Name") or "").lstrip("/"), "status": (c.get("State") or {}).get("Status", ""),
                    "image": (c.get("Config") or {}).get("Image", ""), "project": labels.get("com.docker.compose.project", ""),
                    "labels": labels, "ports": sorted(ports)})
    return out


def answers_like_a_web_page(port):
    return any(_answers(h, port) for h in dict.fromkeys([PROBE_HOST, lan_ip()]))


def _answers(host, port):
    """True when something on this machine answers HTTP on the port (any status counts: a login page is a web page too)."""
    try:
        urllib.request.urlopen("http://%s:%d/" % (host, port), timeout=3).close()
        return True
    except urllib.error.HTTPError:
        return True
    except (OSError, ValueError):
        return False


def is_builtin(c):
    return (c["name"] in BUILTIN_NAMES or c["project"] in BUILTIN_PROJECTS or c["name"].startswith(("immich_", "nextcloud_")))


# ---------------------------------------------------------------- names, sections, icons, colours
def tokens_of(c):
    repo = c["image"].split("@")[0]
    if ":" in repo.rsplit("/", 1)[-1]:
        repo = repo.rsplit(":", 1)[0]                      # the tag is not part of the name
    text = " ".join([repo, c["name"], c["project"], c["labels"].get("org.opencontainers.image.title", "")]).lower()
    toks = [t for t in re.split(r"[^a-z0-9]+", text) if t]
    return toks, "".join(toks)


def guess_section(c):
    """(section, sure)."""
    toks, joined = tokens_of(c)
    for generic in (0, 1):
        for sec in SECTIONS:
            for w in KEYWORDS[sec][generic].split():
                if w in toks or (len(w) >= 6 and not generic and w in joined):
                    return sec, True
    return UNSURE_SECTION, False


def display_name(c):
    t = re.sub(r"[:#\[\]{},&*!|>'\"%@`]", "", c["labels"].get("org.opencontainers.image.title", "")).strip()
    if t and len(t) <= 30:
        return t
    return " ".join(w[:1].upper() + w[1:] for w in re.split(r"[-_.\s]+", c["name"]) if w)


def tidy_description(d):
    """One short line from a longer text (cut at a word, no trailing punctuation); '' when there is nothing useful."""
    d = re.sub(r"\s+", " ", re.sub(r"[`*_#>]|\[([^\]]*)\]\([^)]*\)", lambda m: m.group(1) or "", d or "")).strip()
    if len(d) > DESC_MAX:
        d = d[:DESC_MAX + 1].rsplit(" ", 1)[0] if " " in d[:DESC_MAX + 1] else d[:DESC_MAX]
    return d.strip(" ,;:-.") if len(d) >= 3 else ""


def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "homelab-cards/" + VERSION, "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=6) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except (OSError, ValueError):
        return {}


def online_description(c):
    """The short text of the image on Docker Hub, or of its GitHub project (images from ghcr.io). '' when there is none."""
    if os.environ.get("HOMELAB_CARDS_OFFLINE"):
        return ""
    repo = c["image"].split("@")[0]
    if ":" in repo.rsplit("/", 1)[-1]:
        repo = repo.rsplit(":", 1)[0]
    parts = repo.split("/")
    if parts[0] in ("docker.io", "registry-1.docker.io", "index.docker.io"):
        parts = parts[1:]
    elif "." in parts[0] or ":" in parts[0]:
        if parts[0] == "ghcr.io" and len(parts) >= 3:
            return tidy_description(fetch_json("%s/repos/%s/%s" % (GITHUB_API, parts[1], parts[2])).get("description"))
        if parts[0] == "lscr.io" and len(parts) >= 3:
            parts = parts[1:]                                   # lscr.io/linuxserver/x is linuxserver/x on Docker Hub
        else:
            return ""
    if len(parts) == 1:
        parts = ["library"] + parts
    if len(parts) != 2:
        return ""
    return tidy_description(fetch_json("%s/v2/repositories/%s/%s" % (HUB_API, parts[0], parts[1])).get("description"))


def fallback_description(c):
    return "Added automatically (%s)" % (c["project"] or c["name"])


def description_of(c, online=True):
    """Short text for the card: a known app, the image's own label, Docker Hub or GitHub; else a plain note (which is replaced later
    when a better one is found)."""
    toks, _ = tokens_of(c)
    for w, d in KNOWN_DESCRIPTIONS.items():
        if w in toks:
            return d
    d = tidy_description(c["labels"].get("org.opencontainers.image.description", ""))
    if d:
        return d
    if online:
        d = online_description(c)
        if d:
            return d
    return fallback_description(c)


def yaml_text(s):
    """A value for services.yaml: quoted when plain text would not be read back as the same text."""
    if (re.search(r": |:$| #", s) or re.match(r"[-?:,\[\]{}#&*!|>'\"%@`\s]", s) or s != s.strip()
            or s.lower() in ("yes", "no", "true", "false", "null", "~", "on", "off")):
        return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"')
    return s


def is_auto_description(text):
    return (text or "").strip("\"' ").startswith("Added automatically")


def icon_slugs(c):
    base = c["image"].split("@")[0].rsplit(":", 1)[0].rsplit("/", 1)[-1].lower()
    out = []
    for s in (c["name"].lower(), base, re.sub(r"[-_](app|server|web|ui|docker)$", "", base), re.sub(r"[-_](app|server|web|ui|docker)$", "", c["name"].lower())):
        for v in (s, s.replace("_", "-")):
            if v and v not in out:
                out.append(v)
    return out


def url_exists(url):
    try:
        req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": "homelab-cards/" + VERSION})
        with urllib.request.urlopen(req, timeout=5) as r:
            return r.status == 200
    except (OSError, ValueError):
        return False


def find_icon(c):
    """Homepage icon name: from its icon library, then Simple Icons, else a plain Docker icon."""
    if os.environ.get("HOMELAB_CARDS_OFFLINE"):
        return GENERIC_ICON
    for s in icon_slugs(c):
        for ext in ("svg", "png"):
            if url_exists("%s/gh/homarr-labs/dashboard-icons/%s/%s.%s" % (ICON_CDN, ext, s, ext)):
                return "%s.%s" % (s, ext)
    for s in icon_slugs(c):
        if url_exists("%s/npm/simple-icons/icons/%s.svg" % (ICON_CDN, s.replace("-", ""))):
            return "si-%s" % s.replace("-", "")
    return GENERIC_ICON


def used_colors(css):
    return {tuple(int(x) for x in m.groups()) for m in re.finditer(r"--accent:\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)", css)}


def pick_color(c, css):
    toks, joined = tokens_of(c)
    for w, rgb in KNOWN_COLORS.items():
        if w in toks:
            return rgb
    used = used_colors(css)
    for rgb in PALETTE:
        if rgb not in used:
            return rgb
    return PALETTE[len(used) % len(PALETTE)]


# ---------------------------------------------------------------- Tailscale
def lan_ip():
    if os.environ.get("HOMELAB_LAN_IP"):
        return os.environ["HOMELAB_LAN_IP"]
    rc, txt = run(["ip", "-4", "route", "get", "1.1.1.1"])
    m = re.search(r"\bsrc\s+(\d+\.\d+\.\d+\.\d+)", txt) if rc == 0 else None
    if m:
        return m.group(1)
    rc, txt = run(["hostname", "-I"])
    return txt.split()[0] if rc == 0 and txt.split() else "127.0.0.1"


def tailscale_name():
    rc, txt = run([TAILSCALE, "status", "--json"], timeout=20)
    try:
        return (json.loads(txt).get("Self") or {}).get("DNSName", "").rstrip(".") if rc == 0 else ""
    except ValueError:
        return ""


def serve_map():
    """{https port: proxy target} of the Tailscale Serve addresses now, or None when Tailscale does not answer."""
    rc, txt = run([TAILSCALE, "serve", "status", "--json"], timeout=20)
    if rc != 0:
        return None
    try:
        js = json.loads(txt) if txt.strip() else {}
    except ValueError:
        return None
    found = {}
    for k, v in (js.get("Web") or {}).items():
        m = re.search(r":(\d+)$", k)
        if m:
            found[int(m.group(1))] = (((v.get("Handlers") or {}).get("/") or {}).get("Proxy", "")).rstrip("/")
    return found


def ensure_serve(hostport, want_port, lan, current):
    """Make sure an HTTPS address points at the container; returns its port, or None when Tailscale cannot do it now."""
    if current is None:
        return None
    target = "http://%s:%d" % (lan, hostport)
    for p, t in current.items():                       # an address for this very port exists already (also one made by hand)
        if t.endswith(":%d" % hostport) and p >= FIRST_SERVE_PORT:
            return p
    port = want_port if want_port and current.get(want_port, target) == target else None
    if port is None:
        port = FIRST_SERVE_PORT
        while port in current:
            port += 1
    if DRY:
        current[port] = target
        return port
    rc, _ = run([TAILSCALE, "serve", "--bg", "--https=%d" % port, target], timeout=60)
    if rc != 0:
        return None
    current[port] = target
    return port


def drop_serve(port, current):
    if port and current and port in current and not DRY:
        run([TAILSCALE, "serve", "--https=%d" % port, "off"], timeout=60)


# ---------------------------------------------------------------- services.yaml (edited as text: comments and layout stay)
def indent(line):
    return len(line) - len(line.lstrip(" "))


def groups_of(lines):
    """[(name, start, end)] of the top level sections."""
    heads = [(i, re.match(r"^- (.+?):\s*$", l).group(1)) for i, l in enumerate(lines) if re.match(r"^- (.+?):\s*$", l)]
    out = []
    for n, (i, name) in enumerate(heads):
        out.append((name, i, heads[n + 1][0] if n + 1 < len(heads) else len(lines)))
    return out


def card_range(lines, card_id):
    """(start, end) of the card with this id, or None."""
    idx = next((i for i, l in enumerate(lines) if re.match(r"^\s*id:\s*%s\s*$" % re.escape(card_id), l)), None)
    if idx is None:
        return None
    start = idx
    while start > 0 and not (re.match(r"^\s*- .+:\s*$", lines[start]) and indent(lines[start]) < indent(lines[idx])):
        start -= 1
    hind = indent(lines[start])
    end = idx + 1
    while end < len(lines) and (not lines[end].strip() or indent(lines[end]) > hind):
        end += 1
    while end > idx + 1 and not lines[end - 1].strip():
        end -= 1
    return start, end


def existing_ids_and_ports(lines):
    ids = {m.group(1) for m in (re.match(r"^\s*id:\s*(\S+)\s*$", l) for l in lines) if m}
    ports = set()
    for l in lines:
        if re.match(r"^\s*(siteMonitor|url):", l):
            ports.update(int(p) for p in re.findall(r":(\d+)(?:/|\s|$)", l))
    return ids, ports


def card_block(name, card_id, href, monitor, icon, desc):
    return ["    - %s:" % name, "        id: %s" % card_id, "        href: %s" % href, "        siteMonitor: %s" % monitor,
            "        icon: %s" % icon, "        description: %s" % yaml_text(desc)]


def insert_card(lines, section, block, top=False):
    """Put a card at the end of its section (top=True: as the first card)."""
    gs = groups_of(lines)
    for name, start, end in gs:
        if name == section:
            first = next((i for i in range(start + 1, end) if re.match(r"^\s+- .+:\s*$", lines[i])), None) if top else None
            if first is not None:
                lines[first:first] = block + [""]
                return
            at = end
            while at > start + 1 and (not lines[at - 1].strip() or lines[at - 1].strip().startswith("#")):
                at -= 1
            has_items = any(re.match(r"^\s+- .+:\s*$", l) for l in lines[start + 1:end])
            lines[at:at] = ([""] if has_items else []) + block
            return
    # the section is not in the file yet: put it where the fixed order of the sections says
    order = SECTIONS.index(section)
    later = next((s for n, s, _ in gs if n in SECTIONS and SECTIONS.index(n) > order), None)
    new = ["- %s:" % section, ""] + block + [""]
    if later is None:
        while lines and not lines[-1].strip():
            lines.pop()
        lines += [""] + new[:-1] + [""]
    else:
        lines[later:later] = new


def remove_card(lines, card_id):
    r = card_range(lines, card_id)
    if not r:
        return False
    s, e = r
    home = next((g for g in groups_of(lines) if g[1] < s < g[2]), None)
    del lines[s:e]
    while s < len(lines) and s > 0 and not lines[s].strip() and not lines[s - 1].strip():
        del lines[s]
    # the section it was in is removed too when no card is left in it (Homepage does not like an empty one)
    if home:
        g = next((g for g in groups_of(lines) if g[0] == home[0]), None)
        if g and not any(l.strip() and not l.strip().startswith("#") for l in lines[g[1] + 1:g[2]]):
            del lines[g[1]:g[2]]
    return True


def set_card_line(lines, card_id, key, value):
    """Change one line (href, siteMonitor) of a card. True when something changed."""
    r = card_range(lines, card_id)
    if not r:
        return False
    for i in range(*r):
        m = re.match(r"^(\s+%s:\s*)(.*?)\s*$" % re.escape(key), lines[i])
        if m and indent(lines[i]) == indent(lines[r[0]]) + 4:
            if m.group(2) != value:
                lines[i] = m.group(1) + value
                return True
            return False
    return False


def card_line(lines, card_id, key):
    r = card_range(lines, card_id)
    if not r:
        return None
    for i in range(*r):
        m = re.match(r"^\s+%s:\s*(.*?)\s*$" % re.escape(key), lines[i])
        if m and indent(lines[i]) == indent(lines[r[0]]) + 4:
            return m.group(1)
    return None


def card_section(lines, card_id):
    r = card_range(lines, card_id)
    if not r:
        return None
    return next((n for n, s, e in groups_of(lines) if s < r[0] < e), None)


def valid_yaml(text):
    try:
        import yaml
    except ImportError:
        return True
    try:
        yaml.safe_load(text)
        return True
    except yaml.YAMLError:
        return False


# ---------------------------------------------------------------- custom.css
LISTS = ("", "::before", "::after")


def css_add(css, card_id, rgb, name):
    """Add the card to the lists that style every card and give it its colour line. Returns the new text."""
    tok = "#%s" % card_id
    for suf in LISTS:
        pat = re.compile(r"((?:#[\w-]+-card%s\s*,\s*)+#[\w-]+-card%s)(\s*\{)" % (re.escape(suf), re.escape(suf)))
        for m in list(pat.finditer(css)):
            if (tok + suf) in re.split(r"\s*,\s*", m.group(1)):
                continue
            css = css[:m.end(1)] + ",\n" + tok + suf + css[m.end(1):]
            break
    line = "%s { --accent: %d, %d, %d; }   /* %s (added by homelab-cards) */" % (tok, rgb[0], rgb[1], rgb[2], name)
    if not re.search(r"(?m)^%s\s*\{\s*--accent" % re.escape(tok), css):
        accents = list(re.finditer(r"(?m)^#[\w-]+-card\s*\{\s*--accent:[^}]*\}.*$", css))
        if accents:
            e = accents[-1].end()
            css = css[:e] + "\n" + line + css[e:]
        else:
            css = css.rstrip("\n") + "\n\n" + line + "\n"
    return css


def css_remove(css, card_id):
    tok = "#%s" % card_id
    css = re.sub(r"(?m)^%s\s*\{\s*--accent:[^}]*\}.*\n?" % re.escape(tok), "", css)
    for suf in LISTS:
        t = re.escape(tok + suf)
        css = re.sub(r",\s*%s(?=\s*[,{])" % t, "", css)          # the last or a middle one of a list
        css = re.sub(r"%s\s*,\s*" % t, "", css)                  # the first one of a list
    return css


def css_has(css, card_id):
    return bool(re.search(r"(?m)^#%s\s*\{\s*--accent" % re.escape(card_id), css))


# ---------------------------------------------------------------- the work
def section_arg(text):
    t = re.sub(r"[^a-z]", "", text.lower())
    for s in SECTIONS:
        if t and t in re.sub(r"[^a-z]", "", s.lower()):
            return s
    for s in SECTIONS:
        if any(w.startswith(text.lower()) for w in re.split(r"[ &]+", s.lower()) if w) and text:
            return s
    return None


class Files:
    """services.yaml and custom.css, read once, written once, only when something changed."""

    def __init__(self):
        self.svc_text = read_text(SERVICES)
        self.css_text = read_text(CSS)
        self.lines = self.svc_text.split("\n")
        self.css = self.css_text

    def save(self):
        new_svc = "\n".join(self.lines)
        if new_svc != self.svc_text:
            if not valid_yaml(new_svc):
                raise RuntimeError("the new services.yaml would not be valid YAML, so nothing was written (a bug: please report it)")
            if not DRY:
                backup_once(SERVICES)
                write_text(SERVICES, new_svc)
        if self.css != self.css_text and not DRY:
            backup_once(CSS)
            write_text(CSS, self.css)


def sync():
    """The whole job. Returns 0, or 1 when it could not run (Docker or the Homepage files missing)."""
    if not os.path.exists(SERVICES):
        say("There is no %s, so there is no dashboard to put cards on." % SERVICES)
        return 1
    if not valid_yaml(read_text(SERVICES)):
        note("%s is not valid YAML now (maybe a half finished edit), so no card was changed. Fix it, then run: sudo homelab-cards" % SERVICES)
        return 1
    cs = containers()
    if cs is None:
        say("Docker does not answer, so nothing was looked at.")
        return 1
    st = load_state()
    f = Files()
    lan = lan_ip()
    fq = tailscale_name()
    serve = serve_map()
    by_name = {c["name"]: c for c in cs}

    # 1. the cards made earlier: keep them right, drop them when the container is gone for good
    for name, m in sorted(st["managed"].items()):
        c = by_name.get(name)
        if c is None:
            m["missing"] = m.get("missing", 0) + 1
            if m["missing"] >= MISSING_LIMIT:
                remove_card(f.lines, m["card"])
                f.css = css_remove(f.css, m["card"])
                drop_serve(m.get("serve"), serve)
                del st["managed"][name]
                note("Removed the card %s: the container %s is gone." % (m["name"], name))
            continue
        m["missing"] = 0
        if card_range(f.lines, m["card"]) is None:
            st["ignore"].append(name)
            del st["managed"][name]
            f.css = css_remove(f.css, m["card"])
            drop_serve(m.get("serve"), serve)
            note("The card %s is not in services.yaml any more (you removed it), so %s is ignored. Allow it again with: sudo homelab-cards unignore %s" % (m["name"], name, name))
            continue
        if c["ports"] and m["hostport"] not in c["ports"]:
            m["hostport"] = c["ports"][0]
        sp = ensure_serve(m["hostport"], m.get("serve"), lan, serve)
        if sp:
            m["serve"] = sp
        href = "https://%s:%d" % (fq, m["serve"]) if fq and m.get("serve") else "http://%s:%d" % (lan, m["hostport"])
        monitor = "http://%s:%d" % (lan, m["hostport"])
        # while Tailscale does not answer, the link is left as it is (a hiccup must not swap it for the local address)
        wanted = [("siteMonitor", monitor)] + ([("href", href)] if serve is not None and (fq or not m.get("serve")) else [])
        for key, val in wanted:
            if set_card_line(f.lines, m["card"], key, val):
                note("Updated the %s of the card %s: %s" % (key, m["name"], val))
        if not css_has(f.css, m["card"]):
            f.css = css_add(f.css, m["card"], tuple(m.get("rgb") or PALETTE[0]), m["name"])
        cur = card_line(f.lines, m["card"], "description")
        if cur is not None and is_auto_description(cur) and time.time() - m.get("desc_tried", 0) >= DESC_RETRY_SECS:
            better = description_of(c)
            m["desc_tried"] = int(time.time())
            if not is_auto_description(better) and set_card_line(f.lines, m["card"], "description", yaml_text(better)):
                note("Updated the text of the card %s: %s" % (m["name"], better))
        here = card_section(f.lines, m["card"])
        if here and here != m["section"]:                  # moved by hand in the file: it stays where the person put it
            m["section"], m["unsure"] = here, False

    # 2. new services
    ids, ports = existing_ids_and_ports(f.lines)
    for c in cs:
        name = c["name"]
        card_id = "%s-card" % re.sub(r"[^a-z0-9-]", "-", name.lower())
        if name in st["managed"] or name in st["ignore"] or is_builtin(c) or card_id in ids or not c["ports"]:
            continue
        if any(p in ports for p in c["ports"]):
            continue                                   # a card (maybe a hand written one) already watches this port
        if c["status"] != "running":
            continue
        port = next((p for p in c["ports"] if answers_like_a_web_page(p)), None)
        if port is None:
            continue
        section, sure = guess_section(c)
        title = display_name(c)
        rgb = pick_color(c, f.css)
        sp = ensure_serve(port, None, lan, serve)
        href = "https://%s:%d" % (fq, sp) if fq and sp else "http://%s:%d" % (lan, port)
        icon = find_icon(c)
        insert_card(f.lines, section, card_block(title, card_id, href, "http://%s:%d" % (lan, port), icon, description_of(c)), top=(name == "navidrome"))
        f.css = css_add(f.css, card_id, rgb, title)
        st["managed"][name] = {"card": card_id, "name": title, "section": section, "hostport": port, "serve": sp, "unsure": not sure,
                               "rgb": list(rgb), "added": int(time.time()), "missing": 0}
        ids.add(card_id)
        ports.add(port)
        note("Added the card %s to %s (%s%s)." % (title, section, "http://%s:%d" % (lan, port), "" if sure else "; not sure about the section"))
        if not sure:
            note("  To put it somewhere else:  sudo homelab-cards move %s \"Files & Photos\"   (or Network & DNS, Media & Entertainment)" % name)
        if not sp:
            note("  No Tailscale HTTPS address yet (Tailscale is not ready): the card uses the local address for now and gets the HTTPS one on a later look.")

    f.save()
    save_state(st)
    if not CHANGES:
        say("Nothing to do: %d card(s) managed, all in order." % len(st["managed"]))
    return 0


def find_managed(st, text):
    t = text.lower()
    for name, m in st["managed"].items():
        if t in (name.lower(), m["card"].lower(), m["name"].lower()):
            return name, m
    return None, None


def cmd_move(args):
    if len(args) < 2:
        print("Usage: sudo homelab-cards move CARD SECTION   (SECTION: Network & DNS, Monitoring & Management, Files & Photos or Media & Entertainment)")
        return 1
    st = load_state()
    name, m = find_managed(st, args[0])
    if not m:
        print("'%s' is not a card this command made. Cards you wrote yourself are moved by editing %s." % (args[0], SERVICES))
        return 1
    sec = section_arg(" ".join(args[1:]))
    if not sec:
        print("'%s' is not one of the sections: %s" % (" ".join(args[1:]), ", ".join(SECTIONS)))
        return 1
    f = Files()
    r = card_range(f.lines, m["card"])
    if not r:
        print("The card %s is not in services.yaml." % m["card"])
        return 1
    block = f.lines[r[0]:r[1]]
    remove_card(f.lines, m["card"])
    insert_card(f.lines, sec, block)
    m["section"], m["unsure"], m["pinned"] = sec, False, True
    f.save()
    save_state(st)
    note("Moved the card %s to %s." % (m["name"], sec))
    return 0


def cmd_ignore(args, undo):
    if not args:
        print("Usage: sudo homelab-cards %s NAME" % ("unignore" if undo else "ignore"))
        return 1
    st = load_state()
    n = args[0]
    if undo:
        if n in st["ignore"]:
            st["ignore"].remove(n)
            save_state(st)
            print("%s is allowed again. Run: sudo homelab-cards" % n)
        else:
            print("%s was not ignored." % n)
        return 0
    name, m = find_managed(st, n)
    f = Files()
    if m:
        remove_card(f.lines, m["card"])
        f.css = css_remove(f.css, m["card"])
        drop_serve(m.get("serve"), serve_map())
        del st["managed"][name]
        n = name
        f.save()
    if n not in st["ignore"]:
        st["ignore"].append(n)
    save_state(st)
    note("%s is ignored: no card is made for it." % n)
    return 0


def cmd_list():
    st = load_state()
    cs = containers()
    print("Cards made by homelab-cards:")
    if not st["managed"]:
        print("  none yet")
    for name, m in sorted(st["managed"].items()):
        print("  %-22s %-26s %s%s" % (m["name"], m["section"], "https://...:%s" % m["serve"] if m.get("serve") else "local address only",
                                    "   (not sure about the section: sudo homelab-cards move %s SECTION)" % name if m.get("unsure") else ""))
    if st["ignore"]:
        print("Ignored: %s" % ", ".join(st["ignore"]))
    if cs:
        f = Files()
        ids, ports = existing_ids_and_ports(f.lines)
        wait = [c["name"] for c in cs if not is_builtin(c) and c["name"] not in st["managed"] and c["name"] not in st["ignore"]
                and c["ports"] and "%s-card" % c["name"].lower() not in ids and not any(p in ports for p in c["ports"])]
        if wait:
            print("Waiting (no web page answered yet, or not running): %s" % ", ".join(wait))
    return 0


def cmd_check():
    """Look-only report for homelab-selftest: lines of 'ok: ...', 'warn: ...' or 'fail: ...'."""
    st = load_state()
    if not st["managed"]:
        print("info: no automatic service cards yet")
        return 0
    cs = containers() or []
    names = {c["name"]: c for c in cs}
    lines = read_text(SERVICES).split("\n")
    css = read_text(CSS)
    serve = serve_map()
    for name, m in sorted(st["managed"].items()):
        c = names.get(name)
        if c is None:
            print("warn: the container %s of the card %s is gone (the card goes away at the next look)" % (name, m["name"]))
        elif c["status"] != "running":
            print("warn: %s (card %s) is not running: %s" % (name, m["name"], c["status"]))
        elif card_range(lines, m["card"]) is None:
            print("warn: the card %s is missing in services.yaml" % m["card"])
        elif not css_has(css, m["card"]):
            print("warn: the card %s has no colour in custom.css" % m["card"])
        elif m.get("serve") and serve is not None and m["serve"] not in serve:
            print("warn: the Tailscale address :%s of %s is missing (sudo homelab-cards sync sets it again)" % (m["serve"], m["name"]))
        else:
            print("ok: the card %s is in order (%s, port %s)" % (m["name"], m["section"], m["hostport"]))
        if m.get("unsure"):
            print("warn: not sure which section %s belongs to: sudo homelab-cards move %s SECTION" % (m["name"], name))
    return 0


def main(argv):
    global QUIET, DRY
    args = [a for a in argv if a not in ("--dry-run", "-n")]
    DRY = len(args) != len(argv)
    cmd = args[0] if args else "sync"
    rest = args[1:]
    if cmd in ("version", "--version"):
        print("homelab-cards %s" % VERSION)
        return 0
    if cmd in ("help", "-h", "--help"):
        print((__doc__ or "").strip())
        return 0
    if cmd == "list":
        return cmd_list()
    if cmd == "check":
        return cmd_check()
    if cmd not in ("sync", "auto", "move", "ignore", "unignore"):
        print("Unknown command '%s'. Try: sudo homelab-cards help" % cmd)
        return 1
    if os.geteuid() != 0 and not os.environ.get("HOMELAB_CARDS_NOROOT"):
        print("Run it with sudo:  sudo homelab-cards %s" % cmd)
        return 1
    try:
        os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
        lock = open(LOCK_FILE, "w")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        if cmd != "auto":
            print("Another homelab-cards is running. Try again in a minute.")
        return 0 if cmd == "auto" else 1
    except OSError:
        lock = None
    QUIET = cmd == "auto"
    if cmd == "move":
        return cmd_move(rest)
    if cmd in ("ignore", "unignore"):
        return cmd_ignore(rest, cmd == "unignore")
    try:
        return sync()
    except RuntimeError as e:
        note(str(e))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
