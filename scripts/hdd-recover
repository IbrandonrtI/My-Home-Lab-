#!/usr/bin/env bash
# hdd-recover - run after an unplug, a power cut or a reconnected drive.
# Stops the containers that use the storage, remounts every drive and pool,
# re-applies the power settings and starts the containers again.
# The work is done by "drives recover" so the container list is found automatically.
case "${1:-}" in
  -h | --help | help)
    echo "hdd-recover - after an unplug, a power cut or a reconnected drive: remount the drives and start the containers again."
    echo
    echo "  sudo hdd-recover     do it now (the same as:  sudo drives recover --now)"
    echo "  sudo drives recover  the same with more options; see:  sudo drives help recover"
    exit 0 ;;
  version | --version) echo "hdd-recover 1.1"; exit 0 ;;
esac
exec /usr/local/sbin/drives recover --now "$@"
