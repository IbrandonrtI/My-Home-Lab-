#!/usr/bin/env bash
# homelab - cheat sheet and live status for the home lab server.
#
#   homelab           the whole screen: a summary, the current status (checked live), the dashboard addresses and suggested commands
#   homelab commands  every command I use, in groups
#                     ("Suggested Commands" are up to six that fit the current state)
#   homelab status    only the status block
#   homelab login     the screen shown when a terminal opens: the summary, the status and the browser addresses (no suggestions)
#   homelab docs      list the sections of the README and of the guides in docs/
#   homelab secrets   rebuild check: what must be in your password manager, and what the
#                     server can confirm (values are never shown; sudo gives a fuller check)
#   homelab version   the version of this command
#
#   Short forms (they run the real command with sudo and say which one):
#   homelab backup | update | upgrade | uninstall | setup | drives | cards | selftest   [options]
#                     = sudo homelab-backup | homelab-update | homelab-setup upgrade | homelab-setup uninstall | homelab-setup | drives | homelab-cards | homelab-selftest
#
#   homelab theme     change the Homepage dashboard's background, and the colour of all cards or of one card (homelab theme shows how)
#   homelab bookmark  add, list, move or remove bookmarks, by category; logos come from Brandfetch as SVG files
#
# Apart from theme and bookmark (which edit the Homepage files in your own home folder) and the short
# forms above (which ask sudo for the real command), it only reads information and never needs sudo.
# ~/.bashrc runs the shorter form, "homelab login", when a terminal opens (the installer adds that line).

VERSION="2.1"
MAIN_POOL="${HOMELAB_MAIN_POOL:-/mnt/storage}"
BACKUP_POOL="${HOMELAB_BACKUP_POOL:-/mnt/backup}"
LAST_RUN_FILE="${HOMELAB_LAST_RUN_FILE:-/var/lib/homelab-backup/last-run}"
DOCS_DIR="${HOMELAB_DOCS_DIR:-$HOME/My-Home-Lab-}"
REPO_URL="${HOMELAB_REPO_URL:-https://github.com/IbrandonrtI/My-Home-Lab-.git}"
STALE_HOURS="${HOMELAB_STALE_HOURS:-36}"
BOOT_PATH="${HOMELAB_BOOT_PATH:-/}"
STATE_DIR="${HOMELAB_STATE_DIR:-/var/lib/homelab}"        # readings saved by homelab-sample
TEMP_WARN="${HOMELAB_TEMP_WARN:-50}"                       # drive temperature (C) that turns yellow
TEMP_BAD="${HOMELAB_TEMP_BAD:-60}"                         # ... and red
SAMPLE_STALE_MIN="${HOMELAB_SAMPLE_STALE_MIN:-60}"         # minutes before the readings count as old
LOGIN_CACHE_SECS="${HOMELAB_LOGIN_CACHE_SECS:-120}"        # a login screen this young is shown again as it was (terminals opened close together)
URL_CACHE_SECS="${HOMELAB_URL_CACHE_SECS:-3600}"           # the dashboard addresses are looked up at most this often
BOOT_GRACE_SECS="${HOMELAB_BOOT_GRACE_SECS:-600}"          # after a boot the login screen only does light checks for this long
JUST_BOOTED=0

# colours only when printing to a terminal that supports them
if { [ -t 1 ] || [ "${HOMELAB_COLOR:-}" = 1 ]; } && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then   # HOMELAB_COLOR=1: the login hook writes to a file first but the screen is shown in colour
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'
else
  B=""; D=""; G=""; Y=""; R=""; N=""
fi
# symbols: plain ones if the terminal is not UTF-8
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) S_OK="✓"; S_WARN="!"; S_BAD="✗"; S_DOT="·"; S_RULE="─" ;;
  *)                                S_OK="+"; S_WARN="!"; S_BAD="x"; S_DOT="-"; S_RULE="-" ;;
esac

# The real window width: the terminal is asked first. $COLUMNS is only a copy made when the shell started, and sudo passes it on.
# The terminal is only asked when one is there (stdin or stderr is a terminal): inside a script or a self-test it can hang.
term_cols() { local c=""; if [ -t 0 ] || [ -t 2 ]; then c=$(stty size 2>/dev/null </dev/tty | cut -d" " -f2); [[ "$c" =~ ^[0-9]+$ ]] || c=$(tput cols 2>/dev/null); fi; [[ "$c" =~ ^[0-9]+$ ]] || c=${COLUMNS:-80}; [[ "$c" =~ ^[0-9]+$ ]] || c=80; [ "$c" -lt 40 ] && c=40; echo "$c"; }

rule() {   # rule "Title": a spaced section heading with a thin line
  local cols w t="$1" n pad
  cols=$(term_cols); w=$cols; [ "$w" -gt 76 ] && w=76
  n=$(( w - ${#t} - 8 )); [ "$n" -lt 3 ] && n=3
  pad=$(printf '%*s' "$n" '' | sed "s/ /$S_RULE/g")
  printf '\n  %s%s%s%s %s%s%s %s%s%s\n\n' "$D" "$S_RULE" "$S_RULE" "$N" "$B" "$t" "$N" "$D" "$pad" "$N"
}

# status rows. While BUFFERING=1 they are collected (so the top summary can count them), otherwise printed.
OKN=0; WARNN=0; BADN=0; STATUS_BUF=""; BUFFERING=0
row() {   # row COLOUR SYMBOL LABEL TEXT TEXTCOLOUR
  local out
  printf -v out '   %s%s%s  %-16s %s%s%s\n' "$1" "$2" "$N" "$3" "$5" "$4" "$N"
  if [ "$BUFFERING" -eq 1 ]; then STATUS_BUF+="$out"; else printf '%s' "$out"; fi
}
ok()   { OKN=$((OKN + 1));     row "$G" "$S_OK"   "$1" "$2" ""; }
warn() { WARNN=$((WARNN + 1)); row "$Y" "$S_WARN" "$1" "$2" "$Y"; }
bad()  { BADN=$((BADN + 1));   row "$R" "$S_BAD"  "$1" "$2" "$R"; }

# command lists: collected per section, so the whole section is a table (if it fits the window) or stacked
CMDS_C=(); CMDS_D=()
cmd() { CMDS_C+=("$1"); CMDS_D+=("$2"); }
flush_cmds() {
  local i w=0 cols fits=1
  cols=$(term_cols)
  for i in "${!CMDS_C[@]}"; do [ "${#CMDS_C[$i]}" -gt "$w" ] && w=${#CMDS_C[$i]}; done
  w=$((w + 3))
  for i in "${!CMDS_C[@]}"; do [ $(( 3 + w + ${#CMDS_D[$i]} )) -ge "$cols" ] && fits=0; done
  for i in "${!CMDS_C[@]}"; do
    if [ "$fits" -eq 1 ]; then printf '   %s%-*s%s%s\n' "$B" "$w" "${CMDS_C[$i]}" "$N" "${CMDS_D[$i]}"
    else printf '   %s%s%s\n       %s\n' "$B" "${CMDS_C[$i]}" "$N" "${CMDS_D[$i]}"; fi
  done
  CMDS_C=(); CMDS_D=()
}
section() { flush_cmds; rule "$1"; }

# Suggested commands: status() and setup_line() add entries (priority 1 = most urgent), suggestions() prints the best few.
SUGG=()
suggest() {   # suggest PRIORITY COMMAND WHY  (the same command is kept only once)
  local e
  for e in "${SUGG[@]}"; do [[ "$e" == *"|$2|"* ]] && return 0; done
  SUGG+=("$1|$2|$3")
}
only_boot_section() {   # only_boot_section MAIN|BACKUP: this pool is made of a boot drive section and no real drive
  local pfx=$1 d dir="${HOMELAB_DISKS_DIR:-/mnt/disks}"
  for d in "$dir/$pfx"[0-9]*; do [ -e "$d" ] && findmnt -n "$d" >/dev/null 2>&1 && return 1; done
  findmnt -n "$dir/${pfx}BOOT" >/dev/null 2>&1
}

suggestions() {
  local max="${HOMELAB_SUGGEST_MAX:-6}" n=0 c why
  # when little needs doing, fill up with the commands used most often (the ones that matter now come first)
  suggest 6 "sudo drives status" "pools, drives, temperatures and the last backup"
  suggest 6 "sudo homelab-backup" "run a backup now"
  suggest 7 "sudo homelab-update check" "look online for newer container images"
  suggest 7 "docker ps" "what is running right now"
  suggest 7 "sudo homelab-selftest" "check everything and look for problems or leftovers"
  suggest 8 "sudo drives" "menu: connect or remove drives, or use part of the boot drive for a pool"
  if [ -d "$HOMEPAGE_DIR" ]; then
    suggest 8 "homelab theme" "change the dashboard's background and card colours"
    suggest 8 "homelab bookmark add NAME URL" "add a bookmark to the dashboard, with its logo"
  fi
  suggest 9 "homelab commands" "every command, in groups"
  suggest 9 "homelab docs" "list the sections of the guides"
  rule "Suggested Commands"
  while IFS='|' read -r _p c why; do
    [ -n "$c" ] || continue
    [ "$n" -ge "$max" ] && break
    cmd "$c" "$why"; n=$((n + 1))
  done < <(printf '%s\n' "${SUGG[@]}" | sort -t'|' -k1,1n -s)
  flush_cmds
  echo
}

lan_address() {   # this machine's address on the home network
  local ip="${HOMELAB_LAN_IP:-}"
  [ -n "$ip" ] || ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}')
  [ -n "$ip" ] || ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo "$ip"
}

dashboard_urls() {   # sets DASH_HOME (the address at home) and DASH_TS (the Tailscale one, if there is one)
  local ip port=""
  DASH_HOME=""; DASH_TS=""
  ip=$(lan_address)
  [ -n "$ip" ] || return 0
  # the port Homepage listens on: ask Docker (the installer's default is 3001; 3000 belongs to AdGuard Home)
  command -v docker >/dev/null 2>&1 && port=$(timeout 3 docker port homepage 2>/dev/null | awk -F: 'NR == 1 {print $NF}')
  [[ "$port" =~ ^[0-9]+$ ]] || port="${HOMELAB_HOMEPAGE_PORT:-3001}"
  DASH_HOME="http://$ip:$port"
  if command -v tailscale >/dev/null 2>&1; then
    DASH_TS=$(timeout 3 tailscale serve status 2>/dev/null | awk -v p=":$port" '/^https:\/\// {u = $1} $0 ~ "proxy .*" p "[[:space:]]*$" && u {print u; exit}')
  fi
}

open_section() {   # where to click: the dashboard on the home network, and from anywhere through Tailscale (open_section login: the addresses are kept for an hour)
  [ -d "$HOMEPAGE_DIR" ] || return 0
  if [ -n "${1:-}" ]; then cached_dashboard_urls; else dashboard_urls; fi
  [ -n "$DASH_HOME" ] || return 0
  rule "Open in your browser"
  printf '   %-30s %s%s%s\n' "Dashboard, at home" "$B" "$DASH_HOME" "$N"
  [ -z "$DASH_TS" ] || printf '   %-30s %s%s%s\n' "Dashboard, from anywhere" "$B" "$DASH_TS" "$N"
  [ -z "$DASH_TS" ] || printf '   %s%-30s needs the Tailscale app on that device, signed in to your account%s\n' "$D" "" "$N"
}

show_docs() {
  local f
  if [ ! -d "$DOCS_DIR" ]; then
    echo "The documents are not on this server yet. Clone them once:"
    echo "  git clone $REPO_URL \"$DOCS_DIR\""
    return 1
  fi
  for f in README.md $(cd "$DOCS_DIR" 2>/dev/null && ls docs/*.md 2>/dev/null); do
    [ -f "$DOCS_DIR/$f" ] || continue
    rule "$f"
    echo "   open a section with:  less +LINE $DOCS_DIR/$f"
    echo
    grep -n '^## ' "$DOCS_DIR/$f" | sed 's/^\([0-9]*\):## /   \1\t/'
  done
  echo
}

header() {
  printf '\n  %sHome lab%s  %s%s%s  %s  %s%s%s  %s\n' "$B" "$N" "$D" "$S_DOT" "$N" "$(hostname)" "$D" "$S_DOT" "$N" "$(uptime -p 2>/dev/null)"
}

summary_line() {
  echo
  if [ "$BADN" -gt 0 ]; then
    local w="need"; [ "$BADN" -eq 1 ] && w="needs"
    local p="problems"; [ "$BADN" -eq 1 ] && p="problem"
    printf '   %s%s%s  %s%d %s %s you.%s  Details in Status below.\n' "$R" "$S_BAD" "$N" "$R" "$BADN" "$p" "$w" "$N"
  elif [ "$WARNN" -gt 0 ]; then
    local t="things"; [ "$WARNN" -eq 1 ] && t="thing"
    printf '   %s%s%s  %d %s to look at.  Details in Status below.\n' "$Y" "$S_WARN" "$N" "$WARNN" "$t"
  else
    printf '   %s%s%s  Everything looks fine.\n' "$G" "$S_OK" "$N"
  fi
}

setup_line() {   # shown only while homelab-setup still has steps left (it removes the file when all are done)
  local f="$STATE_DIR/setup-progress" d t _e
  [ -r "$f" ] || return 0
  IFS='|' read -r d t _e <"$f"
  [[ "$d" =~ ^[0-9]+$ && "$t" =~ ^[0-9]+$ ]] || return 0
  [ "$d" -lt "$t" ] || return 0
  printf '   %s%s%s  Setup is not finished: %d of %d steps done. Some warnings below are normal until it is.\n' "$Y" "$S_WARN" "$N" "$d" "$t"
  printf '       Next: run  %ssudo homelab-setup%s  to see what is left.\n' "$B" "$N"
  suggest 2 "sudo homelab-setup refresh" "carry on with setup ($(( t - d )) steps left)"
  suggest 2 "sudo homelab-setup" "see the checklist and the next step"
}

finish_line() {   # the last steps of the install finish in the background (written by `homelab-setup finish`); shown while it runs or after failures
  local f="$STATE_DIR/finish-status" txt st d t u
  [ -r "$f" ] || return 0
  txt=$(cat "$f" 2>/dev/null)
  st=$(sed -n 's/.*"state": "\([a-z]*\)".*/\1/p' <<<"$txt")
  d=$(sed -n 's/.*"done": \([0-9]*\).*/\1/p' <<<"$txt")
  t=$(sed -n 's/.*"total": \([0-9]*\).*/\1/p' <<<"$txt")
  u=$(sed -n 's/.*"updated": \([0-9]*\).*/\1/p' <<<"$txt")
  [[ "$d" =~ ^[0-9]+$ && "$t" =~ ^[0-9]+$ && "$u" =~ ^[0-9]+$ ]] || return 0
  if [ "$st" = running ] && [ $(( $(date +%s) - u )) -lt 3600 ]; then
    printf '   %s%s%s  The last steps of the install are finishing in the background: %d of %d done.\n' "$Y" "$S_WARN" "$N" "$d" "$t"
    printf '       How far it is: run  %ssudo homelab-setup status%s\n' "$B" "$N"
  elif [ "$st" = failed ]; then
    printf '   %s%s%s  Some of the last install steps failed. See which:  %ssudo homelab-setup status%s\n' "$Y" "$S_WARN" "$N" "$B" "$N"
    suggest 2 "sudo homelab-setup finish" "try the failed last steps again"
  fi
}

secrets_hint() {   # the passwords and keys the installer made: one line under the commands hint, then the blank line
  if command -v homelab-setup >/dev/null 2>&1; then
    printf '  %sPasswords and keys:%s %ssudo homelab-setup secrets%s\n' "$D" "$N" "$B" "$N"
  fi
  printf '\n'
}

hint_line() {
  printf '  %sType%s %shomelab commands%s %sto see every command.%s\n' "$D" "$N" "$B" "$N" "$D" "$N"
  secrets_hint
}

commands() {
  # keep every description short: a section prints as a table only if its longest line fits the window (about 100 columns)
  # each section is in alphabetical order (not counting "sudo")
  section "Start here"
  cmd "docker ps"                      "what is running right now, and how healthy it is"
  cmd "sudo drives status"             "pools, drives, SMART health, free space, last backup"
  cmd "homelab"                        "this machine at a glance: status and what to do next"
  cmd "sudo homelab-backup"            "run the backup now (about a minute, longer after many new files)"
  cmd "sudo homelab-setup upgrade"     "update the lab: new files from GitHub, new scripts here"
  cmd "sudo homelab-update check"      "look online for newer container images (changes nothing)"
  section "Which check do I run?"
  cmd "sudo drives check"              "scan the pool drives for file system errors (changes nothing)"
  cmd "sudo drives health"             "SMART health, temperature and wear of every drive"
  cmd "homelab status"                 "a quick look at everything (every row, checked now)"
  cmd "homelab-repocheck ~/My-Home-Lab-" "the repository files only, before an upload (not the server)"
  cmd "sudo homelab-selftest"          "the big check of the whole lab (report saved in ~)"
  cmd "sudo homelab-setup verify"      "does every container and service answer?"
  section "Drives: the main ones"
  cmd "df -h /"                        "free space on the boot drive (the one the system runs from)"
  cmd "sudo drives"                    "menu: look at, connect, remove or fix drives"
  cmd "sudo drives connect"            "add a new drive to the main or backup pool (asks before erasing)"
  cmd "sudo drives disconnect"         "take a drive out of a pool, copying its files to the others first"
  cmd "sudo drives list"               "one line per drive: name, size, pool, state"
  cmd "sudo drives remount"            "after an unplug or power cut: remount, restart containers"
  cmd "sudo drives replace"            "a drive died: swap it, restore the files from the backup"
  cmd "sudo drives usage"              "space used and free, per drive and per pool"
  cmd "sudo drives wizard"             "suggest a ready-made setup (drives with files too)"
  cmd "findmnt /mnt/storage"           "is the main pool connected? (prints nothing if not)"
  section "More drive commands"
  cmd "sudo drives adopt"              "turn the old single data drive into a pool"
  cmd "sudo drives balance"            "even out the files over one pool's drives (shows the plan)"
  cmd "sudo drives bootsection"        "use part of the boot drive for a pool (size limit, used last)"
  cmd "sudo drives cache"              "add an SSD read cache to a ZFS array"
  cmd "sudo drives eject"              "get a spare drive ready to unplug"
  cmd "sudo drives fillorder"          "how new files pick a drive (one by one or spread), and the order"
  cmd "sudo drives help"               "every drive command with its options (sudo drives help NAME)"
  cmd "sudo drives limit"              "how much free space a drive keeps before the next is used"
  cmd "sudo drives move"               "move a drive between the main and the backup pool"
  cmd "sudo drives power"              "re-apply the drive power settings"
  cmd "sudo drives preset"             "ready-made setups on empty drives: pool, SnapRAID, ZFS, RAID"
  cmd "sudo drives release"            "take all drives out of the pools (files stay on the drives)"
  cmd "sudo drives rename"             "give a pool drive a name of your own"
  cmd "sudo drives resize"             "change the size of a boot drive section"
  cmd "sudo drives restore"            "copy back only the files that are missing from the backup"
  cmd "sudo drives sleep"              "spin a drive down now (sudo drives wake wakes it)"
  cmd "sudo drives snapraid"           "SnapRAID by hand: status, diff, sync or scrub"
  cmd "sudo drives spare"              "add a hot spare drive to a ZFS or RAID array"
  cmd "sudo drives timeshift"          "stop Timeshift copying the boot drive sections"
  cmd "sudo drives wipe"               "erase a spare drive that is not in a pool"
  section "Backup"
  cmd "sudo homelab-restore-configs check" "after a rebuild: preview restoring saved settings"
  cmd "sudo tail -f /var/log/homelab-backup.log" "watch a backup while it runs (Ctrl+C to leave)"
  section "Containers and updates"
  cmd "docker logs --tail 50 NAME"     "the last 50 lines a container printed"
  cmd "docker restart NAME"            "restart one container"
  cmd "docker stats --no-stream"       "CPU and memory of each container"
  cmd "sudo homelab-update"            "check, download, then update each stack (asks first)"
  cmd "sudo homelab-update clean"      "delete old saved versions and leftover images (asks first)"
  cmd "homelab-update list"            "what is waiting, and the order to update in (no sudo)"
  section "System and network"
  cmd "sudo apt update && sudo apt upgrade" "install the waiting system updates"
  cmd "sudo reboot"                    "restart the server (afterwards: sudo drives status)"
  cmd "tailscale status"               "who is on your private network"
  section "Homepage dashboard"
  cmd "homelab bookmark add NAME URL [CATEGORY]" "add one (optional too: ICON LINK, NUMBER)"
  cmd "homelab bookmark list"          "the bookmarks, by category, with their numbers"
  cmd "homelab bookmark move NAME CATEGORY" "another category (add a NUMBER for its place)"
  cmd "homelab bookmark remove NAME [CATEGORY]" "take one away (CATEGORY if the name is in two)"
  cmd "homelab calendar add NAME ADDRESS" "show an online calendar (Google, school ...)"
  cmd "homelab calendar list"          "your online calendars (also: remove N, sync)"
  cmd "homelab event add DATE \"text\" [yearly]" "your own event in the calendar"
  cmd "homelab event list"             "your events, numbered (remove: event remove NUMBER)"
  cmd "homelab panel password"         "change the Customize password (admin one at first)"
  cmd "homelab panel status"           "is the panel password set?"
  cmd "homelab simple on|off"          "hide the small text under card names (default: off)"
  cmd "homelab theme"                  "show the look and how to change it (no sudo)"
  cmd "homelab theme background [BLUR] URL" "new picture; optional BLUR: none sm md lg xl 2xl 3xl"
  cmd "homelab theme cards COLOR NUMBER" "ALL cards: colour, how solid (NUMBER 0 to 100)"
  cmd "homelab theme cards SERVICE COLOR" "ONE card, e.g. AdGuard Home blue"
  cmd "homelab theme links GROUP COLOR" "colour of one bookmark group, e.g. Productivity green"
  cmd "homelab theme reset"            "the shipped look again"
  cmd "sudo homelab-cards"             "give new services (containers with a web page) a card"
  cmd "sudo homelab-cards ignore NAME" "never make a card for this container"
  cmd "sudo homelab-cards list"        "the cards it made, and what it waits for"
  cmd "sudo homelab-cards move NAME SECTION" "put a card in another section"
  if command -v homelab-setup >/dev/null 2>&1; then
    section "Setup checklist"
    cmd "sudo homelab-setup"             "the checklist: what is done and what is left"
    cmd "sudo homelab-setup --details"   "the full instructions of every open step"
    cmd "sudo homelab-setup adguard"     "add AdGuard Home, if you skipped it during the install"
    cmd "sudo homelab-setup done STEP"   "mark a step you did by hand as done (see the checklist)"
    cmd "sudo homelab-setup fill"        "walk through the logins and keys that need you"
    cmd "sudo homelab-setup growdisk"    "use the drive's unused space for the system (LVM; asks first)"
    cmd "sudo homelab-setup install"     "set everything up, or carry on after a failure (safe to repeat)"
    cmd "sudo homelab-setup refresh"     "re-check, and continue every step that is now possible"
    cmd "sudo homelab-setup secrets"     "show the generated passwords and keys once more"
    cmd "sudo homelab-setup skip STEP"   "mark an optional step as not wanted"
    cmd "sudo homelab-setup verify"      "check that every container and service is up"
  fi
  section "Rebuild and safety"
  cmd "homelab secrets"                "rebuild check: passwords you must have, and what is backed up"
  section "This screen and the guides"
  cmd "homelab commands"               "this list"
  cmd "homelab docs"                   "sections of the README and the guides in docs/"
  cmd "homelab status"                 "only the status block"
  section "Short forms"
  cmd "homelab backup"                 "the same as: sudo homelab-backup (also update, cards, selftest)"
  cmd "homelab drives"                 "the same as: sudo drives (add a command: homelab drives health)"
  cmd "homelab uninstall"              "the same as: sudo homelab-setup uninstall (asks first)"
  cmd "homelab upgrade"                "the same as: sudo homelab-setup upgrade"
  section "Words used here"
  cmd "Backup / Main"                  "Main holds your files; Backup holds the nightly copy of them"
  cmd "boot drive"                     "the drive the system itself runs from"
  cmd "container"                      "an app running in Docker; a stack is a group of them"
  cmd "mirror, SnapRAID, ZFS, RAID"    "ways to keep your files if a drive dies (sudo drives wizard)"
  cmd "pool"                           "several drives shown as one folder (Main: /mnt/storage)"
  cmd "SMART"                          "a drive's own health report: temperature, bad sectors, wear"
  flush_cmds
}

# ---- homelab theme / homelab bookmark: edit the Homepage files in your own home folder (never needs sudo) ----
HOMEPAGE_DIR="${HOMELAB_HOMEPAGE_DIR:-$HOME/homepage-config}"
calendar_cmd() {   # homelab event add|list|remove|holidays: the holidays and your own events in the dashboard calendar
  if ! command -v homelab-calendar >/dev/null 2>&1; then
    echo "homelab-calendar is not installed yet. Run:  homelab upgrade" >&2
    return 1
  fi
  HP_DIR="$HOMEPAGE_DIR" homelab-calendar "$@"
}

panel_cmd() {   # homelab panel password|status: the password of the control panel (the Customize tab), saved in your own folder
  if ! command -v homelab-panel >/dev/null 2>&1; then
    echo "The control panel is not installed yet. Run:  homelab upgrade" >&2
    return 1
  fi
  if [ "$(id -u)" -eq 0 ] && [ -z "${HOMELAB_ALLOW_ROOT:-}" ]; then
    echo "Run this without sudo, as yourself: the password is saved in your own folder." >&2
    return 1
  fi
  case "${1:-}" in
    password|passwd) homelab-panel set-password ;;
    status|"")       homelab-panel status ;;
    *) echo "Use:  homelab panel password   (choose the password)   or   homelab panel status" >&2; return 1 ;;
  esac
}

homepage_edit() {
  if [ "$(id -u)" -eq 0 ] && [ -z "${HOMELAB_ALLOW_ROOT:-}" ]; then
    echo "Run this without sudo, as the user who owns $HOMEPAGE_DIR (sudo would make the files belong to root)." >&2
    return 1
  fi
  command -v python3 >/dev/null 2>&1 || { echo "python3 is needed for this command (sudo apt install python3)." >&2; return 1; }
  HP_DIR="$HOMEPAGE_DIR" HP_DOCS_DIR="$DOCS_DIR" python3 - "$@" <<'PY'
import difflib
import os
import re
import shutil
import signal
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import urlparse

HP = os.environ["HP_DIR"]
DOCS = os.environ.get("HP_DOCS_DIR", "")
BASE = os.environ.get("HOMELAB_BRANDFETCH_BASE", "https://cdn.brandfetch.io").rstrip("/")
SETTINGS = os.path.join(HP, "settings.yaml")
CSS = os.path.join(HP, "custom.css")
MARKS = os.path.join(HP, "bookmarks.yaml")
SERVICES_FILE = os.path.join(HP, "services.yaml")
IMAGES = os.path.join(HP, "images")
IDFILE = os.path.join(HP, ".brandfetch-client-id")
B1, B2 = "/* >>> homelab theme >>>", "/* <<< homelab theme <<< */"
COLORS = {
    "slate": (14, 19, 31), "black": (0, 0, 0), "white": (255, 255, 255), "gray": (58, 58, 58), "grey": (58, 58, 58),
    "blue": (30, 58, 138), "navy": (15, 23, 60), "green": (20, 83, 45), "teal": (19, 78, 74), "red": (127, 29, 29),
    "purple": (59, 7, 100), "pink": (131, 24, 67), "orange": (124, 45, 18), "yellow": (113, 63, 18), "brown": (68, 40, 22),
}
ACCENT = {
    "blue": (36, 140, 255), "green": (104, 186, 72), "red": (209, 18, 18), "purple": (147, 51, 234), "orange": (214, 90, 22),
    "pink": (236, 72, 153), "teal": (20, 184, 166), "yellow": (234, 179, 8), "cyan": (0, 197, 253), "white": (255, 255, 255),
    "gray": (148, 163, 184), "grey": (148, 163, 184), "black": (23, 21, 20),
}
# the cards that ship with the lab; the real list is read from services.yaml, so a service you add yourself works too
DEFAULT_SERVICES = [("AdGuard Home", "adguard-card"), ("Tailscale", "tailscale-card"), ("Beszel", "beszel-card"), ("Netdata", "netdata-card"),
                    ("Speedtest Tracker", "speedtest-card"), ("Portainer", "portainer-card"), ("FileBrowser", "filebrowser-card"),
                    ("Immich", "immich-card"), ("Nextcloud", "nextcloud-card")]
DEFAULT_WORDS = ("default", "reset", "normal", "shipped")
CARD_TABLE = dict(COLORS)   # the colour names for one service card (the bright ones win over the dark ones of the same name)
CARD_TABLE.update(ACCENT)
BLURS = ("sm", "md", "lg", "xl", "2xl", "3xl")
NO_BLUR = ("none", "off")


class Fail(Exception):
    pass


def read(p):
    try:
        with open(p, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return ""


def write(p, text):
    if os.path.exists(p) and not os.path.exists(p + ".before-theme") and p != IDFILE:
        shutil.copy2(p, p + ".before-theme")
    tmp = p + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, p)


def need_dir():
    if not os.path.isdir(HP):
        raise Fail("The Homepage folder %s does not exist. Set HOMELAB_HOMEPAGE_DIR to the folder that holds settings.yaml." % HP)


def parse_color(s, table, what):
    s = s.strip().lower()
    if s in table:
        return table[s]
    m = re.fullmatch(r"#?([0-9a-f]{6})", s)
    if m:
        h = m.group(1)
        return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    raise Fail("I don't know the %s colour '%s'. Use a name (%s) or a hex code such as #1e3a8a." % (what, s, ", ".join(sorted(table))))


# ---------------------------------------------------------------- settings.yaml: the background block
def bg_block(text):
    lines = text.split("\n")
    for i, l in enumerate(lines):
        if re.match(r"^background:\s*(#.*)?$", l):
            j = i + 1
            while j < len(lines) and (lines[j].startswith(" ") or lines[j].startswith("\t") or lines[j].strip() == "" and j + 1 < len(lines) and lines[j + 1].startswith(" ")):
                j += 1
            return lines, i, j
    return lines, None, None


def bg_get(text):
    lines, i, j = bg_block(text)
    d = {}
    if i is None:
        return d
    for l in lines[i + 1:j]:
        m = re.match(r"^\s+([A-Za-z0-9_]+):\s*(.*?)\s*$", l)
        if m:
            d[m.group(1)] = m.group(2)
    return d


def bg_set(text, key, value):
    """Set (or, with value None, remove) one key in the background: block."""
    lines, i, j = bg_block(text)
    if i is None:
        if value is None:
            return text
        if not text.endswith("\n") and text:
            text += "\n"
        return text + "background:\n  %s: %s\n" % (key, value)
    for k in range(i + 1, j):
        if re.match(r"^\s+%s:" % re.escape(key), lines[k]):
            if value is None:
                del lines[k]
            else:
                lines[k] = "  %s: %s" % (key, value)
            return "\n".join(lines)
    if value is not None:
        lines.insert(j, "  %s: %s" % (key, value))
    return "\n".join(lines)


def quote(s):
    return "'" + s.replace("'", "''") + "'"


def number(s, what, lo=0, hi=100):
    try:
        n = int(s)
    except ValueError:
        raise Fail("%s must be a whole number from %d to %d." % (what, lo, hi)) from None
    if not lo <= n <= hi:
        raise Fail("%s must be from %d to %d." % (what, lo, hi))
    return n


# ---------------------------------------------------------------- custom.css: one marked block at the end
def css_split(text):
    a = text.find(B1)
    if a < 0:
        return text, ""
    b = text.find(B2, a)
    if b < 0:
        return text, ""
    return text[:a].rstrip("\n") + "\n", text[a:b + len(B2)]


def fmt_alpha(a):
    return str(int(a)) if a in (0, 1) else ("%.2f" % a).rstrip("0").rstrip(".")


def css_state(block):
    """cards = the colour of every card; links = {group name tag: (r, g, b)}, the colour of a bookmark group (what the marked block holds)"""
    st = {"cards": None, "links": {}}
    for m in re.finditer(r'(?m)^\.bookmark-group\[data-group="([a-z0-9-]+)"\]\s*\{\s*--accent:\s*(\d+),\s*(\d+),\s*(\d+);', block):
        st["links"][m.group(1)] = (int(m.group(2)), int(m.group(3)), int(m.group(4)))
    m = re.search(r"(?m)^\.service-card\s*\{\s*background:\s*rgba\((\d+),\s*(\d+),\s*(\d+),\s*([0-9.]+)\)", block)
    if m:
        st["cards"] = (int(m.group(1)), int(m.group(2)), int(m.group(3)), float(m.group(4)))
    return st


def css_build(st):
    if not st["cards"] and not st.get("links"):
        return ""
    out = [B1 + " written by: homelab theme. Remove it with: homelab theme reset */"]
    if st["cards"]:
        c = st["cards"][:3] + (fmt_alpha(st["cards"][3]),)
        out.append(".service-card { background: rgba(%d, %d, %d, %s) !important; }" % c)
        out.append(".bookmark > a { background: rgba(%d, %d, %d, %s) !important; }" % c)
    for tag, rgb in sorted(st.get("links", {}).items()):
        out.append('.bookmark-group[data-group="%s"] { --accent: %d, %d, %d; }' % ((tag,) + tuple(rgb)))
    out.append(B2)
    return "\n".join(out) + "\n"


# The colour of one service card is the "accent colors (R, G, B)" line of that service in custom.css (it paints the glow and the edge).
ACCENT_LINE = r"(?m)^(#%s-card\s*\{\s*--accent:\s*)(\d+),\s*(\d+),\s*(\d+);\s*\}(?:[ \t]*/\*.*?\*/)?"


def accent_get(text):
    """{service key: (r, g, b)} from the accent lines of a custom.css text"""
    return {m.group(1): (int(m.group(2)), int(m.group(3)), int(m.group(4)))
            for m in re.finditer(r"(?m)^#([\w-]+)-card\s*\{\s*--accent:\s*(\d+),\s*(\d+),\s*(\d+);", text)}


def accent_set(text, key, rgb, label):
    """Change the three numbers of one service's accent line (the spacing of the file is kept). (new text, changed?)"""
    nums = "%-5s%-5s%-6s}" % ("%d," % rgb[0], "%d," % rgb[1], "%d;" % rgb[2])
    return re.subn(ACCENT_LINE % re.escape(key), lambda m: m.group(1) + nums + "   /* %s */" % label, text, count=1)


def shipped_copy(name, current):
    """The shipped version of a Homepage file: the one in the repository, else the first copy saved before the first change."""
    shipped = read(os.path.join(DOCS, "homepage-config", name)) if DOCS else ""
    return shipped or read(current + ".before-theme")


def shipped_css():
    return shipped_copy("custom.css", CSS)


def split_head():
    """custom.css without the block homelab theme writes"""
    return css_split(read(CSS))[0]


def css_save(st, change=None):
    """Write the marked block for st, and (optionally) first change the text above it with change(text)."""
    head = split_head()
    if change:
        head = change(head)
    block = css_build(st)
    write(CSS, head + ("\n" + block if block else ""))


def cur_css():
    return css_state(css_split(read(CSS))[1])


# ---------------------------------------------------------------- theme commands
REFRESH = "Done. Refresh the Homepage page in the browser (Ctrl+Shift+R) to see it."


def theme_show():
    need_dir()
    bg = bg_get(read(SETTINGS))
    st = cur_css()
    names = {i[:-5]: n for n, i in known_services() if i}
    print("  Background    %s" % bg.get("image", "(none)").strip("'"))
    print("  Dimming       brightness %s, saturation %s, opacity %s, blur %s" % (bg.get("brightness", "default"), bg.get("saturate", "default"), bg.get("opacity", "default"), bg.get("blur", "none")))
    if st["cards"]:
        r, g, b, a = st["cards"]
        print("  All cards     rgb(%d, %d, %d), %d%% solid" % (r, g, b, round(a * 100)))
    else:
        print("  All cards     the shipped look (dark slate, 58% solid)")
    now, was = accent_get(split_head()), accent_get(shipped_css())
    changed = ["%s rgb(%d, %d, %d)" % ((names.get(k, k),) + v) for k, v in sorted(now.items()) if k in was and was[k] != v]
    print("  Card colours  " + (", ".join(changed) if changed else "the shipped colours"))
    mine = {tag: "rgb(%d, %d, %d)" % rgb for tag, rgb in st["links"].items()}
    names = {group_tag(g[0]): g[0] for g in marks_groups(read(MARKS))[0]}
    print("  Link colours  " + (", ".join("%s %s" % (names.get(t, t), c) for t, c in sorted(mine.items())) if mine else "the shipped colours"))
    print()
    print("  Change it with:")
    print("    homelab theme background [BLUR] URL-or-FILE   a picture from the web, or one on this machine, with an optional BLUR")
    print("    homelab theme brightness 0-100           how dark the picture is (shipped: 42)")
    print("    homelab theme blur none|sm|md|lg|xl|2xl|3xl   only the blur, low to high (shipped: md)")
    print("    homelab theme saturate 0-100 | opacity 0-100")
    print("    homelab theme cards COLOR NUMBER         ALL cards: the colour, and how solid (NUMBER 0-100)")
    print("    homelab theme cards SERVICE COLOR        ONE card, for example:  homelab theme cards AdGuard Home blue")
    print("    homelab theme cards SERVICE default      that card goes back to its shipped colour")
    print("    homelab theme links GROUP COLOR          the colour of one bookmark group on the Links tab, e.g.  homelab theme links Productivity green")
    print("    homelab theme links GROUP default        that group goes back to its shipped colour")
    print("    homelab theme reset                      the shipped look again, everywhere")
    print("  Colour names: " + ", ".join(sorted(CARD_TABLE)) + "  (or a hex code such as #1e3a8a)")
    print("  Services: " + ", ".join(n for n, i in known_services() if i))
    print("  Link groups: " + ", ".join(g[0] for g in marks_groups(read(MARKS))[0]))


def images_mounted():
    """True or False: does the homepage container have the images folder mounted? None if Docker cannot be asked."""
    try:
        r = subprocess.run(["docker", "inspect", "homepage", "--format", "{{range .Mounts}}{{.Destination}} {{end}}"],
                           capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    return "/app/public/images" in r.stdout.split()


def theme_background(src, blur=None):
    need_dir()
    if blur is not None:
        blur = (blur_value(blur),)   # checked first, so a typo changes nothing
    if re.match(r"^https?://", src):
        value = quote(src)
    else:
        p = os.path.expanduser(src)
        if not os.path.isfile(p):
            raise Fail("'%s' is neither a web address (https://...) nor a file on this machine." % src)
        ext = os.path.splitext(p)[1].lower()
        if ext not in (".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif", ".svg"):
            raise Fail("Use a picture file (.jpg, .png, .webp, .gif, .avif or .svg).")
        os.makedirs(IMAGES, exist_ok=True)
        name = "background" + ext
        shutil.copyfile(p, os.path.join(IMAGES, name))
        value = "/images/" + name
    text = bg_set(read(SETTINGS), "image", value)
    if blur is not None:
        text = bg_set(text, "blur", blur[0])
    write(SETTINGS, text)
    print("Background set to %s%s. %s" % (value.strip("'") if value.startswith("/") else src,
                                         "" if blur is None else (", blur %s" % blur[0] if blur[0] else ", no blur"), REFRESH))
    if value.startswith("/images/"):
        mounted = images_mounted()
        if mounted is False:
            print("But Homepage cannot see that folder yet. In Portainer, add this line under 'volumes:' of the homepage stack, then update the stack:")
            print("  %s:/app/public/images" % IMAGES)
        else:
            print("Homepage only notices a new local picture after a restart:  docker restart homepage")


def is_blur(word):
    return word.lower() in BLURS + NO_BLUR


def blur_value(arg):
    """The blur word for settings.yaml: None for no blur at all. The sizes from low to high: sm, md, lg, xl, 2xl, 3xl."""
    a = arg.lower()
    if a in NO_BLUR:
        return None
    if a in BLURS:
        return a
    raise Fail("blur must be none, " + ", ".join(BLURS) + " (low to high; the shipped look is md).")


def theme_key(key, arg):
    need_dir()
    if key == "blur":
        write(SETTINGS, bg_set(read(SETTINGS), "blur", blur_value(arg)))
    else:
        write(SETTINGS, bg_set(read(SETTINGS), key, str(number(arg, key))))
    print("%s changed. %s" % (key.capitalize(), REFRESH))


def norm(s):
    return re.sub(r"[^a-z0-9]+", "", s.lower())


def known_services():
    """[(name, card id or None)] from services.yaml (the nine shipped cards when the file is missing)."""
    out, name = [], None
    for line in read(SERVICES_FILE).split("\n"):
        m = re.match(r"^    - (.+?):\s*$", line)
        if m:
            if name:
                out.append((name, None))
            name = m.group(1)
            continue
        m = re.match(r"^ {8}id:\s*['\"]?([A-Za-z0-9_-]+)['\"]?\s*$", line)
        if m and name:
            out.append((name, m.group(1) if m.group(1).endswith("-card") else None))
            name = None
    if name:
        out.append((name, None))
    return out or list(DEFAULT_SERVICES)


def find_service(words, quiet=False):
    """The (name, id) of the card the words point at: not case sensitive, spaces optional, a small typo is forgiven."""
    sv = known_services()
    usable = [(n, i) for n, i in sv if i]
    t = norm(words)
    if not t:
        raise Fail("Which service? One of: %s." % ", ".join(n for n, _ in usable))
    keys = {}
    for n, i in usable:
        keys.setdefault(norm(n), (n, i))
        keys.setdefault(norm(i[:-5]), (n, i))
    if t in keys:
        return keys[t]
    hits = sorted({keys[k] for k in keys if k.startswith(t)}) or sorted({keys[k] for k in keys if len(t) >= 3 and t in k})
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise Fail("'%s' could mean %s. Type a little more of the name." % (words, " or ".join(n for n, _ in hits)))
    close = difflib.get_close_matches(t, list(keys), n=1, cutoff=0.75)
    if close:
        return keys[close[0]]
    for n, i in sv:
        if not i and norm(n) == t:
            raise Fail("'%s' has no 'id:' line in services.yaml, so its card cannot be coloured. Add this line under it:  id: %s-card" % (n, slug(n)))
    if quiet:
        return None
    raise Fail("I don't know a service called '%s'. The services are: %s." % (words, ", ".join(n for n, _ in usable)))


def theme_cards(color, opacity):
    """Every card gets the same colour (a colour given to one card before is dropped)."""
    need_dir()
    r, g, b = parse_color(color, COLORS, "card")
    st = cur_css()
    a = st["cards"][3] if st["cards"] else 0.58
    if opacity is not None:
        a = number(opacity, "How solid the cards are", 0, 100) / 100.0
    st["cards"] = (r, g, b, a)
    css_save(st)
    print("All cards set to rgb(%d, %d, %d), %d%% solid. %s" % (r, g, b, round(a * 100), REFRESH))


def theme_service_color(words, color):
    """One service card: the three numbers of its line in the 'accent colors (R, G, B)' list of custom.css. 'default' puts the shipped numbers back."""
    need_dir()
    name, cid = find_service(words)
    key = cid[:-5]
    st = cur_css()
    if color.lower() in DEFAULT_WORDS:
        line = next((x for x in shipped_css().split("\n") if re.match(r"#%s-card\s*\{\s*--accent:" % re.escape(key), x)), None)
        if not line:
            raise Fail("The shipped custom.css has no colour line for %s." % name)
        rgb = accent_get(line).get(key)
        text, n = re.subn(r"(?m)^#%s-card\s*\{\s*--accent:.*$" % re.escape(key), lambda _m: line, split_head(), count=1)
    else:
        rgb, label = parse_color(color, CARD_TABLE, "card"), "%s %s" % (name, color.lower())
        text, n = accent_set(split_head(), key, rgb, label)
    if not n:
        raise Fail("custom.css has no colour line for the %s card. The lines are in the list that starts with '/* accent colors (R, G, B) */'; "
                   "the glow rules there only cover the cards that came with the lab." % name)
    css_save(st, lambda _head: text)
    print("The %s card is now %s: --accent: %d, %d, %d in custom.css. %s" % (name, color if color.lower() not in DEFAULT_WORDS else "its shipped colour", rgb[0], rgb[1], rgb[2], REFRESH))


def theme_cards_cmd(words):
    """homelab theme cards COLOR [NUMBER]  or  homelab theme cards SERVICE COLOR  (the service name may have spaces and needs no quotes)"""
    words = list(words)
    opacity = None
    if len(words) >= 2 and re.fullmatch(r"\d{1,3}%?", words[-1]):
        opacity = words.pop().rstrip("%")
    color = words.pop()
    if not words or norm(" ".join(words)) == "all":
        if not words and color.lower() not in DEFAULT_WORDS:
            try:
                parse_color(color, COLORS, "card")
            except Fail:
                if find_service(color, quiet=True):
                    raise Fail("Which colour? For example:  homelab theme cards %s blue" % color) from None
                raise
        if color.lower() in DEFAULT_WORDS:
            raise Fail("To put every card back to the shipped look, use:  homelab theme reset")
        theme_cards(color, opacity)
    else:
        if opacity is not None:
            raise Fail("A number (how solid) only goes with the all-cards form:  homelab theme cards COLOR NUMBER")
        theme_service_color(" ".join(words), color)


def theme_accent_cmd(words):
    """homelab theme accent SERVICE|all COLOR: the older name of cards SERVICE COLOR; 'all' colours every card that has a colour line"""
    name = " ".join(words[:-1])
    if norm(name) != "all":
        theme_service_color(name, words[-1])
        return
    have = accent_get(split_head())
    for service, cid in known_services():
        if cid and cid[:-5] in have:
            theme_service_color(service, words[-1])


def group_tag(name):
    """The name tag custom.js puts on a bookmark group (the same letters and digits as in the group's name, joined by dashes)."""
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def find_link_group(words):
    """The name of the bookmark group the words point at: not case sensitive, spaces optional, a small typo is forgiven."""
    names = [g[0] for g in marks_groups(read(MARKS))[0]]
    t = norm(words)
    if not names:
        raise Fail("There are no bookmark groups yet. Add a bookmark first:  homelab bookmark add NAME URL CATEGORY")
    if not t:
        raise Fail("Which group? One of: %s." % ", ".join(names))
    keys = {}
    for n in names:
        keys.setdefault(norm(n), n)
    if t in keys:
        return keys[t]
    hits = sorted({keys[k] for k in keys if k.startswith(t)}) or sorted({keys[k] for k in keys if len(t) >= 3 and t in k})
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        raise Fail("'%s' could mean %s. Type a little more of the name." % (words, " or ".join(hits)))
    close = difflib.get_close_matches(t, list(keys), n=1, cutoff=0.75)
    if close:
        return keys[close[0]]
    raise Fail("I don't know a bookmark group called '%s'. The groups are: %s." % (words, ", ".join(names)))


def theme_links_cmd(words):
    """homelab theme links GROUP COLOR  |  homelab theme links GROUP default  (the group name may have spaces and needs no quotes)"""
    need_dir()
    words = list(words)
    if len(words) < 2:
        raise Fail("Which group and which colour? For example:  homelab theme links Productivity green   (groups: %s)"
                   % ", ".join(g[0] for g in marks_groups(read(MARKS))[0]))
    color = words.pop()
    group = find_link_group(" ".join(words))
    tag = group_tag(group)
    st = cur_css()
    if color.lower() in DEFAULT_WORDS:
        st["links"].pop(tag, None)
        css_save(st)
        print("The %s group is back to its shipped colour. %s" % (group, REFRESH))
        return
    rgb = parse_color(color, CARD_TABLE, "link")
    st["links"][tag] = rgb
    css_save(st)
    print("The %s group is now %s: --accent: %d, %d, %d in the marked block at the end of custom.css. %s" % (group, color, rgb[0], rgb[1], rgb[2], REFRESH))


def theme_reset():
    need_dir()
    def restore(head):   # every colour line goes back to the shipped line (the rest of the file is not touched)
        a = head.find("/* >>> homelab look >>>")           # the look block of the control panel goes too
        z = head.find("/* <<< homelab look <<< */", a) if a >= 0 else -1
        if a >= 0 and z >= 0:
            head = head[:a].rstrip("\n") + "\n" + head[z + len("/* <<< homelab look <<< */"):].lstrip("\n")
        for line in shipped_css().split("\n"):
            m = re.match(r"#([\w-]+)-card\s*\{\s*--accent:", line)
            if m:
                head = re.sub(r"(?m)^#%s-card\s*\{\s*--accent:.*$" % re.escape(m.group(1)), lambda _m, keep=line: keep, head, count=1)
        return head
    css_save({"cards": None, "links": {}}, restore)
    sb = bg_get(shipped_copy("settings.yaml", SETTINGS))
    text = read(SETTINGS)
    for k in ("image", "blur", "saturate", "brightness", "opacity"):
        text = bg_set(text, k, sb.get(k))
    write(SETTINGS, text)
    print("The shipped look is back. %s" % REFRESH)


# ---------------------------------------------------------------- bookmarks
def marks_groups(text):
    """[(group, [(name, start, end)])], where start/end are line numbers in text.split('\\n') (end excluded)."""
    lines = text.split("\n")
    groups, cur, ent = [], None, None
    for i, l in enumerate(lines):
        m = re.match(r"^- (.+?):\s*$", l)
        if m:
            if ent:
                cur[1].append((ent[0], ent[1], i))
                ent = None
            if cur:
                cur[2] = i
            cur = [m.group(1), [], len(lines)]
            groups.append(cur)
            continue
        m = re.match(r"^    - (.+?):\s*$", l)
        if m and cur is not None:
            if ent:
                cur[1].append((ent[0], ent[1], i))
            ent = (m.group(1), i)
    if ent and cur:
        cur[1].append((ent[0], ent[1], len(lines)))
    return groups, lines


def entry_field(lines, start, end, field):
    for l in lines[start:end]:
        m = re.match(r"^\s+(?:- )?%s:\s*(.*?)\s*$" % field, l)
        if m:
            return m.group(1)
    return ""


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "site"


def get_id():
    return os.environ.get("HOMELAB_BRANDFETCH_ID", "").strip() or read(IDFILE).strip()


GENERIC_ICON = "mdi-web"   # Homepage's own plain globe icon: needs no account and no download


def image_kind(data):
    """'svg', 'png' or 'jpeg' when the bytes really are that kind of picture (a web page that says sorry is not)."""
    head = data[:300].lstrip().lower()
    if len(data) > 100 and (head.startswith(b"<svg") or head.startswith(b"<?xml")) and b"<svg" in data[:2000].lower():
        return "svg"
    if data.startswith(b"\x89PNG\r\n\x1a\n") and len(data) > 100:
        return "png"
    if data.startswith(b"\xff\xd8\xff") and len(data) > 100:
        return "jpeg"
    return None


def brandfetch_icon(domain):
    """(web address of the logo, message). Brandfetch is asked for an SVG first, then a PNG, then a JPEG; each in the symbol, logo and
    icon version. The address goes into bookmarks.yaml as it is, like the examples in the shipped file."""
    cid = get_id()
    if not cid:
        return None, "No Brandfetch client ID is saved, so it got the plain globe icon. Save yours once with:  homelab bookmark brandfetch YOUR-CLIENT-ID"
    last = ""
    for ext in ("svg", "png", "jpeg"):
        for kind in ("symbol", "logo", "icon"):
            url = "%s/%s/theme/dark/%s.%s?c=%s" % (BASE, domain, kind, ext, cid)
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "homelab-bookmark/1"})
                with urllib.request.urlopen(req, timeout=12) as r:
                    data = r.read(3000000)
            except (urllib.error.URLError, OSError, ValueError) as e:
                last = str(e)
                continue
            if image_kind(data) == ext:
                return url, "Logo: Brandfetch (%s, %s)." % (kind, ext.upper())
    return None, "Brandfetch has no SVG, PNG or JPEG for %s (%s), so it got the plain globe icon." % (domain, last or "not found")


def looks_like_icon(t):
    """An icon given on the command line: a web address, a file in /images, a Homepage icon name (si-youtube, mdi-web, youtube.svg), or 'generic'."""
    return bool(t.lower() == "generic" or re.match(r"https?://", t) or t.startswith("/")
                or re.fullmatch(r"(si|mdi|sh)-[\w-]+", t) or re.search(r"\.(svg|png|jpe?g|webp|ico|gif|avif)$", t, re.I))


def make_abbr(name):
    """The letters shown if the icon cannot be loaded: YouTube -> YT, Good Site -> GS, Spotify -> SPOT."""
    words = re.findall(r"[A-Z]?[a-z0-9]+|[A-Z]+(?![a-z])", name)
    if len(words) > 1:
        return "".join(w[0] for w in words)[:4].upper()
    return (words[0] if words else "?")[:4].upper()


def tty_path():
    """Where answers can be typed: the keyboard, not the pipe this program is fed through. '' when nobody is there to answer."""
    return os.environ.get("HOMELAB_TTY", "") or ("/dev/tty" if sys.stdout.isatty() else "")


_TTY = []


def ask(question):
    """Ask on the keyboard. None when nobody is there to answer."""
    path = tty_path()
    if not path:
        return None
    try:
        if not _TTY:
            _TTY.append(open(path, encoding="utf-8"))
        sys.stdout.write(question)
        sys.stdout.flush()
        line = _TTY[0].readline()
    except OSError:
        return None
    return line.strip() if line else None


def find_group(groups, wanted):
    """The category that 'wanted' means: not case sensitive, spaces and punctuation ignored, a small typo forgiven. None if there is none."""
    t = norm(wanted)
    for g in groups:
        if norm(g[0]) == t:
            return g
    close = difflib.get_close_matches(t, [norm(g[0]) for g in groups], n=1, cutoff=0.8)
    return next((g for g in groups if norm(g[0]) == close[0]), None) if close else None


def pick_group(groups, what, allow_new):
    """Show the categories as a numbered list and let the person choose one. Returns the group, or its new name as a string."""
    if not tty_path():
        return None
    print(what)
    for i, g in enumerate(groups, 1):
        print("  %d) %s" % (i, g[0]))
    if allow_new:
        print("  %d) A new category (you type its name)" % (len(groups) + 1))
    ans = ask("Number%s: " % (" (Enter = Others)" if allow_new else ""))
    if ans is None:
        return None
    if ans == "" and allow_new:
        return "Others"
    if ans.isdigit() and 1 <= int(ans) <= len(groups):
        return groups[int(ans) - 1]
    if allow_new and ans.isdigit() and int(ans) == len(groups) + 1:
        new = ask("Name of the new category: ")
        return new if new else None
    raise Fail("'%s' is not one of the numbers above. Nothing was changed." % ans)


def place(lines, group, entry, order):
    """The lines with 'entry' added to the category 'group' (made if it is new) at place number 'order' (1 = first; None = last)."""
    groups, _ = marks_groups("\n".join(lines))
    target = find_group(groups, group)
    if not target:
        body = list(lines)
        while body and body[-1].strip() == "":
            body.pop()
        return body + ([""] if body else []) + ["- %s:" % group] + entry, False
    if order and order <= len(target[1]):
        at = target[1][order - 1][1]
        return lines[:at] + entry + [""] + lines[at:], True
    at = target[2]
    while at > 0 and lines[at - 1].strip() == "":
        at -= 1
    return lines[:at] + [""] + entry + lines[at:], True


def split_extras(extra, what):
    """The optional words after NAME URL (or after NAME CATEGORY): a category, an icon, a number. They are told apart by what they look like."""
    group = icon = order = None
    words = []
    for t in extra:
        if re.fullmatch(r"\d+", t):
            if order is not None:
                raise Fail("Two numbers were given. One number (the place in the category) is enough.")
            order = int(t)
            if order < 1:
                raise Fail("The place number starts at 1 (1 = first in the category).")
        elif what == "add" and looks_like_icon(t):
            if icon is not None:
                raise Fail("Two icons were given. One is enough.")
            icon = t
        else:
            words.append(t)     # a category may be several words, typed without quotes: Online Shopping
    group = " ".join(words) if words else None
    return group, icon, order


def layout_add_group(group, others):
    """A new bookmark category is put on the tab of the other bookmark categories (settings.yaml layout:), so it is not shown on every
    tab. Does nothing without a layout block, or when no tab is known. 'others' are the names of the categories that existed."""
    try:
        text = read(SETTINGS)
    except OSError:
        return
    lines = text.split("\n")
    start = next((i for i, l in enumerate(lines) if re.match(r"^layout:\s*(#.*)?$", l)), None)
    if start is None:
        return
    end = start + 1
    while end < len(lines) and (lines[end].strip() == "" or lines[end][0] in " \t#"):
        end += 1
    while end > start + 1 and lines[end - 1].strip() == "":
        end -= 1
    tab, cur = None, None
    for l in lines[start + 1:end]:
        m = re.match(r"^  ('?)([^\s#'][^:]*?)\1:\s*$", l)
        if m:
            cur = m.group(2).strip()
            if cur.lower() == group.lower():
                return
            continue
        t = re.match(r"^    tab:\s*(\S+)", l)
        if t and cur in others and tab is None:
            tab = t.group(1)
    if not tab:
        return
    key = "'%s'" % group.replace("'", "''") if re.search(r"[:#\[\]{},*!|>'\"%@`]|^[&?-]|^\s|\s$", group) else group
    icon = "mdi-dots-horizontal-circle" if group.lower() == "others" else "mdi-bookmark-multiple"
    lines[end:end] = ["  %s:" % key, "    tab: %s" % tab, "    icon: %s" % icon]
    tmp = SETTINGS + ".tmp"          # written directly: this is not a theme change, so no .before-theme copy is made
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    shutil.copymode(SETTINGS, tmp)
    os.replace(tmp, SETTINGS)


def marks_add(name, url, extra):
    need_dir()
    group, icon, order = split_extras(extra, "add")
    if not re.match(r"^https?://", url):
        url = "https://" + url
    parts = urlparse(url)
    if not parts.netloc or " " in url:
        raise Fail("'%s' is not a web address." % url)
    if not parts.path and not parts.query and not parts.fragment:
        url += "/"
    domain = re.sub(r"^www\.", "", parts.netloc.lower().split(":")[0])
    text = read(MARKS)
    groups, lines = marks_groups(text)
    if group is None:   # no category given: ask, or use Others when nobody can answer
        choice = pick_group(groups, "Which category should '%s' go in?" % name, True) if groups else "Others"
        group = choice if choice is not None else "Others"
        if not isinstance(group, str):
            group = group[0]
    target = find_group(groups, group)
    if target:
        group = target[0]
    for g in groups:
        for n, _s, _e in g[1]:
            if n.lower() == name.lower() and g is target:
                raise Fail("A bookmark named '%s' is already in '%s'. Remove it first:  homelab bookmark remove \"%s\" \"%s\"" % (n, g[0], n, g[0]))
    if icon is None:
        icon, msg = brandfetch_icon(domain)
    elif icon.lower() == "generic":
        icon, msg = None, "Icon: the plain globe."
    else:
        msg = "Icon: %s." % icon
    entry = ["    - %s:" % name, "        - abbr: %s" % make_abbr(name), "          href: %s" % url, "          icon: %s" % (icon or GENERIC_ICON)]
    new, existed = place(lines, group, entry, order)
    write(MARKS, "\n".join(new).rstrip("\n") + "\n")
    where, _ = marks_groups("\n".join(new))
    spot = next((i + 1 for g in where if g[0] == group for i, (n, _s, _e) in enumerate(g[1]) if n == name), 1)
    print("Added '%s' to '%s' as number %d (%s). %s" % (name, group, spot, url, msg))
    if not existed:
        layout_add_group(group, [g[0] for g in groups])
    if not existed and groups:
        print("'%s' is a new category (it did not exist yet). The ones before: %s." % (group, ", ".join(g[0] for g in groups)))
    print("Refresh the Homepage page in the browser to see it.")


def marks_list():
    need_dir()
    groups, lines = marks_groups(read(MARKS))
    if not groups:
        print("There are no bookmarks yet. Add one with:  homelab bookmark add NAME URL [CATEGORY]")
        return
    for g in groups:
        print("  %s" % g[0])
        for i, (n, s, e) in enumerate(g[1], 1):
            print("    %2d. %-20s %s" % (i, n, entry_field(lines, s, e, "href")))


def marks_pick(name, group, verb):
    """The one bookmark meant by NAME (and CATEGORY): (group, name, start, end), plus the text and its lines."""
    text = read(MARKS)
    groups, lines = marks_groups(text)
    if group is not None:
        want = find_group(groups, group)
        if not want:
            raise Fail("There is no category '%s'. The categories are: %s." % (group, ", ".join(g[0] for g in groups) or "(none)"))
        groups = [want]
    hits = [(g, n, s, e) for g in groups for n, s, e in g[1] if n.lower() == name.lower()]
    if not hits:
        where = " in '%s'" % groups[0][0] if group is not None else ""
        raise Fail("No bookmark named '%s'%s. See them with:  homelab bookmark list" % (name, where))
    if len(hits) > 1:
        cats = [h[0] for h in hits]
        choice = pick_group(cats, "'%s' is in %d categories. Which one should I %s?" % (name, len(cats), verb), False)
        if choice is None:
            raise Fail("'%s' is in %s. Say which one:  homelab bookmark %s \"%s\" \"CATEGORY\"" % (name, " and ".join("'%s'" % c[0] for c in cats), verb, name))
        hits = [h for h in hits if h[0] is choice]
    return hits[0], text, lines


def clean_marks(lines):
    """Join the lines again with one blank line between categories, and drop a category that has no bookmark left."""
    out = "\n".join(lines)
    out = re.sub(r"([^\n])\n(- )", r"\1\n\n\2", out)
    out = re.sub(r"\n{3,}", "\n\n", out).rstrip("\n") + "\n"
    g2, l2 = marks_groups(out)
    for gg in g2:
        if not gg[1]:
            del l2[l2.index("- %s:" % gg[0])]
            out = re.sub(r"\n{3,}", "\n\n", "\n".join(l2)).strip("\n") + "\n"
            break
    return out if out.strip() else ""


def marks_remove(name, group):
    need_dir()
    (g, n, s, e), text, lines = marks_pick(name, group, "remove")
    icon = entry_field(lines, s, e, "icon")
    out = clean_marks(lines[:s] + lines[e:])
    write(MARKS, out)
    if icon.startswith("/images/") and icon not in out:
        p = os.path.join(IMAGES, os.path.basename(icon))
        if os.path.isfile(p):
            os.remove(p)
    print("Removed '%s' from '%s'. Refresh the Homepage page in the browser." % (n, g[0]))


def marks_move(name, to, extra):
    """Put a bookmark in another category (or, with a number, at another place in the same one). Its icon stays with it."""
    need_dir()
    group, _, order = split_extras(extra, "move")
    (g, n, s, e), text, lines = marks_pick(name, group, "move")
    if norm(to) == norm(g[0]) and order is None:
        raise Fail("'%s' is already in '%s'. To change its place there, add a number:  homelab bookmark move \"%s\" \"%s\" 1" % (n, g[0], n, g[0]))
    entry = lines[s:e]
    while entry and entry[-1].strip() == "":
        entry.pop()
    rest = lines[:s] + lines[e:]
    groups2, _ = marks_groups("\n".join(rest))
    dest = find_group(groups2, to)
    new, existed = place(rest, dest[0] if dest else to, entry, order)
    write(MARKS, clean_marks(new))
    out_name = dest[0] if dest else to
    print("Moved '%s' from '%s' to '%s'%s%s. Refresh the Homepage page in the browser." % (n, g[0], out_name, "" if existed else " (a new category)", " as number %d" % order if order else ""))


def marks_id(cid):
    need_dir()
    if not re.fullmatch(r"[A-Za-z0-9_-]{8,64}", cid):
        raise Fail("A Brandfetch client ID is letters, numbers, - and _ (8 to 64 characters). Copy it from your Brandfetch developer page.")
    with open(IDFILE, "w") as f:
        f.write(cid + "\n")
    os.chmod(IDFILE, 0o600)
    print("Brandfetch client ID saved in %s. New bookmarks now get their logo from Brandfetch." % IDFILE)


USAGE_M = """Bookmarks on the Homepage dashboard (a NAME with spaces goes in quotes; a CATEGORY does not need them):
  homelab bookmark list                           every category, with the number of each bookmark
  homelab bookmark add NAME URL [CATEGORY] [ICON LINK] [NUMBER]
        CATEGORY   where it goes; leave it out to pick from a list (a new name makes a new category)
        ICON LINK  a web address of a picture, a Homepage icon name (si-youtube, mdi-web), or the word generic.
                   Left out: the logo comes from Brandfetch, or the plain globe if you have no Brandfetch ID
        NUMBER     its place in the category (1 = first). Left out: last
  homelab bookmark remove NAME [CATEGORY]         take one away. If the name is in more than one category, give it
  homelab bookmark move NAME CATEGORY [NUMBER]    put it in another category (the same one, plus a NUMBER: change its place)
                                                  a category with spaces needs no quotes: Online Shopping
  homelab bookmark brandfetch CLIENT-ID           save your Brandfetch client ID once, so logos can be found
For example:  homelab bookmark add YouTube youtube.com Entertainment
              homelab bookmark add Netflix netflix.com Entertainment si-netflix 2"""


SIMPLE_BEGIN = "/* >>> homelab simple >>>"
SIMPLE_END = "/* <<< homelab simple <<< */"
SIMPLE_BLOCK = (SIMPLE_BEGIN + " written by: homelab simple on. Remove it with: homelab simple off */\n"
                ".service-description { display: none !important; }\n" + SIMPLE_END + "\n")


def simple_css(css, on):
    """custom.css with the 'less busy cards' rule put in (on) or taken out (off). Everything else in the file is left alone."""
    css = re.sub(r"\n*" + re.escape(SIMPLE_BEGIN) + r".*?" + re.escape(SIMPLE_END) + r"\n?", "\n", css, flags=re.S)
    css = css.rstrip("\n") + "\n" if css.strip() else ""
    return css + ("\n" if css else "") + SIMPLE_BLOCK if on else css


def simple_cmd(args):
    need_dir()
    css = read(CSS)
    now = SIMPLE_BEGIN in css
    word = args[0].lower() if args else "status"
    if len(args) > 1 or word not in ("on", "off", "status"):
        raise Fail("Usage: homelab simple on | off | status")
    if word == "status":
        print("Less busy cards are %s. %s" % ("ON (the small text under card names is hidden)" if now else "OFF (the shipped look)",
                                              "Turn them off with:  homelab simple off" if now else "Turn them on with:  homelab simple on"))
        return
    if (word == "on") == now:
        print("Less busy cards are already %s." % word)
        return
    write(CSS, simple_css(css, word == "on"))
    print("Less busy cards are now %s. %s" % (word.upper(), REFRESH))


def main(a):
    try:
        if not a:
            raise Fail("nothing to do")
        if a[0] == "simple":
            simple_cmd(a[1:])
        elif a[0] == "theme":
            a = a[1:]
            c = a[0] if a else ""
            if c == "":
                theme_show()
            elif c in ("background", "bg") and len(a) == 2:
                theme_background(a[1])
            elif c in ("background", "bg") and len(a) == 3:
                if not is_blur(a[1]):
                    raise Fail("'%s' is not a blur. Use:  homelab theme background BLUR URL-or-FILE   (BLUR: none, %s)" % (a[1], ", ".join(BLURS)))
                theme_background(a[2], a[1])
            elif c in ("brightness", "blur", "saturate", "opacity") and len(a) == 2:
                theme_key(c, a[1])
            elif c == "cards" and len(a) >= 2:
                theme_cards_cmd(a[1:])
            elif c == "accent" and len(a) >= 3:
                theme_accent_cmd(a[1:])
            elif c == "links":
                theme_links_cmd(a[1:])
            elif c == "reset" and len(a) == 1:
                theme_reset()
            else:
                theme_show()
                return 2
        else:
            a = a[1:]
            c = a[0] if a else ""
            if c == "add" and 3 <= len(a) <= 9:
                marks_add(a[1], a[2], a[3:])
            elif c == "add" and len(a) > 9:
                raise Fail("Too many words. If the name has spaces, put it in quotes:  homelab bookmark add \"My Bank\" mybank.com Productivity")
            elif c == "list" and len(a) == 1:
                marks_list()
            elif c in ("remove", "rm", "delete") and 2 <= len(a) <= 5:
                marks_remove(a[1], " ".join(a[2:]) if len(a) > 2 else None)
            elif c == "move" and 3 <= len(a) <= 7:
                to_words = a[2:]
                if len(to_words) > 1 and re.fullmatch(r"\d+", to_words[-1]):
                    marks_move(a[1], " ".join(to_words[:-1]), [to_words[-1]])
                else:
                    marks_move(a[1], " ".join(to_words), [])
            elif c == "brandfetch" and len(a) == 2:
                marks_id(a[1])
            else:
                print(USAGE_M)
                return 2 if c else 0
    except Fail as e:
        print("homelab: %s" % e, file=sys.stderr)
        return 1
    return 0


signal.signal(signal.SIGPIPE, signal.SIG_DFL)
sys.exit(main(sys.argv[1:]))
PY
}

human_bytes() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

# "in 11 h" / "in 40 min" for a number of seconds
in_words() {
  local s=$1
  if [ "$s" -ge 7200 ]; then echo "in $(( s / 3600 )) h"
  elif [ "$s" -ge 60 ]; then echo "in $(( s / 60 )) min"
  else echo "soon"; fi
}

# next_run MINUTE HOUR DAY MONTH WEEKDAY -> "06:00 (in 11 h)" for a daily line, or "see root's crontab"
next_run() {
  local m=$1 h=$2 dom=$3 mon=$4 dow=$5 t now hhmm
  if [[ "$m" =~ ^[0-9]+$ ]] && [[ "$h" =~ ^[0-9]+$ ]] && [ "$dom" = "*" ] && [ "$mon" = "*" ] && [ "$dow" = "*" ]; then
    now=$(date +%s); hhmm=$(printf '%02d:%02d' "$h" "$m")
    t=$(date -d "$hhmm" +%s 2>/dev/null) || { echo "see root's crontab"; return; }
    [ "$t" -gt "$now" ] || t=$(date -d "tomorrow $hhmm" +%s)
    printf '%s (%s)' "$hhmm" "$(in_words $(( t - now )))"
  else
    echo "see root's crontab"
  fi
}

# the file written by homelab-sample is "fresh" if its time stamp is recent
sample_age_min() {   # sample_age_min EPOCH -> minutes
  echo $(( ( $(date +%s) - $1 ) / 60 ))
}

backup_size_line() {
  local stamp result dest _s bytes m h dom mon dow _e text next=""
  [ -r "$LAST_RUN_FILE" ] || return 0
  IFS="|" read -r stamp result dest _s bytes <"$LAST_RUN_FILE"
  if [ -r "$STATE_DIR/schedule" ] && [ -s "$STATE_DIR/schedule" ]; then
    IFS='|' read -r m h dom mon dow _e <"$STATE_DIR/schedule"
    next="next run $(next_run "$m" "$h" "$dom" "$mon" "$dow")"
  fi
  if [[ "${bytes:-}" =~ ^[0-9]+$ ]]; then
    text="$(human_bytes "$bytes") in the backup"
  else
    text="size shows after the next backup run"
  fi
  [ -n "$next" ] && text="$text, $next"
  ok "Backup size" "$text"
}

# The name of a pool drive as "sudo drives status" shows it ("1 TB Samsung HDD"), not the label on the drive (MAIN2).
# The name you chose in /etc/homelab-drive-names wins, then the name "drives" saved. A name two drives share keeps the label too.
drive_shown_name() {   # drive_shown_name LABEL TEMPS-FILE
  local lab=$1 file=$2 name="" other n=0 names_file="${HOMELAB_NAMES_FILE:-/etc/homelab-drive-names}"
  case "$lab" in MAIN[0-9]*|BACKUP[0-9]*) ;; *) printf '%s' "$lab"; return 0 ;; esac
  [ -r "$names_file" ] && name=$(awk -F= -v k="$lab" '{ gsub(/^[ \t]+|[ \t]+$/, "", $1) } $1 == k && !/^[ \t]*#/ { sub(/^[^=]*=/, ""); print; exit }' "$names_file")
  [ -n "$name" ] || name=$(saved_drive_name "$lab")
  [ -n "$name" ] || { printf '%s' "$lab"; return 0; }
  while IFS='|' read -r other _; do
    [ "$other" = "$lab" ] && continue
    case "$other" in MAIN[0-9]*|BACKUP[0-9]*) [ "$(saved_drive_name "$other")" = "$name" ] && n=1 ;; esac
  done <"$file"
  if [ "$n" -eq 1 ]; then printf '%s (%s)' "$name" "$lab"; else printf '%s' "$name"; fi
}

saved_drive_name() {   # saved_drive_name LABEL -> the name "drives" saved for that drive, or nothing
  [ -r "$STATE_DIR/drive-names" ] && awk -F'|' -v k="$1" '$1 == k {print $2; exit}' "$STATE_DIR/drive-names"
  return 0
}

temps_line() {
  local f="$STATE_DIR/temps" label _d t ep parts="" max=0 oldest="" age
  if [ ! -e "$f" ]; then
    warn "Drive temps" "no readings yet (run: sudo homelab-sample, and the installer adds its cron line)"
    return 0
  fi
  if [ ! -s "$f" ]; then
    warn "Drive temps" "no readings (is smartmontools installed? try: sudo homelab-sample)"
    suggest 6 "sudo homelab-sample" "take a drive temperature reading now"
    return 0
  fi
  while IFS="|" read -r label _d t ep; do
    [ -n "$label" ] || continue
    label=$(drive_shown_name "$label" "$f")
    if [ "$t" = "standby" ]; then parts="$parts$label asleep, "
    elif [ "$t" = "none" ]; then parts="$parts$label no reading, "
    elif [[ "$t" =~ ^[0-9]+$ ]]; then
      parts="$parts$label ${t}°C, "
      [ "$t" -gt "$max" ] && max=$t
    fi
    if [[ "$ep" =~ ^[0-9]+$ ]] && { [ -z "$oldest" ] || [ "$ep" -lt "$oldest" ]; }; then oldest=$ep; fi
  done <"$f"
  parts=${parts%, }
  age=""
  [ -n "$oldest" ] && age=$(sample_age_min "$oldest")
  if [ "$max" -ge "$TEMP_BAD" ]; then bad "Drive temps" "$parts -> too hot, check the airflow"
  elif [ "$max" -ge "$TEMP_WARN" ]; then warn "Drive temps" "$parts -> getting warm"
  elif [ -n "$age" ] && [ "$age" -ge "$SAMPLE_STALE_MIN" ]; then warn "Drive temps" "$parts (readings are $age min old; take new ones: sudo homelab-sample)"
  else ok "Drive temps" "$parts"; fi
}

updates_line() {
  local n="" ep names="" img_n=0 text="" line
  [ -r "$STATE_DIR/apt" ] && IFS='|' read -r n ep <"$STATE_DIR/apt"
  if [ -r "$STATE_DIR/image-updates" ]; then
    names=$(tail -n +2 "$STATE_DIR/image-updates" | awk 'NF {printf "%s%s", (c++ ? ", " : ""), $1}')
    img_n=$(tail -n +2 "$STATE_DIR/image-updates" | awk 'NF' | wc -l)
  fi
  # the saved count is from the last reading (up to 6 hours ago). When apt ran since then (an upgrade, or an apt update that
  # found new lists) it is out of date, so count again now: a simulation that changes nothing and needs no sudo.
  if [[ "$n" =~ ^[0-9]+$ && "$ep" =~ ^[0-9]+$ ]] && [ "$JUST_BOOTED" != 1 ] && command -v apt-get >/dev/null 2>&1; then
    local m1 m2
    m1=$(stat -c %Y "${HOMELAB_DPKG_STATUS:-/var/lib/dpkg/status}" 2>/dev/null || echo 0)
    m2=$(stat -c %Y "${HOMELAB_APT_LISTS:-/var/lib/apt/lists}" 2>/dev/null || echo 0)
    if [ "$m1" -gt "$ep" ] || [ "$m2" -gt "$ep" ]; then n=$(timeout 8 apt-get -s upgrade 2>/dev/null | grep -c '^Inst ' || true); fi
  fi
  [[ "$n" =~ ^[0-9]+$ ]] || n=""
  [ -n "$n" ] || [ -r "$STATE_DIR/image-updates" ] || return 0
  if [ -n "$n" ]; then
    if [ "$n" -gt 0 ]; then text="$n system update(s)"; else text="system is up to date"; fi
  fi
  if [ -r "$STATE_DIR/image-updates" ]; then
    line=$(head -1 "$STATE_DIR/image-updates")
    if [ "$img_n" -gt 0 ]; then text="${text:+$text; }newer images: $names"
    else text="${text:+$text; }container images up to date"; fi
    [[ "$line" =~ ^[0-9]+$ ]] && text="$text (checked $(( ( $(date +%s) - line ) / 86400 )) d ago)"
  fi
  if [ "${n:-0}" -gt 0 ] || [ "$img_n" -gt 0 ]; then
    local fix=""
    [ "${n:-0}" -gt 0 ] && fix="install the system ones: sudo apt upgrade"
    [ "$img_n" -gt 0 ] && fix="${fix:+$fix; }update the containers: sudo homelab-update"
    warn "Updates" "$text -> $fix"
    [ "$img_n" -gt 0 ] && suggest 4 "sudo homelab-update" "newer container versions are waiting: it downloads and updates them"
    [ "${n:-0}" -gt 0 ] && suggest 5 "sudo apt update && sudo apt upgrade" "install the waiting system updates"
  else ok "Updates" "$text"; fi
}

pool_mounted() { command -v findmnt >/dev/null 2>&1 && findmnt -n "$1" >/dev/null 2>&1; }

pool_lines() {
  local used size
  # main pool
  if pool_mounted "$MAIN_POOL"; then
    read -r used size < <(df -h --output=used,size "$MAIN_POOL" 2>/dev/null | awk 'NR==2 {print $1, $2}')
    if only_boot_section MAIN; then
      warn "Main Pool" "mounted, ${used:-?} used of ${size:-?}, but only on a section of the boot drive (no separate drive: sudo drives)"
      suggest 3 "sudo drives" "the main pool is only a section of the boot drive: connect a real drive"
    else
      ok "Main Pool" "mounted, ${used:-?} used of ${size:-?}"
    fi
  elif [ -e "$STATE_DIR/no-data-drive" ]; then
    # written by homelab-setup while no data drive has been set up (or when you skipped that step): not a failure
    warn "Main Pool" "no data drive set up yet (when you have one: sudo drives)"
    suggest 5 "sudo drives" "connect a data drive (a menu; it asks before erasing anything)"
  else
    bad "Main Pool" "NOT MOUNTED -> plug the drive in, then run: sudo drives remount (drive dead? sudo drives replace)"
    suggest 1 "sudo drives remount" "the data drive is not mounted: remount it and restart the containers"
  fi

  # backup pool
  if pool_mounted "$BACKUP_POOL"; then
    if only_boot_section BACKUP; then
      warn "Backup Pool" "mounted, but only on a section of the boot drive (lost if that drive dies; fix: sudo drives connect)"
      suggest 4 "sudo drives" "connect a real backup drive: the backup is on the boot drive now"
    else
      ok "Backup Pool" "mounted"
    fi
  else
    warn "Backup Pool" "not connected, so the backup goes to the boot drive (connect a drive: sudo drives connect)"
    suggest 5 "sudo drives" "connect a backup drive (or use part of the boot drive: sudo drives bootsection)"
  fi
}

last_backup_line() {
  local stamp result age_h ts line
  if [ -r "$LAST_RUN_FILE" ]; then
    IFS='|' read -r stamp result _ _ <"$LAST_RUN_FILE"
    ts=$(date -d "$stamp" +%s 2>/dev/null || echo "")
    age_h=""
    [ -n "$ts" ] && age_h=$(( ($(date +%s) - ts) / 3600 ))
    line="$stamp  $result"
    [ -n "$age_h" ] && line="$line  (${age_h} h ago)"
    if [ "$result" != "OK" ]; then
      bad "Last backup" "$line -> read: sudo tail -20 /var/log/homelab-backup.log"
      suggest 1 "sudo tail -20 /var/log/homelab-backup.log" "the last backup failed: read why"
    elif [ -n "$age_h" ] && [ "$age_h" -ge "$STALE_HOURS" ]; then
      warn "Last backup" "$line -> older than ${STALE_HOURS} h (run one now: sudo homelab-backup)"
      suggest 3 "sudo homelab-backup" "the last backup is old: run one now"
    else
      ok "Last backup" "$line"
    fi
  elif [ -e "$(dirname "$LAST_RUN_FILE")" ]; then
    warn "Last backup" "no result found (check: sudo drives status)"
    suggest 3 "sudo drives status" "no backup result was found: check the backup"
  else
    warn "Last backup" "no backup has run yet (run the first one: sudo homelab-backup)"
    suggest 4 "sudo homelab-backup" "no backup has run yet: run the first one now"
  fi
}

# containers (a stopped container whose restart policy is "no" was stopped on purpose, so it is ignored)
containers_line() {
  local n_run=0 n_all=0 down="" unhealthy cname cstate cpol crc cstart restarted="" st_ts now
  if [ "$JUST_BOOTED" -eq 1 ]; then
    # first minutes after a boot: Docker is busy starting the apps, so the login screen leaves it alone
    warn "Containers" "the server just started and the apps are still starting (live check in a few minutes: homelab status)"
  elif command -v docker >/dev/null 2>&1 && timeout 5 docker info >/dev/null 2>&1; then
    now=$(date +%s)
    while read -r cname cstate cpol crc cstart; do
      [ -n "$cname" ] || continue
      cname=${cname#/}
      if [[ "${crc:-0}" =~ ^[0-9]+$ ]] && [ "${crc:-0}" -gt 0 ] && [ "$cstate" = "running" ]; then
        st_ts=$(date -d "$cstart" +%s 2>/dev/null || echo 0)
        [ $(( now - st_ts )) -lt 86400 ] && restarted="$restarted$cname (${crc}x), "
      fi
      if [ "$cstate" = "running" ]; then
        n_run=$((n_run + 1)); n_all=$((n_all + 1))
      elif [ -n "$cpol" ] && [ "$cpol" != "no" ]; then
        n_all=$((n_all + 1)); down="$down$cname "
      fi
    done < <(timeout 10 docker ps -aq 2>/dev/null | xargs -r timeout 10 docker inspect --format '{{.Name}} {{.State.Status}} {{.HostConfig.RestartPolicy.Name}} {{.RestartCount}} {{.State.StartedAt}}' 2>/dev/null)
    unhealthy=$(timeout 5 docker ps --filter health=unhealthy --format '{{.Names}}' 2>/dev/null | tr '\n' ' ')
    if [ -n "$down" ]; then
      bad "Containers" "${n_run} of ${n_all} running; not running: ${down% } (see: docker ps -a)"
      suggest 1 "docker ps -a" "a container is not running: see which one"
    elif [ -n "$unhealthy" ]; then
      warn "Containers" "${n_run} of ${n_all} running; unhealthy: ${unhealthy% } (read: docker logs --tail 50 NAME)"
      suggest 2 "docker logs --tail 50 NAME" "a container is unhealthy: read what it printed"
    else
      ok "Containers" "${n_run} of ${n_all} running"
    fi
    [ -n "$restarted" ] && warn "Restarts" "Docker restarted in the last 24 h: ${restarted%, } (why: docker logs --tail 50 NAME)"
  else
    case "$(systemctl is-active docker 2>/dev/null)" in
      activating) warn "Containers" "Docker is still starting after the restart. Wait a minute, then run  homelab  again" ;;
      inactive|failed) warn "Containers" "Docker is not running. Start it with:  sudo systemctl start docker" ;;
      *) if [ "$(id -u)" != 0 ] && getent group docker 2>/dev/null | cut -d: -f4 | tr ',' '\n' | grep -qx "$(id -un)" && ! id -nG | tr ' ' '\n' | grep -qx docker; then
           warn "Containers" "this terminal has not picked up your Docker access yet. Log out and back in (or run: newgrp docker), or use: sudo homelab"
         else
           warn "Containers" "cannot read Docker (is Docker running, and are you in the docker group?)"
         fi ;;
    esac
  fi
}

boot_drive_line() {
  local line sec_dir="${HOMELAB_BOOT_SECTION_DIR:-/var/lib/homelab-boot-sections}" sec_gb="" f free_b
  line=$(df -h --output=pcent,avail / 2>/dev/null | awk 'NR==2 {print $1 " used, " $2 " free"}')
  for f in "$sec_dir"/*.img; do [ -f "$f" ] && sec_gb="$sec_gb $(( $(stat -c %s "$f") / 1000000000 ))"; done
  if [ -n "$sec_gb" ]; then
    line="$line; sections for pools:$(printf '%s' "$sec_gb" | sed 's/ \([0-9]*\)/ \1 GB,/g; s/,$//')"
    free_b=$(df -B1 --output=avail / 2>/dev/null | awk 'NR==2 {print $1}')
    if [ -n "$free_b" ] && [ "$free_b" -lt 128000000000 ]; then
      warn "Boot drive" "$line -> under 128 GB free; free some space (sudo drives status)"
      suggest 2 "sudo drives status" "the boot drive is getting full and a pool uses part of it"
      return 0
    fi
  fi
  [ -n "$line" ] && ok "Boot drive" "$line"
  return 0
}

cards_line() {   # the cards homelab-cards made for new services (it writes the summary; a section it was unsure about is asked for)
  local f="$STATE_DIR/cards-summary" names="" unsure="" kind name _c _s uns _a n=0
  [ -r "$f" ] || return 0
  while IFS='|' read -r kind name _c _s uns _a; do
    [ "$kind" = managed ] || continue
    n=$((n + 1)); names="$names$name, "
    [ "$uns" = 1 ] && unsure="$unsure$name "
  done <"$f"
  [ "$n" -gt 0 ] || return 0
  if [ -n "$unsure" ]; then
    warn "Service cards" "$n added by themselves (${names%, }); not sure of the section for: ${unsure% }"
    suggest 3 "sudo homelab-cards move ${unsure%% *} SECTION" "put its dashboard card in the right section"
  else
    ok "Service cards" "$n added by themselves: ${names%, }"
  fi
}

status() {
  pool_lines
  last_backup_line
  backup_size_line
  temps_line
  updates_line
  containers_line
  cards_line
  boot_drive_line
}

# ---------- secrets ----------
# Shows which secrets a rebuild needs and checks what the server can confirm.
# It NEVER prints a value: only "set", a length, or a yes/no.
real_home() {   # home folder of the person who runs it (also under sudo)
  if [ -n "${HOMELAB_HOME:-}" ]; then echo "$HOMELAB_HOME"; return; fi
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then getent passwd "$SUDO_USER" | cut -d: -f6; else echo "$HOME"; fi
}

dk() { timeout 10 docker "$@" 2>/dev/null; }
container_running() { dk ps --format '{{.Names}}' | grep -qx "$1"; }

dump_age_line() {   # dump_age_line LABEL DIR PATTERN MISSING-TEXT: how old the newest database dump is
  local label=$1 days
  days=$(age_days "$2" "$3") || days=""
  if [ -z "$days" ]; then bad "$label" "$4"
  elif [ "$days" -ge 2 ]; then warn "$label" "the newest dump is $days days old"
  else ok "$label" "newest dump is $days day(s) old"; fi
}

env_info() {   # env_info CONTAINER VAR -> "LENGTH STARTS_WITH_base64 LOOKS_LIKE_PLACEHOLDER", or nothing
  dk inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" | awk -F= -v v="$2" '
    $1 == v { sub(/^[^=]*=/, ""); print length($0), ($0 ~ /^base64:/ ? 1 : 0), ($0 ~ /your-own-key|^changeme$|^yours?$|^your-password$/ ? 1 : 0); found = 1 }
    END { if (!found) exit 1 }'
}

age_days() {   # age_days DIR PATTERN -> whole days since the newest matching file, or nothing
  local newest
  newest=$(find "$1" -maxdepth 1 -type f -name "$2" -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
  [ -n "$newest" ] || return 1
  echo $(( ( $(date +%s) - ${newest%.*} ) / 86400 ))
}

secrets() {
  local uh dest line len b64 ph n_key n_ph d f missing got
  uh=$(real_home)
  rule "Secrets and rebuild essentials"
  echo "   Values are never shown."
  echo
  printf '   %sKeep these in your password manager%s (the server cannot check them)\n\n' "$B" "$N"
  sed 's/^  /   /' <<'LIST'
  [ ] Linux user login (sudo, SSH, the console)
  [ ] Nextcloud admin login, and the Nextcloud database password
  [ ] Immich admin login, and the Immich database user and password
  [ ] Portainer, AdGuard Home, Beszel and FileBrowser admin logins
  [ ] Speedtest Tracker login and its APP_KEY
  [ ] Homepage widget keys (Tailscale token, Immich key, Nextcloud token, logins)
  [ ] Tailscale account, AnyDesk unattended password, GitHub account and its recovery codes
  [ ] Router admin login and the Wi-Fi password
  [ ] Last.fm and ListenBrainz accounts, and the Last.fm API key and shared secret
LIST
  rule "What this server can confirm"

  dest=""
  if [ -r "$LAST_RUN_FILE" ]; then dest=$(awk -F'|' 'END {print $3}' "$LAST_RUN_FILE"); fi
  [ "$dest" = none ] && dest=""

  # Docker needed for the next checks
  if ! { command -v docker >/dev/null 2>&1 && timeout 5 docker info >/dev/null 2>&1; }; then
    warn "Containers" "cannot read Docker, so the keys inside the containers were not checked"
  else
    # Nextcloud database password
    if container_running nextcloud; then
      n_key=$(dk exec nextcloud grep -c "'dbpassword'" /var/www/html/config/config.php || true)
      if [ "${n_key:-0}" -ge 1 ] 2>/dev/null; then ok "Nextcloud DB" "password is set in config.php (a rebuild must reuse this same password)"
      else bad "Nextcloud DB" "no dbpassword found in config.php"; fi
    else
      warn "Nextcloud DB" "the nextcloud container is not running, not checked"
    fi
    # Immich database password
    if container_running immich_postgres; then
      line=$(env_info immich_postgres POSTGRES_PASSWORD) || line=""
      read -r len _ ph <<<"$line"
      if [ -z "$line" ] || [ "${len:-0}" -eq 0 ]; then bad "Immich DB" "no database password is set in the container"
      elif [ "${ph:-0}" -eq 1 ]; then bad "Immich DB" "the password looks like a placeholder"
      else ok "Immich DB" "password is set (${len} characters)"; fi
    else
      warn "Immich DB" "the immich_postgres container is not running, not checked"
    fi
    # Speedtest Tracker key
    if container_running speedtest-tracker; then
      line=$(env_info speedtest-tracker APP_KEY) || line=""
      read -r len b64 ph <<<"$line"
      if [ -z "$line" ]; then bad "Speedtest key" "no APP_KEY is set in the container"
      elif [ "${ph:-0}" -eq 1 ]; then bad "Speedtest key" "APP_KEY is still the placeholder (replace it in the stack, with a base64: key of your own)"
      elif [ "${b64:-0}" -ne 1 ]; then warn "Speedtest key" "APP_KEY does not start with base64: (the app needs that prefix)"
      else ok "Speedtest key" "APP_KEY is set (${len} characters) and is not the placeholder"; fi
    else
      warn "Speedtest key" "the speedtest-tracker container is not running, not checked"
    fi
  fi

  # Homepage keys
  f="$uh/homepage-config/services.yaml"
  if [ -r "$f" ]; then
    n_key=$(grep -c -E '^[[:space:]]+(key|password|token|apikey|deviceid):[[:space:]]*[^[:space:]]' "$f")
    n_ph=$(grep -c -E '^[[:space:]]+(key|password|token|apikey|deviceid):[[:space:]]*(your-own-key|your-password|TOKEN|changeme)[[:space:]]*$' "$f")
    if [ "$n_ph" -gt 0 ]; then warn "Homepage keys" "$((n_key - n_ph)) filled in, $n_ph still placeholders in services.yaml"
    else ok "Homepage keys" "$n_key key/password fields are filled in"; fi
  else
    warn "Homepage keys" "cannot read $f"
  fi

  # Tailscale
  if command -v tailscale >/dev/null 2>&1; then
    if timeout 5 tailscale status >/dev/null 2>&1; then ok "Tailscale" "this machine is logged in"
    else warn "Tailscale" "not logged in, or cannot be read without sudo"; fi
  fi

  # The backup
  if [ -z "$dest" ]; then
    warn "Backup" "no backup location is known yet (no backup has run)"
  elif [ ! -d "$dest" ]; then
    bad "Backup" "the backup folder $dest is not there"
  else
    if [ "$(stat -c %d "$dest" 2>/dev/null)" = "$(stat -c %d "$BOOT_PATH" 2>/dev/null)" ]; then
      warn "Backup place" "$dest is on the boot drive: it is lost if that drive dies (connect a backup drive)"
    elif only_boot_section BACKUP; then
      warn "Backup place" "$dest is a section of the boot drive: it is lost if that drive dies (connect a backup drive)"
    else
      ok "Backup place" "$dest is on its own drive"
    fi
    if [ -r "$dest/boot-configs" ] && [ -x "$dest/boot-configs" ]; then
      missing=""; got=0
      for d in "home/*/homepage-config/services.yaml" "home/*/nextcloud/html/config/config.php" "opt/adguard-docker/conf/AdGuardHome.yaml"; do
        # shellcheck disable=SC2086
        if compgen -G "$dest/boot-configs/"$d >/dev/null 2>&1; then got=$((got + 1)); else missing="$missing ${d##*/}"; fi
      done
      if [ -z "$missing" ]; then ok "Saved configs" "Homepage, Nextcloud and AdGuard files are in the backup"
      elif [ "$got" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then warn "Saved configs" "cannot look inside the backup (run: sudo homelab secrets)"
      else bad "Saved configs" "missing from the backup:$missing"; fi
    else
      warn "Saved configs" "cannot read $dest/boot-configs (run: sudo homelab secrets)"
    fi
    dump_age_line "Nextcloud dump" "$dest/db-dumps" 'nextcloud-*.sql.gz' "no database dump found in $dest/db-dumps"
  fi

  # Immich's own database dumps (in the main pool)
  d="$MAIN_POOL/immich/backups"
  if [ -d "$d" ]; then
    dump_age_line "Immich dump" "$d" '*.sql.gz' "no Immich database dump in $d (Immich > Administration > Job Queues > Create job > Create Database Dump)"
  else
    warn "Immich dump" "$d is not there (is the main pool mounted?)"
  fi
  echo
  echo "   The full list, with where each secret is used and how to get it back, is in SECRETS-CHECKLIST.md in the repository."
  echo
}

screen() {   # the whole screen, checked live. "login" leaves out the suggested commands and puts the hint under the browser addresses
  local login="${1:-}"
  BUFFERING=1; status; BUFFERING=0
  header; summary_line; setup_line; finish_line
  rule "Status"; printf '%s\n' "$STATUS_BUF"
  open_section "$login"
  if [ -n "$login" ]; then login_hint; else suggestions; hint_line; fi
}

login_hint() {
  printf '\n  %sType%s %shomelab%s %sfor the full status, or%s %shomelab commands%s%s.%s\n' "$D" "$N" "$B" "$N" "$D" "$N" "$B" "$N" "$D" "$N"
  secrets_hint
}

uptime_secs() {
  local u=${HOMELAB_UPTIME:-$(cut -d. -f1 /proc/uptime 2>/dev/null)}
  [[ "$u" =~ ^[0-9]+$ ]] || u=999999
  echo "$u"
}

# The two dashboard addresses are looked up through Docker and Tailscale, which takes a moment, so a login keeps them for an hour.
cached_dashboard_urls() {
  local dir="${HOMELAB_CACHE_DIR:-${XDG_RUNTIME_DIR:-$HOME/.cache}}/homelab-login" file mt now
  file="$dir/urls"; now=$(date +%s); mt=$(stat -c %Y "$file" 2>/dev/null || echo 0)
  DASH_HOME=""; DASH_TS=""
  if [ -r "$file" ] && [ $(( now - mt )) -ge 0 ] && [ $(( now - mt )) -lt "$URL_CACHE_SECS" ]; then
    IFS='|' read -r DASH_HOME DASH_TS <"$file"
    return 0
  fi
  dashboard_urls
  if [ -n "$DASH_HOME" ] && mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null; then
    printf '%s|%s\n' "$DASH_HOME" "$DASH_TS" >"$file.$$" 2>/dev/null && mv -f "$file.$$" "$file" 2>/dev/null || rm -f "$file.$$"
  fi
}

# login_screen: what ~/.bashrc runs when a terminal opens: the summary, the status and the browser addresses, without the suggested commands.
#  - A screen made less than 2 minutes ago (for the same window width) is shown again as it was, so opening several terminals in a row
#    does the checks once. "homelab" and "homelab status" are always live.
#  - In the first 10 minutes after a boot the apps are still starting: only light checks run, so SSH stays quick.
login_screen() {
  local dir="${HOMELAB_CACHE_DIR:-${XDG_RUNTIME_DIR:-$HOME/.cache}}/homelab-login" file cols now mt age up text
  file="$dir/screen"; cols=$(term_cols); now=$(date +%s); up=$(uptime_secs)
  mt=$(stat -c %Y "$file" 2>/dev/null || echo 0); age=$(( now - mt ))
  if [ -r "$file" ] && [ "$age" -ge 0 ] && [ "$age" -lt "$LOGIN_CACHE_SECS" ] && [ "$age" -lt "$up" ] \
     && [ "$(head -n 1 "$file")" = "$cols|$B" ]; then
    tail -n +2 "$file"
    return 0
  fi
  [ "$up" -lt "$BOOT_GRACE_SECS" ] && JUST_BOOTED=1
  text=$(screen login)
  printf '%s\n' "$text"
  if mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null; then
    { printf '%s|%s\n' "$cols" "$B"; printf '%s\n' "$text"; } >"$file.$$" 2>/dev/null && mv -f "$file.$$" "$file" 2>/dev/null || rm -f "$file.$$"
  fi
}

forward() {   # short forms: "homelab backup" runs "sudo homelab-backup" (it says so, so the real name is learned)
  local word="$1"; shift
  local -a real
  case "$word" in
    backup)          real=(homelab-backup) ;;
    update)          real=(homelab-update) ;;
    upgrade)         real=(homelab-setup upgrade) ;;
    uninstall)       real=(homelab-setup uninstall) ;;
    setup)           real=(homelab-setup) ;;
    drives|drive)    real=(drives) ;;
    cards)           real=(homelab-cards) ;;
    selftest)        real=(homelab-selftest) ;;
  esac
  printf '  %sRunning:  sudo %s%s\n' "$D" "${real[*]}${*:+ $*}" "$N" >&2
  if [ "$(id -u)" = 0 ]; then exec "${real[@]}" "$@"; fi
  exec sudo "${real[@]}" "$@"
}

did_you_mean() {   # a word that is not a homelab option: point to the command the person most likely meant
  local w="${1:-}" c="" why=""
  case "$w" in
    disk|disks|storage|pool|pools)     c="homelab drives";                     why="the drive menu: look at, connect, remove or fix drives" ;;
    pull|install)                      c="homelab upgrade";                    why="download the newest lab files from GitHub and put them on this server" ;;
    check|test|health|verify)          c="sudo homelab-selftest";              why="the big check of the whole lab. Which check fits? see: homelab commands" ;;
    restore)                           c="sudo homelab-restore-configs check"; why="preview restoring the saved settings after a rebuild" ;;
    recover|remount|mount)             c="sudo drives remount";                why="after an unplug or power cut: remount the drives and start the containers" ;;
    logs|log)                          c="docker logs --tail 50 NAME";         why="the last lines a container printed" ;;
    help-me|-?|\?)                    c="homelab help";                       why="what this command can do" ;;
  esac
  echo "homelab does not have an option called '$w'."
  [ -z "$c" ] || printf 'Did you mean:  %s\n    (%s)\n' "$c" "$why"
  echo "Options of this command:  homelab help      Every command, in groups:  homelab commands"
}

case "${1:-}" in
  backup|update|upgrade|uninstall|setup|drives|drive|cards|selftest) forward "$@" ;;
  panel)  panel_cmd "${@:2}" ;;
  theme)  homepage_edit theme "${@:2}" ;;
  simple) homepage_edit simple "${@:2}" ;;
  bookmark|bookmarks) homepage_edit bookmark "${@:2}" ;;
  event|events) calendar_cmd "${@:2}" ;;
  calendar|calendars) calendar_cmd feed "${@:2}" ;;
  docs)   show_docs ;;
  secrets) secrets ;;
  -h|--help|help)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  version|--version) echo "homelab $VERSION" ;;
  status) BUFFERING=1; status; BUFFERING=0; rule "Status"; printf '%s\n' "$STATUS_BUF" ;;
  commands|command)
          header; commands
          echo; printf '  %sType%s %shomelab%s %sto see the status.%s\n\n' "$D" "$N" "$B" "$N" "$D" "$N" ;;
  login)  login_screen ;;
  "")     screen ;;
  *)      did_you_mean "$1" >&2; exit 1 ;;
esac

