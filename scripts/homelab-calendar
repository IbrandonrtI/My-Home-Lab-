#!/usr/bin/env python3
"""homelab-calendar - the holidays and your own events for the Calendar on the Homepage dashboard.

It writes three small calendar files into the images folder of Homepage (~/homepage-config/images/), which the Calendar on the
Stats tab reads:
  holidays.ics       US federal holidays, plus Lincoln's Birthday and Election Day (New York State)
  observances.ics    Valentine's Day, Mother's Day, Father's Day, Halloween, Lunar New Year and Diwali
  events.ics         your own events (kept in ~/homepage-config/events.txt, one per line, you may edit that file by hand)
  mycalendars.ics    your online calendars (Google Calendar, school, work ... any calendar with an iCal address), all in one file
The holiday dates are worked out by rule (for example "third Monday of January"), so they are always right. Lunar New Year and Diwali
come from a fixed list of dates (2026 to 2035).

Usage (type  homelab event ...  instead of  homelab-calendar ...):
  homelab event add DATE "text" [yearly]    add an event. DATE: 2026-12-25, 12/25/2026, or 12/25 (the next 12/25).
                                            Add the word yearly for a birthday or anniversary that comes back every year.
  homelab event list                        your events, numbered
  homelab event remove NUMBER               take one away (the number from the list)
  homelab event holidays                    the next holidays
  homelab calendar add NAME ADDRESS         show an online calendar (its iCal address, https://... or webcal://...) next to your own.
                                            Google Calendar: Settings > your calendar > Integrate calendar > the address in iCal format.
  homelab calendar list                     your online calendars, numbered
  homelab calendar remove NUMBER            stop showing one
  homelab calendar sync                     fetch them again now (a daily job does this)
  homelab-calendar build                    rewrite the calendar files (the installer and a weekly job do this)
  homelab-calendar version
"""

import datetime
import hashlib
import os
import pwd
import re
import sys
import urllib.error
import urllib.request

VERSION = "1.0"
STATE_DIR = os.environ.get("HOMELAB_STATE_DIR", "/var/lib/homelab")
YEARS_BACK, YEARS_AHEAD = 1, 5
STAMP = "20260101T000000Z"                     # a fixed time stamp, so a file only changes when its events change
LUNAR_NEW_YEAR = {2026: (2, 17), 2027: (2, 6), 2028: (1, 26), 2029: (2, 13), 2030: (2, 3), 2031: (1, 23), 2032: (2, 11), 2033: (1, 31),
                  2034: (2, 19), 2035: (2, 8)}
DIWALI = {2026: (11, 8), 2027: (10, 29), 2028: (10, 17), 2029: (11, 5), 2030: (10, 26), 2031: (11, 14), 2032: (11, 2), 2033: (10, 22),
          2034: (11, 10), 2035: (10, 30)}
EVENTS_HEADER = ("# Your own events for the Calendar on the Homepage dashboard. One per line:  DATE | once or yearly | text\n"
                 "# Add one with:  homelab event add 2026-12-25 \"Family dinner\"   (you may also edit this file by hand)\n")


FEEDS_HEADER = ("# Your online calendars for the Calendar on the Homepage dashboard. One per line:  NAME | ADDRESS\n"
                "# The address of a Google Calendar is private: do not share this file. Add one with:  homelab calendar add NAME ADDRESS\n")
FEED_MAX_BYTES = 8 * 1024 * 1024
FEED_KEEP_DAYS = 400                  # events that do not repeat and ended longer ago than this are left out (keeps the file small)


class Fail(Exception):
    pass


# ---------------------------------------------------------------- the holidays
def nth_weekday(year, month, weekday, n):
    """The n-th weekday (0 = Monday ... 6 = Sunday) of a month."""
    first = datetime.date(year, month, 1)
    return first + datetime.timedelta(days=(weekday - first.weekday()) % 7 + 7 * (n - 1))


def last_weekday(year, month, weekday):
    nxt = datetime.date(year + (month == 12), month % 12 + 1, 1)
    last = nxt - datetime.timedelta(days=1)
    return last - datetime.timedelta(days=(last.weekday() - weekday) % 7)


def official(y):
    """US federal holidays and the New York State extras: [(date, name)]."""
    d = datetime.date
    return [
        (d(y, 1, 1), "New Year's Day"),
        (nth_weekday(y, 1, 0, 3), "Martin Luther King Jr. Day"),
        (d(y, 2, 12), "Lincoln's Birthday (NY)"),
        (nth_weekday(y, 2, 0, 3), "Presidents' Day"),
        (last_weekday(y, 5, 0), "Memorial Day"),
        (d(y, 6, 19), "Juneteenth"),
        (d(y, 7, 4), "Independence Day"),
        (nth_weekday(y, 9, 0, 1), "Labor Day"),
        (nth_weekday(y, 10, 0, 2), "Columbus Day / Indigenous Peoples' Day"),
        (nth_weekday(y, 11, 0, 1) + datetime.timedelta(days=1), "Election Day (NY)"),
        (d(y, 11, 11), "Veterans Day"),
        (nth_weekday(y, 11, 3, 4), "Thanksgiving"),
        (d(y, 12, 25), "Christmas Day"),
    ]


def observances(y):
    """Days that are not official holidays: [(date, name)]."""
    d = datetime.date
    out = [(d(y, 2, 14), "Valentine's Day"), (nth_weekday(y, 5, 6, 2), "Mother's Day"), (nth_weekday(y, 6, 6, 3), "Father's Day"),
           (d(y, 10, 31), "Halloween")]
    if y in LUNAR_NEW_YEAR:
        out.append((d(y, *LUNAR_NEW_YEAR[y]), "Lunar New Year"))
    if y in DIWALI:
        out.append((d(y, *DIWALI[y]), "Diwali"))
    return out


def years(today=None):
    y = (today or datetime.date.today()).year
    return range(y - YEARS_BACK, y + YEARS_AHEAD + 1)


# ---------------------------------------------------------------- calendar files (iCalendar)
def esc(text):
    return text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\n", " ")


def fold(line):
    """Lines of an .ics file are at most 75 characters; a longer one continues on the next line after a space."""
    out, b = [], line.encode("utf-8")
    while len(b) > 74:
        cut = 74
        while cut > 0 and (b[cut] & 0xC0) == 0x80:      # never cut inside a character
            cut -= 1
        out.append(b[:cut].decode("utf-8"))
        b = b[cut:]
    out.append(b.decode("utf-8"))
    return "\r\n ".join(out)


def vevent(day, name, yearly=False):
    uid = hashlib.sha1(("%s|%s|%s" % (day, name, yearly)).encode("utf-8")).hexdigest()[:20]
    nxt = day + datetime.timedelta(days=1)
    lines = ["BEGIN:VEVENT", "UID:%s@homelab" % uid, "DTSTAMP:" + STAMP, "DTSTART;VALUE=DATE:" + day.strftime("%Y%m%d"),
             "DTEND;VALUE=DATE:" + nxt.strftime("%Y%m%d")]
    if yearly:
        lines.append("RRULE:FREQ=YEARLY")
    lines += ["SUMMARY:" + esc(name), "TRANSP:TRANSPARENT", "END:VEVENT"]
    return lines


def ics(name, events):
    """events: [(date, text, yearly)]. A calendar without any event shows an error on the dashboard, so an empty one gets a note in
    the year 2000 (far outside what the calendar shows)."""
    body = []
    for day, text, yearly in events:
        body += vevent(day, text, yearly)
    if not body:
        body = vevent(datetime.date(2000, 1, 1), "No events yet", False)
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//homelab//calendar//EN", "CALSCALE:GREGORIAN", "X-WR-CALNAME:" + esc(name)] + body + ["END:VCALENDAR"]
    return "\r\n".join(fold(l) for l in lines) + "\r\n"


# ---------------------------------------------------------------- where the files are
def lab_user():
    name = os.environ.get("HOMELAB_USER") or os.environ.get("SUDO_USER")
    if name and name != "root":
        return name
    try:
        return pwd.getpwuid(1000).pw_name
    except KeyError:
        return ""


def homepage_dir():
    forced = os.environ.get("HP_DIR")
    if forced:
        return forced
    try:
        with open(os.path.join(STATE_DIR, "homepage-dir")) as f:
            saved = f.read().strip()
        if saved and os.path.isdir(saved):
            return saved
    except OSError:
        pass
    u = lab_user()
    try:
        home = pwd.getpwnam(u).pw_dir if u else os.path.expanduser("~")
    except KeyError:
        home = os.path.expanduser("~")
    return os.path.join(home, "homepage-config")


def read(path):
    try:
        with open(path, newline="") as f:
            return f.read()
    except OSError:
        return ""


def write_if_changed(path, text, owner_of):
    """Write a file only when its text changed. When run by root the file is handed to the owner of `owner_of`, so the user can change it."""
    if read(path) == text:
        return False
    tmp = path + ".tmp"
    with open(tmp, "w", newline="") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    if os.geteuid() == 0:
        st = os.stat(owner_of)
        os.chown(tmp, st.st_uid, st.st_gid)
    os.replace(tmp, path)
    return True


# ---------------------------------------------------------------- your events
def parse_date(text, today=None):
    today = today or datetime.date.today()
    t = text.strip()
    m = re.fullmatch(r"(\d{4})-(\d{1,2})-(\d{1,2})", t)
    try:
        if m:
            return datetime.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
        m = re.fullmatch(r"(\d{1,2})/(\d{1,2})/(\d{2}|\d{4})", t)
        if m:
            y = int(m.group(3))
            return datetime.date(y + 2000 if y < 100 else y, int(m.group(1)), int(m.group(2)))
        m = re.fullmatch(r"(\d{1,2})/(\d{1,2})", t)
        if m:
            for y in (today.year, today.year + 1, today.year + 2, today.year + 3, today.year + 4):     # 2/29 waits for a leap year
                try:
                    day = datetime.date(y, int(m.group(1)), int(m.group(2)))
                except ValueError:
                    continue
                if day >= today:
                    return day
    except ValueError:
        pass
    raise Fail("'%s' is not a date I can read. Use 2026-12-25, 12/25/2026 or 12/25 (the next 12/25), and a real day of the month." % text)


def load_events(hp):
    """[(date, text, yearly)] from events.txt, sorted. Lines that cannot be read are skipped."""
    out = []
    for line in read(os.path.join(hp, "events.txt")).splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) != 3 or not parts[2]:
            continue
        try:
            day = parse_date(parts[0])
        except Fail:
            continue
        out.append((day, parts[2], parts[1].lower() == "yearly"))
    return sorted(set(out), key=lambda e: (e[0], e[1].lower(), e[2]))


def save_events(hp, events):
    text = EVENTS_HEADER + "".join("%s | %s | %s\n" % (d.isoformat(), "yearly" if y else "once", t) for d, t, y in events)
    write_if_changed(os.path.join(hp, "events.txt"), text, hp)


# ---------------------------------------------------------------- your online calendars
def load_feeds(hp):
    """[(name, address)] from calendars.txt. Lines that cannot be read are skipped."""
    out = []
    for line in read(os.path.join(hp, "calendars.txt")).splitlines():
        if not line.strip() or line.lstrip().startswith("#") or "|" not in line:
            continue
        name, addr = [p.strip() for p in line.split("|", 1)]
        if name and re.match(r"^(https?|webcal)://", addr, re.I):
            out.append((name, addr))
    return out


def save_feeds(hp, feeds):
    path = os.path.join(hp, "calendars.txt")
    write_if_changed(path, FEEDS_HEADER + "".join("%s | %s\n" % f for f in feeds), hp)
    os.chmod(path, 0o600)                      # the address of a calendar must stay private


def feed_url(addr):
    return re.sub(r"^webcal://", "https://", addr, flags=re.I)


def fetch_feed(addr):
    """The text of an online calendar. Raises Fail when it cannot be had or is not a calendar."""
    req = urllib.request.Request(feed_url(addr), headers={"User-Agent": "homelab-calendar"})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            data = r.read(FEED_MAX_BYTES + 1)
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise Fail("could not read that address (%s)" % getattr(e, "reason", e)) from None
    if len(data) > FEED_MAX_BYTES:
        raise Fail("that calendar is bigger than %d MB" % (FEED_MAX_BYTES >> 20))
    text = data.decode("utf-8", "replace")
    if "BEGIN:VCALENDAR" not in text:
        raise Fail("that address is not an iCal calendar (it should end in .ics)")
    return text


def feed_slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "calendar"


def unfold(text):
    """The lines of an .ics text, with continuation lines joined."""
    lines = []
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if raw[:1] in (" ", "\t") and lines:
            lines[-1] += raw[1:]
        elif raw:
            lines.append(raw)
    return lines


def feed_parts(text, name, today=None):
    """(time zone blocks, events) of one calendar. Every event title starts with [name]. Old one-time events are dropped."""
    today = today or datetime.date.today()
    cutoff = (today - datetime.timedelta(days=FEED_KEEP_DAYS)).strftime("%Y%m%d")
    zones, events, cur, kind = [], [], None, ""
    for line in unfold(text):
        if cur is None:
            if line in ("BEGIN:VEVENT", "BEGIN:VTIMEZONE"):
                cur, kind = [line], line[6:]
            continue
        cur.append(line)
        if line == "END:" + kind:
            if kind == "VTIMEZONE":
                zones.append(cur)
            else:
                events.append(tag_event(cur, name, cutoff))
            cur = None
    return zones, [e for e in events if e]


def tag_event(lines, name, cutoff):
    """The event with [name] in front of its title, or None for an old event that does not repeat."""
    start = next((l for l in lines if l.startswith("DTSTART")), "")
    day = re.sub(r"\D", "", start.split(":", 1)[-1])[:8]
    if day and day < cutoff and not any(l.startswith("RRULE") for l in lines):
        return None
    out, done = [], False
    for l in lines:
        m = re.match(r"^SUMMARY(?:;[^:]*)?:(.*)$", l)
        if m and not done:
            out.append("SUMMARY:[%s] %s" % (esc(name), m.group(1)))
            done = True
        else:
            out.append(l)
    if not done:
        out.insert(1, "SUMMARY:[%s]" % esc(name))
    return out


def merged_feeds(hp):
    """The text of mycalendars.ics from the saved copies of the online calendars."""
    zones, seen, body = [], set(), []
    for name, _addr in load_feeds(hp):
        z, ev = feed_parts(read(os.path.join(hp, "calendar-cache", feed_slug(name) + ".ics")), name)
        for block in z:
            tz = next((l for l in block if l.startswith("TZID:")), "")
            if tz not in seen:
                seen.add(tz)
                zones.append(block)
        body += ev
    if not body:
        body = vevent(datetime.date(2000, 1, 1), "No calendars added yet", False)
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//homelab//calendar//EN", "CALSCALE:GREGORIAN", "X-WR-CALNAME:My Calendars"]
    for block in zones:
        lines += block
    lines += [l for e in body for l in (e if isinstance(e, list) else [e])]
    lines.append("END:VCALENDAR")
    return "\r\n".join(fold(l) for l in lines) + "\r\n"


def sync_feeds(hp, only=None):
    """Fetch the online calendars again (a calendar that cannot be fetched keeps its last copy). Returns [(name, 'ok' or the problem)]."""
    cache = os.path.join(hp, "calendar-cache")
    os.makedirs(cache, exist_ok=True)
    if os.geteuid() == 0:
        st = os.stat(hp)
        os.chown(cache, st.st_uid, st.st_gid)
    results = []
    for name, addr in load_feeds(hp):
        if only and name != only:
            continue
        try:
            text = fetch_feed(addr)
            write_if_changed(os.path.join(cache, feed_slug(name) + ".ics"), text, hp)
            results.append((name, "ok"))
        except Fail as e:
            results.append((name, str(e)))
    return results


def build(hp):
    """Write the calendar files. Returns the list of files that changed."""
    img = os.path.join(hp, "images")
    os.makedirs(img, exist_ok=True)
    if os.geteuid() == 0:
        st = os.stat(hp)
        os.chown(img, st.st_uid, st.st_gid)
    ys = list(years())
    hol = sorted(e for y in ys for e in official(y))
    obs = sorted(e for y in ys for e in observances(y))
    files = [("holidays.ics", ics("Holidays", [(d, n, False) for d, n in hol])),
             ("observances.ics", ics("Observances", [(d, n, False) for d, n in obs])),
             ("events.ics", ics("My Events", load_events(hp))),
             ("mycalendars.ics", merged_feeds(hp))]
    return [n for n, text in files if write_if_changed(os.path.join(img, n), text, hp)]


def say_events(events):
    today = datetime.date.today()
    if not events:
        print("You have no events yet. Add one:  homelab event add 2026-12-25 \"Family dinner\"")
        return
    for i, (d, t, y) in enumerate(events, 1):
        when = d.strftime("%a %b %d") + " (every year)" if y else d.strftime("%a %b %d, %Y") + ("" if d >= today else " (past)")
        print("%3d  %s  %s" % (i, when, t))


def short_addr(addr):
    m = re.match(r"^(\w+://[^/]+)", addr)
    return (m.group(1) if m else addr[:30]) + "/..."          # the rest of the address is private


def feed_cmd(hp, a):
    sub = a[0] if a else ""
    feeds = load_feeds(hp)
    if sub == "list":
        if not feeds:
            print("No online calendars yet. Add one with:  homelab calendar add NAME ADDRESS")
        for i, (n, addr) in enumerate(feeds, 1):
            print("  %d  %-20s %s" % (i, n, short_addr(addr)))
        return 0
    if sub == "add":
        words = a[1:]
        if len(words) < 2:
            raise Fail("Usage:  homelab calendar add NAME ADDRESS     for example:  homelab calendar add School \"https://calendar.google.com/calendar/ical/.../basic.ics\"")
        addr, name = words[-1], " ".join(words[:-1]).replace("|", "/").strip()
        if not re.match(r"^(https?|webcal)://", addr, re.I):
            raise Fail("The address must start with https:// or webcal://  (Google Calendar: Settings > your calendar > Integrate calendar > the address in iCal format).")
        if any(n.lower() == name.lower() for n, _ in feeds):
            raise Fail("There is already an online calendar called %s. Remove it first, or use another name." % name)
        text = fetch_feed(addr)                    # refuses an address that is not a calendar
        feeds.append((name, addr))
        save_feeds(hp, feeds)
        cache = os.path.join(hp, "calendar-cache")
        os.makedirs(cache, exist_ok=True)
        if os.geteuid() == 0:
            st = os.stat(hp)
            os.chown(cache, st.st_uid, st.st_gid)
        write_if_changed(os.path.join(cache, feed_slug(name) + ".ics"), text, hp)
        build(hp)
        n = len(feed_parts(text, name)[1])
        print("Added %s (%d events). They show in the dashboard's Calendar within 5 minutes (or reload the page). A daily job keeps them fresh." % (name, n))
        return 0
    if sub in ("remove", "rm", "delete"):
        if len(a) != 2 or not a[1].isdigit():
            raise Fail("Usage:  homelab calendar remove NUMBER     (the number from  homelab calendar list)")
        n = int(a[1])
        if not 1 <= n <= len(feeds):
            raise Fail("There is no online calendar number %d. See the numbers with:  homelab calendar list" % n)
        name, _ = feeds.pop(n - 1)
        save_feeds(hp, feeds)
        try:
            os.remove(os.path.join(hp, "calendar-cache", feed_slug(name) + ".ics"))
        except OSError:
            pass
        build(hp)
        print("Removed %s." % name)
        return 0
    if sub == "sync":
        return run(["sync"])
    raise Fail("Try:  homelab calendar add NAME ADDRESS | list | remove NUMBER | sync")


def run(argv):
    hp = homepage_dir()
    cmd = argv[0] if argv else ""
    if cmd in ("version", "--version"):
        print("homelab-calendar %s" % VERSION)
        return 0
    if cmd in ("", "help", "--help", "-h"):
        print(__doc__.strip())
        return 0
    if cmd == "holidays":
        today = datetime.date.today()
        rows = sorted((d, n, "") for y in (today.year, today.year + 1) for d, n in official(y) + observances(y) if d >= today)[:12]
        for d, n, _ in rows:
            print("  %s  %s" % (d.strftime("%a %b %d, %Y"), n))
        return 0
    if not os.path.isdir(hp):
        raise Fail("The Homepage folder %s does not exist. Set up the dashboard first (sudo homelab-setup)." % hp)
    if cmd == "build":
        changed = build(hp)
        if sys.stdout.isatty():
            print("Calendar files up to date%s." % (" (changed: %s)" % ", ".join(changed) if changed else ""))
        return 0
    if cmd == "list":
        say_events(load_events(hp))
        return 0
    if cmd == "add":
        words = argv[1:]
        yearly = bool(words) and words[-1].lower() == "yearly"
        if yearly:
            words = words[:-1]
        if len(words) < 2:
            raise Fail("Usage:  homelab event add DATE \"text\" [yearly]     for example:  homelab event add 2026-12-25 \"Family dinner\"")
        day = parse_date(words[0])
        text = " ".join(words[1:]).replace("|", "/").strip()
        events = load_events(hp)
        if (day, text, yearly) in events:
            print("That event is already in the calendar.")
            return 0
        events.append((day, text, yearly))
        events.sort(key=lambda e: (e[0], e[1].lower(), e[2]))
        save_events(hp, events)
        build(hp)
        print("Added: %s  %s%s" % (day.strftime("%a %b %d, %Y"), text, "  (every year)" if yearly else ""))
        print("It shows on the dashboard's Calendar within 5 minutes (or reload the page).")
        return 0
    if cmd in ("remove", "rm", "delete"):
        if len(argv) != 2 or not argv[1].isdigit():
            raise Fail("Usage:  homelab event remove NUMBER     (the number from  homelab event list)")
        events = load_events(hp)
        n = int(argv[1])
        if not 1 <= n <= len(events):
            raise Fail("There is no event number %d. See the numbers with:  homelab event list" % n)
        d, t, y = events.pop(n - 1)
        save_events(hp, events)
        build(hp)
        print("Removed: %s  %s" % (d.strftime("%a %b %d, %Y"), t))
        return 0
    if cmd == "sync":
        res = sync_feeds(hp)
        changed = build(hp)
        if sys.stdout.isatty() or any(r != "ok" for _, r in res):
            for name, r in res:
                print("  %-20s %s" % (name, "up to date" if r == "ok" else "PROBLEM: " + r))
            if not res:
                print("No online calendars yet. Add one with:  homelab calendar add NAME ADDRESS")
        return 1 if any(r != "ok" for _, r in res) else 0
    if cmd == "feed":
        return feed_cmd(hp, argv[1:])
    raise Fail("I do not know '%s'. Try:  homelab event add | list | remove | holidays   or   homelab calendar add | list | remove | sync" % cmd)


def main(argv):
    try:
        return run(argv)
    except Fail as e:
        print("homelab-calendar: %s" % e, file=sys.stderr)
        return 1
    except OSError as e:
        print("homelab-calendar: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
