#!/usr/bin/env bash
# homelab-restore-configs - put the saved config files back on a rebuilt server.
#
# The daily backup (homelab-backup) keeps the boot drive's config files under their
# full paths in  <backup>/boot-configs/.  After a fresh Linux install this tool copies
# them back the safe way:
#   - it NEVER restores /etc/fstab (the old boot drive's identifiers would stop the
#     new server from booting), /usr/local/ (the scripts come from GitHub),
#     root-crontab.txt (a record to read, not a file to copy) or /var/lib/docker/
#     (Docker volumes are restored one by one with:  volume NAME)
#   - it shows a preview first (what is new, what would be replaced) and asks you to
#     type RESTORE
#   - it never deletes anything
#
# Usage:
#   sudo homelab-restore-configs [BACKUP_FOLDER]     restore the config files
#   sudo homelab-restore-configs check [BACKUP]      only show the preview, never copy (safe on a running server)
#   sudo homelab-restore-configs list [BACKUP]       list the Docker volumes in the backup
#   sudo homelab-restore-configs volume NAME [BACKUP]  restore one Docker volume
#   homelab-restore-configs version | help

set -u
set -o pipefail
export PATH="${HOMELAB_EXTRA_PATH:+$HOMELAB_EXTRA_PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

VERSION="1.0"
ROOT="${HRC_ROOT:-/}"                                     # tests point this at a fake root
ROOT="${ROOT%/}"
BACKUP_POOL="${HRC_BACKUP_POOL:-/mnt/backup}"
STATUS_FILE="${HRC_STATUS_FILE:-/var/lib/homelab-backup/last-run}"
CONF="${HRC_CONF:-/etc/homelab-backup.conf}"
LOGFILE="${HRC_LOGFILE:-/var/log/homelab-restore-configs.log}"
PREVIEW_NAMES=20

EXCLUDES=(--exclude=/etc/fstab --exclude=/usr/local/ --exclude=/root-crontab.txt --exclude=/var/lib/docker/)

STOPPED=""
PREVIEW_ONLY=0

log()  { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGFILE" 2>/dev/null || true; }
say()  { printf '%s\n' "$*"; }
note() { printf '%s\n' "$*" >&2; }
warn() { printf 'WARNING: %s\n' "$*" >&2; log "WARN $*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; log "ERROR $*"; exit 1; }
ask()  { local v=""; printf '%s' "$1" >&2; IFS= read -r v || true; printf '%s' "$v"; }
yn()   { case "$(ask "$1 [y/N]: ")" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac; }
typed() { [ "$(ask "$2")" = "$1" ]; }
human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

usage() {
  cat <<EOF
homelab-restore-configs $VERSION

  sudo homelab-restore-configs [BACKUP_FOLDER]       restore the saved config files (preview first)
  sudo homelab-restore-configs check [BACKUP_FOLDER] only show the preview, never copy (safe on a running server)
  sudo homelab-restore-configs list [BACKUP_FOLDER]  list the Docker volumes saved in the backup
  sudo homelab-restore-configs volume NAME [BACKUP_FOLDER]
                                                     restore one Docker volume (stops its containers, then starts them)
  homelab-restore-configs version

Without BACKUP_FOLDER it looks at $BACKUP_POOL, then at the place the last backup went.
Never restored: /etc/fstab, /usr/local/, root-crontab.txt, /var/lib/docker/. Nothing is deleted.
EOF
}

[ "$(id -u)" -eq 0 ] || [ "${1:-}" = version ] || [ "${1:-}" = help ] || [ "${1:-}" = --help ] || die "Run it with sudo."

# ---------- find the backup ----------
has_configs() { [ -d "$1/boot-configs" ]; }

find_backup() {   # find_backup [explicit]  -> prints the backup folder
  local c="${1:-}" dest fb
  if [ -n "$c" ]; then
    c="${c%/}"
    has_configs "$c" || die "$c has no boot-configs folder. Give the folder that holds main, boot-configs and db-dumps."
    echo "$c"; return 0
  fi
  if mountpoint -q "$BACKUP_POOL" 2>/dev/null && has_configs "$BACKUP_POOL"; then echo "$BACKUP_POOL"; return 0; fi
  if [ -r "$STATUS_FILE" ]; then
    dest=$(awk -F'|' 'END {print $3}' "$STATUS_FILE")
    if [ -n "$dest" ] && [ "$dest" != none ] && has_configs "$dest"; then echo "$dest"; return 0; fi
  fi
  if [ -r "$CONF" ]; then
    fb=$(DEST_FALLBACK=""; # shellcheck disable=SC1090
         . "$CONF" >/dev/null 2>&1; printf '%s' "$DEST_FALLBACK")
    if [ -n "$fb" ] && has_configs "$fb"; then echo "$fb"; return 0; fi
  fi
  return 1
}

backup_age() {   # backup_age DIR -> text about the last run, if the status file points at this backup
  local d=$1 line
  if [ -r "$STATUS_FILE" ]; then
    line=$(tail -1 "$STATUS_FILE")
    if [ "$(printf '%s' "$line" | awk -F'|' '{print $3}')" = "$d" ]; then
      printf 'last backup run: %s (%s)' "$(printf '%s' "$line" | awk -F'|' '{print $1}')" "$(printf '%s' "$line" | awk -F'|' '{print $2}')"
      return
    fi
  fi
  printf 'no record of a backup run for this folder; newest file inside: %s' "$(find "$d/boot-configs" -type f -printf '%TY-%Tm-%Td\n' 2>/dev/null | sort | tail -1)"
}

# ---------- containers (volume restore) ----------
docker_ok() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

stop_for_volume() {   # stop_for_volume NAME
  local list
  docker_ok || { STOPPED=""; return 0; }
  list=$(docker ps --filter "volume=$1" --format '{{.Names}}' | tr '\n' ' ')
  [ -n "${list// /}" ] || { STOPPED=""; return 0; }
  note "Stopping containers that use this volume: $list"
  # shellcheck disable=SC2086
  docker stop $list >/dev/null || warn "Some containers did not stop cleanly"
  STOPPED=$list
}

start_stopped() {
  [ -n "${STOPPED// /}" ] || return 0
  note "Starting containers: $STOPPED"
  # shellcheck disable=SC2086
  docker start $STOPPED >/dev/null || warn "Some containers did not start"
  STOPPED=""
}

# ---------- preview and copy ----------
# preview SRC/ DEST/ [excludes...]  -> sets NEW_N CHG_N BYTES, writes $OUT (itemized lines)
preview() {
  local src=$1 dst=$2; shift 2
  OUT=$(mktemp); STATS=$(mktemp)
  rsync -aHn --numeric-ids --out-format='%i %n' --stats "$@" "$src" "$dst" >"$OUT" 2>"$STATS.err" || {
    cat "$STATS.err" >&2; rm -f "$OUT" "$STATS" "$STATS.err"; die "rsync could not read the backup."; }
  grep -E '^>f' "$OUT" | grep -E '^>f\+\+\+\+\+\+\+\+\+ ' >"$STATS.new" || true
  grep -E '^>f' "$OUT" | grep -v -E '^>f\+\+\+\+\+\+\+\+\+ ' >"$STATS.chg" || true
  NEW_N=$(wc -l <"$STATS.new"); CHG_N=$(wc -l <"$STATS.chg")
  BYTES=$(awk -F': ' '/^Total transferred file size/ {gsub(/[^0-9]/,"",$2); print $2}' "$OUT")
  BYTES=${BYTES:-0}
  # the stats block is at the end of $OUT; keep only the item lines for display
  NEW_LIST=$STATS.new; CHG_LIST=$STATS.chg
}

show_names() {   # show_names LISTFILE TITLE
  local n; n=$(wc -l <"$1")
  [ "$n" -gt 0 ] || return 0
  say "$2 (first $PREVIEW_NAMES):"
  head -"$PREVIEW_NAMES" "$1" | sed -E 's/^[^ ]+ /  /'
  [ "$n" -le "$PREVIEW_NAMES" ] || say "  ... and $((n - PREVIEW_NAMES)) more"
}

cleanup_preview() { rm -f "${OUT:-}" "${STATS:-}" "${STATS:-}.err" "${STATS:-}.new" "${STATS:-}.chg" 2>/dev/null || true; }

# ---------- restore the config files ----------
restore_configs() {
  local bk src
  bk=$(find_backup "${1:-}") || die "No backup with a boot-configs folder was found. Plug in the backup drive and run  sudo drives, or give the folder:  sudo homelab-restore-configs /path/to/backup"
  src="$bk/boot-configs"
  say "Backup: $bk"
  say "  $(backup_age "$bk")"
  say ""
  if [ "$PREVIEW_ONLY" != 1 ] && docker_ok && [ -n "$(docker ps -q 2>/dev/null)" ] && [ "$ROOT" = "" ]; then
    warn "Docker has running containers. This tool is meant for a freshly installed server."
    yn "Continue anyway?" || { say "Cancelled. Nothing was changed."; return 1; }
  fi
  say "Checking what would be copied (nothing is copied yet)..."
  preview "$src/" "$ROOT/" "${EXCLUDES[@]}"
  if [ $((NEW_N + CHG_N)) -eq 0 ]; then
    say "Nothing to restore: every saved config file is already in place."
    cleanup_preview; return 0
  fi
  say ""
  say "New files (not on this server yet): $NEW_N"
  say "Files that exist here and differ (they would be REPLACED by the backup copy): $CHG_N"
  say "Total size to copy: $(human "$BYTES")"
  say ""
  show_names "$NEW_LIST" "New files"
  show_names "$CHG_LIST" "Would be replaced"
  say ""
  if [ "$PREVIEW_ONLY" = 1 ]; then
    say "Preview only. Nothing was copied. (Files that differ are normal on a server that is running: they changed after the backup.)"
    cleanup_preview; return 0
  fi
  say "What this will and will not do:"
  say "  - It does not touch /etc/fstab, /usr/local/ (the scripts), the crontab or Docker's own folders."
  say "  - It deletes nothing. Owners and permissions are kept as they were in the backup."
  say "  - The files are as old as the last backup."
  typed RESTORE "Type RESTORE (capitals) to copy these $((NEW_N + CHG_N)) files: " || { say "Cancelled. Nothing was copied."; cleanup_preview; return 1; }
  cleanup_preview
  say "Copying..."
  if ! rsync -aH --numeric-ids "${EXCLUDES[@]}" "$src/" "$ROOT/"; then
    log "restore of config files from $bk FAILED"
    die "The copy reported an error. Run the command again; it only copies what is missing or different."
  fi
  log "restored config files from $bk ($((NEW_N + CHG_N)) files)"
  [ "$ROOT" != "" ] || systemctl daemon-reload 2>/dev/null || true
  say ""
  say "Done. Next steps:"
  say "  - Compare the saved crontab with the one on this server:"
  say "      sudo cat $bk/boot-configs/root-crontab.txt"
  say "      sudo crontab -l"
  if [ -d "$src/var/lib/docker/volumes" ]; then
    say "  - Docker volumes saved in the backup (restore each one after its stack is deployed):"
    ( cd "$src/var/lib/docker/volumes" && for d in */; do [ -d "$d" ] && say "      sudo homelab-restore-configs volume ${d%/}"; done )
  fi
  return 0
}

# ---------- list and restore Docker volumes ----------
vol_dir() { echo "$1/boot-configs/var/lib/docker/volumes"; }

list_volumes() {
  local bk d
  bk=$(find_backup "${1:-}") || die "No backup with a boot-configs folder was found."
  [ -d "$(vol_dir "$bk")" ] || { say "The backup at $bk holds no Docker volumes."; return 0; }
  say "Docker volumes saved in $bk:"
  for d in "$(vol_dir "$bk")"/*/; do [ -d "$d" ] && say "  $(basename "$d")"; done
  return 0
}

restore_volume() {   # restore_volume NAME [backup]
  local name=${1:-} bk src dst
  [ -n "$name" ] || die "Give the volume name. List them with:  sudo homelab-restore-configs list"
  [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || die "That is not a valid volume name."
  bk=$(find_backup "${2:-}") || die "No backup with a boot-configs folder was found."
  src="$(vol_dir "$bk")/$name"
  [ -d "$src" ] || die "The backup holds no volume called $name. List them with:  sudo homelab-restore-configs list"
  dst="$ROOT/var/lib/docker/volumes/$name"
  [ -d "$dst" ] || die "The volume $name does not exist on this server yet. Deploy its stack in Portainer first (with the same stack name), then run this again."
  say "Volume: $name"
  say "Backup: $bk"
  say "  $(backup_age "$bk")"
  say ""
  say "Checking what would be copied (nothing is copied yet)..."
  preview "$src/" "$dst/"
  if [ $((NEW_N + CHG_N)) -eq 0 ]; then
    say "Nothing to restore: the volume already matches the backup."
    cleanup_preview; return 0
  fi
  say ""
  say "New files: $NEW_N"
  say "Files that differ (they would be REPLACED): $CHG_N"
  say "Total size to copy: $(human "$BYTES")"
  say ""
  show_names "$NEW_LIST" "New files"
  show_names "$CHG_LIST" "Would be replaced"
  say ""
  say "The containers that use this volume are stopped while the files are copied, then started again."
  typed RESTORE "Type RESTORE (capitals) to copy these $((NEW_N + CHG_N)) files: " || { say "Cancelled. Nothing was copied."; cleanup_preview; return 1; }
  cleanup_preview
  stop_for_volume "$name"
  if ! rsync -aH --numeric-ids "$src/" "$dst/"; then
    log "restore of volume $name FAILED"
    warn "The copy reported an error. The containers stay stopped: ${STOPPED:-none}"
    say "Run the command again, or start them yourself:  docker start ${STOPPED:-NAME}"
    return 1
  fi
  log "restored volume $name from $bk"
  start_stopped
  say ""
  say "Done. Check the service, for example in the Homepage dashboard or with:  docker ps"
  return 0
}

case "${1:-}" in
  ""|restore) restore_configs "${2:-}" ;;
  check)      PREVIEW_ONLY=1; restore_configs "${2:-}" ;;
  list)       list_volumes "${2:-}" ;;
  volume)     restore_volume "${2:-}" "${3:-}" ;;
  version|--version) echo "homelab-restore-configs $VERSION" ;;
  help|--help|-h) usage ;;
  /*)         restore_configs "$1" ;;
  *) usage >&2; exit 1 ;;
esac
