THEME_IDS = [t["id"] for t in LOOK_THEMES]


def slugify(text):
    """The name tag custom.js gives a group or a bookmark (data-group, data-bm)."""
    return re.sub(r"^-+|-+$", "", re.sub(r"[^a-z0-9]+", "-", str(text or "").lower()))


def clean_map(raw, what, limit, key_ok, value_fn):
    if raw is None or raw == {}:
        return {}
    if not isinstance(raw, dict) or len(raw) > limit:
        raise Fail("%s are not understood (too many?)." % what)
    out = {}
    for k, val in raw.items():
        k = clean_text(k, "A name", 60)
        if not key_ok(k):
            raise Fail("The name '%s' has characters that are not allowed here." % k)
        got = value_fn(val, k)
        if got:
            out[k] = got
    return out


NAME_KEYS = {"homelab": "HomeLab", "main": "Main Pool", "backup": "Backup Pool"}       # what a person can rename (the key -> the shipped name)
LOGO_DATA_MAX = 150_000                                                              # the size of an uploaded logo, as text (the browser shrinks the picture first)
LOGO_SIZE = (24, 96)


def names_clean(raw):
    if raw in (None, {}):
        return {}
    if not isinstance(raw, dict):
        raise Fail("The names are not understood.")
    out = {}
    for k, val in raw.items():
        if k not in NAME_KEYS:
            raise Fail("The name '%s' is not one that can be changed." % k)
        val = re.sub(r"\s+", " ", val.strip()) if isinstance(val, str) else ""
        if not val or val == NAME_KEYS[k]:
            continue
        if len(val) > 24:
            raise Fail("A name can have up to 24 characters.")
        if re.search(r"[\x00-\x1f\x7f\"\\<>{}`]", val):
            raise Fail("A name cannot have these characters:  \" \\ < > { } `  or line breaks.")
        out[k] = val
    return out


def logo_clean(raw):
    """The logo: `src` (a web address of a picture, or the picture itself as a data: address that the browser made), `link` (optional), `size` (height in pixels) and `off` (kept, not shown)."""
    if raw in (None, {}):
        return {}
    if not isinstance(raw, dict):
        raise Fail("The logo is not understood.")
    src = raw.get("src") or ""
    if not isinstance(src, str):
        raise Fail("The logo picture is not understood.")
    src = src.strip()
    if not src:
        return {}
    if src.startswith("data:"):
        m = re.fullmatch(r"data:image/(png|jpeg|webp|gif);base64,([A-Za-z0-9+/]+={0,2})", src)
        if not m or len(src) > LOGO_DATA_MAX:
            raise Fail("That logo picture is too big or not a picture the dashboard can show. Choose a smaller PNG, JPG, WebP or GIF.")
        try:
            data = base64.b64decode(m.group(2), validate=True)
        except (ValueError, binascii.Error):
            raise Fail("That logo picture is damaged. Choose it again.") from None
        if sniff_image(data) not in (".png", ".jpg", ".webp", ".gif"):
            raise Fail("That file is not a picture I can use as a logo.")
    else:
        src = clean_url(src, "The logo address", False)
        if "\\" in src:
            raise Fail("The logo address has a character that is not allowed.")
    out = {"src": src}
    if raw.get("off"):
        out["off"] = True                              # the logo is kept but not shown
    link = clean_url(raw.get("link"), "The logo link")
    if link:
        if "\\" in link:
            raise Fail("The logo link has a character that is not allowed.")
        out["link"] = link
    if raw.get("size") not in (None, ""):
        size = number(raw["size"], "The logo size", LOGO_SIZE[0], LOGO_SIZE[1])
        if size != 48:
            out["size"] = size
    return out


def look_clean(raw):
    """The look a person asked for, checked; only the values that differ from the default are kept."""
    if not isinstance(raw, dict):
        raise Fail("The look is missing.")
    out = {}
    if "accent" in raw:
        out["accent"] = rgb_hex(hex_rgb(raw["accent"], "main color"))
    if "glass" in raw:
        out["glass"] = rgb_hex(hex_rgb(raw["glass"], "glass color"))
    if "glassOpacity" in raw:
        out["glassOpacity"] = number(raw["glassOpacity"], "How solid the glass is", 0, 100)
    if "glassClear" in raw:
        out["glassClear"] = bool(raw["glassClear"])
    if "glassLevel" in raw:
        out["glassLevel"] = number(raw["glassLevel"], "How transparent the glass is", 0, 100)
    if "radius" in raw:
        out["radius"] = number(raw["radius"], "How round the corners are", 0, 40)
    if "edge" in raw:
        out["edge"] = number(raw["edge"], "The edge brightness", 0, 40)
    if "side" in raw:
        out["side"] = number(raw["side"], "The space at the sides", 0, 120)
    if "glassBlur" in raw:
        out["glassBlur"] = number(raw["glassBlur"], "How much the glass blurs", 0, 60)
    if "glassSat" in raw:
        out["glassSat"] = number(raw["glassSat"], "How vivid the picture behind the glass is", 50, 300)
    if "theme" in raw:
        if raw["theme"] not in THEME_IDS:
            raise Fail("The theme is not understood.")
        out["theme"] = raw["theme"]
    if "playerHeight" in raw:
        out["playerHeight"] = number(raw["playerHeight"], "The height of the music player", 240, 1000)
    if "paintStrength" in raw:
        out["paintStrength"] = number(raw["paintStrength"], "How strong the colors are", 0, 100)
    if "paintStyle" in raw:
        if raw["paintStyle"] not in PAINT_STYLES:
            raise Fail("The color style is not understood.")
        out["paintStyle"] = raw["paintStyle"]
    if "labelIcon" in raw:
        if raw["labelIcon"] not in LABEL_ICONS:
            raise Fail("The label icon style is not understood.")
        out["labelIcon"] = raw["labelIcon"]
    if raw.get("paintAll"):
        out["paintAll"] = rgb_hex(hex_rgb(raw["paintAll"], "color for everything"))
    for key, fn in (("names", names_clean), ("logo", logo_clean)):
        got = fn(raw.get(key))
        if got:
            out[key] = got
    tabs = raw.get("tabs") or {}
    if not isinstance(tabs, dict) or len(tabs) > 30:
        raise Fail("The tab colors are not understood.")
    tt = {}
    for name, col in tabs.items():
        name = clean_text(name, "A tab name", 40)
        if not re.fullmatch(r"[^\"'\\{};<>/*]+", name):
            raise Fail("The tab name '%s' has characters that are not allowed." % name)
        if col:
            tt[name] = rgb_hex(hex_rgb(col, "color of the tab " + name))
    if tt:
        out["tabs"] = tt
    color_of = lambda val, k: rgb_hex(hex_rgb(val, "color of " + k)) if val else ""
    cards = clean_map(raw.get("cards"), "The card colors", 200, lambda k: re.fullmatch(r"[A-Za-z0-9_-]{1,60}", k) is not None, color_of)
    links = clean_map(raw.get("links"), "The bookmark colors", 400, lambda k: slugify(k) != "", color_of)

    def label_of(val, k):
        if not isinstance(val, dict):
            raise Fail("The colors of the label '%s' are not understood." % k)
        d = {}
        for part in ("text", "icon"):
            if val.get(part):
                d[part] = rgb_hex(hex_rgb(val[part], "%s color of the label %s" % (part, k)))
        return d
    labels = clean_map(raw.get("labels"), "The label colors", 60, lambda k: slugify(k) != "", label_of)
    for key, val in (("cards", cards), ("links", links), ("labels", labels)):
        if val:
            out[key] = val
    keep = ("tabs", "cards", "links", "labels", "paintAll", "names", "logo")
    return {k: v for k, v in out.items() if k in keep or v != LOOK_DEFAULT[k]}


def look_full(custom):
    v = dict(LOOK_DEFAULT)
    v.update({k: x for k, x in custom.items() if k not in ("tabs", "cards", "links", "labels", "names", "logo")})
    tabs = dict(SHIPPED_TAB_COLORS)
    tabs.update(custom.get("tabs") or {})
    v["tabs"] = tabs
    for k in ("cards", "links", "labels", "names", "logo"):
        v[k] = dict(custom.get(k) or {})
    return v


def num(x, places=3):
    return ("%.*f" % (places, x)).rstrip("0").rstrip(".") or "0"


def glass_alpha(v):
    """How solid the glass is: the slider, or, when the glass is set to transparent, a level (100 = clear)."""
    if v["glassClear"]:
        return 0.4 * (1 - v["glassLevel"] / 100.0)
    return v["glassOpacity"] / 100.0


def shipped_accent(css, key):
    """The --accent a card or tile has in the part of custom.css that is not the look block (the shipped colors), or None."""
    before, _block, after = css_look_split(css)
    for text in (before, after):
        for m in re.finditer(r"(?m)^([^{}\n/]*)\{\s*--accent:\s*(\d+,\s*\d+,\s*\d+)\s*;?\s*\}", text):
            if "#" + key in [x.strip() for x in m.group(1).split(",")]:
                return m.group(2)
    return None


def shipped_group_accent(css, slug):
    """The --accent a bookmark group has in the part of custom.css that is not the look block, or None."""
    before, _block, after = css_look_split(css)
    for text in (before, after):
        for m in re.finditer(r'\[data-group="%s"\]\s*\{\s*--accent:\s*(\d+,\s*\d+,\s*\d+)\s*;?\s*\}' % re.escape(slug), text):
            return m.group(1)
    return None


def rgb_to_hex(txt):
    r, g, b = [int(x) for x in txt.split(",")]
    return rgb_hex((r, g, b))


WRAP = "html body #inner_wrapper"


def paint_vars(rgbs, t, style):
    """The color of one painted card, tile or bookmark: its color and how strong the fill is (the page's CSS draws the fill from these three values).
    A gradient is strong on one side and fades out; solid is the same strength everywhere."""
    k = t ** 0.8                                       # 0 = no color at all; 40 is the strength the page's own CSS has when nothing is set
    if style == "solid":
        a1 = a2 = num(0.72 * k)
    else:
        a1, a2 = num(0.9 * k), num(0.22 * k)
    return "--accent:%s;--hl-a1:%s;--hl-a2:%s;" % (rgbs, a1, a2)


RESET_VARS = "--hl-a1:initial;--hl-a2:initial;"


def paint_decl(rgbs, t):
    """The edge of one painted card: a colored border and a soft glow around it."""
    return ("border-color:rgba(%s,%s)!important;"
            "box-shadow:0 0 0 1px rgba(%s,%s),0 0 24px -6px rgba(%s,%s),0 14px 30px -20px rgba(0,0,0,.75)!important;" % (
                rgbs, num(0.30 + 0.5 * t), rgbs, num(0.10 + 0.25 * t), rgbs, num(0.15 + 0.6 * t)))


PLAIN_DECL = "border-color:var(--lk-line)!important;box-shadow:0 14px 30px -20px rgba(0,0,0,.75)!important;"


def paint_rules(v, saved, css):
    """Rules for the colors of cards, tiles and bookmarks. With `saved` (the look on the page now) the things that were painted and are not any more
    get rules that put them back, so a preview shows a removed color at once."""
    t = v["paintStrength"] / 100.0
    st = v["paintStyle"]
    rules = []
    allc = "%d, %d, %d" % hex_rgb(v["paintAll"]) if v.get("paintAll") else None
    cards_all = WRAP + " .service" + "".join(':not([id="%s"])' % x for x in NO_PAINT)     # (an attribute test is weaker than an id, so a card of its own color wins)
    glob_was = saved is not None and (look_full(saved)["paintStrength"] != LOOK_DEFAULT["paintStrength"] or look_full(saved)["paintStyle"] != "gradient")
    if v["paintStrength"] != LOOK_DEFAULT["paintStrength"] or st != "gradient":
        # the strength and the style also work on the cards, tiles and bookmarks that keep their own default color
        al = paint_vars("0", t, st).split(";", 1)[1]
        rules.append("%s{%s}%s .bookmark>a{%s}" % (cards_all, al, WRAP, al))
    elif glob_was:
        rules.append("%s{%s}%s .bookmark>a{%s}" % (cards_all, RESET_VARS, WRAP, RESET_VARS))

    def card(cid, c):
        return "%s #%s{%s}%s #%s .service-card{%s}" % (WRAP, cid, paint_vars(c, t, st), WRAP, cid, paint_decl(c, t))

    def mark(sl, c):
        return '%s .bookmark>a[data-bm="%s"]{%s%s}' % (WRAP, sl, paint_vars(c, t, st), paint_decl(c, t))
    if allc:
        rules.append("%s{%s}%s .service-card{%s}" % (cards_all, paint_vars(allc, t, st), cards_all, paint_decl(allc, t)))
        rules.append("%s .bookmark>a{%s%s}" % (WRAP, paint_vars(allc, t, st), paint_decl(allc, t)))
    for cid in sorted(v["cards"]):
        rules.append(card(cid, "%d, %d, %d" % hex_rgb(v["cards"][cid])))
    for name in sorted(v["links"]):
        rules.append(mark(slugify(name), "%d, %d, %d" % hex_rgb(v["links"][name])))
    if saved is not None:
        was = look_full(saved)
        for cid in sorted(set(was["cards"]) - set(v["cards"])):
            if allc:
                rules.append(card(cid, allc))
            else:
                acc = shipped_accent(css, cid) or ("148, 163, 184" if cid.startswith(("stat-", "cal-")) else "var(--lk-accent)")
                rules.append("%s #%s{--accent:%s;%s}%s #%s .service-card{%s}" % (WRAP, cid, acc, RESET_VARS, WRAP, cid, PLAIN_DECL))
        have = {slugify(n) for n in v["links"]}
        for name in sorted(was["links"]):
            if slugify(name) not in have:
                if allc:
                    rules.append(mark(slugify(name), allc))
                else:
                    rules.append('%s .bookmark>a[data-bm="%s"]{--accent:inherit;%s%s}' % (WRAP, slugify(name), RESET_VARS, PLAIN_DECL))
        if was.get("paintAll") and not allc:
            rules.append("%s{%s}%s .service-card{%s}" % (cards_all, RESET_VARS, cards_all, PLAIN_DECL))
            rules.append("%s .bookmark>a{--accent:inherit;%s%s}" % (WRAP, RESET_VARS, PLAIN_DECL))
    return rules


def label_rules(v, saved):
    rules = []
    for name in sorted(v["labels"]):
        sl = slugify(name)
        d = v["labels"][name]
        sel = '%s [data-group="%s"]' % (WRAP, sl)
        if d.get("text"):
            rules.append("%s .service-group-name,%s .bookmark-group-name{color:%s!important}" % (sel, sel, d["text"]))
        if d.get("icon"):
            rules.append("%s{--icon-color:%s;--hl-label:%d, %d, %d}" % ((sel, d["icon"]) + hex_rgb(d["icon"])))
    if saved is not None:
        for name in sorted(look_full(saved)["labels"]):
            now = v["labels"].get(name, {})
            sel = '%s [data-group="%s"]' % (WRAP, slugify(name))
            was = look_full(saved)["labels"][name]
            if was.get("text") and not now.get("text"):
                rules.append("%s .service-group-name,%s .bookmark-group-name{color:var(--lk-text)!important}" % (sel, sel))
            if was.get("icon") and not now.get("icon"):
                rules.append("%s{--icon-color:#c9d6f2;--hl-label:var(--lk-accent)}" % sel)
    style = v["labelIcon"]
    icons = ".service-group-icon,%s .bookmark-group-icon" % WRAP
    ring = "rgba(var(--hl-label,var(--lk-accent)),"
    if style == "circle":
        rules.append("%s %s{box-sizing:content-box;padding:6px;border-radius:50%%;background:%s.20)}" % (WRAP, icons, ring))
    elif style == "square":
        rules.append("%s %s{box-sizing:content-box;padding:6px;border-radius:10px;background:%s.20)}" % (WRAP, icons, ring))
    elif style == "ring":
        rules.append("%s %s{box-sizing:content-box;padding:5px;border-radius:50%%;border:1.5px solid %s.75);box-shadow:0 0 12px %s.45)}" % (WRAP, icons, ring, ring))
    elif saved is not None and look_full(saved)["labelIcon"] != "plain":
        rules.append("%s %s{padding:0;border-radius:0;background:none;border:0;box-shadow:none}" % (WRAP, icons))
    return rules


def look_css(custom, full=False, saved=None, css=""):
    """The rules of the look block for a look (only what differs from the default). `full` writes every value, for a preview in front of a saved look
    (then `saved` is the look on the page now and `css` its custom.css)."""
    if not custom and not full and saved is None:
        return ""
    v = look_full(custom)
    rules = []
    tok = []
    if full or "accent" in custom:
        tok.append("--lk-accent: %d, %d, %d;" % hex_rgb(v["accent"]))
    if full or "glass" in custom:
        tok.append("--lk-glass: %d, %d, %d;" % hex_rgb(v["glass"]))
    if full or "glassOpacity" in custom or "glassClear" in custom or "glassLevel" in custom:
        tok.append("--lk-glass-a: %s;" % num(glass_alpha(v)))
    if full or "radius" in custom:
        tok.append("--lk-radius: %dpx;" % v["radius"])
    if full or "edge" in custom:
        tok.append("--lk-line: rgba(255, 255, 255, %s);" % num(v["edge"] / 100.0))
    if full or "side" in custom:
        tok.append("--lk-side: %dpx;" % v["side"])
    if full or "glassBlur" in custom:
        tok.append("--lk-blur: %spx;" % num(v["glassBlur"]))
    if full or "glassSat" in custom:
        tok.append("--lk-sat: %s%%;" % num(v["glassSat"]))
    if full or "playerHeight" in custom:
        tok.append("--lk-player-h: %dpx;" % v["playerHeight"])
    if not full:                       # (a preview of names and logo is sent to the dashboard as its own message: the page cannot take them as CSS)
        for k, val in sorted((custom.get("names") or {}).items()):
            tok.append('--hl-name-%s: "%s";' % (k, val))
        lg = custom.get("logo") or {}
        if lg.get("src") and not lg.get("off"):
            tok.append('--hl-logo-src: "%s";' % lg["src"])
            if lg.get("link"):
                tok.append('--hl-logo-link: "%s";' % lg["link"])
            tok.append("--hl-logo-size: %spx;" % num(lg.get("size", 48)))
    if tok:
        rules.append("html body #inner_wrapper { %s }" % " ".join(tok))
    # a color for a tab: the tab rules of the tabs block are more specific than the one above, so each tab gets its own line
    tabs = v["tabs"] if full else (custom.get("tabs") or {})
    for name in sorted(tabs):
        rules.append('html[data-tab="%s"] body #inner_wrapper { --lk-accent: %d, %d, %d; }' % ((name,) + hex_rgb(tabs[name])))
    if full or "playerHeight" in custom:
        ph = max(240, v["playerHeight"] - 40)
        rules.append("@media (max-width: 700px) { html body #inner_wrapper { --lk-player-h: %dpx; } }" % ph)
    rules += paint_rules(v, saved, css) + label_rules(v, saved)
    return "\n".join(rules)


def look_block(custom):
    if not custom:
        return ""
    data = json.dumps(custom, sort_keys=True, separators=(",", ":")).replace("*/", "*\\/")
    return "%s written by the control panel. Remove it with the Reset button there (or delete this block). */\n/* data: %s */\n%s\n%s\n" % (
        LOOK_B1, data, look_css(custom), LOOK_B2)


def css_look_split(text):
    """(text before the block, the block or '', text after the block)"""
    a = text.find(LOOK_B1)
    if a < 0:
        return text, "", ""
    b = text.find(LOOK_B2, a)
    if b < 0:
        return text, "", ""
    end = b + len(LOOK_B2)
    if text[end:end + 1] == "\n":
        end += 1
    return text[:a], text[a:end], text[end:]


def look_get(css=None):
    css = read(CSS) if css is None else css
    block = css_look_split(css)[1]
    m = re.search(r"/\* data: (.*?) \*/", block)
    if not m:
        return {}
    try:
        data = json.loads(m.group(1).replace("*\\/", "*/"))
        return look_clean(data)
    except (ValueError, Fail):
        return {}


def css_with_look(css, custom):
    """custom.css with the look block replaced (or added in front of the theme block, or at the end)."""
    before, block, after = css_look_split(css)
    new = look_block(custom)
    if block:
        return before + new + after
    if not new:
        return css
    t = css.find(THEME_B1)
    if t >= 0:
        return css[:t].rstrip("\n") + "\n\n" + new + "\n" + css[t:]
    return css.rstrip("\n") + "\n\n" + new


def look_tab_names():
    return [t["name"] for t in layout_tabs(layout_groups(read(SETTINGS)))]


def look_state():
    custom = look_get()
    return {"custom": custom, "values": look_full(custom), "defaults": look_full({}), "themes": LOOK_THEMES,
            "tabNames": look_tab_names()}


def api_look_save(body):
    custom = look_clean(body.get("look"))
    tx = Tx("Look changed")
    tx.put(CSS, css_with_look(tx.get(CSS), custom))
    tx.commit()
    return {}


def api_look_css(body):
    """The rules for a preview of a look that is not saved yet (the page puts them over the saved look)."""
    custom = look_clean(body.get("look"))
    css = read(CSS)
    return {"css": look_css(custom, full=True, saved=look_get(css), css=css)}


def api_look_reset(body):
    tx = Tx("Look reset")
    tx.put(CSS, css_with_look(tx.get(CSS), {}))
    tx.commit()
    return {}


# ================================================================ the background (settings.yaml: background:)
BG_KEYS = ("image", "blur", "saturate", "brightness", "opacity")
BG_DEFAULT = {"blur": "md", "saturate": 60, "brightness": 42, "opacity": 80}
BLURS = ("sm", "md", "lg", "xl", "2xl", "3xl")
IMG_TYPES = {b"\xff\xd8\xff": ".jpg", b"\x89PNG\r\n\x1a\n": ".png", b"GIF8": ".gif"}


def bg_block(lines):
    for i, l in enumerate(lines):
        if re.match(r"^background:\s*(#.*)?$", l):
            j = i + 1
            while j < len(lines) and (lines[j].startswith((" ", "\t")) or (lines[j].strip() == "" and j + 1 < len(lines) and lines[j + 1].startswith(" "))):
                j += 1
            return i, j
    return None, None


def bg_get(text):
    lines = text.split("\n")
    i, j = bg_block(lines)
    d = {}
    if i is None:
        return d
    for l in lines[i + 1:j]:
        m = re.match(r"^\s+([A-Za-z0-9_]+):\s*(.*?)\s*$", l)
        if m:
            d[m.group(1)] = unq(m.group(2))
    return d


def bg_set(text, key, value):
    """Set (or, with value None, remove) one key of the background: block."""
    lines = text.split("\n")
    i, j = bg_block(lines)
    new = "  %s: %s" % (key, "'" + str(value).replace("'", "''") + "'" if key == "image" else value)
    if i is None:
        if value is None:
            return text
        return text.rstrip("\n") + "\n\nbackground:\n%s\n" % new
    for k in range(i + 1, j):
        if re.match(r"^\s+%s:" % re.escape(key), lines[k]):
            if value is None:
                del lines[k]
            else:
                lines[k] = new
            return "\n".join(lines)
    if value is not None:
        lines.insert(j, new)
    return "\n".join(lines)


def images_mounted():
    if NO_DOCKER:
        return None
    try:
        r = subprocess.run(["docker", "inspect", "homepage", "--format", "{{range .Mounts}}{{.Destination}} {{end}}"],
                           capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        return None
    return ("/app/public/images" in r.stdout.split()) if r.returncode == 0 else None


def bg_state():
    d = bg_get(read(SETTINGS))
    return {"image": d.get("image", ""), "blur": d.get("blur", ""), "saturate": int(d.get("saturate") or 100), "brightness": int(d.get("brightness") or 100),
            "opacity": int(d.get("opacity") or 100), "defaults": BG_DEFAULT, "mounted": images_mounted(), "homepageUrl": HOMEPAGE_URL,
            "blurs": list(BLURS)}


def bg_numbers(body, tx_text):
    text = tx_text
    if "blur" in body:
        b = body["blur"]
        if b in (None, "", "none"):
            text = bg_set(text, "blur", None)
        elif b in BLURS:
            text = bg_set(text, "blur", b)
        else:
            raise Fail("The blur must be none or one of: %s." % ", ".join(BLURS))
    for k in ("saturate", "brightness", "opacity"):
        if k in body:
            text = bg_set(text, k, number(body[k], k.capitalize(), 0, 100))
    return text


def api_bg_save(body):
    tx = Tx("Background changed")
    text = tx.get(SETTINGS)
    if body.get("url"):
        text = bg_set(text, "image", clean_url(body["url"], "The picture address", False))
    text = bg_numbers(body, text)
    tx.put(SETTINGS, text)
    tx.commit()
    return {}


def api_bg_reset(body):
    tx = Tx("Background sliders reset")
    text = tx.get(SETTINGS)
    text = bg_set(text, "blur", BG_DEFAULT["blur"])
    for k in ("saturate", "brightness", "opacity"):
        text = bg_set(text, k, BG_DEFAULT[k])
    tx.put(SETTINGS, text)
    tx.commit()
    return {}


def sniff_image(data):
    for magic, ext in IMG_TYPES.items():
        if data.startswith(magic):
            return ext
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return ".webp"
    if data[4:12] in (b"ftypavif", b"ftypavis"):
        return ".avif"
    return None


def restart_homepage():
    """Homepage only serves a new local picture after a restart. Done in the background; the panel does not wait."""
    if NO_DOCKER:
        return False

    def go():
        try:
            subprocess.run(["docker", "restart", "homepage"], capture_output=True, timeout=120)
        except (OSError, subprocess.SubprocessError):
            pass
    threading.Thread(target=go, daemon=True).start()
    return True


def api_bg_upload(data):
    ext = sniff_image(data)
    if not ext:
        raise Fail("That file is not a picture I can use. Choose a .jpg, .png, .webp, .gif or .avif file.")
    os.makedirs(IMAGES, exist_ok=True)
    name = "background-%s%s" % (time.strftime("%Y%m%d%H%M%S"), ext)
    with open(os.path.join(IMAGES, name), "wb") as f:
        f.write(data)
    os.chmod(os.path.join(IMAGES, name), 0o644)
    tx = Tx("Background picture changed")
    tx.put(SETTINGS, bg_set(tx.get(SETTINGS), "image", "/images/" + name))
    tx.commit()
    for old in os.listdir(IMAGES):                      # earlier uploads are not needed any more (Undo only brings back the setting)
        if re.fullmatch(r"background-\d{14}\.\w+", old) and old != name:
            try:
                if len([x for x in os.listdir(IMAGES) if x.startswith("background-")]) > 3:
                    os.remove(os.path.join(IMAGES, old))
            except OSError:
                pass
    return {"restarting": restart_homepage(), "image": "/images/" + name}


# ================================================================ layout: tabs, groups, their order (settings.yaml: layout:)
AUTOMATIC = {"At a Glance", "Music Library", "Library Totals", "Storage", "Backup & Updates", "Folder Sizes", "Calendar"}     # made by the lab's scripts
PROTECTED = {"Customize", "Edit Links", "Terminal"}          # the panel itself (the Customize tab and the link editor of the Links tab): it can be moved, but not removed


def layout_span(lines):
    i = next((k for k, l in enumerate(lines) if re.match(r"^layout:\s*(#.*)?$", l)), None)
    if i is None:
        return None, None
    j = i + 1
    while j < len(lines) and (lines[j].startswith((" ", "\t")) or not lines[j].strip()):
        j += 1
    while j > i + 1 and not lines[j - 1].strip():
        j -= 1
    return i, j


def layout_groups(text):
    """[{name, props: {tab, icon, style, columns, ...}, extra: [lines]}] in the order of the file."""
    lines = text.split("\n")
    i, j = layout_span(lines)
    out = []
    if i is None:
        return out
    cur = None
    for l in lines[i + 1:j]:
        m = re.match(r"^  (?! )(.+?):\s*$", l)
        if m and not l.lstrip().startswith("#"):
            cur = {"name": unq(m.group(1)), "props": {}, "extra": []}
            out.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"^    ([A-Za-z0-9_]+):\s*(.*?)\s*$", l)
        if m:
            cur["props"][m.group(1)] = unq(m.group(2))
        elif l.strip():
            cur["extra"].append(l)
    return out


def layout_tabs(groups):
    tabs = []
    for g in groups:
        t = g["props"].get("tab") or "Home"
        tab = next((x for x in tabs if x["name"] == t), None)
        if not tab:
            tab = {"name": t, "groups": []}
            tabs.append(tab)
        tab["groups"].append(g)
    return tabs


def layout_write(text, groups):
    lines = text.split("\n")
    i, j = layout_span(lines)
    block = ["layout:"]
    for g in groups:
        block.append("  %s:" % yq(g["name"]))
        p = dict(g["props"])
        for k in ("tab", "icon", "style", "columns"):
            if p.get(k) not in (None, ""):
                block.append("    %s: %s" % (k, p[k] if k in ("style", "columns") else yq(p[k])))
        for k, v in p.items():
            if k not in ("tab", "icon", "style", "columns") and v != "":
                block.append("    %s: %s" % (k, v))
        block.extend(g["extra"])
    if i is None:
        return text.rstrip("\n") + "\n\n" + "\n".join(block) + "\n"
    return "\n".join(lines[:i] + block + lines[j:])


def group_kinds():
    kinds = {}
    for g in services_parse(read(SERVICES).split("\n")):
        kinds.setdefault(g["name"], set()).add("services")
    for g in marks_parse(read(BOOKMARKS))[1]:
        kinds.setdefault(g["name"], set()).add("bookmarks")
    return kinds


def layout_state():
    text = read(SETTINGS)
    groups = layout_groups(text)
    kinds = group_kinds()
    svc = {g["name"]: len(g["cards"]) for g in services_parse(read(SERVICES).split("\n"))}
    bm = {g["name"]: len(g["links"]) for g in marks_parse(read(BOOKMARKS))[1]}
    listed = {g["name"] for g in groups}
    # a group that is in services.yaml or bookmarks.yaml but not in the layout is shown on every tab by Homepage: list it as part of the first tab
    extra = [n for n in list(svc) + list(bm) if n not in listed]
    for n in dict.fromkeys(extra):
        groups.append({"name": n, "props": {"tab": (layout_tabs(groups)[0]["name"] if groups else "Home")}, "extra": [], "unlisted": True})
    tabs = []
    for t in layout_tabs(groups):
        tabs.append({"name": t["name"], "groups": [{
            "name": g["name"], "icon": g["props"].get("icon", ""), "style": g["props"].get("style", ""), "columns": g["props"].get("columns", ""),
            "kind": "+".join(sorted(kinds.get(g["name"], ()))) or "empty", "locked": g["name"] in AUTOMATIC or g["name"] in PROTECTED,
            "automatic": g["name"] in AUTOMATIC, "count": svc.get(g["name"], 0) + bm.get(g["name"], 0)} for g in t["groups"]]})
    return {"tabs": tabs}


def api_layout_save(body):
    want = body.get("tabs")
    if not isinstance(want, list) or not want or len(want) > 12:
        raise Fail("The layout is missing.")
    tx = Tx("Layout changed")
    text = tx.get(SETTINGS)
    cur = layout_groups(text)
    state = {g["name"]: g for g in cur}
    for n in group_kinds():
        if n not in state:
            state[n] = {"name": n, "props": {}, "extra": []}
    out, seen = [], set()
    names = set()
    for t in want:
        tname = clean_text(t.get("name"), "A tab name", 24)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#]+", tname):
            raise Fail("The tab name '%s' has characters that are not allowed." % tname)
        if tname in names:
            raise Fail("Two tabs are called '%s'." % tname)
        names.add(tname)
        for g in t.get("groups") or []:
            n = g.get("name")
            if n not in state or n in seen:
                raise Fail("The group '%s' is not known (or is listed twice). Reload the panel and try again." % n)
            seen.add(n)
            o = state[n]
            props = dict(o["props"])
            props["tab"] = tname
            icon = clean_icon(g.get("icon", props.get("icon", "")))
            if icon:
                props["icon"] = icon
            else:
                props.pop("icon", None)
            style = g.get("style", props.get("style", ""))
            if style not in ("", "row", "column"):
                raise Fail("The style must be 'row' or 'column'.")
            if style:
                props["style"] = style
            else:
                props.pop("style", None)
            cols = g.get("columns", props.get("columns", ""))
            if cols in ("", None):
                props.pop("columns", None)
            else:
                props["columns"] = str(number(cols, "The number of columns", 1, 8))
            out.append({"name": n, "props": props, "extra": o["extra"]})
    missing = [n for n in state if n not in seen and (n in {g["name"] for g in cur} or n in group_kinds())]
    if missing:
        raise Fail("These groups are missing from the layout: %s. Reload the panel and try again." % ", ".join(missing))
    tx.put(SETTINGS, layout_write(text, out))
    tx.commit()
    return {}


# ================================================================ cards (services.yaml): line based, so widgets and secrets are never touched
def services_parse(lines):
    """[{name, start, end, cards: [{name, start, end}]}] with line numbers; end is exclusive."""
    heads = [(i, re.match(r"^- (.+?):\s*$", l)) for i, l in enumerate(lines)]
    heads = [(i, unq(m.group(1))) for i, m in heads if m]
    groups = []
    for n, (i, name) in enumerate(heads):
        e = heads[n + 1][0] if n + 1 < len(heads) else len(lines)
        g = {"name": name, "start": i, "end": e, "cards": []}
        cards = [(k, re.match(r"^    - (.+?):\s*$", lines[k])) for k in range(i + 1, e)]
        cards = [(k, unq(m.group(1))) for k, m in cards if m]
        for c, (k, cn) in enumerate(cards):
            ce = cards[c + 1][0] if c + 1 < len(cards) else e
            while ce > k + 1 and (not lines[ce - 1].strip() or lines[ce - 1].lstrip().startswith("#") and indent(lines[ce - 1]) < 8):
                ce -= 1
            g["cards"].append({"name": cn, "start": k, "end": ce})
        while g["end"] > g["start"] + 1 and (not lines[g["end"] - 1].strip() or (lines[g["end"] - 1].lstrip().startswith("#") and indent(lines[g["end"] - 1]) < 4)):
            g["end"] -= 1                    # the blank lines and the marker comments after the last card belong to no group
        groups.append(g)
    return groups


def card_fields(lines, c):
    """The simple lines of a card (id, href, icon, description, siteMonitor) and the type of its widget ('' when it has none)."""
    f = {}
    for k in range(c["start"] + 1, c["end"]):
        m = re.match(r"^        (id|href|icon|description|siteMonitor|target):\s*(.*?)\s*$", lines[k])
        if m:
            f[m.group(1)] = unq(m.group(2))
    w = ""
    for k in range(c["start"] + 1, c["end"]):
        if re.match(r"^        widget:\s*$", lines[k]):
            w = "yes"
            for q in range(k + 1, c["end"]):
                m = re.match(r"^          type:\s*(\S+)\s*$", lines[q])
                if m:
                    w = unq(m.group(1))
                    break
            break
    f["widget"] = w
    return f


def card_public(lines, c, group):
    f = card_fields(lines, c)
    managed = bool(f.get("widget")) or f.get("id", "").endswith("-card")
    return {"name": c["name"], "id": f.get("id", ""), "href": f.get("href", ""), "icon": f.get("icon", ""), "description": f.get("description", ""),
            "siteMonitor": f.get("siteMonitor", ""), "widget": f.get("widget", ""), "managed": managed,
            "locked": group in AUTOMATIC or f.get("id", "") in ("customize-card", "navidrome-card")}


def services_state():
    lines = read(SERVICES).split("\n")
    out = []
    for g in services_parse(lines):
        out.append({"group": g["name"], "locked": g["name"] in AUTOMATIC or g["name"] in PROTECTED,
                    "cards": [card_public(lines, c, g["name"]) for c in g["cards"]]})
    return out


def find_card(lines, group, name):
    for g in services_parse(lines):
        if g["name"] == group:
            for c in g["cards"]:
                if c["name"] == name:
                    return g, c
    raise Fail("I cannot find the card '%s' in '%s'. Reload the panel and try again." % (name, group))


def set_line(lines, c, key, value):
    """Set one simple line of a card (value None or '' removes it). The widget lines are never touched."""
    ind = " " * 8
    idx = None
    for k in range(c["start"] + 1, c["end"]):
        if re.match(r"^        %s:\s" % re.escape(key), lines[k] + " "):
            idx = k
            break
    if value in (None, ""):
        if idx is not None:
            del lines[idx]
            c["end"] -= 1
        return
    new = "%s%s: %s" % (ind, key, yq(value))
    if idx is not None:
        lines[idx] = new
        return
    at = c["end"]
    for k in range(c["start"] + 1, c["end"]):                       # new simple lines go in front of the widget (or any deeper block)
        if re.match(r"^        (widget|server|container|stack):", lines[k]):
            at = k
            break
    lines.insert(at, new)
    c["end"] += 1


def new_card_lines(name, href, icon, description, monitor):
    block = ["    - %s:" % yq(name)]
    if href:
        block.append("        href: %s" % yq(href))
    if monitor:
        block.append("        siteMonitor: %s" % yq(monitor))
    if icon:
        block.append("        icon: %s" % yq(icon))
    if description:
        block.append("        description: %s" % yq(description))
    return block


def tidy_blank(lines, at):
    """After a cut at index `at`: no double blank line."""
    while 0 < at < len(lines) and not lines[at].strip() and not lines[at - 1].strip():
        del lines[at]


def card_insert(lines, group, block, before=None):
    """Put a card block into a group: before the card named `before`, else at the end. A group that does not exist is made."""
    for g in services_parse(lines):
        if g["name"] == group:
            if before is not None:
                tgt = next((c for c in g["cards"] if c["name"] == before), None)
                at = tgt["start"] if tgt else None
            else:
                at = None
            if at is None:
                at = g["cards"][-1]["end"] if g["cards"] else g["start"] + 1
                ins = ([""] if lines[at - 1].strip() else []) + block + ([""] if at < len(lines) and lines[at].strip() else [])
            else:
                ins = block + [""]
            if before is None and not g["cards"]:
                ins = [""] + block + [""]
            lines[at:at] = ins
            return
    while lines and not lines[-1].strip():
        lines.pop()
    lines.extend(([""] if lines else []) + ["- %s:" % yq(group), ""] + block + [""])


def check_group_name(name):
    name = clean_text(name, "The group name", 40)
    if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
        raise Fail("The group name '%s' has characters that are not allowed." % name)
    return name


def card_values(body, managed_card=False):
    v = {"name": clean_text(body.get("name"), "The name", 60)}
    if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", v["name"]):
        raise Fail("The name '%s' has characters that are not allowed (use letters, digits, spaces and - _ . , ( ) + )." % v["name"])
    v["description"] = clean_text(body.get("description", ""), "The description", 160, True)
    v["icon"] = clean_icon(body.get("icon", ""))
    if not managed_card:
        v["href"] = clean_url(body.get("href", ""), "The address")
        v["siteMonitor"] = v["href"] if body.get("dot") and v["href"] else ""
    return v


def ensure_layout_group(tx, group, tab=None):
    """A new group gets a line in the layout (on the tab given, else the first tab)."""
    text = tx.get(SETTINGS)
    gs = layout_groups(text)
    if any(g["name"] == group for g in gs) or not gs:
        return
    t = tab or layout_tabs(gs)[0]["name"]
    gs.append({"name": group, "props": {"tab": t}, "extra": []})
    tx.put(SETTINGS, layout_write(text, gs))


def drop_layout_group(tx, group):
    text = tx.get(SETTINGS)
    gs = layout_groups(text)
    left = [g for g in gs if g["name"] != group]
    if len(left) != len(gs):
        tx.put(SETTINGS, layout_write(text, left))


def api_card(body):
    op = body.get("op")
    tx = Tx({"add": "Card added", "edit": "Card changed", "remove": "Card removed", "move": "Card moved"}.get(op, "Cards changed"))
    lines = tx.get(SERVICES).split("\n")
    if op == "add":
        group = check_group_name(body.get("group"))
        if group in AUTOMATIC or group in PROTECTED:
            raise Fail("The group '%s' is kept up to date by HomeLab. Put the card in another group." % group)
        v = card_values(body)
        if any(c["name"] == v["name"] for g in services_parse(lines) for c in g["cards"]):
            raise Fail("There is already a card called '%s'. Choose another name." % v["name"])
        card_insert(lines, group, new_card_lines(v["name"], v["href"], v["icon"], v["description"], v["siteMonitor"]))
        tx.put(SERVICES, "\n".join(lines))
        ensure_layout_group(tx, group, body.get("tab"))
    elif op == "edit":
        g, c = find_card(lines, body.get("group"), body.get("old"))
        pub = card_public(lines, c, g["name"])
        if pub["locked"]:
            raise Fail("This card is kept up to date by HomeLab and cannot be changed here.")
        v = card_values(body, pub["managed"])
        if v["name"] != c["name"] and any(x["name"] == v["name"] for gg in services_parse(lines) for x in gg["cards"]):
            raise Fail("There is already a card called '%s'." % v["name"])
        lines[c["start"]] = "    - %s:" % yq(v["name"])
        set_line(lines, c, "icon", v["icon"])
        set_line(lines, c, "description", v["description"])
        if not pub["managed"]:
            set_line(lines, c, "href", v["href"])
            set_line(lines, c, "siteMonitor", v["siteMonitor"])
        tx.put(SERVICES, "\n".join(lines))
    elif op == "remove":
        g, c = find_card(lines, body.get("group"), body.get("name"))
        pub = card_public(lines, c, g["name"])
        if pub["locked"]:
            raise Fail("This card is kept up to date by HomeLab and cannot be removed here.")
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:                 # Homepage does not like an empty group
            del lines[left["start"]:left["end"]]
            tx.put(SERVICES, "\n".join(lines))
            drop_layout_group(tx, g["name"])
        else:
            tx.put(SERVICES, "\n".join(lines))
    elif op == "move":
        g, c = find_card(lines, body.get("group"), body.get("name"))
        if card_public(lines, c, g["name"])["locked"]:
            raise Fail("This card is kept up to date by HomeLab and cannot be moved here.")
        to = check_group_name(body.get("to") or g["name"])
        if to in AUTOMATIC or to in PROTECTED:
            raise Fail("The group '%s' is kept up to date by HomeLab. Choose another group." % to)
        block = lines[c["start"]:c["end"]]
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        card_insert(lines, to, block, before=body.get("before"))
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            drop_layout_group(tx, g["name"])
        tx.put(SERVICES, "\n".join(lines))
        ensure_layout_group(tx, to, body.get("tab"))
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


# ================================================================ links (bookmarks.yaml): the whole file is rewritten from the parsed groups
def marks_parse(text):
    """(the comment lines at the top, [{name, links: [{name, abbr, href, icon, description, extra}]}])"""
    lines = text.split("\n")
    head, groups, cur, ent = [], [], None, None
    for l in lines:
        m = re.match(r"^- (.+?):\s*$", l)
        if m:
            cur = {"name": unq(m.group(1)), "links": []}
            groups.append(cur)
            ent = None
            continue
        if cur is None:
            if l.strip():
                head.append(l)
            continue
        m = re.match(r"^    - (.+?):\s*$", l)
        if m:
            ent = {"name": unq(m.group(1)), "abbr": "", "href": "", "icon": "", "description": "", "extra": []}
            cur["links"].append(ent)
            continue
        if ent is None or not l.strip():
            continue
        m = re.match(r"^\s+(?:- )?([A-Za-z][A-Za-z0-9_]*):\s*(.*?)\s*$", l)
        if m and m.group(1) in ("abbr", "href", "icon", "description"):
            ent[m.group(1)] = unq(m.group(2))
        elif m and l.strip() != "-":
            ent["extra"].append((m.group(1), m.group(2)))
    return head, groups


def marks_write(head, groups):
    out = list(head)
    for g in groups:
        out.append("- %s:" % yq(g["name"]))
        for e in g["links"]:
            out.append("    - %s:" % yq(e["name"]))
            fields = [(k, yq(e[k])) for k in ("abbr", "href", "icon", "description") if e.get(k)] + list(e["extra"])
            if not fields:
                fields = [("href", '""')]
            for n, (k, v) in enumerate(fields):
                out.append("        %s%s: %s" % ("- " if n == 0 else "  ", k, v))
            out.append("")
        if not g["links"]:
            out.append("")
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out) + "\n"


def marks_state():
    return [{"group": g["name"], "links": [{k: e[k] for k in ("name", "abbr", "href", "icon", "description")} for e in g["links"]]}
            for g in marks_parse(read(BOOKMARKS))[1]]


def abbr_of(name):
    w = re.sub(r"[^A-Za-z0-9 ]", "", name).split()
    return (w[0][:4] if len(w) == 1 else "".join(x[0] for x in w[:4])).upper()


def api_link(body):
    op = body.get("op")
    tx = Tx({"add": "Link added", "edit": "Link changed", "remove": "Link removed", "move": "Link moved", "group-add": "Link group added",
             "group-rename": "Link group renamed", "group-remove": "Link group removed"}.get(op, "Links changed"))
    head, groups = marks_parse(tx.get(BOOKMARKS))

    def grp(name):
        g = next((x for x in groups if x["name"] == name), None)
        if not g:
            raise Fail("I cannot find the group '%s'. Reload the panel and try again." % name)
        return g

    def link(g, name):
        e = next((x for x in g["links"] if x["name"] == name), None)
        if not e:
            raise Fail("I cannot find the link '%s'. Reload the panel and try again." % name)
        return e

    def values(b):
        name = clean_text(b.get("name"), "The name", 60)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
            raise Fail("The name '%s' has characters that are not allowed." % name)
        href = clean_url(b.get("href"), "The address", False)
        abbr = clean_text(b.get("abbr", ""), "The short label", 6, True) or abbr_of(name)
        if not re.fullmatch(r"[A-Za-z0-9 ]{1,6}", abbr):
            raise Fail("The short label can have up to 6 letters or digits.")
        return {"name": name, "abbr": abbr, "href": href, "icon": clean_icon(b.get("icon", "")),
                "description": clean_text(b.get("description", ""), "The description", 120, True), "extra": []}

    if op == "add":
        gname = check_group_name(body.get("group"))
        g = next((x for x in groups if x["name"] == gname), None)
        if g is None:
            g = {"name": gname, "links": []}
            groups.append(g)
        e = values(body)
        if any(x["name"] == e["name"] for gg in groups for x in gg["links"]):
            raise Fail("There is already a link called '%s'. Choose another name." % e["name"])
        g["links"].append(e)
        tx.put(BOOKMARKS, marks_write(head, groups))
        ensure_layout_group(tx, gname, body.get("tab") or "Links")
    elif op == "edit":
        g = grp(body.get("group"))
        e = link(g, body.get("old"))
        v = values(body)
        if v["name"] != e["name"] and any(x["name"] == v["name"] for gg in groups for x in gg["links"]):
            raise Fail("There is already a link called '%s'." % v["name"])
        v["extra"] = e["extra"]
        e.update(v)
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "remove":
        g = grp(body.get("group"))
        g["links"].remove(link(g, body.get("name")))
        if not g["links"]:
            groups.remove(g)
            drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "move":
        g = grp(body.get("group"))
        e = link(g, body.get("name"))
        to = check_group_name(body.get("to") or g["name"])
        tg = next((x for x in groups if x["name"] == to), None)
        if tg is None:
            tg = {"name": to, "links": []}
            groups.append(tg)
        g["links"].remove(e)
        before = body.get("before")
        at = next((i for i, x in enumerate(tg["links"]) if x["name"] == before), len(tg["links"]))
        tg["links"].insert(at, e)
        if not g["links"]:
            groups.remove(g)
            drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
        ensure_layout_group(tx, to, body.get("tab") or "Links")
    elif op == "group-rename":
        g = grp(body.get("group"))
        new = check_group_name(body.get("to"))
        if any(x["name"] == new for x in groups):
            raise Fail("There is already a group called '%s'." % new)
        text = tx.get(SETTINGS)
        gs = layout_groups(text)
        for x in gs:
            if x["name"] == g["name"]:
                x["name"] = new
        tx.put(SETTINGS, layout_write(text, gs))
        g["name"] = new
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "group-remove":
        g = grp(body.get("group"))
        groups.remove(g)
        drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


def api_group(body):
    """Groups of cards: rename or remove a whole group of the dashboard (not the ones HomeLab keeps up to date)."""
    op = body.get("op")
    name = body.get("group")
    if name in AUTOMATIC or name in PROTECTED:
        raise Fail("The group '%s' is kept up to date by HomeLab and cannot be changed here." % name)
    tx = Tx("Group changed")
    lines = tx.get(SERVICES).split("\n")
    g = next((x for x in services_parse(lines) if x["name"] == name), None)
    if g is None:
        raise Fail("I cannot find the group '%s'. Reload the panel and try again." % name)
    if op == "rename":
        new = check_group_name(body.get("to"))
        if any(x["name"] == new for x in services_parse(lines)):
            raise Fail("There is already a group called '%s'." % new)
        lines[g["start"]] = "- %s:" % yq(new)
        tx.put(SERVICES, "\n".join(lines))
        text = tx.get(SETTINGS)
        gs = layout_groups(text)
        for x in gs:
            if x["name"] == name:
                x["name"] = new
        tx.put(SETTINGS, layout_write(text, gs))
    elif op == "remove":
        if any(card_public(lines, c, name)["locked"] for c in g["cards"]):
            raise Fail("This group has a card HomeLab keeps up to date. Remove the other cards one by one.")
        del lines[g["start"]:g["end"]]
        tx.put(SERVICES, "\n".join(lines))
        drop_layout_group(tx, name)
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


# ================================================================ the password and the sessions
def hash_password(pw, salt=None):
    salt = salt or secrets.token_bytes(16)
    h = hashlib.scrypt(pw.encode("utf-8"), salt=salt, n=2 ** 14, r=8, p=1, dklen=32)
    return "scrypt$%s$%s" % (base64.b64encode(salt).decode(), base64.b64encode(h).decode())


def check_password(pw):
    txt = read(PASSFILE).strip()
    m = re.fullmatch(r"scrypt\$([A-Za-z0-9+/=]+)\$([A-Za-z0-9+/=]+)", txt)
    if not m:
        return False
    salt = base64.b64decode(m.group(1))
    return hmac.compare_digest(hash_password(pw, salt), txt)


def password_problem(pw):
    if len(pw) < 10:
        return "The password needs at least 10 characters."
    if pw.strip() != pw:
        return "The password cannot start or end with a space."
    return ""


def set_password(pw):
    p = password_problem(pw)
    if p:
        raise Fail(p)
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    write_atomic(PASSFILE, hash_password(pw) + "\n", 0o600)
    SESSIONS.clear()                                   # a new password logs everyone out


SESSIONS = {}          # token -> {"created", "seen", "csrf"}
FAILS = {"count": 0, "until": 0.0}


def login(pw):
    now = time.time()
    if now < FAILS["until"]:
        raise Fail("Too many wrong passwords. Wait %d seconds and try again." % int(FAILS["until"] - now + 1), 429)
    if not os.path.exists(PASSFILE):
        raise Fail("No password is set yet. In a terminal on the server, run:  homelab panel password", 403)
    if not isinstance(pw, str) or not check_password(pw):
        FAILS["count"] += 1
        FAILS["until"] = now + min(300, 2 ** min(FAILS["count"], 8)) if FAILS["count"] >= 4 else 0.0
        raise Fail("That is not the password.", 401)
    FAILS["count"], FAILS["until"] = 0, 0.0
    tok = secrets.token_urlsafe(32)
    SESSIONS[tok] = {"created": now, "seen": now, "pw": pw_version()}
    for t in [t for t, s in SESSIONS.items() if now - s["seen"] > SESSION_IDLE or now - s["created"] > SESSION_MAX]:
        del SESSIONS[t]
    return tok


def pw_version():
    """Changes whenever the password file does: a new password logs every session out, also in a running panel."""
    try:
        return os.stat(PASSFILE).st_mtime_ns
    except OSError:
        return 0


def session_ok(tok):
    s = SESSIONS.get(tok or "")
    now = time.time()
    if not s or now - s["seen"] > SESSION_IDLE or now - s["created"] > SESSION_MAX or s["pw"] != pw_version():
        SESSIONS.pop(tok or "", None)
        return False
    s["seen"] = now
    return True


# ================================================================ what can get a color, and the icon library
def paint_state():
    """The cards, tiles and bookmarks and the group labels the Colors screen lists."""
    lines = read(SERVICES).split("\n")
    css = read(CSS)
    look_accent = look_full(look_get(css))["accent"]
    cards, stats, cal, labels = [], [], [], []
    for g in services_parse(lines):
        if g["name"] not in PROTECTED and g["name"] not in labels:
            labels.append(g["name"])
        for c in g["cards"]:
            cid = card_fields(lines, c).get("id", "")
            if not cid or cid in NO_PAINT or not re.fullmatch(r"[A-Za-z0-9_-]+", cid):
                continue
            tile = cid.startswith(("stat-", "cal-"))
            acc = shipped_accent(css, cid)
            col = rgb_to_hex(acc) if acc else ("#94a3b8" if tile else look_accent)
            (stats if cid.startswith("stat-") else cal if cid.startswith("cal-") else cards).append({"id": cid, "name": c["name"], "group": g["name"], "color": col})
    links = []
    for g in marks_parse(read(BOOKMARKS))[1]:
        if g["name"] not in labels:
            labels.append(g["name"])
        gcol = rgb_to_hex(shipped_group_accent(css, slugify(g["name"])) or "148, 163, 184")
        links += [{"name": e["name"], "group": g["name"], "color": gcol} for e in g["links"]]
    return {"cards": cards, "stats": stats, "calendar": cal, "links": links, "labels": labels}


ICON_CACHE_DAYS = 30
ICON_TREE_URLS = [os.environ["HLP_ICON_TREE"]] if os.environ.get("HLP_ICON_TREE") else [
    "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/tree.json", "https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/tree.json"]
ICON_MDI_URLS = [os.environ["HLP_ICON_MDI"]] if os.environ.get("HLP_ICON_MDI") else [
    "https://cdn.jsdelivr.net/npm/@mdi/svg@7.4.47/meta.json", "https://raw.githubusercontent.com/Templarian/MaterialDesign-SVG/master/meta.json"]


def fetch_json(urls):
    for u in urls:
        try:
            if u.startswith("/"):
                with open(u, "rb") as f:
                    raw = f.read(8_000_000)
            else:
                req = urllib.request.Request(u, headers={"User-Agent": "homelab-panel"})
                with urllib.request.urlopen(req, timeout=20) as r:
                    raw = r.read(8_000_000)
            return json.loads(raw.decode("utf-8"))
        except (OSError, ValueError, urllib.error.URLError):
            continue
    return None


def icon_index():
    """{"apps": [names like plex.svg], "mdi": [names like home-outline]} from the icon lists the dashboard's own icons come from. The lists are downloaded once
    and kept for a month; without internet the last copy (or nothing) is used and the page falls back to its short list."""
    cache = os.path.join(STATE_DIR, "icons.json")
    try:
        with open(cache, encoding="utf-8") as f:
            have = json.load(f)
    except (OSError, ValueError):
        have = None
    if have and time.time() - have.get("time", 0) < ICON_CACHE_DAYS * 86400:
        return have["data"]
    tree, meta = fetch_json(ICON_TREE_URLS), fetch_json(ICON_MDI_URLS)
    data = {"apps": (have or {}).get("data", {}).get("apps", []), "mdi": (have or {}).get("data", {}).get("mdi", [])}
    if isinstance(tree, dict):
        svg = [x for x in tree.get("svg", []) if isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,80}\.svg", x)]
        have_svg = {x[:-4] for x in svg}
        png = [x for x in tree.get("png", []) if isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,80}\.png", x) and x[:-4] not in have_svg]
        data["apps"] = sorted(svg + png)
    if isinstance(meta, list):
        data["mdi"] = sorted({m["name"] for m in meta if isinstance(m, dict) and isinstance(m.get("name"), str) and re.fullmatch(r"[a-z0-9-]{1,60}", m["name"])})
    if data["apps"] or data["mdi"]:
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            write_atomic(cache, json.dumps({"time": time.time(), "data": data}), 0o600)
        except OSError:
            pass
    return data


# ================================================================ the state the page shows
def full_state():
    h = history_last()
    return {"version": VERSION, "look": look_state(), "background": bg_state(), "layout": layout_state(), "services": services_state(),
            "links": marks_state(), "paint": paint_state(), "undo": (h[1]["label"] if h else ""), "automatic": sorted(AUTOMATIC), "protected": sorted(PROTECTED)}


# ================================================================ the Drives tab
# The panel never touches a drive itself. It asks the drives tool, through the narrow sudo rule the installer writes
# (/etc/sudoers.d/homelab-panel): `sudo -n drives panel status|health|check|actions|remount|rename ID NAME|sleep ID|wake ID` and nothing else.
# Every word is checked here and again by the drives tool.
DRIVES_GATE = threading.Condition()           # looking at the drives (any number at once) or changing them (one, alone); it is not the big LOCK, so the look still works meanwhile
DRIVES_STATE = {"readers": 0, "changing": False}
DRIVE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
DRIVE_NAME = re.compile(r"[A-Za-z0-9 .()+,-]{1,40}\Z")
DRIVE_TIMEOUT = {"status": 90, "actions": 90, "setups": 120, "health": 180, "check": 180, "remount": 600}
DRIVE_WORD = re.compile(r"(ERASE|CONTINUE|REMOVE|KEEP|NOW|/dev/[a-z0-9]{1,16}|pool|mirror|snapraid1|snapraid2|zfs-stripe|zfs-mirror|zfs-raidz1|zfs-raidz2|zfs-raidz3|md-raid0|md-raid1|md-raid5|md-raid6|md-raid10)\Z")      # what a person may type in a confirmation; the drives tool checks that it is the word asked for
JOB_MAX_SECONDS = 8 * 3600
JOB = {"id": 0, "running": False, "action": "", "lines": [], "rc": None, "message": "", "started": 0, "items": [], "progress": {}, "current": "", "stopping": False}      # the drive change that runs (or ran last) in the background
JOB_LOCK = threading.Lock()


def drives_problem(rc, text):
    """A sentence for a drives command that did not work (sudo said no, the tool is missing, or the tool refused)."""
    low = text.lower()
    if rc == 127 or "command not found" in low or "no such file" in low:
        return "The drives tool is not installed on this machine, so the Drives tab has nothing to work with."
    if "password is required" in low or "not allowed" in low or "may not run sudo" in low or "no tty present" in low:
        return "The Drives tab is not allowed to use the drives tool yet. On the server, run:  sudo homelab-setup upgrade"
    if rc == 124:
        return "The drives tool took too long. Nothing more was started; try again in a minute."
    lines = [x.strip() for x in text.splitlines() if x.strip() and not x.startswith("WARNING")]
    return " ".join(lines[-3:])[:400] or "The drives tool did not work (code %d)." % rc


DRIVES_BUSY_MSG = "A drive change is running right now. This page shows its progress."


def drives_look_begin():
    with DRIVES_GATE:
        if DRIVES_STATE["changing"]:
            raise Fail(DRIVES_BUSY_MSG, 409)
        DRIVES_STATE["readers"] += 1


def drives_look_end():
    with DRIVES_GATE:
        DRIVES_STATE["readers"] -= 1
        DRIVES_GATE.notify_all()


def drives_change_begin(wait=30):
    """A change runs alone: it says so first (so no new look starts), then waits a moment for the looks that are already running."""
    with DRIVES_GATE:
        if DRIVES_STATE["changing"]:
            raise Fail("Another drive command is running. Try again in a moment.", 409)
        DRIVES_STATE["changing"] = True
        if not DRIVES_GATE.wait_for(lambda: DRIVES_STATE["readers"] == 0, timeout=wait):
            DRIVES_STATE["changing"] = False
            DRIVES_GATE.notify_all()
            raise Fail("The drives are still being read. Try again in a moment.", 409)


def drives_change_end():
    with DRIVES_GATE:
        DRIVES_STATE["changing"] = False
        DRIVES_GATE.notify_all()


def drives_run(words, timeout, look=False):
    """Run `drives panel WORDS...`; returns (returncode, stdout, stderr). Looks run together; a change runs alone."""
    if look:
        drives_look_begin()
    else:
        drives_change_begin()
    try:
        try:
            p = subprocess.run(DRIVES_CMD + ["panel"] + words, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
            return p.returncode, p.stdout or "", p.stderr or ""
        except FileNotFoundError:
            return 127, "", "command not found"
        except subprocess.TimeoutExpired:
            return 124, "", "timed out"
    finally:
        if look:
            drives_look_end()
        else:
            drives_change_end()


def drives_json(action, extra=()):
    """The JSON a look-only command prints (health and check also exit 1 when they find a problem, and still print it)."""
    rc, out, err = drives_run([action] + list(extra), DRIVE_TIMEOUT[action], look=True)
    try:
        data = json.loads(out)
    except ValueError:
        raise Fail(drives_problem(rc, err or out), 502 if rc != 124 else 504) from None
    if not isinstance(data, dict):
        raise Fail("The drives tool answered in a way the panel does not understand.", 502)
    return data


def api_drives_state():
    """Pools, drives and the last backup, plus what can be renamed or put to sleep."""
    st = drives_json("status")
    ac = drives_json("actions")
    return {"status": st, "actions": ac}


def drive_message(out, err, limit=600, problem=False):
    """What the drives tool said, for a toast: its own sentences, without the progress lines.
    A finished change is told by its "Done." line alone; a change that did not work by the warnings it ended with.
    The text is cut between lines, never in the middle of a sentence."""
    lines = []
    for x in (out + "\n" + err).splitlines():
        x = x.strip()
        if not x or x.startswith(("Starting containers", "Stopping", "WARNING: Not a good moment")):
            continue
        if re.fullmatch(r"[-\u2014\u2500=_ ]+", x) or x.startswith(("\u2014", "\u2500")) or "\u2014\u2014" in x:
            continue      # (a rule or a heading line of another tool)
        lines.append(x)
    if not problem:
        for x in lines:
            if x.startswith("Done"):
                return x[:limit]
    else:
        errors = [x[len("ERROR:"):].strip() for x in lines if x.startswith("ERROR:")]      # (the reason the tool gave up: it stands alone, not after the drive's table)
        warned = [x[len("WARNING:"):].strip() for x in lines if x.startswith("WARNING:") and "lazy unmount" not in x]
        if errors:
            lines = errors
        elif warned:
            lines = warned
    while len(lines) > 1 and len(" ".join(lines)) > limit:
        lines.pop(0)
    return " ".join(lines)[-limit:]


def api_drives_do(action, body):
    """rename / sleep / wake / remount. The answer says what the drives tool said."""
    words = [action]
    if action in ("rename", "sleep", "wake"):
        ident = body.get("id")
        if not isinstance(ident, str) or not DRIVE_ID.match(ident):
            raise Fail("Choose a drive first.")
        words.append(ident)
    if action == "rename":
        name = body.get("name")
        if not isinstance(name, str):
            raise Fail("Type a name first.")
        name = " ".join(name.split())
        if name != "auto" and not DRIVE_NAME.match(name):
            raise Fail("A name may have up to 40 letters, numbers, spaces and these marks: . ( ) + , -")
        if name != "auto" and (name[0] in " .-" or name[-1] in " .-"):
            raise Fail("A name cannot start or end with a space, a dot or a dash.")
        words.append(name)
    rc, out, err = drives_run(words, DRIVE_TIMEOUT.get(action, 90))
    msg = drive_message(out, err)
    if rc != 0:
        low = (err + out).lower()
        sudo_no = "password is required" in low or "not allowed" in low or "may not run sudo" in low or "no tty present" in low
        raise Fail(drives_problem(rc, err + out) if rc in (124, 127) or sudo_no or not msg else msg, 409 if rc == 1 and not sudo_no else 502)
    return {"message": msg or "Done."}



DRIVE_TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}(:(keep|erase))?\Z")


def job_ids(body):
    """The drives a change is about: `ids` (up to eight, each 'ID' or 'ID:keep' / 'ID:erase') or the single `id`."""
    ids = body.get("ids")
    if ids is None:
        ids = [body.get("id")]
    if not isinstance(ids, list) or not 1 <= len(ids) <= 8:
        raise Fail("Choose between one and eight drives.")
    out = []
    for t in ids:
        if not isinstance(t, str) or not DRIVE_TOKEN.match(t):
            raise Fail("Choose a drive first.")
        if t.split(":")[0] in [x.split(":")[0] for x in out]:
            raise Fail("A drive cannot be chosen twice.")
        out.append(t)
    each = [":" in t for t in out]
    if any(each) and not all(each):
        raise Fail("Every drive needs its own choice.")
    return out


def job_words(action, body):
    """The exact words of a drive change (add, wipe, disconnect, move), checked before anything is asked of the drives tool."""
    typed = body.get("typed", [])
    if not isinstance(typed, list) or len(typed) > 20 or not all(isinstance(w, str) and DRIVE_WORD.match(w) for w in typed):
        raise Fail("A confirmation word is not allowed.")

    def pick(key, allowed):
        v = body.get(key)
        if v not in allowed:
            raise Fail("Choose %s first." % key)
        return v
    if action == "bootadd":
        units = body.get("units")
        if not isinstance(units, int) or isinstance(units, bool) or not 1 <= units <= 999999:
            raise Fail("Choose a size first.")
        return ["bootadd", pick("role", ("main", "backup")), str(units)] + typed
    if action == "setup":
        name, ids = body.get("setup"), body.get("ids")
        if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9-]{3,12}", name):
            raise Fail("Choose a setup first.")
        if not isinstance(ids, list) or not 1 <= len(ids) <= 16 or not all(isinstance(t, str) and DRIVE_TOKEN.match(t) for t in ids) or len({t.split(":")[0] for t in ids}) != len(ids):
            raise Fail("Choose the drives for the setup.")      # (each is 'ID', or 'ID:keep' to keep its files, 'ID:erase')
        return ["setup", name, ",".join(ids)] + typed
    if action == "wipe":
        ident = body.get("id")
        if not isinstance(ident, str) or not DRIVE_ID.match(ident):
            raise Fail("Choose a drive first.")
        words = ["wipe", ident, pick("mode", ("empty", "format"))]
        return words + typed
    ids = job_ids(body)
    lst = ",".join(ids)
    each = ":" in ids[0]
    if action == "add":
        words = ["add", lst, pick("role", ("main", "backup")), "each" if each else pick("mode", ("keep", "erase"))]
    elif action == "disconnect":
        words = ["disconnect", lst, pick("copy", ("yes", "no"))]
    elif action == "move":
        words = ["move", lst, "each" if each else pick("keep", ("keep", "erase")), pick("copy", ("yes", "no"))]
    else:
        raise Fail("Unknown address.", 404)
    return words + typed


def job_progress(line):
    """A progress line of the drives tool: `PROGRESS ID PERCENT text`. Keeps the bar of that drive (it never goes back; several drives report at the same time). True when the line was one."""
    m = re.match(r"PROGRESS (\S+) (\d{1,3}) ?(.*)\Z", line)
    if not m:
        return False
    item, pct, text = m.group(1), min(100, int(m.group(2))), m.group(3)[:80]
    prog = JOB["progress"]
    JOB["current"] = item
    old = prog.get(item, {"pct": 0})
    prog[item] = {"pct": max(old["pct"], pct), "text": text}
    return True


def job_thread(words):
    """Run one drive change and keep its progress lines for the page. Holds the drive gate (a change runs alone) until it is over."""
    rc, tail = 1, []
    try:
        try:
            p = subprocess.Popen(DRIVES_CMD + ["panel"] + words, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True, bufsize=1)
        except FileNotFoundError:
            with JOB_LOCK:
                JOB["lines"] = ["command not found"]
            rc = 127
        else:
            timer = threading.Timer(JOB_MAX_SECONDS, p.kill)
            timer.start()
            try:
                for line in p.stdout:
                    line = line.rstrip()
                    if line:
                        with JOB_LOCK:
                            if not job_progress(line):
                                JOB["lines"] = (JOB["lines"] + [line])[-300:]
                rc = p.wait()
            finally:
                timer.cancel()
        with JOB_LOCK:
            tail = list(JOB["lines"])
    finally:
        text = "\n".join(tail)
        low = text.lower()
        sudo_no = "password is required" in low or "may not run sudo" in low or "no tty present" in low
        with JOB_LOCK:
            JOB["rc"] = rc
            if rc == 0:
                for it in JOB["items"]:
                    JOB["progress"][it] = {"pct": 100, "text": "Done"}
            JOB["message"] = drives_problem(rc, text) if rc in (124, 127) or sudo_no else (tail[-1] if rc == 4 and tail else drive_message(text, "", 1500, problem=(rc != 0)))      # (4 = the person pressed Stop: the tool's last line says what happened)
            JOB["running"] = False
            JOB["stopping"] = False
            drives_change_end()      # (inside the same lock: whoever sees "not running" can look at the drives at once)


def api_drives_job_start(action, body):
    words = job_words(action, body)
    items = [t.split(":")[0] for t in job_ids(body)] if action not in ("wipe", "setup", "bootadd") else ([body.get("id")] if action == "wipe" else ["bootadd"] if action == "bootadd" else [str(t).split(":")[0] for t in (body.get("ids") or [])])
    drives_change_begin()
    with JOB_LOCK:
        JOB.update(id=JOB["id"] + 1, running=True, action=action, lines=[], rc=None, message="", started=int(time.time()), items=items, progress={}, current="", stopping=False)
        jid = JOB["id"]
    threading.Thread(target=job_thread, args=(words,), daemon=True).start()
    return {"ok": True, "job": jid}


def api_drives_job():
    with JOB_LOCK:
        return {"id": JOB["id"], "running": JOB["running"], "action": JOB["action"], "lines": JOB["lines"][-(12 if JOB["running"] else 60):], "rc": JOB["rc"], "message": JOB["message"], "started": JOB["started"], "items": JOB["items"], "progress": JOB["progress"], "current": JOB["current"], "stopping": JOB["stopping"]}


def api_drives_abort():
    """The Stop button: asks the drives tool to stop the running change at the next safe moment (it does not wait for the change, and it is not held back by the drive gate)."""
    with JOB_LOCK:
        running, action = JOB["running"], JOB["action"]
        copying = any(str(v.get("text", "")).startswith("Copying files") for v in JOB["progress"].values())
    if not running:
        raise Fail("No drive change is running right now.", 409)
    if action == "setup" and not copying:
        raise Fail("A new setup can be stopped only while the files of the Main pool are being copied. Erasing and building the drives is not something to cut off halfway.", 409)
    if action not in ("add", "move", "disconnect", "setup"):
        raise Fail("That cannot be stopped: erasing a drive is not something to cut off halfway.", 409)
    try:
        p = subprocess.run(DRIVES_CMD + ["panel", "abort"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Fail("The drives tool did not answer. Try Stop again.", 504) from None
    except FileNotFoundError:
        raise Fail("The drives tool is not installed.", 502) from None
    msg = drive_message(p.stdout or "", p.stderr or "")
    if p.returncode != 0:
        raise Fail(msg or "The change could not be stopped.", 409)
    with JOB_LOCK:
        JOB["stopping"] = True
    return {"message": msg or "Stopping."}


# ================================================================ the web server
TERM_MAX = 6_000_000             # the biggest page the terminal may send (its own page is under 1 MB)
TERM_IDLE = 600                  # a terminal connection with no traffic at all for this many seconds is closed (ttyd pings every few seconds)


class UnixConn(http.client.HTTPConnection):
    """An HTTP connection to a socket file (ttyd listens on one)."""
    def __init__(self, path, timeout=20):
        super().__init__("localhost", timeout=timeout)
        self.sock_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.sock_path)


class Handler(BaseHTTPRequestHandler):
    server_version = "homelab-panel"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        if os.environ.get("HLP_LOG"):
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    # --- helpers
    def host_ok(self):
        host = (self.headers.get("Host") or "").lower()
        ok = {"localhost:%d" % PORT, "127.0.0.1:%d" % PORT, "[::1]:%d" % PORT}
        for h in HOSTS:
            ok.add(h)
        return host in ok

    def origin_ok(self, origin):
        """The page that sent the request is the panel itself. (Tailscale may pass the Host header on or replace it; both are accepted.)"""
        net = urllib.parse.urlparse(origin).netloc.lower()
        return net == (self.headers.get("Host") or "").lower() or net in set(HOSTS) | {"localhost:%d" % PORT, "127.0.0.1:%d" % PORT}

    def cookie_token(self):
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE:
                return v
        return ""

    def send(self, code, body, ctype="application/json", extra=None, csp=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode("utf-8")
        elif isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        anc = " ".join(["'self'"] + FRAME)
        self.send_header("Content-Security-Policy", csp or ("default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; "
                                                           "script-src 'self'; connect-src 'self'; frame-ancestors " + anc))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def fail(self, e):
        self.send(e.code, {"error": str(e)})

    def read_body(self, limit):
        n = int(self.headers.get("Content-Length") or 0)
        if n > limit:
            raise Fail("That is too big.", 413)
        return self.rfile.read(n) if n else b""

    def api_guard(self):
        """Every call that changes something: right host, same origin, our own header, a logged-in session."""
        if self.headers.get("X-Panel") != "1":
            raise Fail("This request did not come from the panel page.", 403)
        origin = self.headers.get("Origin")
        if origin and not self.origin_ok(origin):
            raise Fail("This request came from another website.", 403)
        if not session_ok(self.cookie_token()):
            raise Fail("Please log in again.", 401)

    # --- GET
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        try:
            if not self.host_ok():
                return self.send(421, {"error": "Unknown address."})
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/session":
                return self.send(200, {"loggedIn": session_ok(self.cookie_token()), "passwordSet": os.path.exists(PASSFILE), "version": VERSION})
            if path == "/api/state":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                with LOCK:
                    return self.send(200, full_state())
            if path == "/api/icons":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, icon_index())
            if path == "/api/drives/job":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, api_drives_job())
            if path in ("/api/drives", "/api/drives/health", "/api/drives/check", "/api/drives/setups"):
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                if path == "/api/drives":
                    return self.send(200, api_drives_state())
                action, extra = path.rsplit("/", 1)[1], ()
                if action == "setups":      # ?skip=sdc,sdd: spare drives the person left out of the scan
                    skip = [x for x in urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("skip", [""])[0].split(",") if x]
                    if len(skip) > 24 or not all(DRIVE_ID.match(x) for x in skip):
                        raise Fail("Those are not drive names.", 400)
                    extra = (",".join(skip),) if skip else ()
                return self.send(200, drives_json(action, extra))
            if path.startswith("/api/"):
                raise Fail("Unknown address.", 404)
            if path == "/terminal":
                return self.send(302, b"", "text/plain", {"Location": "/terminal/"})
            if path.startswith("/terminal/"):
                return self.terminal()
            self.static(path)
        except Fail as e:
            self.fail(e)
        except Exception as e:      # never show a stack trace to the browser
            sys.stderr.write("error: %r\n" % (e,))
            self.send(500, {"error": "Something went wrong inside the panel. Look at:  journalctl -u homelab-panel -n 30"})

    # --- the web terminal: ttyd on a private socket, passed through after the login
    def terminal_page(self, code, text):
        page = ("<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Terminal</title>"
                "<body style='font:16px system-ui,sans-serif;background:#0a0f19;color:#dbe4f5;padding:24px'><p>%s</p>"
                "<p><a style='color:#8ab4ff' target=_blank rel=noopener href='/'>Open the control panel</a></p>" % text)
        return self.send(code, page, "text/html; charset=utf-8")

    def terminal_target(self):
        u = urllib.parse.urlparse(self.path)
        return u.path + ("?" + u.query if u.query else "")

    def terminal(self):
        if not session_ok(self.cookie_token()):
            return self.terminal_page(401, "Please log in to the control panel first (the Customize tab uses the same login), then reload this card.")
        if (self.headers.get("Upgrade") or "").lower() == "websocket":
            origin = self.headers.get("Origin")
            if not origin or not self.origin_ok(origin):          # a page of another website must not be able to open the terminal
                raise Fail("This request came from another website.", 403)
            return self.terminal_socket()
        try:
            conn = UnixConn(TERM_SOCK)
            page = urllib.parse.urlparse(self.path).path.rstrip("/") in ("/terminal", "")      # the page itself (not its scripts): plain, so a line can be added to it
            conn.request("GET", self.terminal_target(), headers={"Host": "localhost", "Accept": self.headers.get("Accept") or "*/*",
                                                    "Accept-Encoding": "identity" if page else (self.headers.get("Accept-Encoding") or "identity")})
            r = conn.getresponse()
            body = r.read(TERM_MAX + 1)
            ctype, enc, status = r.getheader("Content-Type") or "application/octet-stream", r.getheader("Content-Encoding"), r.status
            conn.close()
        except (OSError, http.client.HTTPException):
            return self.terminal_page(502, "The terminal is not running. On the server, look at:  sudo systemctl status homelab-terminal")
        if len(body) > TERM_MAX or status not in (200, 304, 401, 404):
            return self.terminal_page(502, "The terminal gave an answer the panel does not understand.")
        if status == 200 and ctype.startswith("text/html") and not enc and b"</head>" in body:
            # the dashboard card must not move when the terminal reaches its top or bottom while you scroll
            body = body.replace(b"</head>", b"<style>html,body{overscroll-behavior:contain}</style></head>", 1)
        anc = " ".join(["'self'"] + FRAME)
        csp = ("default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; "
               "connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-ancestors " + anc)
        return self.send(status, body, ctype, {"Content-Encoding": enc} if enc else None, csp=csp)

    def terminal_socket(self):
        """The terminal's WebSocket: the handshake is passed on and then the bytes go both ways until one side closes."""
        up = socket.socket(socket.AF_UNIX)
        try:
            up.settimeout(5)
            up.connect(TERM_SOCK)
        except OSError:
            up.close()
            return self.terminal_page(502, "The terminal is not running. On the server, look at:  sudo systemctl status homelab-terminal")
        keep = ("Upgrade", "Connection", "Sec-WebSocket-Key", "Sec-WebSocket-Version", "Sec-WebSocket-Protocol", "Sec-WebSocket-Extensions")
        head = ["GET %s HTTP/1.1" % self.terminal_target(), "Host: localhost"] + ["%s: %s" % (k, self.headers[k]) for k in keep if self.headers.get(k)]
        try:
            up.sendall(("\r\n".join(head) + "\r\n\r\n").encode("latin-1"))
        except (OSError, UnicodeEncodeError):
            up.close()
            return self.terminal_page(502, "The terminal could not be reached.")
        self.close_connection = True
        client = self.connection
        up.settimeout(None)
        client.settimeout(None)
        socks = [client, up]
        try:
            while True:
                ready = select.select(socks, [], [], TERM_IDLE)[0]
                if not ready:
                    break
                for x in ready:
                    data = x.recv(65536)
                    if not data:
                        return
                    (up if x is client else client).sendall(data)
        except OSError:
            pass
        finally:
            up.close()

    def static(self, path):
        names = {"/": "index.html", "/index.html": "index.html", "/app.js": "app.js", "/app.css": "app.css", "/icon.svg": "icon.svg"}
        fn = names.get(path)
        if not fn:
            return self.send(404, {"error": "Not found."})
        data = read_bytes(os.path.join(UI_DIR, fn))
        if data is None:
            return self.send(404, {"error": "The panel's page files are not installed (%s). Run: sudo homelab-setup upgrade" % UI_DIR})
        ctype = mimetypes.guess_type(fn)[0] or "application/octet-stream"
        self.send(200, data, ctype + ("; charset=utf-8" if ctype.startswith("text/") or ctype.endswith("javascript") else ""))

    # --- POST
    def do_POST(self):
        try:
            if not self.host_ok():
                return self.send(421, {"error": "Unknown address."})
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/login":
                if self.headers.get("X-Panel") != "1" or (self.headers.get("Origin") and not self.origin_ok(self.headers.get("Origin"))):
                    raise Fail("This request did not come from the panel page.", 403)
                body = json.loads(self.read_body(4096) or b"{}")
                tok = login(body.get("password"))
                flags = "; HttpOnly; SameSite=Lax; Path=/; Max-Age=%d" % SESSION_MAX + ("" if os.environ.get("HLP_COOKIE_PLAIN") else "; Secure")
                return self.send(200, {"ok": True}, extra={"Set-Cookie": "%s=%s%s" % (COOKIE, tok, flags)})
            self.api_guard()
            if path == "/api/logout":
                SESSIONS.pop(self.cookie_token(), None)
                return self.send(200, {"ok": True}, extra={"Set-Cookie": "%s=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0%s" % (COOKIE, "" if os.environ.get("HLP_COOKIE_PLAIN") else "; Secure")})
            if path == "/api/background/upload":
                data = self.read_body(MAX_UPLOAD)
                with LOCK:
                    res = api_bg_upload(data)
                return self.send(200, res)
            body = json.loads(self.read_body(1 << 20) or b"{}")
            if not isinstance(body, dict):
                raise Fail("The request is not understood.")
            if path == "/api/drives/abort":
                return self.send(200, dict(api_drives_abort(), ok=True))
            if path in ("/api/drives/add", "/api/drives/wipe", "/api/drives/disconnect", "/api/drives/move", "/api/drives/setup", "/api/drives/bootadd"):
                return self.send(200, api_drives_job_start(path.rsplit("/", 1)[1], body))      # runs in the background: the page follows it with /api/drives/job
            if path in ("/api/drives/rename", "/api/drives/sleep", "/api/drives/wake", "/api/drives/remount"):
                return self.send(200, dict(api_drives_do(path.rsplit("/", 1)[1], body), ok=True))      # not under LOCK: a remount takes a while
            routes = {"/api/look": api_look_save, "/api/look/css": api_look_css, "/api/look/reset": api_look_reset, "/api/background": api_bg_save, "/api/background/reset": api_bg_reset,
                      "/api/layout": api_layout_save, "/api/card": api_card, "/api/link": api_link, "/api/group": api_group,
                      "/api/undo": lambda b: {"undone": undo()}}
            fn = routes.get(path)
            if not fn:
                raise Fail("Unknown address.", 404)
            with LOCK:
                res = fn(body)
            self.send(200, dict(res, ok=True))
        except Fail as e:
            self.fail(e)
        except ValueError:
            self.send(400, {"error": "The request is not understood."})
        except Exception as e:
            sys.stderr.write("error: %r\n" % (e,))
            self.send(500, {"error": "Something went wrong inside the panel. Look at:  journalctl -u homelab-panel -n 30"})


def read_bytes(p):
    try:
        with open(p, "rb") as f:
            return f.read()
    except OSError:
        return None


# ================================================================ commands
def cmd_serve():
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    srv.daemon_threads = True
    sys.stderr.write("homelab-panel %s listening on http://%s:%d (files in %s)\n" % (VERSION, BIND, PORT, HP))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_set_password(args):
    if "--stdin" in args:
        pw = sys.stdin.readline().rstrip("\n")
    else:
        pw = getpass.getpass("New password for the control panel (at least 10 characters): ")
        if getpass.getpass("Type it again: ") != pw:
            print("The two entries did not match. Nothing was changed.", file=sys.stderr)
            return 1
    try:
        set_password(pw)
    except Fail as e:
        print(str(e), file=sys.stderr)
        return 1
    print("The control panel password is set. Everyone who was logged in is logged out.")
    return 0


def cmd_status():
    print("homelab-panel %s" % VERSION)
    print("  password:       %s" % ("set" if os.path.exists(PASSFILE) else "NOT set yet (run: homelab panel password)"))
    print("  listens on:     http://%s:%d" % (BIND, PORT))
    print("  dashboard files: %s" % HP)
    print("  page files:     %s" % UI_DIR)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd == "serve":
        cmd_serve()
        return 0
    if cmd == "set-password":
        return cmd_set_password(argv[2:])
    if cmd == "status":
        return cmd_status()
    if cmd == "version":
        print(VERSION)
        return 0
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
