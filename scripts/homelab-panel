def slugify(text):
    return re.sub(r"^-+|-+$", "", re.sub(r"[^a-z0-9]+", "-", str(text or "").lower()))


def clean_map(raw, what, limit, key_ok, value_fn):
    if raw is None or raw == {}:
        return {}
    if not isinstance(raw, dict) or len(raw) > limit:
        raise Fail("%s are not valid (too many?)." % what)
    out = {}
    for k, val in raw.items():
        k = clean_text(k, "A name", 60)
        if not key_ok(k):
            raise Fail("The name '%s' has characters that are not allowed here." % k)
        got = value_fn(val, k)
        if got:
            out[k] = got
    return out


NAME_KEYS = {"homelab": "HomeLab", "main": "Main Pool", "backup": "Backup Pool"}
LOGO_DATA_MAX = 150_000
LOGO_SIZE = (24, 96)


def names_clean(raw):
    if raw in (None, {}):
        return {}
    if not isinstance(raw, dict):
        raise Fail("The names are not understood.")
    out = {}
    for k, val in raw.items():
        if k not in NAME_KEYS:
            raise Fail("The name '%s' is not one that can be changed." % k)
        val = re.sub(r"\s+", " ", val.strip()) if isinstance(val, str) else ""
        if not val or val == NAME_KEYS[k]:
            continue
        if len(val) > 24:
            raise Fail("A name can have up to 24 characters.")
        if re.search(r"[\x00-\x1f\x7f\"\\<>{}`]", val):
            raise Fail("A name cannot have these characters:  \" \\ < > { } `  or line breaks.")
        out[k] = val
    return out


def logo_clean(raw):
    """Check the logo settings: `src` (a web address of a picture, or the picture itself as a data: address), `link` (optional), `size` (height in pixels) and `off`."""
    if raw in (None, {}):
        return {}
    if not isinstance(raw, dict):
        raise Fail("The logo is not understood.")
    src = raw.get("src") or ""
    if not isinstance(src, str):
        raise Fail("The logo picture is not valid.")
    src = src.strip()
    if not src:
        return {}
    if src.startswith("data:"):
        m = re.fullmatch(r"data:image/(png|jpeg|webp|gif);base64,([A-Za-z0-9+/]+={0,2})", src)
        if not m or len(src) > LOGO_DATA_MAX:
            raise Fail("That logo picture is too big or not a picture the dashboard can show. Choose a smaller PNG, JPG, WebP or GIF.")
        try:
            data = base64.b64decode(m.group(2), validate=True)
        except (ValueError, binascii.Error):
            raise Fail("That logo picture is damaged. Choose it again.") from None
        if sniff_image(data) not in (".png", ".jpg", ".webp", ".gif"):
            raise Fail("That file cannot be used as a logo.")
    else:
        src = clean_url(src, "The logo address", False)
        if "\\" in src:
            raise Fail("The logo address has a character that is not allowed.")
    out = {"src": src}
    if raw.get("off"):
        out["off"] = True
    link = clean_url(raw.get("link"), "The logo link")
    if link:
        if "\\" in link:
            raise Fail("The logo link has a character that is not allowed.")
        out["link"] = link
    if raw.get("size") not in (None, ""):
        size = number(raw["size"], "The logo size", LOGO_SIZE[0], LOGO_SIZE[1])
        if size != 48:
            out["size"] = size
    return out


def look_clean(raw):
    """Validate the requested look and keep only the values that differ from the default."""
    if not isinstance(raw, dict):
        raise Fail("The look is missing.")
    out = {}
    if "accent" in raw:
        out["accent"] = rgb_hex(hex_rgb(raw["accent"], "main color"))
    if "glass" in raw:
        out["glass"] = rgb_hex(hex_rgb(raw["glass"], "glass color"))
    if "glassOpacity" in raw:
        out["glassOpacity"] = number(raw["glassOpacity"], "How solid the glass is", 0, 100)
    if "glassClear" in raw:
        out["glassClear"] = bool(raw["glassClear"])
    if "glassLevel" in raw:
        out["glassLevel"] = number(raw["glassLevel"], "How transparent the glass is", 0, 100)
    if "radius" in raw:
        out["radius"] = number(raw["radius"], "How round the corners are", 0, 40)
    if "edge" in raw:
        out["edge"] = number(raw["edge"], "The edge brightness", 0, 40)
    if "side" in raw:
        out["side"] = number(raw["side"], "The space at the sides", 0, 120)
    if "glassBlur" in raw:
        out["glassBlur"] = number(raw["glassBlur"], "How much the glass blurs", 0, 60)
    if "glassSat" in raw:
        out["glassSat"] = number(raw["glassSat"], "How vivid the picture behind the glass is", 50, 300)
    if "text" in raw:
        out["text"] = rgb_hex(hex_rgb(raw["text"], "text color"))
    if "muted" in raw:
        out["muted"] = rgb_hex(hex_rgb(raw["muted"], "color of the smaller text"))
    if "glassTint" in raw:
        out["glassTint"] = bool(raw["glassTint"])
    if "cardDepth" in raw:
        out["cardDepth"] = number(raw["cardDepth"], "How deep the color behind the words is", 0, 100)
    if "glassRim" in raw:
        out["glassRim"] = number(raw["glassRim"], "How bright the shine on the glass edge is", 0, 100)
    if "theme" in raw:
        if raw["theme"] not in THEME_IDS and not MYTHEME_ID.match(str(raw["theme"])):
            raise Fail("The theme is not understood.")
        out["theme"] = raw["theme"]
    if "playerHeight" in raw:
        out["playerHeight"] = number(raw["playerHeight"], "The height of the music player", 240, 1000)
    if "paintStrength" in raw:
        out["paintStrength"] = number(raw["paintStrength"], "How strong the colors are", 0, 100)
    if "paintStyle" in raw:
        if raw["paintStyle"] not in PAINT_STYLES:
            raise Fail("The color style is not valid.")
        out["paintStyle"] = raw["paintStyle"]
    if "labelIcon" in raw:
        if raw["labelIcon"] not in LABEL_ICONS:
            raise Fail("The label icon style is not valid.")
        out["labelIcon"] = raw["labelIcon"]
    if raw.get("paintAll"):
        out["paintAll"] = rgb_hex(hex_rgb(raw["paintAll"], "color for everything"))
    for key, fn in (("names", names_clean), ("logo", logo_clean)):
        got = fn(raw.get(key))
        if got:
            out[key] = got
    tabs = raw.get("tabs") or {}
    if not isinstance(tabs, dict) or len(tabs) > 30:
        raise Fail("The tab colors are not valid.")
    tt = {}
    for name, col in tabs.items():
        name = clean_text(name, "A tab name", 40)
        if not re.fullmatch(r"[^\"'\\{};<>/*]+", name):
            raise Fail("The tab name '%s' has characters that are not allowed." % name)
        if col:
            tt[name] = rgb_hex(hex_rgb(col, "color of the tab " + name))
    if tt:
        out["tabs"] = tt
    color_of = lambda val, k: rgb_hex(hex_rgb(val, "color of " + k)) if val else ""
    cards = clean_map(raw.get("cards"), "The card colors", 200, lambda k: re.fullmatch(r"[A-Za-z0-9_-]{1,60}", k) is not None, color_of)
    links = clean_map(raw.get("links"), "The bookmark colors", 400, lambda k: slugify(k) != "", color_of)

    def label_of(val, k):
        if not isinstance(val, dict):
            raise Fail("The colors of the label '%s' are not valid." % k)
        d = {}
        for part in ("text", "icon"):
            if val.get(part):
                d[part] = rgb_hex(hex_rgb(val[part], "%s color of the label %s" % (part, k)))
        return d
    labels = clean_map(raw.get("labels"), "The label colors", 60, lambda k: slugify(k) != "", label_of)
    for key, val in (("cards", cards), ("links", links), ("labels", labels)):
        if val:
            out[key] = val
    keep = ("tabs", "cards", "links", "labels", "paintAll", "names", "logo")
    return {k: v for k, v in out.items() if k in keep or v != LOOK_DEFAULT[k]}


def look_full(custom):
    v = dict(LOOK_DEFAULT)
    v.update({k: x for k, x in custom.items() if k not in ("tabs", "cards", "links", "labels", "names", "logo")})
    tabs = dict(SHIPPED_TAB_COLORS)
    tabs.update(custom.get("tabs") or {})
    v["tabs"] = tabs
    for k in ("cards", "links", "labels", "names", "logo"):
        v[k] = dict(custom.get(k) or {})
    return v


def num(x, places=3):
    return ("%.*f" % (places, x)).rstrip("0").rstrip(".") or "0"


NO_RIM = "0 0 0 0 transparent"


def rim_shadow(level):
    r = max(0.0, min(100.0, float(level))) / 100.0
    if r <= 0:
        return NO_RIM
    return ("inset 1px 1px 0 rgba(255, 255, 255, %s), inset -1px -1px 0 rgba(255, 255, 255, %s), inset 0 0 %dpx rgba(255, 255, 255, %s), inset 0 12px 18px -14px rgba(255, 255, 255, %s)"
            % (num(0.7 * r), num(0.32 * r), round(10 + 14 * r), num(0.12 * r), num(0.30 * r)))


def glass_alpha(v):
    if not v["glassTint"]:
        return 0.0
    if v["glassClear"]:
        return 0.4 * (1 - v["glassLevel"] / 100.0)
    return v["glassOpacity"] / 100.0


def shipped_accent(css, key):
    before, _block, after = css_look_split(css)
    for text in (before, after):
        for m in re.finditer(r"(?m)^([^{}\n/]*)\{\s*--accent:\s*(\d+,\s*\d+,\s*\d+)\s*;?\s*\}", text):
            if "#" + key in [x.strip() for x in m.group(1).split(",")]:
                return m.group(2)
    return None


def shipped_group_accent(css, slug):
    before, _block, after = css_look_split(css)
    for text in (before, after):
        for m in re.finditer(r'\[data-group="%s"\]\s*\{\s*--accent:\s*(\d+,\s*\d+,\s*\d+)\s*;?\s*\}' % re.escape(slug), text):
            return m.group(1)
    return None


def rgb_to_hex(txt):
    r, g, b = [int(x) for x in txt.split(",")]
    return rgb_hex((r, g, b))


WRAP = "html body #inner_wrapper"


def paint_vars(rgbs, t, style):
    k = t ** 0.8
    if style == "solid":
        a1 = a2 = num(0.72 * k)
    else:
        a1, a2 = num(0.9 * k), num(0.22 * k)
    return "--accent:%s;--hl-a1:%s;--hl-a2:%s;" % (rgbs, a1, a2)


RESET_VARS = "--hl-a1:initial;--hl-a2:initial;"


def paint_decl(rgbs, t):
    return ("border-color:rgba(%s,%s)!important;"
            "box-shadow:0 0 0 1px rgba(%s,%s),0 0 18px -8px rgba(%s,%s),0 14px 30px -20px rgba(0,0,0,.75),var(--lk-rim,0 0 0 0 transparent)!important;" % (
                rgbs, num(0.16 + 0.34 * t), rgbs, num(0.05 + 0.14 * t), rgbs, num(0.05 + 0.3 * t)))


PLAIN_DECL = "border-color:var(--lk-line)!important;box-shadow:0 14px 30px -20px rgba(0,0,0,.75),var(--lk-rim,0 0 0 0 transparent)!important;"


def paint_rules(v, saved, css):
    """Build the rules for the colors of cards, tiles and bookmarks. With `saved` (the look on the page now), things that were painted and no longer are get rules that put them back."""
    t = v["paintStrength"] / 100.0
    st = v["paintStyle"]
    rules = []
    allc = "%d, %d, %d" % hex_rgb(v["paintAll"]) if v.get("paintAll") else None
    cards_all = WRAP + " .service" + "".join(':not([id="%s"])' % x for x in NO_PAINT)
    glob_was = saved is not None and (look_full(saved)["paintStrength"] != LOOK_DEFAULT["paintStrength"] or look_full(saved)["paintStyle"] != "gradient")
    if v["paintStrength"] != LOOK_DEFAULT["paintStrength"] or st != "gradient":
        al = paint_vars("0", t, st).split(";", 1)[1]
        rules.append("%s{%s}%s .bookmark>a{%s}" % (cards_all, al, WRAP, al))
    elif glob_was:
        rules.append("%s{%s}%s .bookmark>a{%s}" % (cards_all, RESET_VARS, WRAP, RESET_VARS))

    def card(cid, c):
        return "%s #%s{%s}%s #%s .service-card{%s}" % (WRAP, cid, paint_vars(c, t, st), WRAP, cid, paint_decl(c, t))

    def mark(sl, c):
        return '%s .bookmark>a[data-bm="%s"]{%s%s}' % (WRAP, sl, paint_vars(c, t, st), paint_decl(c, t))
    if allc:
        rules.append("%s{%s}%s .service-card{%s}" % (cards_all, paint_vars(allc, t, st), cards_all, paint_decl(allc, t)))
        rules.append("%s .bookmark>a{%s%s}" % (WRAP, paint_vars(allc, t, st), paint_decl(allc, t)))
    for cid in sorted(v["cards"]):
        rules.append(card(cid, "%d, %d, %d" % hex_rgb(v["cards"][cid])))
    for name in sorted(v["links"]):
        rules.append(mark(slugify(name), "%d, %d, %d" % hex_rgb(v["links"][name])))
    if saved is not None:
        was = look_full(saved)
        for cid in sorted(set(was["cards"]) - set(v["cards"])):
            if allc:
                rules.append(card(cid, allc))
            else:
                acc = shipped_accent(css, cid) or ("148, 163, 184" if cid.startswith(("stat-", "cal-")) else "var(--lk-accent)")
                rules.append("%s #%s{--accent:%s;%s}%s #%s .service-card{%s}" % (WRAP, cid, acc, RESET_VARS, WRAP, cid, PLAIN_DECL))
        have = {slugify(n) for n in v["links"]}
        for name in sorted(was["links"]):
            if slugify(name) not in have:
                if allc:
                    rules.append(mark(slugify(name), allc))
                else:
                    rules.append('%s .bookmark>a[data-bm="%s"]{--accent:inherit;%s%s}' % (WRAP, slugify(name), RESET_VARS, PLAIN_DECL))
        if was.get("paintAll") and not allc:
            rules.append("%s{%s}%s .service-card{%s}" % (cards_all, RESET_VARS, cards_all, PLAIN_DECL))
            rules.append("%s .bookmark>a{--accent:inherit;%s%s}" % (WRAP, RESET_VARS, PLAIN_DECL))
    return rules


def label_rules(v, saved):
    rules = []
    for name in sorted(v["labels"]):
        sl = slugify(name)
        d = v["labels"][name]
        sel = '%s [data-group="%s"]' % (WRAP, sl)
        if d.get("text"):
            rules.append("%s .service-group-name,%s .bookmark-group-name{color:%s!important}" % (sel, sel, d["text"]))
        if d.get("icon"):
            rules.append("%s{--icon-color:%s;--hl-label:%d, %d, %d}" % ((sel, d["icon"]) + hex_rgb(d["icon"])))
    if saved is not None:
        for name in sorted(look_full(saved)["labels"]):
            now = v["labels"].get(name, {})
            sel = '%s [data-group="%s"]' % (WRAP, slugify(name))
            was = look_full(saved)["labels"][name]
            if was.get("text") and not now.get("text"):
                rules.append("%s .service-group-name,%s .bookmark-group-name{color:var(--lk-text)!important}" % (sel, sel))
            if was.get("icon") and not now.get("icon"):
                rules.append("%s{--icon-color:#c9d6f2;--hl-label:var(--lk-accent)}" % sel)
    style = v["labelIcon"]
    icons = ".service-group-icon,%s .bookmark-group-icon" % WRAP
    ring = "rgba(var(--hl-label,var(--lk-accent)),"
    if style == "circle":
        rules.append("%s %s{box-sizing:content-box;padding:6px;border-radius:50%%;background:%s.20)}" % (WRAP, icons, ring))
    elif style == "square":
        rules.append("%s %s{box-sizing:content-box;padding:6px;border-radius:10px;background:%s.20)}" % (WRAP, icons, ring))
    elif style == "ring":
        rules.append("%s %s{box-sizing:content-box;padding:5px;border-radius:50%%;border:1.5px solid %s.75);box-shadow:0 0 12px %s.45)}" % (WRAP, icons, ring, ring))
    elif saved is not None and look_full(saved)["labelIcon"] != "plain":
        rules.append("%s %s{padding:0;border-radius:0;background:none;border:0;box-shadow:none}" % (WRAP, icons))
    return rules


def look_css(custom, full=False, saved=None, css=""):
    """Build the rules of the look block for a look (only what differs from the default). `full` writes every value, for a preview in front of a saved look."""
    if not custom and not full and saved is None:
        return ""
    v = look_full(custom)
    rules = []
    tok = []
    if full or "accent" in custom:
        tok.append("--lk-accent: %d, %d, %d;" % hex_rgb(v["accent"]))
    if full or "glass" in custom:
        tok.append("--lk-glass: %d, %d, %d;" % hex_rgb(v["glass"]))
    if full or "glassOpacity" in custom or "glassClear" in custom or "glassLevel" in custom or "glassTint" in custom:
        tok.append("--lk-glass-a: %s;" % num(glass_alpha(v)))
    if full or "glassTint" in custom:
        tok.append("--lk-tshadow: %s;" % ("none" if v["glassTint"] else "0 1px 2px rgba(0, 0, 0, 0.6), 0 0 8px rgba(0, 0, 0, 0.3)"))
    if full or "radius" in custom:
        tok.append("--lk-radius: %dpx;" % v["radius"])
    if full or "edge" in custom:
        tok.append("--lk-line: rgba(255, 255, 255, %s);" % num(v["edge"] / 100.0))
    if full or "side" in custom:
        tok.append("--lk-side: %dpx;" % v["side"])
    if full or "glassBlur" in custom:
        tok.append("--lk-blur: %spx;" % num(v["glassBlur"]))
    if full or "glassSat" in custom:
        tok.append("--lk-sat: %s%%;" % num(v["glassSat"]))
    if full or "cardDepth" in custom:
        tok.append("--lk-deep: %s%%;" % num(round(v["cardDepth"] * 0.85, 1)))
    if full or "glassRim" in custom:
        tok.append("--lk-rim: %s;" % rim_shadow(v["glassRim"]))
    if full or "text" in custom:
        tok.append("--lk-text: %s;" % v["text"])
    if full or "muted" in custom:
        tok.append("--lk-muted: %s;" % v["muted"])
    if full or "playerHeight" in custom:
        tok.append("--lk-player-h: %dpx;" % v["playerHeight"])
    if not full:
        for k, val in sorted((custom.get("names") or {}).items()):
            tok.append('--hl-name-%s: "%s";' % (k, val))
        lg = custom.get("logo") or {}
        if lg.get("src") and not lg.get("off"):
            tok.append('--hl-logo-src: "%s";' % lg["src"])
            if lg.get("link"):
                tok.append('--hl-logo-link: "%s";' % lg["link"])
            tok.append("--hl-logo-size: %spx;" % num(lg.get("size", 48)))
    if tok:
        rules.append("html body #inner_wrapper { %s }" % " ".join(tok))
    tabs = v["tabs"] if full else (custom.get("tabs") or {})
    for name in sorted(tabs):
        rules.append('html[data-tab="%s"] body #inner_wrapper { --lk-accent: %d, %d, %d; }' % ((name,) + hex_rgb(tabs[name])))
    if full or "playerHeight" in custom:
        ph = max(240, v["playerHeight"] - 40)
        rules.append("@media (max-width: 700px) { html body #inner_wrapper { --lk-player-h: %dpx; } }" % ph)
    rules += paint_rules(v, saved, css) + label_rules(v, saved)
    return "\n".join(rules)


def look_block(custom):
    if not custom:
        return ""
    data = json.dumps(custom, sort_keys=True, separators=(",", ":")).replace("*/", "*\\/")
    return "%s written by the control panel. Remove it with the Reset button there (or delete this block). */\n/* data: %s */\n%s\n%s\n" % (
        LOOK_B1, data, look_css(custom), LOOK_B2)


def css_look_split(text):
    a = text.find(LOOK_B1)
    if a < 0:
        return text, "", ""
    b = text.find(LOOK_B2, a)
    if b < 0:
        return text, "", ""
    end = b + len(LOOK_B2)
    if text[end:end + 1] == "\n":
        end += 1
    return text[:a], text[a:end], text[end:]


def look_get(css=None):
    css = read(CSS) if css is None else css
    block = css_look_split(css)[1]
    m = re.search(r"/\* data: (.*?) \*/", block)
    if not m:
        return {}
    try:
        data = json.loads(m.group(1).replace("*\\/", "*/"))
        return look_clean(data)
    except (ValueError, Fail):
        return {}


def css_with_look(css, custom):
    before, block, after = css_look_split(css)
    new = look_block(custom)
    if block:
        return before + new + after
    if not new:
        return css
    t = css.find(THEME_B1)
    if t >= 0:
        return css[:t].rstrip("\n") + "\n\n" + new + "\n" + css[t:]
    return css.rstrip("\n") + "\n\n" + new


def picture_block(settings_text):
    d = bg_get(settings_text)
    decl = []
    if d.get("blur") in BLUR_PX:
        decl.append("--tw-backdrop-blur: blur(%dpx);" % BLUR_PX[d["blur"]])
    for key, name in (("brightness", "brightness"), ("saturate", "saturate")):
        try:
            n = float(d.get(key))
        except (TypeError, ValueError):
            continue
        if 0 <= n <= 300:
            decl.append("--tw-backdrop-%s: %s(%s);" % (name, name, num(n / 100.0)))
    if not decl:
        return ""
    return "%s written by the control panel from the picture sliders. It is rewritten when they change. */\nhtml body #inner_wrapper { %s }\n%s\n" % (BG_B1, " ".join(decl), BG_B2)


def css_with_picture(css, settings_text):
    a = css.find(BG_B1)
    b = css.find(BG_B2, a) if a >= 0 else -1
    new = picture_block(settings_text)
    if a >= 0 and b >= 0:
        end = b + len(BG_B2)
        if css[end:end + 1] == "\n":
            end += 1
        return css[:a] + new + css[end:]
    if not new:
        return css
    return css.rstrip("\n") + "\n\n" + new


def look_tab_names():
    return [t["name"] for t in layout_tabs(layout_groups(read(SETTINGS)))]


def look_state():
    custom = look_get()
    return {"custom": custom, "values": look_full(custom), "defaults": look_full({}), "themes": LOOK_THEMES,
            "tabNames": look_tab_names()}


def api_look_save(body):
    custom = look_clean(body.get("look"))
    tx = Tx("Look changed")
    tx.put(CSS, css_with_look(tx.get(CSS), custom))
    tx.commit()
    return {}


def api_look_css(body):
    custom = look_clean(body.get("look"))
    css = read(CSS)
    return {"css": look_css(custom, full=True, saved=look_get(css), css=css)}


def api_look_reset(body):
    tx = Tx("Look reset")
    tx.put(CSS, css_with_look(tx.get(CSS), {}))
    tx.commit()
    return {}


BG_DEFAULT = {"blur": "md", "saturate": 60, "brightness": 42, "opacity": 80}
BLURS = ("sm", "md", "lg", "xl", "2xl", "3xl")
IMG_TYPES = {b"\xff\xd8\xff": ".jpg", b"\x89PNG\r\n\x1a\n": ".png", b"GIF8": ".gif"}


def bg_block(lines):
    for i, l in enumerate(lines):
        if re.match(r"^background:\s*(#.*)?$", l):
            j = i + 1
            while j < len(lines) and (lines[j].startswith((" ", "\t")) or (lines[j].strip() == "" and j + 1 < len(lines) and lines[j + 1].startswith(" "))):
                j += 1
            return i, j
    return None, None


def bg_get(text):
    lines = text.split("\n")
    i, j = bg_block(lines)
    d = {}
    if i is None:
        return d
    for l in lines[i + 1:j]:
        m = re.match(r"^\s+([A-Za-z0-9_]+):\s*(.*?)\s*$", l)
        if m:
            d[m.group(1)] = unq(m.group(2))
    return d


def bg_set(text, key, value):
    """Set one key of the background block, or remove it when value is None."""
    lines = text.split("\n")
    i, j = bg_block(lines)
    new = "  %s: %s" % (key, "'" + str(value).replace("'", "''") + "'" if key == "image" else value)
    if i is None:
        if value is None:
            return text
        return text.rstrip("\n") + "\n\nbackground:\n%s\n" % new
    for k in range(i + 1, j):
        if re.match(r"^\s+%s:" % re.escape(key), lines[k]):
            if value is None:
                del lines[k]
            else:
                lines[k] = new
            return "\n".join(lines)
    if value is not None:
        lines.insert(j, new)
    return "\n".join(lines)


def images_mounted():
    if NO_DOCKER:
        return None
    try:
        r = subprocess.run(["docker", "inspect", "homepage", "--format", "{{range .Mounts}}{{.Destination}} {{end}}"],
                           capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.SubprocessError):
        return None
    return ("/app/public/images" in r.stdout.split()) if r.returncode == 0 else None


def bg_state():
    d = bg_get(read(SETTINGS))
    return {"image": d.get("image", ""), "blur": d.get("blur", ""), "saturate": int(d.get("saturate") or 100), "brightness": int(d.get("brightness") or 100),
            "opacity": int(d.get("opacity") or 100), "defaults": BG_DEFAULT, "mounted": images_mounted(), "homepageUrl": HOMEPAGE_URL,
            "blurs": list(BLURS)}


def bg_numbers(body, tx_text):
    text = tx_text
    if "blur" in body:
        b = body["blur"]
        if b in (None, "", "none"):
            text = bg_set(text, "blur", None)
        elif b in BLURS:
            text = bg_set(text, "blur", b)
        else:
            raise Fail("The blur must be none or one of: %s." % ", ".join(BLURS))
    for k in ("saturate", "brightness", "opacity"):
        if k in body:
            text = bg_set(text, k, number(body[k], k.capitalize(), 0, 100))
    return text


def api_bg_save(body):
    tx = Tx("Background changed")
    text = tx.get(SETTINGS)
    u = body.get("url")
    if u and isinstance(u, str) and u.startswith("/images/"):
        name = u[len("/images/"):]
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,120}", name) or not os.path.isfile(os.path.join(IMAGES, name)):
            raise Fail("That picture is no longer in the images folder.")
        text = bg_set(text, "image", u)
    elif u:
        text = bg_set(text, "image", clean_url(u, "The picture address", False))
    text = bg_numbers(body, text)
    tx.put(SETTINGS, text)
    tx.commit()
    return {}


def api_bg_reset(body):
    tx = Tx("Background sliders reset")
    text = tx.get(SETTINGS)
    text = bg_set(text, "blur", BG_DEFAULT["blur"])
    for k in ("saturate", "brightness", "opacity"):
        text = bg_set(text, k, BG_DEFAULT[k])
    tx.put(SETTINGS, text)
    tx.commit()
    return {}


def sniff_image(data):
    for magic, ext in IMG_TYPES.items():
        if data.startswith(magic):
            return ext
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return ".webp"
    if data[4:12] in (b"ftypavif", b"ftypavis"):
        return ".avif"
    return None


def restart_homepage():
    if NO_DOCKER:
        return False

    def go():
        try:
            subprocess.run(["docker", "restart", "homepage"], capture_output=True, timeout=120)
        except (OSError, subprocess.SubprocessError):
            pass
    threading.Thread(target=go, daemon=True).start()
    return True


def bg_store(data, body=None, fixed=None):
    """Keep a picture in the images folder and make it the background, with the sliders in `body` if any. Returns what the panel needs to know."""
    ext = sniff_image(data)
    if not ext:
        raise Fail("That file cannot be used as a picture. Choose a .jpg, .png, .webp, .gif or .avif file.")
    os.makedirs(IMAGES, exist_ok=True)
    name = (fixed + ext) if fixed else "background-%s%s" % (time.strftime("%Y%m%d%H%M%S"), ext)
    with open(os.path.join(IMAGES, name), "wb") as f:
        f.write(data)
    os.chmod(os.path.join(IMAGES, name), 0o644)
    tx = Tx("Background picture changed")
    text = bg_set(tx.get(SETTINGS), "image", "/images/" + name)
    tx.put(SETTINGS, bg_numbers(body or {}, text))
    tx.commit()
    for old in ([] if fixed else os.listdir(IMAGES)):
        if re.fullmatch(r"background-\d{14}\.\w+", old) and old != name:
            try:
                if len([x for x in os.listdir(IMAGES) if x.startswith("background-")]) > 3:
                    os.remove(os.path.join(IMAGES, old))
            except OSError:
                pass
    return {"restarting": restart_homepage(), "image": "/images/" + name}


def api_bg_upload(data):
    return bg_store(data)


def theme_picture(body):
    """Return the picture of a theme. The panel only names the theme and the address comes from the list above, so it cannot be made to fetch any other address."""
    t = next((x for x in LOOK_THEMES if x["id"] == body.get("theme")), None)
    if not t or not t.get("background"):
        raise Fail("That theme has no picture.")
    url = t["background"]["url"]
    with LOCK:
        have = [f for f in (sorted(os.listdir(IMAGES)) if os.path.isdir(IMAGES) else []) if re.fullmatch(r"theme-%s\.\w+" % t["id"], f)]
        if have:
            tx = Tx("Background picture changed")
            tx.put(SETTINGS, bg_numbers(body, bg_set(tx.get(SETTINGS), "image", "/images/" + have[0])))
            tx.commit()
            return {"restarting": False, "image": "/images/" + have[0], "stored": True, "cached": True}
    base = os.environ.get("HLP_THEME_PICTURE_BASE")
    data = None
    try:
        req = urllib.request.Request(base.rstrip("/") + "/" + t["id"] + ".png" if base else url, headers={"User-Agent": "homelab-panel"})
        with urllib.request.urlopen(req, timeout=30) as r:
            data = r.read(MAX_UPLOAD + 1)
        if len(data) > MAX_UPLOAD or not sniff_image(data):
            data = None
    except (OSError, ValueError, urllib.error.URLError):
        data = None
    with LOCK:
        if data:
            return dict(bg_store(data, body, "theme-" + t["id"]), stored=True)
        tx = Tx("Background picture changed")
        tx.put(SETTINGS, bg_numbers(body, bg_set(tx.get(SETTINGS), "image", url)))
        tx.commit()
        return {"restarting": False, "image": url, "stored": False}


AUTOMATIC = {"At a Glance", "Music Library", "Library Totals", "Storage", "Backup & Updates", "Folder Sizes", "Calendar"}
HL_ID = re.compile(r"^(stat|cal)-")
HL_BLOCKS = (("# >>> homelab stats >>>", "# <<< homelab stats <<<"), ("# >>> homelab calendar >>>", "# <<< homelab calendar <<<"))
HL_GROUP_LOOK = {"At a Glance": ("mdi-view-dashboard", 4, "Stats"), "Music Library": ("mdi-music", 2, "Stats"), "Library Totals": ("mdi-image-multiple", 2, "Stats"),
                 "Storage": ("mdi-harddisk", 3, "Stats"), "Backup & Updates": ("mdi-backup-restore", 2, "Stats"), "Folder Sizes": ("mdi-folder-multiple", 1, "Stats"),
                 "Calendar": ("mdi-calendar-month", 2, "Home")}
PROTECTED = {"Customize", "Edit Links", "Terminal"}


def layout_span(lines):
    i = next((k for k, l in enumerate(lines) if re.match(r"^layout:\s*(#.*)?$", l)), None)
    if i is None:
        return None, None
    j = i + 1
    while j < len(lines) and (lines[j].startswith((" ", "\t")) or not lines[j].strip()):
        j += 1
    while j > i + 1 and not lines[j - 1].strip():
        j -= 1
    return i, j


def layout_groups(text):
    """Return [{name, props: {tab, icon, style, columns, ...}, extra: [lines]}] in the order of the file."""
    lines = text.split("\n")
    i, j = layout_span(lines)
    out = []
    if i is None:
        return out
    cur = None
    for l in lines[i + 1:j]:
        m = re.match(r"^  (?! )(.+?):\s*$", l)
        if m and not l.lstrip().startswith("#"):
            cur = {"name": unq(m.group(1)), "props": {}, "extra": []}
            out.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"^    ([A-Za-z0-9_]+):\s*(.*?)\s*$", l)
        if m:
            cur["props"][m.group(1)] = unq(m.group(2))
        elif l.strip():
            cur["extra"].append(l)
    return out


def layout_tabs(groups):
    tabs = []
    for g in groups:
        t = g["props"].get("tab") or "Home"
        tab = next((x for x in tabs if x["name"] == t), None)
        if not tab:
            tab = {"name": t, "groups": []}
            tabs.append(tab)
        tab["groups"].append(g)
    return tabs


def layout_write(text, groups):
    lines = text.split("\n")
    i, j = layout_span(lines)
    block = ["layout:"]
    for g in groups:
        block.append("  %s:" % yq(g["name"]))
        p = dict(g["props"])
        for k in ("tab", "icon", "style", "columns"):
            if p.get(k) not in (None, ""):
                block.append("    %s: %s" % (k, p[k] if k in ("style", "columns") else yq(p[k])))
        for k, v in p.items():
            if k not in ("tab", "icon", "style", "columns") and v != "":
                block.append("    %s: %s" % (k, v))
        block.extend(g["extra"])
    if i is None:
        return text.rstrip("\n") + "\n\n" + "\n".join(block) + "\n"
    return "\n".join(lines[:i] + block + lines[j:])


def group_kinds():
    kinds = {}
    for g in services_parse(read(SERVICES).split("\n")):
        kinds.setdefault(g["name"], set()).add("services")
    for g in marks_parse(read(BOOKMARKS))[1]:
        kinds.setdefault(g["name"], set()).add("bookmarks")
    return kinds


def layout_state():
    text = read(SETTINGS)
    groups = layout_groups(text)
    kinds = group_kinds()
    svc = {g["name"]: len(g["cards"]) for g in services_parse(read(SERVICES).split("\n"))}
    bm = {g["name"]: len(g["links"]) for g in marks_parse(read(BOOKMARKS))[1]}
    listed = {g["name"] for g in groups}
    extra = [n for n in list(svc) + list(bm) if n not in listed]
    for n in dict.fromkeys(extra):
        groups.append({"name": n, "props": {"tab": (layout_tabs(groups)[0]["name"] if groups else "Home")}, "extra": [], "unlisted": True})
    tabs = []
    for t in layout_tabs(groups):
        tabs.append({"name": t["name"], "groups": [{
            "name": g["name"], "icon": g["props"].get("icon", ""), "style": g["props"].get("style", ""), "columns": g["props"].get("columns", ""),
            "kind": "+".join(sorted(kinds.get(g["name"], ()))) or "empty", "locked": g["name"] in AUTOMATIC or g["name"] in PROTECTED,
            "automatic": g["name"] in AUTOMATIC, "count": svc.get(g["name"], 0) + bm.get(g["name"], 0)} for g in t["groups"]]})
    return {"tabs": tabs}


def api_layout_save(body):
    """Save the tabs, the order of the groups and their icons, styles and columns."""
    want = body.get("tabs")
    if not isinstance(want, list) or not want or len(want) > 12:
        raise Fail("The layout is missing.")
    tx = Tx("Layout changed")
    text = tx.get(SETTINGS)
    cur = layout_groups(text)
    state = {g["name"]: g for g in cur}
    for n in group_kinds():
        if n not in state:
            state[n] = {"name": n, "props": {}, "extra": []}
    out, seen = [], set()
    names = set()
    for t in want:
        tname = clean_text(t.get("name"), "A tab name", 24)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#]+", tname):
            raise Fail("The tab name '%s' has characters that are not allowed." % tname)
        if tname in names:
            raise Fail("Two tabs are called '%s'." % tname)
        names.add(tname)
        for g in t.get("groups") or []:
            n = g.get("name")
            if n not in state or n in seen:
                raise Fail("The group '%s' is not known (or is listed twice). Reload the panel and try again." % n)
            seen.add(n)
            o = state[n]
            props = dict(o["props"])
            props["tab"] = tname
            icon = clean_icon(g.get("icon", props.get("icon", "")))
            if icon:
                props["icon"] = icon
            else:
                props.pop("icon", None)
            style = g.get("style", props.get("style", ""))
            if style not in ("", "row", "column"):
                raise Fail("The style must be 'row' or 'column'.")
            if style:
                props["style"] = style
            else:
                props.pop("style", None)
            cols = g.get("columns", props.get("columns", ""))
            if cols in ("", None):
                props.pop("columns", None)
            else:
                props["columns"] = str(number(cols, "The number of columns", 1, 8))
            out.append({"name": n, "props": props, "extra": o["extra"]})
    missing = [n for n in state if n not in seen and (n in {g["name"] for g in cur} or n in group_kinds())]
    if missing:
        raise Fail("These groups are missing from the layout: %s. Reload the panel and try again." % ", ".join(missing))
    tx.put(SETTINGS, layout_write(text, out))
    tx.commit()
    return {}


def services_parse(lines):
    """Return [{name, start, end, cards: [{name, start, end}]}] with line numbers. end is exclusive."""
    heads = [(i, re.match(r"^- (.+?):\s*$", l)) for i, l in enumerate(lines)]
    heads = [(i, unq(m.group(1))) for i, m in heads if m]
    groups = []
    for n, (i, name) in enumerate(heads):
        e = heads[n + 1][0] if n + 1 < len(heads) else len(lines)
        g = {"name": name, "start": i, "end": e, "cards": []}
        cards = [(k, re.match(r"^    - (.+?):\s*$", lines[k])) for k in range(i + 1, e)]
        cards = [(k, unq(m.group(1))) for k, m in cards if m]
        for c, (k, cn) in enumerate(cards):
            ce = cards[c + 1][0] if c + 1 < len(cards) else e
            while ce > k + 1 and (not lines[ce - 1].strip() or lines[ce - 1].lstrip().startswith("#") and indent(lines[ce - 1]) < 8):
                ce -= 1
            g["cards"].append({"name": cn, "start": k, "end": ce})
        while g["end"] > g["start"] + 1 and (not lines[g["end"] - 1].strip() or (lines[g["end"] - 1].lstrip().startswith("#") and indent(lines[g["end"] - 1]) < 4)):
            g["end"] -= 1
        groups.append(g)
    return groups


def card_fields(lines, c):
    """Return the simple lines of a card (id, href, icon, description, siteMonitor) and the type of its widget ('' when it has none)."""
    f = {}
    for k in range(c["start"] + 1, c["end"]):
        m = re.match(r"^        (id|href|icon|description|siteMonitor|target):\s*(.*?)\s*$", lines[k])
        if m:
            f[m.group(1)] = unq(m.group(2))
    w = ""
    for k in range(c["start"] + 1, c["end"]):
        if re.match(r"^        widget:\s*$", lines[k]):
            w = "yes"
            for q in range(k + 1, c["end"]):
                m = re.match(r"^          type:\s*(\S+)\s*$", lines[q])
                if m:
                    w = unq(m.group(1))
                    break
            break
    f["widget"] = w
    return f


def card_public(lines, c, group):
    f = card_fields(lines, c)
    managed = bool(f.get("widget")) or f.get("id", "").endswith("-card")
    return {"name": c["name"], "id": f.get("id", ""), "href": f.get("href", ""), "icon": f.get("icon", ""), "description": f.get("description", ""),
            "siteMonitor": f.get("siteMonitor", ""), "widget": f.get("widget", ""), "managed": managed,
            "hl": bool(HL_ID.match(f.get("id", ""))),
            "locked": f.get("id", "") in ("customize-card", "navidrome-card")}


def services_state():
    lines = read(SERVICES).split("\n")
    out = []
    for g in services_parse(lines):
        out.append({"group": g["name"], "locked": g["name"] in PROTECTED, "automatic": g["name"] in AUTOMATIC,
                    "cards": [card_public(lines, c, g["name"]) for c in g["cards"]]})
    return out


def find_card(lines, group, name):
    for g in services_parse(lines):
        if g["name"] == group:
            for c in g["cards"]:
                if c["name"] == name:
                    return g, c
    raise Fail("The card '%s' was not found in '%s'. Reload the panel and try again." % (name, group))


def set_line(lines, c, key, value):
    """Set one simple line of a card. A value of None or '' removes it. The widget lines are never touched."""
    ind = " " * 8
    idx = None
    for k in range(c["start"] + 1, c["end"]):
        if re.match(r"^        %s:\s" % re.escape(key), lines[k] + " "):
            idx = k
            break
    if value in (None, ""):
        if idx is not None:
            del lines[idx]
            c["end"] -= 1
        return
    new = "%s%s: %s" % (ind, key, yq(value))
    if idx is not None:
        lines[idx] = new
        return
    at = c["end"]
    for k in range(c["start"] + 1, c["end"]):
        if re.match(r"^        (widget|server|container|stack):", lines[k]):
            at = k
            break
    lines.insert(at, new)
    c["end"] += 1


def new_card_lines(name, href, icon, description, monitor):
    block = ["    - %s:" % yq(name)]
    if href:
        block.append("        href: %s" % yq(href))
    if monitor:
        block.append("        siteMonitor: %s" % yq(monitor))
    if icon:
        block.append("        icon: %s" % yq(icon))
    if description:
        block.append("        description: %s" % yq(description))
    return block


def tidy_blank(lines, at):
    while 0 < at < len(lines) and not lines[at].strip() and not lines[at - 1].strip():
        del lines[at]


def card_insert(lines, group, block, before=None):
    """Put a card block into a group, before the card named `before` or else at the end. A group that does not exist is created."""
    for g in services_parse(lines):
        if g["name"] == group:
            if before is not None:
                tgt = next((c for c in g["cards"] if c["name"] == before), None)
                at = tgt["start"] if tgt else None
            else:
                at = None
            if at is None:
                at = g["cards"][-1]["end"] if g["cards"] else g["start"] + 1
                ins = ([""] if lines[at - 1].strip() else []) + block + ([""] if at < len(lines) and lines[at].strip() else [])
            else:
                ins = block + [""]
            if before is None and not g["cards"]:
                ins = [""] + block + [""]
            lines[at:at] = ins
            return
    while lines and not lines[-1].strip():
        lines.pop()
    lines.extend(([""] if lines else []) + ["- %s:" % yq(group), ""] + block + [""])


def check_group_name(name):
    name = clean_text(name, "The group name", 40)
    if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
        raise Fail("The group name '%s' has characters that are not allowed." % name)
    return name


def card_values(body, managed_card=False):
    v = {"name": clean_text(body.get("name"), "The name", 60)}
    if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", v["name"]):
        raise Fail("The name '%s' has characters that are not allowed (use letters, digits, spaces and - _ . , ( ) + )." % v["name"])
    v["description"] = clean_text(body.get("description", ""), "The description", 160, True)
    v["icon"] = clean_icon(body.get("icon", ""))
    if not managed_card:
        v["href"] = clean_url(body.get("href", ""), "The address")
        v["siteMonitor"] = v["href"] if body.get("dot") and v["href"] else ""
    return v


def ensure_layout_group(tx, group, tab=None, props=None):
    text = tx.get(SETTINGS)
    gs = layout_groups(text)
    if any(g["name"] == group for g in gs) or not gs:
        return
    t = tab or layout_tabs(gs)[0]["name"]
    gs.append({"name": group, "props": dict(props or {}, tab=t), "extra": []})
    tx.put(SETTINGS, layout_write(text, gs))


def hl_adopt(lines):
    done = False
    for b, _e in HL_BLOCKS:
        for i, l in enumerate(lines):
            if l.startswith(b) and not l[len(b):].strip():
                lines[i] = b + " customized"
                done = True
    return done


def hl_lan(live_text):
    m = re.search(r"http://([A-Za-z0-9._-]+):3001/images/", live_text or "")
    return m.group(1) if m else ""


def hl_catalog():
    """Return the cards HomeLab can fill in, from the files the installer keeps next to the panel: [{id, name, group, icon, description, extra, lines}]."""
    out, seen = [], set()
    lan = hl_lan(read(SERVICES))
    for path, extra in ((SHIPPED, False), (SHIPPED_EXTRAS, True)):
        text = read(path)
        if not text:
            continue
        if lan:
            text = text.replace("192.168.X.X", lan)
        lines = text.split("\n")
        for g in services_parse(lines):
            if g["name"] not in HL_GROUP_LOOK:
                continue
            for c in g["cards"]:
                f = card_fields(lines, c)
                if not HL_ID.match(f.get("id", "")) or f["id"] in seen:
                    continue
                seen.add(f["id"])
                out.append({"id": f["id"], "name": c["name"], "group": g["name"], "icon": f.get("icon", ""), "description": f.get("description", ""),
                            "extra": extra, "lines": lines[c["start"]:c["end"]]})
    return out


def hl_state():
    lines = read(SERVICES).split("\n")
    where = {}
    for g in services_parse(lines):
        for c in g["cards"]:
            i = card_fields(lines, c).get("id", "")
            if i:
                where[i] = g["name"]
    return [{"id": c["id"], "name": c["name"], "group": c["group"], "icon": c["icon"], "description": c["description"], "extra": c["extra"],
             "in": where.get(c["id"], "")} for c in hl_catalog()]


def hl_place(tx, lines, card, group, tab=None):
    if any(c["name"] == card["name"] for g in services_parse(lines) if g["name"] == group for c in g["cards"]):
        raise Fail("The group '%s' already has a card called '%s'. Change that card's name first." % (group, card["name"]))
    card_insert(lines, group, list(card["lines"]))
    look = HL_GROUP_LOOK.get(group)
    text = tx.get(SETTINGS)
    names = [t["name"] for t in layout_tabs(layout_groups(text))] if layout_groups(text) else []
    want = tab if tab in names else (look[2] if look and look[2] in names else None)
    ensure_layout_group(tx, group, want, {"icon": look[0], "columns": str(look[1])} if look else None)


def api_hl_restore(body):
    """Put back every card HomeLab ships that was changed, moved or hidden, each in its own group. Cards the user added stay."""
    cat = [c for c in hl_catalog() if not c["extra"]]
    if not cat:
        raise Fail("The list of HomeLab's cards is not on this machine yet. Run:  sudo homelab-setup upgrade")
    tx = Tx("HomeLab cards restored")
    lines = tx.get(SERVICES).split("\n")
    hl_adopt(lines)
    ids = {c["id"] for c in cat}
    while True:
        hit = None
        for g in services_parse(lines):
            for c in g["cards"]:
                if card_fields(lines, c).get("id") in ids:
                    hit = (g, c)
                    break
            if hit:
                break
        if not hit:
            break
        g, c = hit
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            tidy_blank(lines, left["start"])
    for card in cat:
        hl_place(tx, lines, card, card["group"])
    tx.put(SERVICES, "\n".join(lines))
    tx.commit()
    return {}


def drop_layout_group(tx, group):
    text = tx.get(SETTINGS)
    gs = layout_groups(text)
    left = [g for g in gs if g["name"] != group]
    if len(left) != len(gs):
        tx.put(SETTINGS, layout_write(text, left))


def api_card(body):
    """Add, edit, remove or move cards in services.yaml."""
    op = body.get("op")
    tx = Tx({"add": "Card added", "add-list": "Cards added", "edit": "Card changed", "remove": "Card removed", "move": "Card moved"}.get(op, "Cards changed"))
    lines = tx.get(SERVICES).split("\n")
    if op == "add-list":
        want = body.get("ids")
        if not isinstance(want, list) or not want or len(want) > 40:
            raise Fail("Choose at least one card from the list.")
        cat = {c["id"]: c for c in hl_catalog()}
        here = {card_fields(lines, c).get("id") for g in services_parse(lines) for c in g["cards"]}
        hl_adopt(lines)
        for i in want:
            card = cat.get(i)
            if card is None:
                raise Fail("That card is not on the list. Reload the panel and try again.")
            if i in here:
                raise Fail("The card '%s' is already on the dashboard." % card["name"])
            group = check_group_name(body.get("group")) if body.get("group") else card["group"]
            if group in PROTECTED:
                raise Fail("Choose another group.")
            hl_place(tx, lines, card, group, body.get("tab"))
        tx.put(SERVICES, "\n".join(lines))
    elif op == "add":
        group = check_group_name(body.get("group"))
        if group in PROTECTED:
            raise Fail("The group '%s' is part of the panel itself. Put the card in another group." % group)
        if group in AUTOMATIC:
            hl_adopt(lines)
        v = card_values(body)
        if any(c["name"] == v["name"] for g in services_parse(lines) for c in g["cards"]):
            raise Fail("There is already a card called '%s'. Choose another name." % v["name"])
        card_insert(lines, group, new_card_lines(v["name"], v["href"], v["icon"], v["description"], v["siteMonitor"]))
        tx.put(SERVICES, "\n".join(lines))
        ensure_layout_group(tx, group, body.get("tab"))
    elif op == "edit":
        g, c = find_card(lines, body.get("group"), body.get("old"))
        pub = card_public(lines, c, g["name"])
        if pub["locked"]:
            raise Fail("This card is part of the panel itself and cannot be changed here.")
        if pub["hl"] or g["name"] in AUTOMATIC:
            hl_adopt(lines)
        v = card_values(body, pub["managed"])
        if v["name"] != c["name"] and any(x["name"] == v["name"] for gg in services_parse(lines) for x in gg["cards"]):
            raise Fail("There is already a card called '%s'." % v["name"])
        lines[c["start"]] = "    - %s:" % yq(v["name"])
        set_line(lines, c, "icon", v["icon"])
        set_line(lines, c, "description", v["description"])
        if not pub["managed"]:
            set_line(lines, c, "href", v["href"])
            set_line(lines, c, "siteMonitor", v["siteMonitor"])
        tx.put(SERVICES, "\n".join(lines))
    elif op == "remove":
        g, c = find_card(lines, body.get("group"), body.get("name"))
        pub = card_public(lines, c, g["name"])
        if pub["locked"]:
            raise Fail("This card is part of the panel itself and cannot be removed here.")
        if pub["hl"] or g["name"] in AUTOMATIC:
            hl_adopt(lines)
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            tx.put(SERVICES, "\n".join(lines))
            drop_layout_group(tx, g["name"])
        else:
            tx.put(SERVICES, "\n".join(lines))
    elif op == "move":
        g, c = find_card(lines, body.get("group"), body.get("name"))
        mv = card_public(lines, c, g["name"])
        if mv["locked"]:
            raise Fail("This card is part of the panel itself and cannot be moved here.")
        to = check_group_name(body.get("to") or g["name"])
        if to in PROTECTED:
            raise Fail("The group '%s' is part of the panel itself. Choose another group." % to)
        if mv["hl"] or g["name"] in AUTOMATIC or to in AUTOMATIC:
            hl_adopt(lines)
        block = lines[c["start"]:c["end"]]
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        card_insert(lines, to, block, before=body.get("before"))
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            drop_layout_group(tx, g["name"])
        tx.put(SERVICES, "\n".join(lines))
        ensure_layout_group(tx, to, body.get("tab"))
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


MYTHEMES = os.path.join(HP, ".panel-themes.json")
MYTHEME_ID = re.compile(r"^my-[a-z0-9]{4,24}$")
MAX_MYTHEMES = 24
MYTHEME_PARTS = ("look", "background", "layout", "cards")


def mythemes_load():
    try:
        data = json.loads(read(MYTHEMES) or "{}")
        lst = data.get("themes") if isinstance(data, dict) else None
        return [t for t in lst if isinstance(t, dict) and MYTHEME_ID.match(str(t.get("id", "")))] if isinstance(lst, list) else []
    except ValueError:
        return []


def mythemes_save(lst):
    write_atomic(MYTHEMES, json.dumps({"version": 1, "themes": lst}, indent=1, sort_keys=True), 0o644)


def mythemes_state():
    out = []
    for t in mythemes_load():
        parts = [p for p in MYTHEME_PARTS if p in t]
        look = t.get("look") or {}
        out.append({"id": t["id"], "name": t.get("name", ""), "blurb": t.get("blurb", ""), "mine": True, "parts": parts, "look": look, "background": t.get("background"),
                    "ui": t.get("ui") or {}, "paintAll": look.get("paintAll", ""), "palette": [],
                    "counts": {"tabs": len(t.get("layout") or []), "cards": sum(len(g.get("cards", [])) for g in (t.get("cards") or {}).get("groups", []))}})
    return out


def layout_snapshot():
    out = []
    for t in layout_tabs(layout_groups(read(SETTINGS))):
        out.append({"name": t["name"], "groups": [{"name": g["name"], "icon": g["props"].get("icon", ""), "style": g["props"].get("style", ""),
                                                   "columns": str(g["props"].get("columns", ""))} for g in t["groups"]]})
    return out


def cards_snapshot():
    lines = read(SERVICES).split("\n")
    groups = []
    for g in services_parse(lines):
        if g["name"] in PROTECTED:
            continue
        cards = []
        for c in g["cards"]:
            pub = card_public(lines, c, g["name"])
            if pub["locked"]:
                continue
            kind = "hl" if pub["hl"] else ("managed" if pub["managed"] else "own")
            item = {"key": pub["id"] or c["name"], "id": pub["id"], "name": c["name"], "icon": pub["icon"], "description": pub["description"], "kind": kind}
            if kind == "own":
                item["href"], item["siteMonitor"] = pub["href"], pub["siteMonitor"]
            cards.append(item)
        if cards:
            groups.append({"group": g["name"], "cards": cards})
    return {"groups": groups}


def mytheme_background(raw, tid, old_image=None):
    """Check the picture settings of a theme. A picture on this machine is copied to a file of the theme's own, so replacing the background later does not change it."""
    if not isinstance(raw, dict):
        raise Fail("The picture settings are missing.")
    out = {}
    img = raw.get("image") or ""
    if img.startswith("/images/"):
        name = img[len("/images/"):]
        src = os.path.join(IMAGES, name)
        if not re.fullmatch(r"[A-Za-z0-9._-]{1,120}", name) or not os.path.isfile(src):
            raise Fail("The background picture cannot be found. Choose it again on the Look screen.")
        ext = os.path.splitext(name)[1].lower()
        mine = "theme-%s%s" % (tid, ext)
        if name != mine:
            shutil.copyfile(src, os.path.join(IMAGES, mine))
            os.chmod(os.path.join(IMAGES, mine), 0o644)
        img = "/images/" + mine
    elif img:
        img = clean_url(img, "The picture address")
    out["image"] = img
    b = raw.get("blur")
    if b in (None, "", "none"):
        out["blur"] = "none"
    elif b in BLURS:
        out["blur"] = b
    else:
        raise Fail("The blur must be none or one of: %s." % ", ".join(BLURS))
    for k in ("saturate", "brightness", "opacity"):
        out[k] = number(raw.get(k, BG_DEFAULT[k]), k.capitalize(), 0, 100)
    return out


def api_mytheme(body):
    """Create, apply, rename and delete the user's saved themes."""
    op = body.get("op")
    lst = mythemes_load()
    if op == "create":
        if len(lst) >= MAX_MYTHEMES:
            raise Fail("The limit of %d themes has been reached. Delete one first." % MAX_MYTHEMES)
        name = clean_text(body.get("name"), "The theme name", 30)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
            raise Fail("The name '%s' has characters that are not allowed (use letters, digits, spaces and - _ . , ( ) + )." % name)
        if any(t.get("name", "").lower() == name.lower() for t in lst) or any(t["name"].lower() == name.lower() for t in LOOK_THEMES):
            raise Fail("There is already a theme called '%s'. Choose another name." % name)
        parts = body.get("parts")
        if not isinstance(parts, list) or not parts or any(p not in MYTHEME_PARTS for p in parts):
            raise Fail("Select at least one item for the theme to contain.")
        tid = "my-" + secrets.token_hex(4)
        t = {"id": tid, "name": name, "blurb": clean_text(body.get("blurb", ""), "The description", 90, True) or "Your own theme.", "created": int(time.time())}
        if "look" in parts:
            custom = look_clean(body.get("look"))
            custom["theme"] = tid
            t["look"] = custom
            ui = body.get("ui")
            if isinstance(ui, dict):
                t["ui"] = {k: str(v)[:140] for k, v in ui.items() if k in ("bg", "panel", "panel2", "line", "field", "dialog", "blur", "rim") and re.fullmatch(r"[#A-Za-z0-9 .,()%-]+", str(v))}
        if "background" in parts:
            t["background"] = mytheme_background(body.get("background"), tid)
        if "layout" in parts:
            t["layout"] = layout_snapshot()
        if "cards" in parts:
            t["cards"] = cards_snapshot()
        lst.append(t)
        mythemes_save(lst)
        return {"id": tid}
    t = next((x for x in lst if x["id"] == body.get("id")), None)
    if t is None:
        raise Fail("The theme was not found. Reload the panel and try again.")
    if op == "rename":
        name = clean_text(body.get("name"), "The theme name", 30)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
            raise Fail("The name '%s' has characters that are not allowed." % name)
        if any(x is not t and x.get("name", "").lower() == name.lower() for x in lst) or any(x["name"].lower() == name.lower() for x in LOOK_THEMES):
            raise Fail("There is already a theme called '%s'." % name)
        t["name"] = name
        t["blurb"] = clean_text(body.get("blurb", t.get("blurb", "")), "The description", 90, True)
        mythemes_save(lst)
    elif op == "delete":
        lst.remove(t)
        mythemes_save(lst)
        if os.path.isdir(IMAGES):
            for f in os.listdir(IMAGES):
                if re.fullmatch(r"theme-%s\.\w+" % re.escape(t["id"]), f):
                    try:
                        os.remove(os.path.join(IMAGES, f))
                    except OSError:
                        pass
    elif op == "apply":
        if "cards" not in t and "layout" not in t:
            return {"changed": False}
        tx = Tx("Theme “%s”: layout and cards" % t.get("name", ""))
        if "cards" in t:
            cards_apply(tx, t["cards"])
        if "layout" in t:
            layout_apply(tx, t["layout"])
        tx.commit()
        return {"changed": True}
    else:
        raise Fail("Unknown action.")
    return {}


def layout_apply(tx, snap):
    """Apply a theme's tabs, group order, icons, styles and columns to the groups that exist now. Groups the theme does not know stay on their tab."""
    text = tx.get(SETTINGS)
    cur = layout_groups(text)
    if not cur:
        return
    state = {g["name"]: g for g in cur}
    out, seen = [], set()
    for t in snap if isinstance(snap, list) else []:
        tname = str(t.get("name", ""))
        if not tname or not re.fullmatch(r"[^\"'\\{};<>/*:#]+", tname) or len(tname) > 24:
            continue
        for g in t.get("groups") or []:
            n = g.get("name")
            if n not in state or n in seen:
                continue
            seen.add(n)
            props = dict(state[n]["props"])
            props["tab"] = tname
            icon = g.get("icon", "")
            try:
                icon = clean_icon(icon)
            except Fail:
                icon = ""
            props["icon"] = icon
            if not icon:
                props.pop("icon")
            for k, ok in (("style", ("row", "column")), ("columns", tuple(str(i) for i in range(1, 9)))):
                v = str(g.get(k, "") or "")
                if v in ok:
                    props[k] = v
                else:
                    props.pop(k, None)
            out.append({"name": n, "props": props, "extra": state[n]["extra"]})
    out.extend(g for g in cur if g["name"] not in seen)
    tx.put(SETTINGS, layout_write(text, out))


def cards_apply(tx, snap):
    """Put the cards the way a theme had them: names, icons, texts, groups and order. A card that is gone is created again when HomeLab fills it in or the user made it."""
    lines = tx.get(SERVICES).split("\n")
    want = [(g["group"], c) for g in (snap.get("groups") if isinstance(snap, dict) else []) or [] for c in g.get("cards", [])]
    catalog = {c["id"]: c for c in hl_catalog()}
    if any(c.get("kind") == "hl" for _g, c in want) or any(HL_ID.match(i) for i in card_ids(lines)):
        hl_adopt(lines)

    def find(item):
        for g in services_parse(lines):
            for c in g["cards"]:
                f = card_fields(lines, c)
                if item.get("id"):
                    if f.get("id") == item["id"]:
                        return g, c
                elif not f.get("id") and c["name"] == item.get("key"):
                    return g, c
        if item.get("kind") == "own" and item.get("href"):
            for g in services_parse(lines):
                for c in g["cards"]:
                    f = card_fields(lines, c)
                    if not f.get("id") and not f.get("widget") and f.get("href") == item["href"]:
                        return g, c
        return None

    for group, item in want:
        try:
            group = check_group_name(group)
        except Fail:
            continue
        got = find(item)
        if got is None:
            if item.get("kind") == "hl" and item.get("id") in catalog:
                card = dict(catalog[item["id"]])
                try:
                    hl_place(tx, lines, card, group)
                except Fail:
                    continue
                got = find(item)
            elif item.get("kind") == "own" and item.get("name"):
                try:
                    v = card_values({"name": item["name"], "description": item.get("description", ""), "icon": item.get("icon", ""), "href": item.get("href", ""),
                                     "dot": bool(item.get("siteMonitor"))})
                except Fail:
                    continue
                if any(x["name"] == v["name"] for g in services_parse(lines) if g["name"] == group for x in g["cards"]):
                    continue
                card_insert(lines, group, new_card_lines(v["name"], v["href"], v["icon"], v["description"], v["siteMonitor"]))
                ensure_layout_group(tx, group)
                got = find(item)
        if got is None:
            continue
        g, c = got
        pub = card_public(lines, c, g["name"])
        if pub["locked"]:
            continue
        nm = item.get("name") or c["name"]
        if nm != c["name"] and not any(x["name"] == nm for gg in services_parse(lines) if gg["name"] == group for x in gg["cards"]) and re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", nm) and len(nm) <= 60:
            lines[c["start"]] = "    - %s:" % yq(nm)
        try:
            set_line(lines, c, "icon", clean_icon(item.get("icon", "")))
        except Fail:
            pass
        try:
            set_line(lines, c, "description", clean_text(item.get("description", ""), "The description", 160, True))
        except Fail:
            pass
        block = lines[c["start"]:c["end"]]
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        card_insert(lines, group, block)
        ensure_layout_group(tx, group)
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            drop_layout_group(tx, g["name"])
    sids = {c["id"] for _g, c in want if c.get("id")}
    skeys = {c.get("key") for _g, c in want if not c.get("id")}
    for _ in range(200):
        hit = None
        for g in services_parse(lines):
            for c in g["cards"]:
                i = card_fields(lines, c).get("id", "")
                if HL_ID.match(i) and i not in sids:
                    hit = (g, c)
                    break
            if hit:
                break
        if not hit:
            break
        g, c = hit
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        left = next((x for x in services_parse(lines) if x["name"] == g["name"]), None)
        if left is not None and not left["cards"]:
            del lines[left["start"]:left["end"]]
            tidy_blank(lines, left["start"])
            drop_layout_group(tx, g["name"])
    gnames = {g for g, _c in want}
    later = []
    for g in services_parse(lines):
        if g["name"] in gnames:
            for c in g["cards"]:
                i = card_fields(lines, c).get("id", "")
                if not ((i in sids) if i else (c["name"] in skeys)):
                    later.append((g["name"], c["name"], i))
    for gname, cname, i in later:
        g = next((x for x in services_parse(lines) if x["name"] == gname), None)
        c = next((x for x in (g["cards"] if g else []) if x["name"] == cname and card_fields(lines, x).get("id", "") == i), None)
        if c is None:
            continue
        block = lines[c["start"]:c["end"]]
        del lines[c["start"]:c["end"]]
        tidy_blank(lines, c["start"])
        card_insert(lines, gname, block)
    tx.put(SERVICES, "\n".join(lines))


def card_ids(lines):
    return [card_fields(lines, c).get("id", "") for g in services_parse(lines) for c in g["cards"]]


def marks_parse(text):
    """Return (the comment lines at the top, [{name, links: [{name, abbr, href, icon, description, extra}]}]) from bookmarks.yaml."""
    lines = text.split("\n")
    head, groups, cur, ent = [], [], None, None
    for l in lines:
        m = re.match(r"^- (.+?):\s*$", l)
        if m:
            cur = {"name": unq(m.group(1)), "links": []}
            groups.append(cur)
            ent = None
            continue
        if cur is None:
            if l.strip():
                head.append(l)
            continue
        m = re.match(r"^    - (.+?):\s*$", l)
        if m:
            ent = {"name": unq(m.group(1)), "abbr": "", "href": "", "icon": "", "description": "", "extra": []}
            cur["links"].append(ent)
            continue
        if ent is None or not l.strip():
            continue
        m = re.match(r"^\s+(?:- )?([A-Za-z][A-Za-z0-9_]*):\s*(.*?)\s*$", l)
        if m and m.group(1) in ("abbr", "href", "icon", "description"):
            ent[m.group(1)] = unq(m.group(2))
        elif m and l.strip() != "-":
            ent["extra"].append((m.group(1), m.group(2)))
    return head, groups


def marks_write(head, groups):
    out = list(head)
    for g in groups:
        out.append("- %s:" % yq(g["name"]))
        for e in g["links"]:
            out.append("    - %s:" % yq(e["name"]))
            fields = [(k, yq(e[k])) for k in ("abbr", "href", "icon", "description") if e.get(k)] + list(e["extra"])
            if not fields:
                fields = [("href", '""')]
            for n, (k, v) in enumerate(fields):
                out.append("        %s%s: %s" % ("- " if n == 0 else "  ", k, v))
            out.append("")
        if not g["links"]:
            out.append("")
    while out and not out[-1].strip():
        out.pop()
    return "\n".join(out) + "\n"


def marks_state():
    return [{"group": g["name"], "links": [{k: e[k] for k in ("name", "abbr", "href", "icon", "description")} for e in g["links"]]}
            for g in marks_parse(read(BOOKMARKS))[1]]


def abbr_of(name):
    w = re.sub(r"[^A-Za-z0-9 ]", "", name).split()
    return (w[0][:4] if len(w) == 1 else "".join(x[0] for x in w[:4])).upper()


def api_link(body):
    """Add, edit, remove or move bookmarks and bookmark groups."""
    op = body.get("op")
    tx = Tx({"add": "Link added", "edit": "Link changed", "remove": "Link removed", "move": "Link moved", "group-add": "Link group added",
             "group-rename": "Link group renamed", "group-remove": "Link group removed"}.get(op, "Links changed"))
    head, groups = marks_parse(tx.get(BOOKMARKS))

    def grp(name):
        g = next((x for x in groups if x["name"] == name), None)
        if not g:
            raise Fail("The group '%s' was not found. Reload the panel and try again." % name)
        return g

    def link(g, name):
        e = next((x for x in g["links"] if x["name"] == name), None)
        if not e:
            raise Fail("The link '%s' was not found. Reload the panel and try again." % name)
        return e

    def values(b):
        name = clean_text(b.get("name"), "The name", 60)
        if not re.fullmatch(r"[^\"'\\{};<>/*:#\[\]|`]+", name):
            raise Fail("The name '%s' has characters that are not allowed." % name)
        href = clean_url(b.get("href"), "The address", False)
        abbr = clean_text(b.get("abbr", ""), "The short label", 6, True) or abbr_of(name)
        if not re.fullmatch(r"[A-Za-z0-9 ]{1,6}", abbr):
            raise Fail("The short label can have up to 6 letters or digits.")
        return {"name": name, "abbr": abbr, "href": href, "icon": clean_icon(b.get("icon", "")),
                "description": clean_text(b.get("description", ""), "The description", 120, True), "extra": []}

    if op == "add":
        gname = check_group_name(body.get("group"))
        g = next((x for x in groups if x["name"] == gname), None)
        if g is None:
            g = {"name": gname, "links": []}
            groups.append(g)
        e = values(body)
        if any(x["name"] == e["name"] for gg in groups for x in gg["links"]):
            raise Fail("There is already a link called '%s'. Choose another name." % e["name"])
        g["links"].append(e)
        tx.put(BOOKMARKS, marks_write(head, groups))
        ensure_layout_group(tx, gname, body.get("tab") or "Links")
    elif op == "edit":
        g = grp(body.get("group"))
        e = link(g, body.get("old"))
        v = values(body)
        if v["name"] != e["name"] and any(x["name"] == v["name"] for gg in groups for x in gg["links"]):
            raise Fail("There is already a link called '%s'." % v["name"])
        v["extra"] = e["extra"]
        e.update(v)
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "remove":
        g = grp(body.get("group"))
        g["links"].remove(link(g, body.get("name")))
        if not g["links"]:
            groups.remove(g)
            drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "move":
        g = grp(body.get("group"))
        e = link(g, body.get("name"))
        to = check_group_name(body.get("to") or g["name"])
        tg = next((x for x in groups if x["name"] == to), None)
        if tg is None:
            tg = {"name": to, "links": []}
            groups.append(tg)
        g["links"].remove(e)
        before = body.get("before")
        at = next((i for i, x in enumerate(tg["links"]) if x["name"] == before), len(tg["links"]))
        tg["links"].insert(at, e)
        if not g["links"]:
            groups.remove(g)
            drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
        ensure_layout_group(tx, to, body.get("tab") or "Links")
    elif op == "group-rename":
        g = grp(body.get("group"))
        new = check_group_name(body.get("to"))
        if any(x["name"] == new for x in groups):
            raise Fail("There is already a group called '%s'." % new)
        text = tx.get(SETTINGS)
        gs = layout_groups(text)
        for x in gs:
            if x["name"] == g["name"]:
                x["name"] = new
        tx.put(SETTINGS, layout_write(text, gs))
        g["name"] = new
        tx.put(BOOKMARKS, marks_write(head, groups))
    elif op == "group-remove":
        g = grp(body.get("group"))
        groups.remove(g)
        drop_layout_group(tx, g["name"])
        tx.put(BOOKMARKS, marks_write(head, groups))
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


def api_group(body):
    """Rename or remove a whole group of cards on the dashboard. Groups HomeLab keeps up to date cannot be removed."""
    op = body.get("op")
    name = body.get("group")
    if name in AUTOMATIC or name in PROTECTED:
        raise Fail("The group '%s' is kept up to date by HomeLab and cannot be changed here." % name)
    tx = Tx("Group changed")
    lines = tx.get(SERVICES).split("\n")
    g = next((x for x in services_parse(lines) if x["name"] == name), None)
    if g is None:
        raise Fail("The group '%s' was not found. Reload the panel and try again." % name)
    if op == "rename":
        new = check_group_name(body.get("to"))
        if any(x["name"] == new for x in services_parse(lines)):
            raise Fail("There is already a group called '%s'." % new)
        lines[g["start"]] = "- %s:" % yq(new)
        tx.put(SERVICES, "\n".join(lines))
        text = tx.get(SETTINGS)
        gs = layout_groups(text)
        for x in gs:
            if x["name"] == name:
                x["name"] = new
        tx.put(SETTINGS, layout_write(text, gs))
    elif op == "remove":
        if any(card_public(lines, c, name)["locked"] for c in g["cards"]):
            raise Fail("This group has a card HomeLab keeps up to date. Remove the other cards one by one.")
        del lines[g["start"]:g["end"]]
        tx.put(SERVICES, "\n".join(lines))
        drop_layout_group(tx, name)
    else:
        raise Fail("Unknown action.")
    tx.commit()
    return {}


def hash_password(pw, salt=None):
    salt = salt or secrets.token_bytes(16)
    h = hashlib.scrypt(pw.encode("utf-8"), salt=salt, n=2 ** 14, r=8, p=1, dklen=32)
    return "scrypt$%s$%s" % (base64.b64encode(salt).decode(), base64.b64encode(h).decode())


def check_password(pw):
    txt = read(PASSFILE).strip()
    m = re.fullmatch(r"scrypt\$([A-Za-z0-9+/=]+)\$([A-Za-z0-9+/=]+)", txt)
    if not m:
        return False
    salt = base64.b64decode(m.group(1))
    return hmac.compare_digest(hash_password(pw, salt), txt)


def password_problem(pw):
    if len(pw) < 10:
        return "The password must be at least 10 characters."
    if pw.strip() != pw:
        return "The password cannot start or end with a space."
    return ""


def set_password(pw):
    p = password_problem(pw)
    if p:
        raise Fail(p)
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    write_atomic(PASSFILE, hash_password(pw) + "\n", 0o600)
    SESSIONS.clear()


SESSIONS = {}
FAILS = {"count": 0, "until": 0.0}


def login(pw):
    now = time.time()
    if now < FAILS["until"]:
        raise Fail("Too many wrong passwords. Wait %d seconds and try again." % int(FAILS["until"] - now + 1), 429)
    if not os.path.exists(PASSFILE):
        raise Fail("No password is set yet. In a terminal on the server, run:  homelab panel password", 403)
    if not isinstance(pw, str) or not check_password(pw):
        FAILS["count"] += 1
        FAILS["until"] = now + min(300, 2 ** min(FAILS["count"], 8)) if FAILS["count"] >= 4 else 0.0
        raise Fail("That is not the password.", 401)
    FAILS["count"], FAILS["until"] = 0, 0.0
    tok = secrets.token_urlsafe(32)
    SESSIONS[tok] = {"created": now, "seen": now, "pw": pw_version()}
    for t in [t for t, s in SESSIONS.items() if now - s["seen"] > SESSION_IDLE or now - s["created"] > SESSION_MAX]:
        del SESSIONS[t]
    return tok


def pw_version():
    try:
        return os.stat(PASSFILE).st_mtime_ns
    except OSError:
        return 0


def session_ok(tok):
    s = SESSIONS.get(tok or "")
    now = time.time()
    if not s or now - s["seen"] > SESSION_IDLE or now - s["created"] > SESSION_MAX or s["pw"] != pw_version():
        SESSIONS.pop(tok or "", None)
        return False
    s["seen"] = now
    return True


def paint_state():
    """Return the cards, tiles, bookmarks and group labels that the Colors screen lists."""
    lines = read(SERVICES).split("\n")
    css = read(CSS)
    look_accent = look_full(look_get(css))["accent"]
    cards, stats, cal, labels = [], [], [], []
    for g in services_parse(lines):
        if g["name"] not in PROTECTED and g["name"] not in labels:
            labels.append(g["name"])
        for c in g["cards"]:
            cid = card_fields(lines, c).get("id", "")
            if not cid or cid in NO_PAINT or not re.fullmatch(r"[A-Za-z0-9_-]+", cid):
                continue
            tile = cid.startswith(("stat-", "cal-"))
            acc = shipped_accent(css, cid)
            col = rgb_to_hex(acc) if acc else ("#94a3b8" if tile else look_accent)
            (stats if cid.startswith("stat-") else cal if cid.startswith("cal-") else cards).append({"id": cid, "name": c["name"], "group": g["name"], "color": col})
    links = []
    for g in marks_parse(read(BOOKMARKS))[1]:
        if g["name"] not in labels:
            labels.append(g["name"])
        gcol = rgb_to_hex(shipped_group_accent(css, slugify(g["name"])) or "148, 163, 184")
        links += [{"name": e["name"], "group": g["name"], "color": gcol} for e in g["links"]]
    return {"cards": cards, "stats": stats, "calendar": cal, "links": links, "labels": labels}


ICON_CACHE_DAYS = 30
ICON_TREE_URLS = [os.environ["HLP_ICON_TREE"]] if os.environ.get("HLP_ICON_TREE") else [
    "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/tree.json", "https://raw.githubusercontent.com/homarr-labs/dashboard-icons/main/tree.json"]
ICON_MDI_URLS = [os.environ["HLP_ICON_MDI"]] if os.environ.get("HLP_ICON_MDI") else [
    "https://cdn.jsdelivr.net/npm/@mdi/svg@7.4.47/meta.json", "https://raw.githubusercontent.com/Templarian/MaterialDesign-SVG/master/meta.json"]


def fetch_json(urls):
    for u in urls:
        try:
            if u.startswith("/"):
                with open(u, "rb") as f:
                    raw = f.read(8_000_000)
            else:
                req = urllib.request.Request(u, headers={"User-Agent": "homelab-panel"})
                with urllib.request.urlopen(req, timeout=20) as r:
                    raw = r.read(8_000_000)
            return json.loads(raw.decode("utf-8"))
        except (OSError, ValueError, urllib.error.URLError):
            continue
    return None


def icon_index():
    """Return {"apps": [names like plex.svg], "mdi": [names like home-outline]} from the icon lists the dashboard uses. The lists are downloaded once and kept for a month."""
    cache = os.path.join(STATE_DIR, "icons.json")
    try:
        with open(cache, encoding="utf-8") as f:
            have = json.load(f)
    except (OSError, ValueError):
        have = None
    if have and time.time() - have.get("time", 0) < ICON_CACHE_DAYS * 86400:
        return have["data"]
    tree, meta = fetch_json(ICON_TREE_URLS), fetch_json(ICON_MDI_URLS)
    data = {"apps": (have or {}).get("data", {}).get("apps", []), "mdi": (have or {}).get("data", {}).get("mdi", [])}
    if isinstance(tree, dict):
        svg = [x for x in tree.get("svg", []) if isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,80}\.svg", x)]
        have_svg = {x[:-4] for x in svg}
        png = [x for x in tree.get("png", []) if isinstance(x, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,80}\.png", x) and x[:-4] not in have_svg]
        data["apps"] = sorted(svg + png)
    if isinstance(meta, list):
        data["mdi"] = sorted({m["name"] for m in meta if isinstance(m, dict) and isinstance(m.get("name"), str) and re.fullmatch(r"[a-z0-9-]{1,60}", m["name"])})
    if data["apps"] or data["mdi"]:
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            write_atomic(cache, json.dumps({"time": time.time(), "data": data}), 0o600)
        except OSError:
            pass
    return data


GEOCODE_API = os.environ.get("HLP_GEOCODE_API") or "https://geocoding-api.open-meteo.com"
ZONE_NAME = re.compile(r"[A-Za-z0-9_+/-]{1,60}\Z")


def widget_block(text, key):
    m = re.search(r"(- %s:)(.*?)(\n- |\Z)" % key, text, re.S)
    return (m.start(2), m.end(2)) if m else None


def location_state():
    text = read(WIDGETS)
    out = {"timeZone": "", "city": "", "lat": None, "lon": None, "zones": sorted(zoneinfo.available_timezones())}
    b = widget_block(text, "datetime")
    if b:
        m = re.search(r"\n\s+timeZone:\s*(\S+)", text[b[0]:b[1]])
        out["timeZone"] = m.group(1).strip("\"'") if m else ""
    b = widget_block(text, "openmeteo")
    if b:
        blk = text[b[0]:b[1]]
        m = re.search(r"\n\s+label:\s*(.*)", blk)
        out["city"] = m.group(1).strip().strip("\"'") if m else ""
        for key, k in (("lat", "latitude"), ("lon", "longitude")):
            m = re.search(r"\n\s+%s:\s*(-?[0-9.]+)" % k, blk)
            out[key] = float(m.group(1)) if m else None
    return out


def api_location_search(body):
    """Search cities by name with Open-Meteo's free search. The page shows the results and the person picks one."""
    q = str(body.get("q") or "").strip()[:60]
    if not q:
        raise Fail("Type the name of a city first.")
    try:
        req = urllib.request.Request(GEOCODE_API + "/v1/search?count=6&language=en&format=json&name=" + urllib.parse.quote(q), headers={"User-Agent": "homelab-panel"})
        with urllib.request.urlopen(req, timeout=15) as r:
            js = json.loads(r.read().decode("utf-8", "replace"))
    except (OSError, ValueError):
        raise Fail("The city search did not respond. Check that the server is online and try again.") from None
    found = []
    for r in js.get("results") or []:
        try:
            found.append({"name": str(r["name"]), "region": str(r.get("admin1") or ""), "country": str(r.get("country") or ""),
                          "lat": float(r["latitude"]), "lon": float(r["longitude"])})
        except (KeyError, TypeError, ValueError):
            continue
    return {"places": found}


def api_location_save(body):
    """Save the chosen city and time zone."""
    tz = str(body.get("timeZone") or "").strip()
    place = body.get("place")
    tx = Tx("Time zone and city changed")
    text = tx.get(WIDGETS)
    if tz:
        if not ZONE_NAME.match(tz) or tz not in zoneinfo.available_timezones():
            raise Fail("That is not a valid time zone name. Choose one from the list, for example America/New_York.")
        b = widget_block(text, "datetime")
        if not b:
            raise Fail("The dashboard has no clock widget in widgets.yaml, so there is nothing to set.")
        blk = text[b[0]:b[1]]
        if re.search(r"\n\s+timeZone:", blk):
            blk = re.sub(r"(\n\s+timeZone:).*", lambda m: "%s %s" % (m.group(1), tz), blk, count=1)
        else:
            f = re.search(r"\n(\s+)format:[^\n]*", blk)
            blk = (blk[:f.end()] + "\n%s  timeZone: %s" % (f.group(1), tz) + blk[f.end():]) if f else blk.rstrip("\n") + "\n    format:\n      timeZone: %s\n" % tz
        text = text[:b[0]] + blk + text[b[1]:]
    if place:
        try:
            name, lat, lon = str(place["name"]).strip(), float(place["lat"]), float(place["lon"])
        except (KeyError, TypeError, ValueError):
            raise Fail("The city is not valid. Search for it again and choose one from the list.") from None
        if not name or len(name) > 60 or not (-90 <= lat <= 90 and -180 <= lon <= 180):
            raise Fail("The city is not valid. Search for it again and choose one from the list.")
        b = widget_block(text, "openmeteo")
        if not b:
            raise Fail("The dashboard has no weather widget in widgets.yaml, so there is nothing to set.")
        blk = text[b[0]:b[1]]
        label = name.replace("\\", "").replace('"', "")
        blk = re.sub(r"(\n\s+label:).*", lambda m: '%s "%s"' % (m.group(1), label), blk, count=1)
        blk = re.sub(r"(\n\s+latitude:).*", lambda m: "%s %.4f" % (m.group(1), lat), blk, count=1)
        blk = re.sub(r"(\n\s+longitude:).*", lambda m: "%s %.4f" % (m.group(1), lon), blk, count=1)
        text = text[:b[0]] + blk + text[b[1]:]
    if not tz and not place:
        raise Fail("Nothing to save.")
    tx.put(WIDGETS, text)
    tx.commit()
    return {}


def full_state():
    h = history_last()
    return {"version": VERSION, "look": look_state(), "background": bg_state(), "layout": layout_state(), "services": services_state(), "hlcards": hl_state(), "mythemes": mythemes_state(),
            "links": marks_state(), "location": location_state(), "paint": paint_state(), "undo": (h[1]["label"] if h else ""), "automatic": sorted(AUTOMATIC), "protected": sorted(PROTECTED)}


DRIVES_GATE = threading.Condition()
DRIVES_STATE = {"readers": 0, "changing": False}
DRIVE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
DRIVE_NAME = re.compile(r"[A-Za-z0-9 .()+,-]{1,40}\Z")
DRIVE_TIMEOUT = {"status": 90, "actions": 90, "setups": 120, "health": 180, "check": 180, "remount": 600, "apps": 60}
DRIVE_WORD = re.compile(r"(ERASE|CONTINUE|REMOVE|KEEP|NOW|RESTORE|START|/dev/[a-z0-9]{1,16}|pool|mirror|snapraid1|snapraid2|zfs-stripe|zfs-mirror|zfs-raidz1|zfs-raidz2|zfs-raidz3|md-raid0|md-raid1|md-raid5|md-raid6|md-raid10)\Z")
JOB_MAX_SECONDS = 8 * 3600
JOB = {"id": 0, "running": False, "action": "", "lines": [], "rc": None, "message": "", "started": 0, "items": [], "progress": {}, "current": "", "stopping": False}
JOB_LOCK = threading.Lock()


def drives_problem(rc, text):
    low = text.lower()
    if rc == 127 or "command not found" in low or "no such file" in low:
        return "The drives tool is not installed on this machine, so the Drives tab has nothing to work with."
    if "password is required" in low or "not allowed" in low or "may not run sudo" in low or "no tty present" in low:
        return "The Drives tab is not allowed to use the drives tool yet. On the server, run:  sudo homelab-setup upgrade"
    if rc == 124:
        return "The drives tool took too long. Nothing further was started. Try again shortly."
    lines = [x.strip() for x in text.splitlines() if x.strip() and not x.startswith("WARNING")]
    return " ".join(lines[-3:])[:400] or "The drives tool failed (code %d)." % rc


DRIVES_BUSY_MSG = "A drive change is running right now. This page shows its progress."


def drives_look_begin():
    with DRIVES_GATE:
        if DRIVES_STATE["changing"]:
            raise Fail(DRIVES_BUSY_MSG, 409)
        DRIVES_STATE["readers"] += 1


def drives_look_end():
    with DRIVES_GATE:
        DRIVES_STATE["readers"] -= 1
        DRIVES_GATE.notify_all()


def drives_change_begin(wait=30):
    with DRIVES_GATE:
        if DRIVES_STATE["changing"]:
            raise Fail("Another drive command is running. Try again shortly.", 409)
        DRIVES_STATE["changing"] = True
        if not DRIVES_GATE.wait_for(lambda: DRIVES_STATE["readers"] == 0, timeout=wait):
            DRIVES_STATE["changing"] = False
            DRIVES_GATE.notify_all()
            raise Fail("The drives are still being read. Try again shortly.", 409)


def drives_change_end():
    with DRIVES_GATE:
        DRIVES_STATE["changing"] = False
        DRIVES_GATE.notify_all()


def drives_run(words, timeout, look=False):
    """Run `drives panel WORDS...` and return (returncode, stdout, stderr). Reading commands can run together; a change runs alone."""
    if look:
        drives_look_begin()
    else:
        drives_change_begin()
    try:
        try:
            p = subprocess.run(DRIVES_CMD + ["panel"] + words, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
            return p.returncode, p.stdout or "", p.stderr or ""
        except FileNotFoundError:
            return 127, "", "command not found"
        except subprocess.TimeoutExpired:
            return 124, "", "timed out"
    finally:
        if look:
            drives_look_end()
        else:
            drives_change_end()


def drives_json(action, extra=()):
    rc, out, err = drives_run([action] + list(extra), DRIVE_TIMEOUT[action], look=True)
    try:
        data = json.loads(out)
    except ValueError:
        raise Fail(drives_problem(rc, err or out), 502 if rc != 124 else 504) from None
    if not isinstance(data, dict):
        raise Fail("The drives tool returned a response that the panel cannot read.", 502)
    return data


DRIVES_LAST = {"state": None}
DRIVES_LAST_FILE = os.path.join(STATE_DIR, "drives-last.json")


def drives_last_load():
    if DRIVES_LAST["state"] is None:
        try:
            with open(DRIVES_LAST_FILE) as f:
                data = json.load(f)
            if isinstance(data, dict) and isinstance(data.get("status"), dict):
                DRIVES_LAST["state"] = data
        except (OSError, ValueError):
            pass
    return DRIVES_LAST["state"]


def api_drives_state():
    """Return the pools, drives and last backup, plus what can be renamed or put to sleep. While a change is running the drives are not read, so the last state is returned."""
    try:
        st = drives_json("status")
        ac = drives_json("actions")
    except Fail as e:
        last = drives_last_load() if e.code == 409 and DRIVES_STATE["changing"] else None
        if last is None:
            raise
        return dict(last, stale=True)
    state = {"status": st, "actions": ac}
    DRIVES_LAST["state"] = state
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = DRIVES_LAST_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, DRIVES_LAST_FILE)
    except OSError:
        pass
    return state


def drive_message(out, err, limit=600, problem=False):
    """Turn the drives tool's output into a short message for the page. A finished change is reported by its "Done." line alone."""
    lines = []
    for x in (out + "\n" + err).splitlines():
        x = x.strip()
        if not x or x.startswith(("Starting containers", "Stopping", "WARNING: Not safe to continue now")):
            continue
        if re.fullmatch(r"[-\u2014\u2500=_ ]+", x) or x.startswith(("\u2014", "\u2500")) or "\u2014\u2014" in x:
            continue
        lines.append(x)
    if not problem:
        for x in lines:
            if x.startswith("Done"):
                return x[:limit]
    else:
        errors = [x[len("ERROR:"):].strip() for x in lines if x.startswith("ERROR:")]
        warned = [x[len("WARNING:"):].strip() for x in lines if x.startswith("WARNING:") and "lazy unmount" not in x]
        if errors:
            lines = errors
        elif warned:
            lines = warned
    while len(lines) > 1 and len(" ".join(lines)) > limit:
        lines.pop(0)
    return " ".join(lines)[-limit:]


def api_drives_do(action, body):
    """Run rename, sleep, wake or remount and return what the drives tool said."""
    words = [action]
    if action in ("rename", "sleep", "wake"):
        ident = body.get("id")
        if not isinstance(ident, str) or not DRIVE_ID.match(ident):
            raise Fail("Choose a drive first.")
        words.append(ident)
    if action == "rename":
        name = body.get("name")
        if not isinstance(name, str):
            raise Fail("Type a name first.")
        name = " ".join(name.split())
        if name != "auto" and not DRIVE_NAME.match(name):
            raise Fail("A name may have up to 40 letters, numbers, spaces and these marks: . ( ) + , -")
        if name != "auto" and (name[0] in " .-" or name[-1] in " .-"):
            raise Fail("A name cannot start or end with a space, a dot or a dash.")
        words.append(name)
    rc, out, err = drives_run(words, DRIVE_TIMEOUT.get(action, 90))
    msg = drive_message(out, err)
    if rc != 0:
        low = (err + out).lower()
        sudo_no = "password is required" in low or "not allowed" in low or "may not run sudo" in low or "no tty present" in low
        raise Fail(drives_problem(rc, err + out) if rc in (124, 127) or sudo_no or not msg else msg, 409 if rc == 1 and not sudo_no else 502)
    return {"message": msg or "Done."}


DRIVE_TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}(:(keep|erase))?\Z")


def job_ids(body):
    ids = body.get("ids")
    if ids is None:
        ids = [body.get("id")]
    if not isinstance(ids, list) or not 1 <= len(ids) <= 8:
        raise Fail("Choose between one and eight drives.")
    out = []
    for t in ids:
        if not isinstance(t, str) or not DRIVE_TOKEN.match(t):
            raise Fail("Choose a drive first.")
        if t.split(":")[0] in [x.split(":")[0] for x in out]:
            raise Fail("A drive cannot be chosen twice.")
        out.append(t)
    each = [":" in t for t in out]
    if any(each) and not all(each):
        raise Fail("Every drive needs its own choice.")
    return out


def job_words(action, body):
    """Build the exact words of a drive change (add, wipe, disconnect, move) and check them before the drives tool is asked to do anything."""
    typed = body.get("typed", [])
    if not isinstance(typed, list) or len(typed) > 20 or not all(isinstance(w, str) and DRIVE_WORD.match(w) for w in typed):
        raise Fail("A confirmation word is not allowed.")

    def pick(key, allowed):
        v = body.get(key)
        if v not in allowed:
            raise Fail("Choose %s first." % key)
        return v
    if action == "moveboot":
        return ["moveboot"]
    if action == "appsfix":
        return ["appsfix", pick("mode", ("restore", "fresh"))] + typed
    if action == "bootadd":
        units = body.get("units")
        if not isinstance(units, int) or isinstance(units, bool) or not 1 <= units <= 999999:
            raise Fail("Choose a size first.")
        return ["bootadd", pick("role", ("main", "backup")), str(units)] + typed
    if action == "setup":
        name, ids = body.get("setup"), body.get("ids")
        if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9-]{3,12}", name):
            raise Fail("Choose a setup first.")
        if not isinstance(ids, list) or not 1 <= len(ids) <= 16 or not all(isinstance(t, str) and DRIVE_TOKEN.match(t) for t in ids) or len({t.split(":")[0] for t in ids}) != len(ids):
            raise Fail("Choose the drives for the setup.")
        return ["setup", name, ",".join(ids)] + typed
    if action == "wipe":
        ident = body.get("id")
        if not isinstance(ident, str) or not DRIVE_ID.match(ident):
            raise Fail("Choose a drive first.")
        words = ["wipe", ident, pick("mode", ("empty", "format"))]
        return words + typed
    ids = job_ids(body)
    lst = ",".join(ids)
    each = ":" in ids[0]
    if action == "add":
        words = ["add", lst, pick("role", ("main", "backup")), "each" if each else pick("mode", ("keep", "erase"))]
    elif action == "disconnect":
        words = ["disconnect", lst, pick("copy", ("yes", "no"))]
    elif action == "move":
        words = ["move", lst, "each" if each else pick("keep", ("keep", "erase")), pick("copy", ("yes", "no"))]
    else:
        raise Fail("Unknown address.", 404)
    return words + typed


def job_progress(line):
    m = re.match(r"PROGRESS (\S+) (\d{1,3}) ?(.*)\Z", line)
    if not m:
        return False
    item, pct, text = m.group(1), min(100, int(m.group(2))), m.group(3)[:80]
    prog = JOB["progress"]
    JOB["current"] = item
    old = prog.get(item, {"pct": 0})
    prog[item] = {"pct": max(old["pct"], pct), "text": text}
    return True


def job_thread(words):
    """Run one drive change and keep its progress lines for the page. Holds the drive gate, so a change runs alone, until it ends."""
    rc, tail = 1, []
    try:
        try:
            p = subprocess.Popen(DRIVES_CMD + ["panel"] + words, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True, bufsize=1)
        except FileNotFoundError:
            with JOB_LOCK:
                JOB["lines"] = ["command not found"]
            rc = 127
        else:
            timer = threading.Timer(JOB_MAX_SECONDS, p.kill)
            timer.start()
            try:
                for line in p.stdout:
                    line = line.rstrip()
                    if line:
                        with JOB_LOCK:
                            if not job_progress(line):
                                JOB["lines"] = (JOB["lines"] + [line])[-300:]
                rc = p.wait()
            finally:
                timer.cancel()
        with JOB_LOCK:
            tail = list(JOB["lines"])
    finally:
        text = "\n".join(tail)
        low = text.lower()
        sudo_no = "password is required" in low or "may not run sudo" in low or "no tty present" in low
        with JOB_LOCK:
            JOB["rc"] = rc
            if rc == 0:
                for it in JOB["items"]:
                    JOB["progress"][it] = {"pct": 100, "text": "Done"}
            JOB["message"] = drives_problem(rc, text) if rc in (124, 127) or sudo_no else (tail[-1] if rc == 4 and tail else drive_message(text, "", 1500, problem=(rc != 0)))
            JOB["running"] = False
            JOB["stopping"] = False
            drives_change_end()


def api_drives_job_start(action, body):
    words = job_words(action, body)
    items = [t.split(":")[0] for t in job_ids(body)] if action not in ("wipe", "setup", "bootadd", "appsfix", "moveboot") else ([body.get("id")] if action == "wipe" else ["bootadd"] if action == "bootadd" else ["moveboot"] if action == "moveboot" else ["appsfix"] if action == "appsfix" else [str(t).split(":")[0] for t in (body.get("ids") or [])])
    drives_change_begin()
    with JOB_LOCK:
        JOB.update(id=JOB["id"] + 1, running=True, action=action, lines=[], rc=None, message="", started=int(time.time()), items=items, progress={}, current="", stopping=False)
        jid = JOB["id"]
    threading.Thread(target=job_thread, args=(words,), daemon=True).start()
    return {"ok": True, "job": jid}


def api_drives_job():
    with JOB_LOCK:
        return {"id": JOB["id"], "running": JOB["running"], "action": JOB["action"], "lines": JOB["lines"][-(12 if JOB["running"] else 60):], "rc": JOB["rc"], "message": JOB["message"], "started": JOB["started"], "items": JOB["items"], "progress": JOB["progress"], "current": JOB["current"], "stopping": JOB["stopping"]}


def api_drives_abort():
    """The Stop button: ask the drives tool to stop the running change at the next safe moment. It does not wait for the change and is not held back by the drive gate."""
    with JOB_LOCK:
        running, action = JOB["running"], JOB["action"]
        copying = any(str(v.get("text", "")).startswith("Copying files") for v in JOB["progress"].values())
    if not running:
        raise Fail("No drive change is running right now.", 409)
    if action == "setup" and not copying:
        raise Fail("A new setup can be stopped only while the files of the Main pool are being copied. Erasing and building the drives cannot be interrupted.", 409)
    if action == "appsfix" and not copying:
        raise Fail("Cancel works while the files are being copied from the backup. Right now nothing is being copied.", 409)
    if action not in ("add", "move", "disconnect", "setup", "appsfix"):
        raise Fail("That cannot be stopped: erasing a drive cannot be interrupted.", 409)
    try:
        p = subprocess.run(DRIVES_CMD + ["panel", "abort"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Fail("The drives tool did not respond. Try Stop again.", 504) from None
    except FileNotFoundError:
        raise Fail("The drives tool is not installed.", 502) from None
    msg = drive_message(p.stdout or "", p.stderr or "")
    if p.returncode != 0:
        raise Fail(msg or "The change could not be stopped.", 409)
    with JOB_LOCK:
        JOB["stopping"] = True
    return {"message": msg or "Stopping."}


BACKUP_ID = re.compile(r"[a-z][a-z0-9-]{0,23}\Z")
BACKUP_VERSION = re.compile(r"(current|\d{4}-\d\d-\d\d(_\d{6})?)\Z")
BACKUP_HOST = re.compile(r"[a-z_][a-z0-9_-]{0,31}@[A-Za-z0-9][A-Za-z0-9.-]{0,252}(:[0-9]{1,5})?\Z")
BJOB = {"id": 0, "running": False, "action": "", "task": "", "lines": [], "rc": None, "message": "", "started": 0, "pct": None}
BJOB_LOCK = threading.Lock()
BACKUP_SAVE_KEYS = ("id", "name", "enabled", "source", "exclude", "dest", "schedule", "keep")


def backup_problem(rc, text):
    low = text.lower()
    if rc == 127 or "command not found" in low or "no such file" in low:
        return "The backup tool is not installed on this machine yet. Run the installer's update (homelab-update) to add it."
    if rc == 124:
        return "The backup tool took too long to respond. Try again shortly."
    if "password is required" in low or "not allowed" in low or "may not run sudo" in low or "no tty present" in low:
        return "The panel is not allowed to run the backup tool yet. Run the installer's update (homelab-update) to add the permission."
    return ""


def backup_run(words, stdin=None, timeout=60):
    try:
        p = subprocess.run(BACKUP_CMD + words, capture_output=True, text=True, timeout=timeout, input=stdin if stdin is not None else None,
                           stdin=None if stdin is not None else subprocess.DEVNULL)
        return p.returncode, p.stdout or "", p.stderr or ""
    except FileNotFoundError:
        return 127, "", "command not found"
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"


def backup_json(words, stdin=None, timeout=60):
    rc, out, err = backup_run(words, stdin, timeout)
    try:
        data = json.loads(out.strip().split("\n")[-1]) if out.strip() else None
    except ValueError:
        data = None
    if isinstance(data, dict) and "error" in data:
        raise Fail(str(data["error"])[:600], 409)
    if rc != 0 or not isinstance(data, dict):
        raise Fail(backup_problem(rc, err + out) or "The backup tool returned a response that the panel cannot read.", 502 if rc != 124 else 504)
    return data


def backup_id(v):
    if not isinstance(v, str) or not BACKUP_ID.match(v):
        raise Fail("Choose a backup task first.")
    return v


def backup_version(v):
    if not isinstance(v, str) or not BACKUP_VERSION.match(v):
        raise Fail("Choose a version first.")
    return v


def backup_rel(v):
    v = "." if v in (None, "", "/") else v
    if not isinstance(v, str) or len(v) > 600 or re.search(r"[\x00-\x1f]", v) or ".." in v.split("/") or v.startswith("-"):
        raise Fail("That path is not allowed.")
    return v


def api_backup_state():
    return backup_json(["state"])


def api_backup_save(body):
    task = {k: body[k] for k in BACKUP_SAVE_KEYS if k in body}
    if "id" in task:
        backup_id(task["id"])
    return backup_json(["save"], json.dumps(task))


def api_backup_task(action, body):
    """Quick backup actions that complete immediately: delete, toggle, sshkey, sshtest and cloud-add."""
    if action == "delete":
        if body.get("data") not in ("keep", "erase"):
            raise Fail("Choose whether to keep or erase the copies already made.")
        return backup_json(["delete", backup_id(body.get("id")), body["data"]], timeout=3700)
    if action == "toggle":
        return backup_json(["toggle", backup_id(body.get("id")), "on" if body.get("enabled") else "off"])
    if action == "sshkey":
        return backup_json(["sshkey"], timeout=90)
    if action == "sshtest":
        host = body.get("host")
        if not isinstance(host, str) or not BACKUP_HOST.match(host):
            raise Fail("The other computer must look like user@name.")
        return backup_json(["sshtest", host], timeout=90)
    if action == "cloud-add":
        keep = {k: body.get(k) for k in ("type", "name", "key_id", "key", "endpoint") if isinstance(body.get(k), str)}
        return backup_json(["cloud-add"], json.dumps(keep))
    raise Fail("Unknown address.", 404)


def api_backup_look(path, query):
    q = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
    if path == "versions":
        return backup_json(["versions", backup_id(q.get("id"))], timeout=120)
    return backup_json(["browse", backup_id(q.get("id")), backup_version(q.get("v")), backup_rel(q.get("rel"))], timeout=180)


DL_TOKENS = {}
DL_LOCK = threading.Lock()


def api_backup_dltoken(body, session):
    """The Download button: create a link that works once, for two minutes and for this session only."""
    mode = body.get("mode")
    if mode not in ("file", "zip"):
        raise Fail("Choose a file or a folder.")
    task, version, rel = backup_id(body.get("id")), backup_version(body.get("v")), backup_rel(body.get("rel"))
    rel = "" if rel == "." else rel
    name = os.path.basename(rel) if rel else "backup"
    if mode == "zip":
        name += ".zip"
    tok = secrets.token_urlsafe(24)
    with DL_LOCK:
        now = time.time()
        for k in [k for k, v in DL_TOKENS.items() if v[0] < now]:
            del DL_TOKENS[k]
        if len(DL_TOKENS) > 200:
            raise Fail("Too many downloads are waiting. Try again shortly.", 429)
        DL_TOKENS[tok] = (now + 120, session, task, version, rel or ".", mode, name)
    return {"url": "/api/backup/download?t=" + tok}


def backup_download(handler, query):
    """Stream one file, or a folder as a .zip, from the backup tool to the browser. The tool reads as root and nothing is kept on the way."""
    t = urllib.parse.parse_qs(query).get("t", [""])[0]
    with DL_LOCK:
        entry = DL_TOKENS.pop(t, None)
    if not entry or entry[0] < time.time() or entry[1] != handler.cookie_token():
        raise Fail("That download link has expired. Press Download again.", 403)
    _, _, task, version, rel, mode, name = entry
    p = subprocess.Popen(BACKUP_CMD + ["stream", task, version, rel, mode], stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL)
    try:
        first = p.stdout.read(65536)
        if len(first) < 65536:
            rc = p.wait()
            if rc != 0:
                msg = ""
                try:
                    msg = str(json.loads(first.decode("utf-8", "replace")).get("error", ""))
                except ValueError:
                    pass
                err = (p.stderr.read() or b"").decode("utf-8", "replace")
                raise Fail(msg or backup_problem(rc, err) or "That could not be downloaded.", 409)
        safe = re.sub(r'[^A-Za-z0-9._ ()+,-]', "_", name) or "download"
        handler.send_response(200)
        handler.send_header("Content-Type", "application/zip" if mode == "zip" else "application/octet-stream")
        handler.send_header("Content-Disposition", "attachment; filename=\"%s\"; filename*=UTF-8''%s" % (safe, urllib.parse.quote(name)))
        handler.send_header("Cache-Control", "no-store")
        handler.send_header("X-Content-Type-Options", "nosniff")
        handler.send_header("Connection", "close")
        handler.end_headers()
        handler.close_connection = True
        try:
            handler.wfile.write(first)
            while True:
                chunk = p.stdout.read(1 << 20)
                if not chunk:
                    break
                handler.wfile.write(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass
    finally:
        if p.poll() is None:
            p.kill()
        p.wait()
        p.stdout.close()
        p.stderr.close()


def backup_job_thread(words):
    """Run a backup command in the background and keep its output lines for the page."""
    rc = 1
    try:
        try:
            p = subprocess.Popen(BACKUP_CMD + words, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True, bufsize=1)
        except FileNotFoundError:
            with BJOB_LOCK:
                BJOB["lines"] = ["command not found"]
            rc = 127
        else:
            timer = threading.Timer(JOB_MAX_SECONDS, p.kill)
            timer.start()
            try:
                for line in p.stdout:
                    line = line.rstrip()
                    if not line:
                        continue
                    m = re.match(r"PROGRESS (\d{1,3})\Z", line)
                    with BJOB_LOCK:
                        if m:
                            BJOB["pct"] = min(100, int(m.group(1)))
                        else:
                            BJOB["lines"] = (BJOB["lines"] + [line[:400]])[-200:]
                rc = p.wait()
            finally:
                timer.cancel()
    finally:
        with BJOB_LOCK:
            text = "\n".join(BJOB["lines"])
            tail = [x for x in BJOB["lines"] if x.strip()]
            BJOB["rc"] = rc
            if rc == 0:
                BJOB["pct"] = 100
            BJOB["message"] = backup_problem(rc, text) or (tail[-1] if tail else ("Done." if rc == 0 else "The backup tool stopped without giving a reason."))
            BJOB["running"] = False


def api_backup_job_start(action, body):
    """Start run, dry or restore in the background, one at a time."""
    tid = backup_id(body.get("id"))
    if action == "restore":
        target = body.get("target")
        if target not in ("folder", "original"):
            raise Fail("Choose where to put the files back.")
        words = ["restore", tid, backup_version(body.get("version")), backup_rel(body.get("rel")), target]
    elif action in ("run", "dry"):
        words = [action, tid]
    else:
        raise Fail("Unknown address.", 404)
    with BJOB_LOCK:
        if BJOB["running"]:
            raise Fail("A backup, preview or restore is running already. Wait until it has finished.", 409)
        BJOB.update(id=BJOB["id"] + 1, running=True, action=action, task=tid, lines=[], rc=None, message="", started=int(time.time()), pct=None)
        jid = BJOB["id"]
    threading.Thread(target=backup_job_thread, args=(words,), daemon=True).start()
    return {"ok": True, "job": jid}


def api_backup_job():
    with BJOB_LOCK:
        return dict(BJOB, lines=BJOB["lines"][-(8 if BJOB["running"] else 40):])


UPDATE_STATE = os.environ.get("HLP_UPDATE_STATE") or "/var/lib/homelab"
REBOOT_FILE = os.environ.get("HLP_REBOOT_FILE") or "/var/run/reboot-required"
UPDATE_STEPS = {
    "check": [["sudo", "-n", "/usr/local/sbin/homelab-update", "check"]],
    "containers": [["sudo", "-n", "/usr/local/sbin/homelab-update", "--yes"]],
    "containers-now": [["sudo", "-n", "/usr/local/sbin/homelab-update", "--yes", "--now"]],
    "system": [["sudo", "-n", "/usr/bin/apt-get", "update"], ["sudo", "-n", "/usr/bin/apt-get", "-y", "upgrade"]],
    "restart": [["sudo", "-n", "/usr/bin/systemctl", "reboot"]],
}
if os.environ.get("HLP_UPDATE_STEPS"):
    UPDATE_STEPS = json.loads(os.environ["HLP_UPDATE_STEPS"])
UPJOB = {"id": 0, "running": False, "action": "", "lines": [], "rc": None, "message": "", "started": 0, "pct": None, "stage": "", "held": ""}
UPJOB_LOCK = threading.Lock()
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


APT_GET = os.environ.get("HLP_APT_GET") or "apt-get"
ALERTS_CMD = os.environ.get("HLP_ALERTS") or "/usr/local/sbin/homelab-alerts"
APT_CACHE = {"at": 0.0, "n": None, "kept": 0}


def apt_waiting():
    if APT_CACHE["n"] is not None and time.time() - APT_CACHE["at"] < 60:
        return APT_CACHE["n"], APT_CACHE["kept"]
    try:
        p = subprocess.run([APT_GET, "-s", "upgrade"], capture_output=True, text=True, timeout=40, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None, 0
    if p.returncode != 0:
        return None, 0
    n = sum(1 for l in p.stdout.splitlines() if l.startswith("Inst "))
    m = re.search(r"(\d+) not upgraded", p.stdout)
    APT_CACHE.update(at=time.time(), n=n, kept=int(m.group(1)) if m else 0)
    return n, APT_CACHE["kept"]


def refresh_alerts():
    try:
        subprocess.run([ALERTS_CMD], capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def api_updates_state(fresh=False):
    if fresh:
        APT_CACHE["n"] = None
    lines = read_text(os.path.join(UPDATE_STATE, "image-updates")).splitlines()
    first = lines[0].strip() if lines else ""
    stacks = []
    for l in lines[1:]:
        if l.strip():
            parts = l.split(None, 1)
            stacks.append({"name": parts[0], "detail": parts[1] if len(parts) > 1 else ""})
    apt = read_text(os.path.join(UPDATE_STATE, "apt")).strip().split("|")
    system = int(apt[0]) if apt and apt[0].isdigit() else None
    live, kept = apt_waiting()
    if live is not None:
        system = live
    return {"checked": int(first) if first.isdigit() else 0, "containers": stacks, "system": system, "kept_back": kept, "restart": os.path.exists(REBOOT_FILE),
            "now": int(time.time()), "job": api_updates_job()}


def api_updates_job():
    with UPJOB_LOCK:
        return dict(UPJOB, lines=UPJOB["lines"][-(10 if UPJOB["running"] else 60):])


def upd_progress(action, st, line):
    """Work out how far an update has got from the lines the update tools print (one line at a time, colors removed) for the Updates tab's progress bar. `st` is the memory of one job."""
    def done(pct, text):
        pct = None if pct is None else max(st.get("pct", 0), min(99, int(round(pct))))
        if pct is not None:
            st["pct"] = pct
        return pct, text
    if action in ("containers", "containers-now"):
        m = re.search(r"Step (\d) of 4", line)
        if m:
            st["step"] = int(m.group(1))
            if st["step"] == 1:
                return done(3, "Step 1 of 4: checking for new versions")
            if st["step"] == 2:
                return done(10, "Step 2 of 4: downloading the new images")
            if st["step"] == 3:
                return done(52, "Step 3 of 4: checking that no upload is running")
            return done(55, "Step 4 of 4: updating the services one at a time")
        step = st.get("step", 0)
        m = re.search(r"(\d+) image\(s\) to download", line)
        if m and step == 2:
            st["images"] = int(m.group(1))
            st["got"] = 0
            return done(10, "Step 2 of 4: downloading the new images (0 of %d)" % st["images"])
        if step == 2 and re.match(r" {6}\S ", line):
            st["got"] = st.get("got", 0) + 1
            total = st.get("images") or 0
            if total:
                return done(10 + 40 * min(st["got"], total) / total, "Step 2 of 4: downloading the new images (%d of %d)" % (min(st["got"], total), total))
            return done(10 + 40 * (1 - 1 / (1 + st["got"])), "Step 2 of 4: downloading the new images (%d done)" % st["got"])
        m = re.search(r"(\d+) stack\(s\) to update", line)
        if m and step == 4:
            st["total_stacks"] = int(m.group(1))
            return done(55, "Step 4 of 4: updating %d service%s one after the other" % (st["total_stacks"], "" if st["total_stacks"] == 1 else "s"))
        if step == 4:
            total = st.get("total_stacks") or 0
            m = re.match(r" {3}(\d+) {2}(\S+)", line)
            if m:
                st["cur"], st["name"], st["frac"] = int(m.group(1)), m.group(2), 0.0
            cur, name = st.get("cur", 0), st.get("name", "")
            stage = None
            if "Quick database dump" in line:
                stage = (0.15, "making a quick database dump")
            elif "Updating the stack through Portainer" in line or "Recreating Portainer" in line:
                stage = (0.35, "installing the new version")
            elif "Waiting for the containers to come back" in line:
                stage = (0.65, "waiting for the containers to come back")
            elif "is updated and running" in line or "left as it is" in line:
                stage = (1.0, "finished")
            if m:
                stage = (0.0, "starting")
            if stage is not None and cur:
                st["frac"] = max(st.get("frac", 0), stage[0])
                what = "Step 4 of 4: %s%s: %s" % (name, " (%d of %d)" % (cur, total) if total else "", stage[1])
                return done(55 + 45 * ((cur - 1) + st["frac"]) / total if total else 55 + 40 * (1 - 1 / (1 + cur - 1 + st["frac"])), what)
        return None
    if action == "system":
        if line.startswith("$ "):
            if "update" in line.split():
                st["phase"] = "list"
                return done(2, "Step 1 of 2: updating the package list")
            if "upgrade" in line.split():
                st["phase"] = "pkgs"
                st.setdefault("total", APT_CACHE["n"] or 0)
                return done(10, "Step 2 of 2: installing packages" + (" (%d)" % st["total"] if st["total"] else ""))
            return None
        m = re.search(r"(\d+) upgraded, (\d+) newly installed", line)
        if m:
            st["total"] = int(m.group(1)) + int(m.group(2))
            if st["total"] == 0:
                return done(95, "Step 2 of 2: nothing to install")
            return done(10, "Step 2 of 2: installing %d package%s" % (st["total"], "" if st["total"] == 1 else "s"))
        if st.get("phase") == "list":
            st["lists"] = st.get("lists", 0) + 1
            return done(2 + min(7, st["lists"] // 2), "Step 1 of 2: updating the package list") if re.match(r"(Hit|Get|Ign):", line) else None
        if st.get("phase") == "pkgs":
            kind = "dl" if re.match(r"Get:\d+ ", line) else "un" if line.startswith("Unpacking ") else "set" if line.startswith("Setting up ") else ""
            if not kind:
                if line.startswith("Processing triggers"):
                    return done(max(st.get("pct", 0), 96), "Step 2 of 2: finishing up")
                return None
            st[kind] = st.get(kind, 0) + 1
            total = st.get("total") or 0
            if not total:
                n = st.get("dl", 0) + st.get("un", 0) + st.get("set", 0)
                return done(10 + 85 * (1 - 1 / (1 + n / 20.0)), "Step 2 of 2: installing packages (%d steps done)" % n)
            n = min(st.get("dl", 0), total) + min(st.get("un", 0), total) + min(st.get("set", 0), total)
            word = {"dl": "downloading", "un": "unpacking", "set": "setting up"}[kind]
            return done(10 + 86 * n / (3.0 * total), "Step 2 of 2: %s package %d of %d" % (word, min(st[kind], total), total))
    return None


def held_reason(lines):
    """When the update tool holds the update back ("Not now: <reason>"), return (reason, message for the person); otherwise None."""
    for line in lines:
        m = re.search(r"Not now: (.+)", line)
        if not m:
            continue
        early = "Stopped before" in m.group(1)
        reason = re.split(r"\. Stopped before", m.group(1))[0].strip().rstrip(".")
        if early:
            return reason, "The update stopped early because %s. The services updated so far are done; the rest are still waiting. Try again when it has finished." % reason
        return reason, "Nothing was updated because %s. Try again when it has finished, or choose Update Anyway." % reason
    return None


def updates_job_thread(action):
    """Run the steps of an update action in the background and keep their output for the Updates tab."""
    rc = 1
    mem = {}
    try:
        for cmd in UPDATE_STEPS[action]:
            with UPJOB_LOCK:
                head = "$ " + " ".join(cmd[2:] if cmd[:2] == ["sudo", "-n"] else cmd)
                UPJOB["lines"] = (UPJOB["lines"] + [head])[-300:]
                got = upd_progress(action, mem, head)
                if got:
                    UPJOB["pct"], UPJOB["stage"] = got
            try:
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True, bufsize=1)
            except FileNotFoundError:
                with UPJOB_LOCK:
                    UPJOB["lines"].append("command not found")
                rc = 127
                break
            timer = threading.Timer(JOB_MAX_SECONDS, p.kill)
            timer.start()
            try:
                for line in p.stdout:
                    line = ANSI.sub("", line).rstrip()
                    if line.strip():
                        with UPJOB_LOCK:
                            UPJOB["lines"] = (UPJOB["lines"] + [line[:400]])[-300:]
                            got = upd_progress(action, mem, line[:400])
                            if got:
                                UPJOB["pct"], UPJOB["stage"] = got
                rc = p.wait()
            finally:
                timer.cancel()
            if rc != 0:
                break
    finally:
        APT_CACHE["n"] = None
        if action != "restart":
            refresh_alerts()
        with UPJOB_LOCK:
            tail = [x for x in UPJOB["lines"] if x.strip() and not x.startswith("$ ")]
            text = "\n".join(UPJOB["lines"])
            UPJOB["rc"] = rc
            if rc == 0 and UPJOB["pct"] is not None:
                UPJOB["pct"], UPJOB["stage"] = 100, "Done"
            held = held_reason(UPJOB["lines"]) if action in ("containers", "containers-now") and rc == 0 else None
            if held:
                UPJOB["rc"], UPJOB["held"] = 75, held[0]
                UPJOB["message"] = held[1]
            elif rc == 0:
                UPJOB["message"] = tail[-1] if tail else "Done."
            elif "a password is required" in text or "not allowed to execute" in text or "sudo:" in text:
                UPJOB["message"] = "The panel does not have permission to run that yet. Run the installer's update (homelab-update) to add the permission."
            elif rc == 127:
                UPJOB["message"] = "That tool is not installed on this machine."
            else:
                UPJOB["message"] = tail[-1] if tail else "It stopped without giving a reason."
            UPJOB["running"] = False


def api_updates_start(body):
    action = body.get("what")
    if action not in UPDATE_STEPS:
        raise Fail("Choose what to update.")
    if action == "restart" and body.get("confirm") is not True:
        raise Fail("Confirm the restart first.")
    with UPJOB_LOCK:
        if UPJOB["running"]:
            raise Fail("An update is already running. Wait until it has finished.", 409)
        UPJOB.update(id=UPJOB["id"] + 1, running=True, action=action, lines=[], rc=None, message="", started=int(time.time()), pct=None, stage="", held="")
        jid = UPJOB["id"]
    threading.Thread(target=updates_job_thread, args=(action,), daemon=True).start()
    return {"ok": True, "job": jid}


IMMICH_URL = (os.environ.get("HLP_IMMICH_URL") or "http://127.0.0.1:2283").rstrip("/")
UPLOAD_FILE = os.path.join(STATE_DIR, "uploads.json")
PHOTO_MAX = 20 * 1024 ** 3
SONG_MAX = 2 * 1024 ** 3
PHOTO_EXT = {"jpg", "jpeg", "png", "gif", "webp", "heic", "heif", "avif", "tif", "tiff", "bmp", "jxl", "dng", "arw", "cr2", "cr3", "nef", "nrw", "orf", "raf", "rw2", "pef", "srw",
             "mp4", "mov", "m4v", "avi", "mkv", "webm", "3gp", "mpg", "mpeg", "mts", "m2ts", "wmv", "flv"}
SONG_EXT = {"mp3", "flac", "m4a", "aac", "ogg", "oga", "opus", "wav", "wma", "alac", "aiff", "aif", "ape", "wv", "mka"}
IMMICH_KEY = re.compile(r"[A-Za-z0-9_-]{16,200}\Z")
MUSIC_CACHE = {"at": 0.0, "dir": ""}
UPLOAD_CHUNK = 1 << 20


def uploads_cfg():
    try:
        with open(UPLOAD_FILE, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def uploads_save(cfg):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    tmp = UPLOAD_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.replace(tmp, UPLOAD_FILE)


def music_dir():
    """Return the folder Navidrome plays from: HLP_MUSIC_DIR, else the folder the Navidrome container has as /music, else the installer's note, else /mnt/storage/music."""
    forced = os.environ.get("HLP_MUSIC_DIR")
    if forced:
        return forced
    if time.time() - MUSIC_CACHE["at"] < 60:
        return MUSIC_CACHE["dir"]
    found = ""
    if not NO_DOCKER:
        try:
            r = subprocess.run(["docker", "inspect", "navidrome", "--format", '{{range .Mounts}}{{if eq .Destination "/music"}}{{.Source}}{{end}}{{end}}'],
                               capture_output=True, text=True, timeout=10)
            found = r.stdout.strip() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            found = ""
    if not found:
        try:
            with open("/var/lib/homelab/music-dir", encoding="utf-8") as f:
                found = f.read().strip()
        except OSError:
            found = ""
    MUSIC_CACHE.update(at=time.time(), dir=found or "/mnt/storage/music")
    return MUSIC_CACHE["dir"]


def immich_call(method, path, key, timeout=5):
    u = urllib.parse.urlparse(IMMICH_URL)
    try:
        c = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=timeout)
        c.request(method, path, headers={"x-api-key": key, "Accept": "application/json"} if key else {"Accept": "application/json"})
        r = c.getresponse()
        raw = r.read(1 << 20)
        c.close()
    except (OSError, http.client.HTTPException):
        return 0, None
    try:
        return r.status, json.loads(raw)
    except ValueError:
        return r.status, None


def api_upload_state():
    key = uploads_cfg().get("immich_key", "")
    up = immich_call("GET", "/api/server/ping", "", timeout=3)[0] == 200
    d = music_dir()
    ok = os.path.isdir(d)
    writable = ok and os.access(d, os.W_OK | os.X_OK)
    try:
        free = shutil.disk_usage(d).free if ok else None
    except OSError:
        free = None
    return {"immich": {"configured": bool(key), "up": up}, "music": {"dir": d, "exists": ok, "writable": writable, "free": free, "user": getpass.getuser()},
            "limits": {"photo": PHOTO_MAX, "song": SONG_MAX}, "photo_ext": sorted(PHOTO_EXT), "song_ext": sorted(SONG_EXT)}


def api_upload_key(body):
    """Keep the Immich API key, or forget it when empty. A key that Immich rejects is not kept."""
    key = body.get("key")
    if not isinstance(key, str):
        raise Fail("Paste the key first.")
    key = key.strip()
    if not key:
        cfg = uploads_cfg()
        cfg.pop("immich_key", None)
        uploads_save(cfg)
        return {"configured": False, "message": "The Immich key was forgotten."}
    if not IMMICH_KEY.match(key):
        raise Fail("That does not look like an Immich API key (letters and numbers, at least 16).")
    st, js = immich_call("GET", "/api/users/me", key)
    if st == 0:
        raise Fail("Immich is not responding, so the key could not be checked. Check that Immich is running.", 502)
    if st == 401:
        raise Fail("Immich rejected that key. Check that the whole key was copied.", 409)
    if st not in (200, 403):
        raise Fail("Immich returned an unexpected response (code %d)." % st, 502)
    cfg = uploads_cfg()
    cfg["immich_key"] = key
    uploads_save(cfg)
    who = js.get("name") or js.get("email") if isinstance(js, dict) else ""
    return {"configured": True, "message": "The key works" + (" (account: %s)." % who if who else ".")}


def upload_name(raw, allowed):
    name = re.sub(r"[\x00-\x1f\x7f]", "", (raw or "").replace("\\", "/").split("/")[-1]).strip().lstrip(".").strip()
    if not name or len(name) > 255:
        raise Fail("That file has no usable name.", 400)
    ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
    if ext not in allowed:
        raise Fail("That file type is not accepted (.%s)." % ext if ext else "That file has no extension such as .mp3 or .jpg.", 415)
    return name


def upload_drain(handler, n):
    left = min(n, 64 * 1024 * 1024)
    while left > 0:
        b = handler.rfile.read(min(left, UPLOAD_CHUNK))
        if not b:
            break
        left -= len(b)
    handler.close_connection = True


def api_upload_stream(handler, kind, q):
    """Receive an uploaded photo or song from the page and pass it on."""
    n = int(handler.headers.get("Content-Length") or 0)
    try:
        if n <= 0:
            raise Fail("The file is empty.", 400)
        one = lambda k: (q.get(k) or [""])[0]  # noqa: E731
        if kind == "photo":
            name = upload_name(one("name"), PHOTO_EXT)
            if n > PHOTO_MAX:
                raise Fail("That file is larger than 20 GB.", 413)
            key = uploads_cfg().get("immich_key", "")
            if not key:
                raise Fail("Paste your Immich key first.", 409)
        else:
            name = upload_name(one("name"), SONG_EXT)
            if n > SONG_MAX:
                raise Fail("That song is larger than 2 GB.", 413)
    except Fail:
        upload_drain(handler, n)
        raise
    try:
        return upload_photo(handler, name, n, one("mtime"), key) if kind == "photo" else upload_song(handler, name, n)
    except Fail:
        handler.close_connection = True
        raise


def upload_photo(handler, name, n, mtime, key):
    """Send an uploaded photo to Immich with its original time stamp."""
    try:
        ms = int(mtime)
    except ValueError:
        ms = int(time.time() * 1000)
    stamp = datetime_iso(ms / 1000.0)
    safe = name.replace('"', "'")
    boundary = "hlpanel" + secrets.token_hex(12)
    fields = {"deviceAssetId": "%s-%d-%d" % (re.sub(r"[^A-Za-z0-9._-]", "_", name)[:120], n, ms), "deviceId": "homelab-panel", "fileCreatedAt": stamp, "fileModifiedAt": stamp}
    pre = "".join('--%s\r\nContent-Disposition: form-data; name="%s"\r\n\r\n%s\r\n' % (boundary, k, v) for k, v in fields.items())
    pre += '--%s\r\nContent-Disposition: form-data; name="assetData"; filename="%s"\r\nContent-Type: application/octet-stream\r\n\r\n' % (boundary, safe)
    pre, post = pre.encode("utf-8"), ("\r\n--%s--\r\n" % boundary).encode("ascii")
    u = urllib.parse.urlparse(IMMICH_URL)
    try:
        c = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=3600)
        c.putrequest("POST", "/api/assets")
        c.putheader("x-api-key", key)
        c.putheader("Accept", "application/json")
        c.putheader("Content-Type", "multipart/form-data; boundary=" + boundary)
        c.putheader("Content-Length", str(len(pre) + n + len(post)))
        c.endheaders()
        c.send(pre)
    except (OSError, http.client.HTTPException):
        raise Fail("Immich is not responding. Check that it is running.", 502) from None
    left = n
    try:
        while left > 0:
            b = handler.rfile.read(min(left, UPLOAD_CHUNK))
            if not b:
                c.close()
                raise Fail("The upload was cut off.", 400)
            c.send(b)
            left -= len(b)
        c.send(post)
    except (OSError, http.client.HTTPException):
        pass
    try:
        r = c.getresponse()
        raw = r.read(1 << 20)
        c.close()
    except (OSError, http.client.HTTPException):
        raise Fail("Immich stopped responding while the file was being sent.", 502) from None
    try:
        js = json.loads(raw)
    except ValueError:
        js = {}
    if r.status in (200, 201):
        return {"ok": True, "status": "duplicate" if js.get("status") == "duplicate" else "created", "id": js.get("id", "")}
    if r.status == 401:
        raise Fail("Immich rejected the key. Paste the key again.", 409)
    raise Fail("Immich rejected the file (code %d): %s" % (r.status, str(js.get("message") or raw[:200])[:200]), 502)


def datetime_iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(ts))


def upload_song(handler, name, n):
    """Save an uploaded song in the music folder after checking the folder, free space and file name."""
    d = music_dir()
    if not os.path.isdir(d):
        raise Fail("The music folder (%s) was not found. Check that the drive is connected." % d, 409)
    if not os.access(d, os.W_OK | os.X_OK):
        raise Fail("The panel does not have permission to write to the music folder (%s)." % d, 409)
    try:
        free = shutil.disk_usage(d).free
    except OSError:
        free = n + 10 ** 9
    if free < n + 200 * 1024 * 1024:
        raise Fail("There is not enough free space in the music folder for this song.", 507)
    tmp = os.path.join(d, ".upload-%s.part" % secrets.token_hex(6))
    try:
        with open(tmp, "wb") as f:
            left = n
            while left > 0:
                b = handler.rfile.read(min(left, UPLOAD_CHUNK))
                if not b:
                    raise Fail("The upload was cut off.", 400)
                f.write(b)
                left -= len(b)
        os.chmod(tmp, 0o664)
        base, dot, ext = name.rpartition(".")
        final, i = os.path.join(d, name), 1
        while True:
            try:
                os.close(os.open(final, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o664))
                break
            except FileExistsError:
                i += 1
                final = os.path.join(d, "%s (%d).%s" % (base, i, ext))
        os.replace(tmp, final)
    except OSError as e:
        raise Fail("The song could not be saved: %s" % (e.strerror or e), 500) from None
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return {"ok": True, "saved": os.path.basename(final)}


TERM_MAX = 6_000_000
TERM_IDLE = 600


class UnixConn(http.client.HTTPConnection):
    def __init__(self, path, timeout=20):
        super().__init__("localhost", timeout=timeout)
        self.sock_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.sock_path)


class Handler(BaseHTTPRequestHandler):
    """The panel's HTTP server: serves the page files and the API, checks the session and the request origin, and relays the terminal."""
    server_version = "homelab-panel"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        if os.environ.get("HLP_LOG"):
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def host_ok(self):
        host = (self.headers.get("Host") or "").lower()
        ok = {"localhost:%d" % PORT, "127.0.0.1:%d" % PORT, "[::1]:%d" % PORT}
        for h in HOSTS:
            ok.add(h)
        return host in ok

    def origin_ok(self, origin):
        net = urllib.parse.urlparse(origin).netloc.lower()
        return net == (self.headers.get("Host") or "").lower() or net in set(HOSTS) | {"localhost:%d" % PORT, "127.0.0.1:%d" % PORT}

    def cookie_token(self):
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE:
                return v
        return ""

    def send(self, code, body, ctype="application/json", extra=None, csp=None):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode("utf-8")
        elif isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        anc = " ".join(["'self'"] + FRAME)
        self.send_header("Content-Security-Policy", csp or ("default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; "
                                                           "script-src 'self'; connect-src 'self'; frame-ancestors " + anc))
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def fail(self, e):
        self.send(e.code, {"error": str(e)})

    def read_body(self, limit):
        n = int(self.headers.get("Content-Length") or 0)
        if n > limit:
            raise Fail("That is too big.", 413)
        return self.rfile.read(n) if n else b""

    def api_guard(self):
        if self.headers.get("X-Panel") != "1":
            raise Fail("This request did not come from the panel page.", 403)
        origin = self.headers.get("Origin")
        if origin and not self.origin_ok(origin):
            raise Fail("This request came from another website.", 403)
        if not session_ok(self.cookie_token()):
            raise Fail("Please log in again.", 401)

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        """Handle GET requests: the page files, the session and the read-only API calls."""
        try:
            if not self.host_ok():
                return self.send(421, {"error": "Unknown address."})
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/session":
                return self.send(200, {"loggedIn": session_ok(self.cookie_token()), "passwordSet": os.path.exists(PASSFILE), "version": VERSION})
            if path == "/api/state":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                with LOCK:
                    return self.send(200, full_state())
            if path == "/api/icons":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, icon_index())
            if path == "/api/drives/job":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, api_drives_job())
            if path == "/api/upload":
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, api_upload_state())
            if path in ("/api/updates", "/api/updates/job"):
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return self.send(200, api_updates_state("fresh=1" in self.path) if path == "/api/updates" else api_updates_job())
            if path == "/api/backup/download":
                if not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                return backup_download(self, urllib.parse.urlparse(self.path).query)
            if path in ("/api/backup", "/api/backup/job", "/api/backup/versions", "/api/backup/browse"):
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                if path == "/api/backup/job":
                    return self.send(200, api_backup_job())
                if path == "/api/backup":
                    return self.send(200, api_backup_state())
                return self.send(200, api_backup_look(path.rsplit("/", 1)[1], urllib.parse.urlparse(self.path).query))
            if path in ("/api/drives", "/api/drives/health", "/api/drives/check", "/api/drives/setups", "/api/drives/apps"):
                if self.headers.get("X-Panel") != "1" or not session_ok(self.cookie_token()):
                    raise Fail("Please log in again.", 401)
                if path == "/api/drives":
                    return self.send(200, api_drives_state())
                action, extra = path.rsplit("/", 1)[1], ()
                if action == "setups":
                    skip = [x for x in urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("skip", [""])[0].split(",") if x]
                    if len(skip) > 24 or not all(DRIVE_ID.match(x) for x in skip):
                        raise Fail("Those are not drive names.", 400)
                    extra = (",".join(skip),) if skip else ()
                return self.send(200, drives_json(action, extra))
            if path.startswith("/api/"):
                raise Fail("Unknown address.", 404)
            if path == "/terminal":
                return self.send(302, b"", "text/plain", {"Location": "/terminal/"})
            if path.startswith("/terminal/"):
                return self.terminal()
            self.static(path)
        except Fail as e:
            self.fail(e)
        except Exception as e:
            sys.stderr.write("error: %r\n" % (e,))
            self.send(500, {"error": "An internal error occurred in the panel. See:  journalctl -u homelab-panel -n 30"})

    def terminal_page(self, code, text):
        page = ("<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Terminal</title>"
                "<body style='font:16px system-ui,sans-serif;background:#0a0f19;color:#dbe4f5;padding:24px'><p>%s</p>"
                "<p><a style='color:#8ab4ff' target=_blank rel=noopener href='/'>Open the control panel</a></p>" % text)
        return self.send(code, page, "text/html; charset=utf-8")

    def terminal_target(self):
        u = urllib.parse.urlparse(self.path)
        return u.path + ("?" + u.query if u.query else "")

    def terminal(self):
        if not session_ok(self.cookie_token()):
            return self.terminal_page(401, "Log in to the control panel first (the Customize tab uses the same login), then reload this card.")
        if (self.headers.get("Upgrade") or "").lower() == "websocket":
            origin = self.headers.get("Origin")
            if not origin or not self.origin_ok(origin):
                raise Fail("This request came from another website.", 403)
            return self.terminal_socket()
        try:
            conn = UnixConn(TERM_SOCK)
            page = urllib.parse.urlparse(self.path).path.rstrip("/") in ("/terminal", "")
            conn.request("GET", self.terminal_target(), headers={"Host": "localhost", "Accept": self.headers.get("Accept") or "*/*",
                                                    "Accept-Encoding": "identity" if page else (self.headers.get("Accept-Encoding") or "identity")})
            r = conn.getresponse()
            body = r.read(TERM_MAX + 1)
            ctype, enc, status = r.getheader("Content-Type") or "application/octet-stream", r.getheader("Content-Encoding"), r.status
            conn.close()
        except (OSError, http.client.HTTPException):
            return self.terminal_page(502, "The terminal is not running. On the server, look at:  sudo systemctl status homelab-terminal")
        if len(body) > TERM_MAX or status not in (200, 304, 401, 404):
            return self.terminal_page(502, "The terminal returned a response that the panel cannot read.")
        if status == 200 and ctype.startswith("text/html") and not enc and b"</head>" in body:
            body = body.replace(b"</head>", b"<style>html,body{overscroll-behavior:contain}</style></head>", 1)
        anc = " ".join(["'self'"] + FRAME)
        csp = ("default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; "
               "connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-ancestors " + anc)
        return self.send(status, body, ctype, {"Content-Encoding": enc} if enc else None, csp=csp)

    def terminal_socket(self):
        """Relay the terminal's WebSocket: pass the handshake on, then pass bytes both ways until one side closes."""
        up = socket.socket(socket.AF_UNIX)
        try:
            up.settimeout(5)
            up.connect(TERM_SOCK)
        except OSError:
            up.close()
            return self.terminal_page(502, "The terminal is not running. On the server, look at:  sudo systemctl status homelab-terminal")
        keep = ("Upgrade", "Connection", "Sec-WebSocket-Key", "Sec-WebSocket-Version", "Sec-WebSocket-Protocol", "Sec-WebSocket-Extensions")
        head = ["GET %s HTTP/1.1" % self.terminal_target(), "Host: localhost"] + ["%s: %s" % (k, self.headers[k]) for k in keep if self.headers.get(k)]
        try:
            up.sendall(("\r\n".join(head) + "\r\n\r\n").encode("latin-1"))
        except (OSError, UnicodeEncodeError):
            up.close()
            return self.terminal_page(502, "The terminal could not be reached.")
        self.close_connection = True
        client = self.connection
        up.settimeout(None)
        client.settimeout(None)
        socks = [client, up]
        try:
            while True:
                ready = select.select(socks, [], [], TERM_IDLE)[0]
                if not ready:
                    break
                for x in ready:
                    data = x.recv(65536)
                    if not data:
                        return
                    (up if x is client else client).sendall(data)
        except OSError:
            pass
        finally:
            up.close()

    def static(self, path):
        names = {"/": "index.html", "/index.html": "index.html", "/app.js": "app.js", "/app.css": "app.css", "/icon.svg": "icon.svg"}
        fn = names.get(path)
        if not fn:
            return self.send(404, {"error": "Not found."})
        data = read_bytes(os.path.join(UI_DIR, fn))
        if data is None:
            return self.send(404, {"error": "The panel's page files are not installed (%s). Run: sudo homelab-setup upgrade" % UI_DIR})
        ctype = mimetypes.guess_type(fn)[0] or "application/octet-stream"
        self.send(200, data, ctype + ("; charset=utf-8" if ctype.startswith("text/") or ctype.endswith("javascript") else ""))

    def do_POST(self):
        """Handle POST requests: login and every change the panel can make."""
        try:
            if not self.host_ok():
                return self.send(421, {"error": "Unknown address."})
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/login":
                if self.headers.get("X-Panel") != "1" or (self.headers.get("Origin") and not self.origin_ok(self.headers.get("Origin"))):
                    raise Fail("This request did not come from the panel page.", 403)
                body = json.loads(self.read_body(4096) or b"{}")
                tok = login(body.get("password"))
                flags = "; HttpOnly; SameSite=Lax; Path=/; Max-Age=%d" % SESSION_MAX + ("" if os.environ.get("HLP_COOKIE_PLAIN") else "; Secure")
                return self.send(200, {"ok": True}, extra={"Set-Cookie": "%s=%s%s" % (COOKIE, tok, flags)})
            self.api_guard()
            if path == "/api/logout":
                SESSIONS.pop(self.cookie_token(), None)
                return self.send(200, {"ok": True}, extra={"Set-Cookie": "%s=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0%s" % (COOKIE, "" if os.environ.get("HLP_COOKIE_PLAIN") else "; Secure")})
            if path == "/api/background/theme":
                tb = json.loads(self.read_body(1 << 20) or b"{}")
                if not isinstance(tb, dict):
                    raise Fail("The request is not valid.")
                return self.send(200, theme_picture(tb))
            if path == "/api/background/upload":
                data = self.read_body(MAX_UPLOAD)
                with LOCK:
                    res = api_bg_upload(data)
                return self.send(200, res)
            if path in ("/api/upload/photo", "/api/upload/song"):
                return self.send(200, api_upload_stream(self, path.rsplit("/", 1)[1], urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)))
            body = json.loads(self.read_body(1 << 20) or b"{}")
            if not isinstance(body, dict):
                raise Fail("The request is not valid.")
            if path == "/api/upload/immich-key":
                return self.send(200, dict(api_upload_key(body), ok=True))
            if path == "/api/updates/start":
                return self.send(200, api_updates_start(body))
            if path == "/api/backup/save":
                return self.send(200, api_backup_save(body))
            if path == "/api/backup/dltoken":
                return self.send(200, api_backup_dltoken(body, self.cookie_token()))
            if path in ("/api/backup/run", "/api/backup/dry", "/api/backup/restore"):
                return self.send(200, api_backup_job_start(path.rsplit("/", 1)[1], body))
            if path in ("/api/backup/delete", "/api/backup/toggle", "/api/backup/sshkey", "/api/backup/sshtest", "/api/backup/cloud-add"):
                return self.send(200, dict(api_backup_task(path.rsplit("/", 1)[1], body), ok=True))
            if path == "/api/drives/abort":
                return self.send(200, dict(api_drives_abort(), ok=True))
            if path in ("/api/drives/add", "/api/drives/wipe", "/api/drives/disconnect", "/api/drives/move", "/api/drives/setup", "/api/drives/bootadd", "/api/drives/appsfix", "/api/drives/moveboot"):
                return self.send(200, api_drives_job_start(path.rsplit("/", 1)[1], body))
            if path in ("/api/drives/rename", "/api/drives/sleep", "/api/drives/wake", "/api/drives/remount"):
                return self.send(200, dict(api_drives_do(path.rsplit("/", 1)[1], body), ok=True))
            if path == "/api/location/search":
                return self.send(200, dict(api_location_search(body), ok=True))
            routes = {"/api/location": api_location_save, "/api/look": api_look_save, "/api/look/css": api_look_css, "/api/look/reset": api_look_reset, "/api/background": api_bg_save, "/api/background/reset": api_bg_reset,
                      "/api/layout": api_layout_save, "/api/card": api_card, "/api/hlcards/restore": api_hl_restore, "/api/mytheme": api_mytheme, "/api/link": api_link, "/api/group": api_group,
                      "/api/undo": lambda b: {"undone": undo()}}
            fn = routes.get(path)
            if not fn:
                raise Fail("Unknown address.", 404)
            with LOCK:
                res = fn(body)
            self.send(200, dict(res, ok=True))
        except Fail as e:
            self.fail(e)
        except ValueError:
            self.send(400, {"error": "The request is not valid."})
        except Exception as e:
            sys.stderr.write("error: %r\n" % (e,))
            self.send(500, {"error": "An internal error occurred in the panel. See:  journalctl -u homelab-panel -n 30"})


def read_bytes(p):
    try:
        with open(p, "rb") as f:
            return f.read()
    except OSError:
        return None


JOBSTATUS_FILE = os.path.join(IMAGES, "job-status.json")
MDSTAT = os.environ.get("HLP_MDSTAT") or "/proc/mdstat"
JOBSTATUS_SECS = float(os.environ.get("HLP_JOBSTATUS_SECS") or 5)
DRIVE_TITLES = {"setup": "Building the new drive setup", "add": "Adding a drive", "move": "Moving a drive", "disconnect": "Taking a drive out of its pool", "wipe": "Erasing a drive",
                "bootadd": "Reserving space on the boot drive", "moveboot": "Moving files from the boot drive", "appsfix": "Repairing Immich and Nextcloud", "remount": "Repairing the drives"}
UPDATE_TITLES = {"check": "Looking for updates", "containers": "Updating the containers", "containers-now": "Updating the containers", "system": "Updating the system", "restart": "Restarting the machine"}
MD_TITLES = {"resync": "Syncing drive array %s", "recovery": "Rebuilding drive array %s", "reshape": "Resizing drive array %s", "check": "Checking drive array %s"}


def eta_from_pace(pct, started, now):
    """Time left, from how long the job has taken so far. Given only when the percent is high enough for the pace to mean something."""
    if pct is None or not started or pct < 15 or pct >= 99 or now - started < 45:
        return None
    return max(60, int((now - started) * (100 - pct) / pct))


def md_jobs():
    """Drive arrays that are building or checking their redundancy in the background, with the percent and the finish time the system itself reports."""
    jobs, name = [], ""
    for line in read_text(MDSTAT).splitlines():
        m = re.match(r"(md\w+) :", line)
        if m:
            name = m.group(1)
            continue
        m = re.search(r"(resync|recovery|reshape|check)\s*=\s*([\d.]+)%", line)
        if name and m:
            f = re.search(r"finish=([\d.]+)min", line)
            sp = re.search(r"speed=(\d+)K/sec", line)
            jobs.append({"id": "md:" + name, "kind": "array", "title": MD_TITLES[m.group(1)] % name, "step": "Runs in the background. The drives can be used meanwhile." + (" About %d MB/s." % round(int(sp.group(1)) / 1024) if sp else ""),
                         "pct": min(99, int(float(m.group(2)))), "eta": int(float(f.group(1)) * 60) if f else None, "started": 0})
    return jobs


def job_status_jobs():
    now = int(time.time())
    jobs = []
    with UPJOB_LOCK:
        if UPJOB["running"]:
            pct = UPJOB["pct"]
            jobs.append({"id": "update", "kind": "updates", "title": UPDATE_TITLES.get(UPJOB["action"], "Updating"), "step": UPJOB["stage"] or "Working...", "pct": pct, "eta": eta_from_pace(pct, UPJOB["started"], now), "started": UPJOB["started"]})
    with JOB_LOCK:
        if JOB["running"]:
            vals = [JOB["progress"].get(i, {}).get("pct", 0) for i in JOB["items"]] or []
            pct = min(99, int(sum(vals) / len(vals))) if vals and JOB["progress"] else None
            cur = JOB["progress"].get(JOB["current"], {})
            jobs.append({"id": "drives", "kind": "drives", "title": DRIVE_TITLES.get(JOB["action"], "Changing the drives"), "step": cur.get("text") or "Working...", "pct": pct, "eta": eta_from_pace(pct, JOB["started"], now), "started": JOB["started"]})
    with BJOB_LOCK:
        if BJOB["running"]:
            pct = BJOB["pct"]
            jobs.append({"id": "backup", "kind": "backup", "title": {"run": "Running a backup", "dry": "Previewing a backup", "restore": "Restoring files"}.get(BJOB["action"], "Backup"), "step": "Working...", "pct": pct, "eta": eta_from_pace(pct, BJOB["started"], now), "started": BJOB["started"]})
    return jobs + md_jobs()


def job_status_write(last):
    """Write the running jobs for the dashboard's progress ring (images/job-status.json). `last` is True when the previous write held jobs. Returns True when this one does."""
    jobs = job_status_jobs()
    if not jobs and not last:
        return False
    if os.path.isdir(IMAGES):
        try:
            write_atomic(JOBSTATUS_FILE, json.dumps({"version": 1, "updated": int(time.time()), "jobs": jobs}), 0o644)
        except OSError:
            pass
    return bool(jobs)


def job_status_loop():
    last = True
    while True:
        try:
            last = job_status_write(last)
        except Exception as e:
            sys.stderr.write("job status: %r\n" % (e,))
        time.sleep(JOBSTATUS_SECS)


def cmd_serve():
    srv = ThreadingHTTPServer((BIND, PORT), Handler)
    srv.daemon_threads = True
    threading.Thread(target=job_status_loop, daemon=True).start()
    sys.stderr.write("homelab-panel %s listening on http://%s:%d (files in %s)\n" % (VERSION, BIND, PORT, HP))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_set_password(args):
    if "--stdin" in args:
        pw = sys.stdin.readline().rstrip("\n")
    else:
        pw = getpass.getpass("New password for the control panel (at least 10 characters): ")
        if getpass.getpass("Type it again: ") != pw:
            print("The two entries do not match. Nothing was changed.", file=sys.stderr)
            return 1
    try:
        set_password(pw)
    except Fail as e:
        print(str(e), file=sys.stderr)
        return 1
    print("The control panel password is set. All active sessions have been logged out.")
    return 0


def cmd_status():
    print("homelab-panel %s" % VERSION)
    print("  password:       %s" % ("set" if os.path.exists(PASSFILE) else "Not set (run: homelab panel password)"))
    print("  listens on:     http://%s:%d" % (BIND, PORT))
    print("  dashboard files: %s" % HP)
    print("  page files:     %s" % UI_DIR)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd == "serve":
        cmd_serve()
        return 0
    if cmd == "set-password":
        return cmd_set_password(argv[2:])
    if cmd == "status":
        return cmd_status()
    if cmd == "version":
        print(VERSION)
        return 0
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
