#!/usr/bin/env bash
# homelab-selftest - run the lab's read-only commands one by one and look for bugs and for things that should not be there.
#
#   sudo homelab-selftest             run everything, print a short verdict, save the full report
#   sudo homelab-selftest --online    also run the checks that use the internet (homelab-update check)
#   sudo homelab-selftest --builds    also build every ready-made setup on FAKE drives (about 10 minutes, Part 4)
#   homelab-selftest version
#
# It only reads. It never starts, stops or changes anything: hdd-recover, homelab-backup, drives release,
# restores and every other command that changes the machine are NOT run. Part 1 runs each command and notes
# the exit code, the time it took and error words in its output. Part 2 checks the state of the machine:
# the pools, Docker, the containers, the web pages, the schedule, leftovers from an earlier install, and so on.
# Part 3 tries the ready-made setups (sudo drives wizard, preset, spare, cache and their options) in look-only form: the list, the
# plan of every setup with --dry-run, the refusals, the help texts, and the repository's own unit tests. It compares
# /etc/fstab, /etc/crypttab, mdadm.conf and the drive records before and after, and fails if anything changed.
# Part 4 (only with --builds) builds every ready-made setup (plain pool, mirror, SnapRAID, ZFS, RAID, with and without hot spare,
# SSD cache and encryption) on fake drives made of files, with the INSTALLED drives command, and checks what each one did: the files
# it wrote, the lines in fstab, the key files, the list / status / health screens, the refusals and taking it apart again.
# No real drive, pool, mount or container is touched. It stops without running when a backup is running.
#
# The full report is saved in your home folder as homelab-selftest-<date>.txt. Known secret formats
# (tokens, keys, passwords) are hidden in it, but read it before you share it.

VERSION="1.4"
case "${1:-}" in
  version|--version) echo "homelab-selftest $VERSION"; exit 0 ;;
  -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
esac
ONLINE=0; BUILDS=0
for a in "$@"; do
  case "$a" in
    --online) ONLINE=1 ;;
    --builds) BUILDS=1 ;;
    *) echo "Unknown option: $a" >&2; echo "Usage: sudo homelab-selftest [--online] [--builds]   (or: homelab-selftest help | version)" >&2; exit 1 ;;
  esac
done

[ "$(id -u)" = 0 ] || { echo "Run this with sudo:  sudo homelab-selftest"; exit 1; }

REAL_USER="${HOMELAB_USER:-${SUDO_USER:-$(getent passwd 1000 | cut -d: -f1)}}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
REAL_HOME=${REAL_HOME:-/root}
REPORT="$REAL_HOME/homelab-selftest-$(date +%Y%m%d-%H%M).txt"
: >"$REPORT" 2>/dev/null || REPORT="/tmp/homelab-selftest-$(date +%Y%m%d-%H%M).txt"
chmod 600 "$REPORT" 2>/dev/null || true
[ "$REAL_HOME" != /root ] && chown "$REAL_USER:" "$REPORT" 2>/dev/null

N_OK=0; N_INFO=0; N_WARN=0; N_FAIL=0
ISSUES=()

mask() {   # hide the secret formats this lab uses
  sed -E \
    -e 's/tskey-[A-Za-z0-9_-]+/tskey-***/g' \
    -e 's/ptr_[A-Za-z0-9+\/=_-]+/ptr_***/g' \
    -e 's/base64:[A-Za-z0-9+\/=]+/base64:***/g' \
    -e 's/ssh-ed25519 [A-Za-z0-9+\/=]+/ssh-ed25519 ***/g' \
    -e 's/([Pp]assword|PASSWORD|[Tt]oken|TOKEN|[Ss]ecret|SECRET|[Aa]pi[_-]?[Kk]ey|API_KEY|APP_KEY)([A-Za-z_]*)([=:][ ]*)[^ ]+/\1\2\3***/g'
}

emit() { printf '%s\n' "$*" | tee -a "$REPORT" | cat; }
to_report() { mask >>"$REPORT"; }
section() { emit ""; emit "== $* =="; }
ok()   { N_OK=$((N_OK + 1));     emit "  ok    $*"; }
info() { N_INFO=$((N_INFO + 1)); emit "  info  $*"; }
warn() { N_WARN=$((N_WARN + 1)); emit "  WARN  $*"; ISSUES+=("WARN  $*"); }
fail() { N_FAIL=$((N_FAIL + 1)); emit "  FAIL  $*"; ISSUES+=("FAIL  $*"); }

as_user() { sudo -u "$REAL_USER" -H "$@"; }

# ---------------------------------------------------------------- part 1: every command
run_cmd() {   # run_cmd LABEL SECONDS user|root ALLOWED_EXIT_CODES -- command...
  local label=$1 secs=$2 who=$3 allowed=$4 out rc start elapsed errwords
  shift 5
  if ! command -v "$1" >/dev/null 2>&1 && [ "${1#/}" = "$1" ]; then
    fail "$label: the command '$1' is not installed"
    return
  fi
  start=$(date +%s)
  if [ "$who" = user ]; then
    out=$(cd "$REAL_HOME" && timeout "$secs" sudo -u "$REAL_USER" -H env TERM=dumb "$@" 2>&1 </dev/null); rc=$?
  else
    out=$(cd /root && timeout "$secs" env TERM=dumb "$@" 2>&1 </dev/null); rc=$?
  fi
  elapsed=$(( $(date +%s) - start ))
  {
    printf '\n--- %s   [%s]  exit %s  %ss\n' "$label" "$*" "$rc" "$elapsed"
    printf '%s\n' "$out" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | head -60
  } | to_report
  if [ "$rc" = 124 ]; then
    fail "$label: no answer after ${secs}s (stuck?)"
    return
  fi
  case " $allowed " in
    *" $rc "*) ;;
    *) fail "$label: exit code $rc ($(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | grep -m1 . | cut -c1-110 | mask))"; return ;;
  esac
  errwords=$(printf '%s\n' "$out" | grep -Eio 'traceback|command not found|syntax error|unbound variable|bad substitution|permission denied|cannot read docker|no such file or directory' | sort -u | tr '\n' ',' | sed 's/,$//')
  if [ -n "$errwords" ]; then
    warn "$label: the output contains: $errwords"
    return
  fi
  if [ "$elapsed" -gt 30 ]; then warn "$label: slow (${elapsed}s)"; return; fi
  ok "$label (${elapsed}s)"
}

part_commands() {
  section "Part 1: the commands (read-only ones)"
  run_cmd "homelab version"          20  user "0" -- homelab version
  run_cmd "homelab (login screen)"   90  user "0" -- homelab
  run_cmd "homelab status"           90  user "0" -- homelab status
  run_cmd "homelab commands"         20  user "0" -- homelab commands
  run_cmd "homelab docs"             20  user "0" -- homelab docs
  run_cmd "homelab secrets"          60  user "0" -- homelab secrets
  run_cmd "homelab bookmark list"    30  user "0" -- homelab bookmark list
  run_cmd "homelab-setup version"    20  root "0" -- homelab-setup version
  run_cmd "homelab-setup (checklist)" 180 root "0" -- homelab-setup
  run_cmd "homelab-setup --details"  180 root "0" -- homelab-setup --details
  run_cmd "homelab-setup verify"     180 root "0 1" -- homelab-setup verify
  run_cmd "drives version"           20  root "0" -- drives version
  run_cmd "drives status"            120 root "0" -- drives status
  run_cmd "homelab-update version"   20  root "0" -- homelab-update version
  run_cmd "homelab-update list"      30  user "0 1" -- homelab-update list
  run_cmd "homelab-sample version"   20  root "0" -- homelab-sample version
  if [ "$ONLINE" = 1 ]; then
    run_cmd "homelab-update check (internet)" 300 root "0" -- homelab-update check
  else
    info "homelab-update check was not run (it uses the internet). Add --online to include it."
  fi
  local repo; repo=$(repo_dir)
  if [ -n "$repo" ] && command -v homelab-check >/dev/null 2>&1; then
    run_cmd "homelab-check (the repo copy)" 120 user "0" -- homelab-check "$repo"
  else
    info "homelab-check was not run (no repository folder in $REAL_HOME)"
  fi
  local f
  for f in hdd-recover homelab-backup homelab-restore-configs; do
    if command -v "$f" >/dev/null 2>&1; then
      if bash -n "$(command -v "$f")" 2>/dev/null; then ok "$f is installed and has no syntax errors (not run: it changes things)"
      else fail "$f has a syntax error"; fi
    else
      fail "$f is not installed"
    fi
  done
}

# ---------------------------------------------------------------- part 2: the state of the machine
mode_of() { stat -c %a "$1" 2>/dev/null; }
fstab_lines() { grep -v '^[[:space:]]*#' /etc/fstab 2>/dev/null; }   # the active lines of /etc/fstab
repo_dir() {   # the folder with the lab's repository in the home folder (prints nothing when there is none)
  local d
  for d in "$REAL_HOME/My-Home-Lab-" "$REAL_HOME/My-Home-Lab"; do [ -d "$d/scripts" ] && { echo "$d"; return 0; }; done
  return 0
}
BOOT_SECTIONS=/var/lib/homelab-boot-sections

same_as_repo() {   # same_as_repo REPO_COPY INSTALLED_COPY: true when they are the same, apart from the user name the installer fills in
  cmp -s "$1" "$2" && return 0
  [ "$(wc -l <"$1")" = "$(wc -l <"$2")" ] && [ "$(diff "$1" "$2" | grep -c '^[<>]')" -le 4 ]
}

check_scripts_vs_repo() {
  local f installed repo; repo=$(repo_dir)
  if [ -z "$repo" ]; then info "no repository folder in $REAL_HOME, so the installed scripts were not compared with it"; return; fi
  for f in drives homelab-backup homelab-update homelab-restore-configs homelab-sample hdd-recover homelab homelab-check; do
    installed=$(command -v "$f" 2>/dev/null) || continue
    # the installer puts this machine's user name into its copy, so a plain byte comparison is not enough
    if same_as_repo "$repo/scripts/$f" "$installed"; then continue; fi
    warn "the installed $f differs from the copy in $repo (it is older or newer; a fresh install or: cd $repo && git pull, then sudo homelab-setup refresh)"
  done
}

part_state() {
  section "Part 2: the state of the machine"
  local n b pool names f p

  # ---- system
  if [ -r /etc/os-release ]; then info "$(grep -m1 '^PRETTY_NAME=' /etc/os-release | cut -d'"' -f2), kernel $(uname -r), up $(uptime -p | sed 's/^up //')"; fi
  local freepct
  freepct=$(df --output=pcent / | tail -1 | tr -dc 0-9)
  if [ "${freepct:-0}" -ge 90 ]; then fail "the boot drive is ${freepct}% full"; else ok "boot drive ${freepct}% used"; fi
  if [ "$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)" -lt 300 ]; then warn "less than 300 MB of memory is available"; else ok "memory is fine"; fi

  # ---- drives and pools
  for pool in /mnt/storage /mnt/backup; do
    if mountpoint -q "$pool"; then
      info "$pool is mounted ($(findmnt -no FSTYPE "$pool"), $(df -h --output=used,size "$pool" | tail -1 | awk '{print $1" of "$2}'))"
    else
      info "$pool is not mounted: a plain folder on the boot drive ($(du -sh "$pool" 2>/dev/null | cut -f1 | grep . || echo empty))"
    fi
  done
  names=$(fstab_lines | awk '$2 ~ "^/mnt/disks/(MAIN|BACKUP)([0-9]+|BOOT)$" {print $2}' | xargs -r -n1 basename | tr '\n' ' ')
  if [ -n "${names// /}" ]; then
    info "drives assigned to pools in /etc/fstab: $names"
    info "on a new install nothing should be listed here until you chose the drives with: sudo drives. To take them out: sudo drives release"
  else
    ok "no drive is assigned to a pool in /etc/fstab"
  fi
  while read -r b; do
    [ -n "$b" ] || continue
    if ! mountpoint -q "$b"; then fail "$b is in /etc/fstab but is not mounted (drive unplugged?)"; fi
  done < <(fstab_lines | awk '$2 ~ "^/mnt/disks/" {print $2}')
  for pool in /mnt/storage /mnt/backup; do
    if ! mountpoint -q "$pool" && [ -n "$(ls -A "$pool" 2>/dev/null)" ] && fstab_lines | awk -v p="$pool" '$2 == p' | grep -q .; then
      fail "$pool has a pool line in /etc/fstab but is not mounted, and the boot drive folder has files in it"
    fi
  done
  # boot drive sections: a file of a fixed size on the boot drive that a pool uses last
  local img
  for img in "$BOOT_SECTIONS"/*.img; do
    [ -f "$img" ] || continue
    if fstab_lines | awk -v f="$img" '$1 == f' | grep -q .; then
      info "boot drive section in use: $(basename "$img" .img) pool, $(( $(stat -c %s "$img") / 1000000000 )) GB reserved on the boot drive"
    else
      warn "$img is not used by any pool (left over after sudo drives release or remove); it still takes $(( $(stat -c %s "$img") / 1000000000 )) GB of the boot drive"
    fi
  done
  if ls "$BOOT_SECTIONS"/*.img >/dev/null 2>&1; then
    local bfree; bfree=$(df -B1 --output=avail / | tail -1 | tr -d ' ')
    if [ "${bfree:-0}" -lt 128000000000 ]; then warn "the boot drive has less than 128 GB free while boot drive sections exist"; fi
    # Timeshift copies the whole boot drive: without an exclusion every snapshot holds a full extra copy of the section
    local tsconf="${TIMESHIFT_CONF:-/etc/timeshift/timeshift.json}" tsstate
    if [ -f "$tsconf" ]; then
      tsstate=$(python3 - "$tsconf" "$BOOT_SECTIONS/**" <<'PY' 2>/dev/null || echo unreadable
import json, sys
try:
    ex = json.load(open(sys.argv[1])).get("exclude", [])
except Exception:
    print("unreadable"); sys.exit(0)
print("ok" if isinstance(ex, list) and sys.argv[2] in ex else "missing")
PY
)
      case "$tsstate" in
        ok) ok "Timeshift skips the boot drive sections" ;;
        missing) warn "Timeshift does not skip $BOOT_SECTIONS: every snapshot would hold a full copy of the section and fill the boot drive (fix: sudo drives timeshift)" ;;
        *) warn "Timeshift's settings ($tsconf) could not be read, so the boot drive section exclusion was not checked" ;;
      esac
    fi
  fi
  if [ -d /var/lib/homelab-drives ] && [ -z "${names// /}" ]; then warn "/var/lib/homelab-drives exists but no drive is assigned (leftover of an earlier install)"; fi
  if [ -f /etc/homelab-drive-names ]; then info "/etc/homelab-drive-names exists (drive names you chose): $(tr '\n' ';' </etc/homelab-drive-names | cut -c1-120)"; fi
  if [ -d /etc/systemd/system/docker.service.d ] && ls /etc/systemd/system/docker.service.d/*.conf >/dev/null 2>&1; then
    info "Docker has extra settings: $(find /etc/systemd/system/docker.service.d -name '*.conf' -printf '%f ')"
  fi

  # ---- backup
  if [ -r /var/lib/homelab-backup/last-run ]; then
    local stamp result dest
    IFS='|' read -r stamp result dest _ </var/lib/homelab-backup/last-run
    if [ -n "$dest" ] && [ "$dest" != none ] && [ ! -d "$dest/main" ]; then
      warn "the last-backup record ($stamp, $result) points to $dest, which has no backup in it (a record left by an earlier install)"
    else
      info "last backup: $stamp $result -> $dest"
    fi
  else
    info "no backup has run yet"
  fi
  if [ -f /etc/homelab-backup.conf ]; then
    info "backup folder used while no backup drive is connected: $(grep -m1 '^DEST_FALLBACK=' /etc/homelab-backup.conf | cut -d'"' -f2)"
    if grep -q '750GB_HDD' /etc/homelab-backup.conf && [ ! -d "$REAL_HOME/750GB_HDD" ] && [ -d "$REAL_HOME/boot-drive-files" ]; then
      warn "/etc/homelab-backup.conf still names ~/750GB_HDD (from the earlier install) but this machine uses ~/boot-drive-files; change DEST_FALLBACK there"
    fi
    # shellcheck disable=SC1091
    ( . /etc/homelab-backup.conf 2>/dev/null; [ -z "${DEST_FALLBACK:-}" ] || [ -d "$(dirname "$DEST_FALLBACK")" ] ) || warn "the fallback backup folder in /etc/homelab-backup.conf does not exist"
  fi
  if [ -d "$REAL_HOME/750GB_HDD" ] && [ -d "$REAL_HOME/boot-drive-files" ]; then info "both ~/750GB_HDD and ~/boot-drive-files exist (the older name is from the original server)"; fi

  # ---- Docker and the containers
  if systemctl is-active --quiet docker 2>/dev/null; then ok "the Docker service is running"; else fail "the Docker service is not running (sudo systemctl status docker)"; fi
  if id -nG "$REAL_USER" | tr ' ' '\n' | grep -qx docker; then ok "$REAL_USER is in the docker group"; else fail "$REAL_USER is not in the docker group (log out and in again, or: sudo usermod -aG docker $REAL_USER)"; fi
  local ps
  if ps=$(timeout 30 docker ps -a --format '{{.Names}}|{{.Status}}' 2>&1); then
    local total bad
    total=$(printf '%s\n' "$ps" | grep -c .)
    bad=$(printf '%s\n' "$ps" | grep -Ei 'exited|restarting|unhealthy|dead|created' | cut -d'|' -f1 | tr '\n' ' ')
    if [ "$total" -eq 0 ]; then warn "Docker has no containers";
    elif [ -n "${bad// /}" ]; then fail "containers not running or not healthy: $bad"
    else ok "all $total containers are running"; fi
    printf '\n--- docker ps -a\n%s\n' "$ps" | to_report
  else
    fail "docker ps did not answer: $(printf '%s' "$ps" | head -1)"
  fi

  # ---- the web pages of the apps (answered on this machine)
  local svc port code
  LAN_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i+1); exit}}')
  [ -n "$LAN_IP" ] || LAN_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  for svc in "Homepage:3001" "Portainer:9000" "AdGuard Home:3000" "Beszel:8090" "Netdata:19999" "Speedtest Tracker:8088" "FileBrowser:8081" "Immich:2283" "Nextcloud:8082"; do
    port=${svc##*:}; svc=${svc%:*}
    # Homepage only answers the addresses it was told about (HOMEPAGE_ALLOWED_HOSTS), so ask by this machine's address
    code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "http://${LAN_IP:-127.0.0.1}:$port/" 2>/dev/null)
    case "$code" in
      200|301|302|303|307|308|401|403) ok "$svc answers on port $port (HTTP $code)" ;;
      000) fail "$svc does not answer on port $port" ;;
      *) warn "$svc answers on port $port with HTTP $code" ;;
    esac
  done

  # ---- network
  if command -v tailscale >/dev/null 2>&1; then
    if timeout 15 tailscale status >/dev/null 2>&1; then ok "Tailscale is connected"; else fail "Tailscale is not connected (sudo tailscale up)"; fi
  else
    fail "Tailscale is not installed"
  fi
  local p53
  p53=$(ss -lntupH 2>/dev/null | awk '$5 ~ /:53$/ {print $0}' | head -3)
  if printf '%s' "$p53" | grep -q 'systemd-resolve'; then fail "systemd-resolved still holds port 53, so AdGuard Home cannot use it"
  elif [ -z "$p53" ]; then warn "nothing listens on port 53 (AdGuard Home is not answering DNS)"
  else ok "port 53 is held by something other than systemd-resolved"; fi
  if getent hosts example.com >/dev/null 2>&1; then ok "this machine resolves names"; else fail "this machine cannot resolve names"; fi
  info "name server in /etc/resolv.conf: $(awk '/^nameserver/ {print $2}' /etc/resolv.conf | tr '\n' ' ')"

  # ---- the schedule and the login screen
  local cron
  cron=$(crontab -l 2>/dev/null | grep -v '^[[:space:]]*#')
  for n in homelab-sample homelab-update "drives power"; do
    local cnt; cnt=$(printf '%s\n' "$cron" | grep -c -- "$n")
    if [ "$cnt" = 0 ]; then warn "root's crontab has no line for: $n"
    elif [ "$cnt" -gt 1 ]; then warn "root's crontab has $cnt lines for: $n (duplicates)"
    else ok "root's crontab has one line for: $n"; fi
  done
  if printf '%s\n' "$cron" | grep -q homelab-backup; then ok "root's crontab has the backup line"; else info "root's crontab has no backup line (fine until a backup drive is set up)"; fi
  if [ -r "$REAL_HOME/.bashrc" ]; then
    local blocks; blocks=$(grep -c '# >>> homelab login display >>>' "$REAL_HOME/.bashrc")
    if [ "$blocks" = 1 ]; then ok "the login screen is set up once"; elif [ "$blocks" = 0 ]; then warn "the login screen is not set up in .bashrc"; else warn "the login screen block is in .bashrc $blocks times"; fi
  fi

  # ---- secrets and permissions
  if [ -f /root/.homelab-setup/secrets.env ]; then
    if [ "$(mode_of /root/.homelab-setup/secrets.env)" = 600 ]; then ok "the secrets file is root-only (600)"; else fail "the secrets file has mode $(mode_of /root/.homelab-setup/secrets.env), it should be 600"; fi
  else
    info "no secrets file (this machine was not built by the installer)"
  fi
  if [ -f "$REAL_HOME/homepage-config/services.yaml" ] && [ "$(stat -c %U "$REAL_HOME/homepage-config/services.yaml")" != "$REAL_USER" ]; then warn "the Homepage config files are not owned by $REAL_USER"; fi
  for f in drives homelab-backup homelab-update homelab-restore-configs homelab-sample homelab-setup hdd-recover homelab; do
    p=$(command -v "$f" 2>/dev/null) || continue
    [ -x "$p" ] || fail "$p is not executable"
    if grep -q $'\r' "$p" 2>/dev/null; then fail "$p has Windows line endings"; fi
  done
  check_scripts_vs_repo

  # ---- ports that listen on all interfaces
  local known=" 22 53 2283 3000 3001 8081 8082 8088 8090 9000 9443 19999 " unknown=""
  while read -r port proc; do
    case "$known" in *" $port "*) continue ;; esac
    unknown="$unknown $port${proc:+ ($proc)};"
  done < <(ss -lntpH 2>/dev/null | awk '$4 ~ /^(0\.0\.0\.0|\*|\[::\]):/ {n = split($4, a, ":"); match($0, /\("[^"]+"/); print a[n], (RSTART ? substr($0, RSTART + 2, RLENGTH - 3) : "")}' | sort -un)
  info "ports open to the whole network: $(ss -lntH 2>/dev/null | awk '$4 ~ /^(0\.0\.0\.0|\*|\[::\]):/ {n=split($4,a,":"); print a[n]}' | sort -un | tr '\n' ' ')"
  [ -z "$unknown" ] || info "ports that are not one of the lab's apps:$unknown"
}


# ---------------------------------------------------------------- part 3: the ready-made setups (look-only)
fingerprint() {   # everything the ready-made setups could change, as one line of checksums
  {
    cat /etc/fstab /etc/crypttab /etc/mdadm/mdadm.conf /etc/cron.d/homelab-snapraid /etc/cron.d/homelab-zfs-scrub /etc/systemd/system/homelab-zfs-key.service 2>/dev/null
    ls -lR /var/lib/homelab-drives /etc/homelab-drives 2>/dev/null
    cat /proc/mdstat 2>/dev/null
    zpool list -H -o name 2>/dev/null
    findmnt -rn -o TARGET,SOURCE,FSTYPE 2>/dev/null
  } | sha256sum | cut -c1-16
}

expect_cmd() {   # expect_cmd LABEL SECONDS ALLOWED_EXIT_CODES REGEX -- command...   (root, no input; REGEX must match the output)
  local label=$1 secs=$2 allowed=$3 want=$4 out rc clean
  shift 5
  out=$(cd /root && timeout "$secs" env TERM=dumb "$@" 2>&1 </dev/null); rc=$?
  clean=$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g')
  { printf '\n--- %s   [%s]  exit %s\n' "$label" "$*" "$rc"; printf '%s\n' "$clean" | head -60; } | to_report
  if [ "$rc" = 124 ]; then fail "$label: no answer after ${secs}s (stuck?)"; return; fi
  case " $allowed " in *" $rc "*) ;; *) fail "$label: exit code $rc, expected $allowed ($(printf '%s\n' "$clean" | grep -m1 . | cut -c1-100))"; return ;; esac
  if printf '%s\n' "$clean" | grep -Eiq 'traceback|command not found|syntax error|unbound variable|bad substitution'; then
    fail "$label: the output has a script error ($(printf '%s\n' "$clean" | grep -Eim1 'traceback|command not found|syntax error|unbound variable|bad substitution'))"; return
  fi
  if ! printf '%s\n' "$clean" | grep -Eq "$want"; then
    fail "$label: the output does not say what it should (looking for: $want). First line: $(printf '%s\n' "$clean" | grep -m1 . | cut -c1-100)"; return
  fi
  ok "$label"
}

part_presets() {
  section "Part 3: the ready-made setups (drives wizard, preset, spare, cache) - look only"
  local id before after repo help_out ids="pool mirror snapraid1 snapraid2 zfs-stripe zfs-mirror zfs-raidz1 zfs-raidz2 zfs-raidz3 md-raid0 md-raid1 md-raid5 md-raid6 md-raid10"
  if ! command -v drives >/dev/null 2>&1; then fail "drives is not installed"; return; fi
  if ! drives help 2>&1 </dev/null | grep -q 'preset'; then
    fail "the installed drives does not know 'preset': install the new one:  cd ~/My-Home-Lab- && git pull && sudo install -m 755 scripts/drives /usr/local/sbin/drives"
    return
  fi
  before=$(fingerprint)

  # the words and the help
  expect_cmd "drives help preset"  20 "0" 'sudo drives preset \[NAME\].*--spare.*--cache.*--encrypt' -- drives help preset
  expect_cmd "drives help spare"   20 "0" '^sudo drives spare'   -- drives help spare
  expect_cmd "drives help cache"   20 "0" '^sudo drives cache'   -- drives help cache
  expect_cmd "drives help snapraid" 20 "0" '^sudo drives snapraid' -- drives help snapraid
  expect_cmd "drives help wizard"  20 "0" '^sudo drives wizard'  -- drives help wizard
  expect_cmd "drives (command list)" 20 "0 1" 'preset +build a whole setup' -- drives help
  if command -v homelab >/dev/null 2>&1; then
    help_out=$(homelab commands 2>&1 </dev/null | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g')
    local w; for w in wizard preset snapraid spare cache; do
      if printf '%s\n' "$help_out" | grep -Eq "sudo drives $w( |$)"; then ok "homelab commands lists 'sudo drives $w'"; else fail "homelab commands does not list 'sudo drives $w' (install the new homelab: sudo install -m 755 scripts/homelab /usr/local/bin/homelab)"; fi
    done
  fi

  # the list of setups
  expect_cmd "drives preset (the list)" 30 "0" 'Ready-made setups' -- drives preset
  help_out=$(drives preset 2>&1 </dev/null | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g')
  local found=0 missing=""
  for id in $ids; do
    if printf '%s\n' "$help_out" | grep -Eq "^  $id +"; then found=$((found + 1)); else missing="$missing $id"; fi
  done
  if [ "$found" = 14 ]; then ok "the list shows all 14 setups"; else fail "the list shows $found of 14 setups (missing:$missing)"; fi
  if printf '%s\n' "$help_out" | grep -q 'With your drives:'; then ok "the list says what your drives can do"; else fail "the list has no 'With your drives:' lines"; fi

  # the plan of each setup, without changing anything: either a plan, or a clear reason why not
  for id in $ids; do
    expect_cmd "drives preset $id --dry-run" 60 "0 1" 'DRY RUN|needs a program that is not installed|empty drives?; I found|some drives are already in a storage|is already a .* array|has files in it|is already used by something else|already exists on this computer' -- drives preset "$id" --dry-run
  done
  expect_cmd "drives preset nonsense is refused" 20 "1" "There is no setup called 'nonsense'" -- drives preset nonsense
  expect_cmd "drives preset raidz1 (short name)" 60 "0 1" 'DRY RUN|needs a program that is not installed|empty drives?; I found|some drives are already in a storage|is already a .* array|already exists on this computer' -- drives preset raidz1 --dry-run

  # the extras and their refusals
  expect_cmd "drives wizard --dry-run (looks at the drives, changes nothing)" 60 "0" 'already set up|Drive scan' -- drives wizard --dry-run
  expect_cmd "--first-run outside wizard is refused" 20 "1" 'works with: wizard' -- drives status --first-run
  expect_cmd "--spare outside preset is refused" 20 "1" 'work with: preset' -- drives status --spare
  expect_cmd "--cache outside preset is refused" 20 "1" 'work with: preset' -- drives list --cache
  expect_cmd "--encrypt outside preset is refused" 20 "1" 'work with: preset' -- drives health --encrypt
  if [ -s /var/lib/homelab-drives/preset ] && grep -Eq '^(zfs|md)-' /var/lib/homelab-drives/preset; then
    info "a ZFS / RAID array exists on this machine, so spare / cache / pool-command refusals were not tried (they work differently with an array)"
    expect_cmd "drives status shows the array" 120 "0" 'Array health' -- drives status
  else
    expect_cmd "drives spare with no array is refused" 20 "1" 'no ZFS or RAID array' -- drives spare
    expect_cmd "drives cache with no array is refused" 20 "1" 'no ZFS or RAID array' -- drives cache
    expect_cmd "drives spare --dry-run with no array is refused" 20 "1" 'no ZFS or RAID array' -- drives spare --dry-run
  fi

  # the look-only commands that show array drives
  expect_cmd "drives list"   60  "0" 'DRIVE +ROLE +DEVICE' -- drives list
  expect_cmd "drives health" 180 "0 1" 'DRIVE +DEVICE|HEALTH' -- drives health

  # the repository's own tests of the arithmetic and the words (they run on a temporary folder, not on this machine's drives)
  repo=$(repo_dir)
  if [ -n "$repo" ] && [ -f "$repo/tests/t_preset.sh" ]; then
    local t_out t_rc
    t_out=$(cd "$repo" && timeout 300 bash tests/t_preset.sh 2>&1 </dev/null); t_rc=$?
    { printf '\n--- tests/t_preset.sh  exit %s\n' "$t_rc"; printf '%s\n' "$t_out" | tail -20; } | to_report
    if [ "$t_rc" = 0 ] && printf '%s\n' "$t_out" | tail -1 | grep -qx OK; then ok "tests/t_preset.sh: $(printf '%s\n' "$t_out" | grep -m1 '^ok ' | sed 's/^ok *//')"
    else fail "tests/t_preset.sh failed: $(printf '%s\n' "$t_out" | grep -m1 FAIL | cut -c1-120)"; fi
    # the repository copy and the installed copy must be the same version of the script
    if same_as_repo "$repo/scripts/drives" "$(command -v drives)"; then ok "the installed drives is the same as the repository copy"
    else warn "the installed drives differs from $repo/scripts/drives (after a git pull run: sudo install -m 755 scripts/drives /usr/local/sbin/drives)"; fi
  else
    info "the repository's own tests were not run (no repository folder with tests/t_preset.sh in $REAL_HOME)"
  fi

  after=$(fingerprint)
  if [ "$before" = "$after" ]; then ok "nothing on this machine changed during these checks (fstab, crypttab, RAID, pools, drive records)"
  else fail "something on this machine changed during the checks (fstab, crypttab, RAID, pools or drive records): this part must only read"; fi
}

# ---------------------------------------------------------------- part 4: build every setup on fake drives
part_builds() {
  section "Part 4: build every ready-made setup on FAKE drives (no real drive is touched)"
  local repo bench work log drives_bin before after rc pid n last free_kb bad_lines runs line dev mp
  repo=$(repo_dir); bench="$repo/tools/drive-bench/bench.py"
  if [ -z "$repo" ] || [ ! -f "$bench" ]; then
    fail "the build test needs the repository folder with tools/drive-bench in $REAL_HOME (cd ~ && git clone https://github.com/IbrandonrtI/My-Home-Lab-.git)"; return
  fi
  drives_bin=$(command -v drives) || { fail "drives is not installed"; return; }
  local tool missing=""
  for tool in python3 losetup mkfs.ext4 mergerfs parted rsync fallocate blkid e2label wipefs partprobe; do command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"; done
  if [ -n "$missing" ]; then fail "the build test needs these programs, which are not installed:$missing"; return; fi
  if [ -e /var/lock/homelab-backup.lock ] && ! ( exec 7</var/lock/homelab-backup.lock && flock -n 7 ) 2>/dev/null; then
    warn "a backup is running right now, so the build test was NOT started (it would slow the backup down). Run it again after the backup."; return
  fi
  free_kb=$(df --output=avail -k /var/tmp 2>/dev/null | tail -1 | tr -d ' ')
  if [ -z "$free_kb" ] || [ "$free_kb" -lt 2000000 ]; then fail "less than 2 GB are free in /var/tmp, which the fake drives need"; return; fi
  work=/var/tmp/homelab-selftest-builds; log=$work.log
  if [ -d "$work" ]; then   # an earlier run that was stopped
    findmnt -rn -o TARGET | grep "^$work" | sort -r | while read -r mp; do umount -l "$mp" 2>/dev/null; done
    losetup -ln -O NAME,BACK-FILE 2>/dev/null | awk -v w="$work" 'index($2, w) {print $1}' | while read -r dev; do losetup -d "$dev" 2>/dev/null; done
    chattr -R -i "$work" 2>/dev/null; rm -rf "$work"
  fi
  info "building 14 setups and their extras on fake drives with $drives_bin; this takes about 10 minutes"
  before=$(fingerprint)
  ( nice -n 5 ionice -c2 -n6 timeout 3000 python3 "$bench" --level quick --layout '^m0-b0-blank5$' --flow presets --no-other --no-truth --real off \
        --work "$work" --drives "$drives_bin" >"$log" 2>&1 </dev/null; echo "$?" >"$log.rc" ) &
  pid=$!; last=-1
  while kill -0 "$pid" 2>/dev/null; do
    sleep 20
    n=$(wc -l <"$work/results.jsonl" 2>/dev/null || echo 0)
    [ "$n" != "$last" ] && [ "$n" -gt 0 ] && { printf '        ... %s runs done\n' "$n"; last=$n; }
  done
  wait "$pid" 2>/dev/null
  rc=$(cat "$log.rc" 2>/dev/null || echo 99); rm -f "$log.rc"
  { printf '\n--- the build test   exit %s\n' "$rc"; tail -30 "$log" 2>/dev/null; } | to_report
  if [ -f "$work/report.txt" ]; then
    cp "$work/report.txt" "$REAL_HOME/homelab-selftest-builds-$(date +%Y%m%d-%H%M).txt" 2>/dev/null
    chmod 600 "$REAL_HOME"/homelab-selftest-builds-*.txt 2>/dev/null; [ "$REAL_HOME" != /root ] && chown "$REAL_USER:" "$REAL_HOME"/homelab-selftest-builds-*.txt 2>/dev/null
    runs=$(grep -m1 -o 'runs: [0-9]*' "$work/report.txt" | tr -dc 0-9)
    if [ "$rc" = 0 ] && grep -q '^No problems found' "$work/report.txt"; then
      ok "every setup built, was checked and was taken apart again on fake drives (${runs:-?} runs, no problems)"
    else
      bad_lines=$(grep -E '^\[(HIGH|MEDIUM|LOW)\]' "$work/report.txt" | head -8 | cut -c1-150)
      fail "the build test found problems (exit $rc, ${runs:-?} runs):"
      printf '%s\n' "$bad_lines" | while IFS= read -r line; do [ -n "$line" ] && emit "          $line"; done
      emit "          (the full text is in the file homelab-selftest-builds-*.txt in $REAL_HOME)"
    fi
  else
    fail "the build test did not write a report (exit $rc). Last lines: $(tail -3 "$log" 2>/dev/null | tr '\n' ' ' | cut -c1-200)"
  fi
  # take the fake drives away again
  findmnt -rn -o TARGET | grep "^$work" | sort -r | while read -r mp; do umount -l "$mp" 2>/dev/null; done
  losetup -ln -O NAME,BACK-FILE 2>/dev/null | awk -v w="$work" 'index($2, w) {print $1}' | while read -r dev; do losetup -d "$dev" 2>/dev/null; done
  chattr -R -i "$work" 2>/dev/null; rm -rf "$work" "$log"
  if [ -e "$work" ] || losetup -ln -O BACK-FILE 2>/dev/null | grep -q "$work"; then warn "some fake drives could not be removed from $work (harmless; they are files, not real drives)"; fi
  after=$(fingerprint)
  if [ "$before" = "$after" ]; then ok "nothing on this machine changed during the build test (fstab, crypttab, RAID, pools, drive records)"
  else fail "something on this machine changed during the build test: it must only use fake drives"; fi
}

# ---------------------------------------------------------------- run it
emit "homelab-selftest $VERSION   $(date '+%F %T')   machine: $(hostname)   user: $REAL_USER"
part_commands
part_state
part_presets
if [ "$BUILDS" = 1 ]; then part_builds
else
  section "Part 4: the build test"
  info "not run. Add --builds to also build every setup on fake drives (about 10 minutes, no real drive is touched)."
fi

section "Result"
emit "  $N_OK ok, $N_INFO info, $N_WARN warnings, $N_FAIL failures"
if [ ${#ISSUES[@]} -gt 0 ]; then
  emit ""
  emit "Look at these:"
  for n in "${ISSUES[@]}"; do emit "  $n"; done
fi
emit ""
emit "Full report with the output of every command: $REPORT"
[ "$N_FAIL" -eq 0 ]
