#!/usr/bin/env bash
# homelab-sample - save a few readings that need root, so the login screen can show them.
#
# Runs from root's crontab every 15 minutes. It writes small files into /var/lib/homelab/:
#   temps      one line per drive:  LABEL|DEVICE|TEMP_C|EPOCH     (TEMP_C is "standby" for a sleeping drive)
#   apt        UPGRADABLE_PACKAGES|EPOCH
#   schedule   MINUTE|HOUR|DAY|MONTH|WEEKDAY|EPOCH               (the cron line of homelab-backup)
# It also keeps the drive pills of the Homepage dashboard right: "Main pool" and "Backup pool" while the pool is
# connected, "Connect Main Drive" / "Connect Backup Drive" while it is not.
# The homelab command only reads these files.
#
# It never wakes a sleeping drive (smartctl -n standby) and never changes anything except these files.
# To keep the machine quiet it runs at the lowest priority, only reads the drive temperatures in the first
# 10 minutes after a boot (apps are still starting), and looks for system updates at most every 6 hours
# when the schedule runs it (typed by hand, it takes every reading).
#
#   sudo homelab-sample            take the readings now and print what was saved
#   sudo homelab-sample widgets    only update the drive names on the Homepage dashboard (the drive tool runs this)
#   homelab-sample version

set -u
export PATH="${HOMELAB_EXTRA_PATH:+$HOMELAB_EXTRA_PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

VERSION="1.1"
OUT_DIR="${HOMELAB_STATE_DIR:-/var/lib/homelab}"

case "${1:-}" in
  version|--version) echo "homelab-sample $VERSION"; exit 0 ;;
  help|--help|-h) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  ""|widgets) ;;
  *) echo "Usage: sudo homelab-sample   (or: homelab-sample widgets | version)" >&2; exit 1 ;;
esac

[ "$(id -u)" -eq 0 ] || { echo "Run it with sudo."; exit 1; }
mkdir -p "$OUT_DIR" || { echo "Cannot create $OUT_DIR"; exit 1; }
chmod 755 "$OUT_DIR"
NOW=$(date +%s)
# lowest priority for CPU and drive, so the readings never slow the apps or an SSH session down
renice -n 19 -p $$ >/dev/null 2>&1 || true
ionice -c3 -p $$ >/dev/null 2>&1 || true

BOOT_GRACE=600
UPDATES_EVERY=21600
up=${HOMELAB_UPTIME:-$(cut -d. -f1 /proc/uptime 2>/dev/null)}
[[ "${up:-}" =~ ^[0-9]+$ ]] || up=999999

put() {   # put NAME  (content on stdin): write atomically, readable by everyone
  local tmp
  tmp=$(mktemp "$OUT_DIR/.tmp.XXXXXX") || return 1
  cat >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$OUT_DIR/$1"
}

# ---------- drive temperatures ----------
temp_from_smart() {   # reads smartctl -A output on stdin -> integer degrees C, or nothing
  awk '
    function num(x) { gsub(/[^0-9].*$/, "", x); return x }
    /^194[[:space:]]/ { t194 = num($10) }
    /^190[[:space:]]/ { t190 = num($10) }
    /^Temperature:[[:space:]]/ { if ($2 ~ /^[0-9]+$/) tn = $2 }
    /^Current Drive Temperature:/ { if ($4 ~ /^[0-9]+$/) tn = $4 }
    END { if (t194 != "") print t194; else if (tn != "") print tn; else if (t190 != "") print t190 }
  '
}

read_temp() {   # read_temp /dev/sdX -> prints a number or "standby"; prints nothing if there is no reading
  local dev=$1 out t
  command -v smartctl >/dev/null 2>&1 || return 1
  out=$(smartctl -n standby -A "$dev" 2>/dev/null)
  if printf '%s' "$out" | grep -qi 'STANDBY'; then echo standby; return 0; fi
  t=$(printf '%s' "$out" | temp_from_smart)
  if [ -z "$t" ]; then
    out=$(smartctl -n standby -A -d sat "$dev" 2>/dev/null)
    if printf '%s' "$out" | grep -qi 'STANDBY'; then echo standby; return 0; fi
    t=$(printf '%s' "$out" | temp_from_smart)
  fi
  [ -n "$t" ] && echo "$t"
}

disk_label() {   # disk_label NAME -> MAIN1, BACKUP1 ... or "boot", or the model name
  local d=$1 line lab mnt model
  while IFS= read -r line; do
    lab=$(printf '%s' "$line" | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
    mnt=$(printf '%s' "$line" | sed -n 's/.*MOUNTPOINT="\([^"]*\)".*/\1/p')
    case "$mnt" in /|/boot|/boot/efi|"[SWAP]") echo boot; return ;; esac
    case "$mnt" in /mnt/disks/*) [ -n "$lab" ] && { echo "$lab"; return; } ;; esac
  done < <(lsblk -P -o LABEL,MOUNTPOINT "/dev/$d" 2>/dev/null)
  model=$(lsblk -dno MODEL "/dev/$d" 2>/dev/null | sed 's/[[:space:]]*$//; s/ /_/g')
  echo "${model:-$d}"
}

sample_temps() {
  local d dev label t lines=""
  while read -r d typ; do
    [ "$typ" = disk ] || continue
    case "$d" in loop*|ram*|zram*|sr*) continue ;; esac
    dev="/dev/$d"
    t=$(read_temp "$dev") || t=""
    [ -n "$t" ] || continue
    label=$(disk_label "$d")
    lines="${lines}${label}|${dev}|${t}|${NOW}"$'\n'
  done < <(lsblk -dno NAME,TYPE 2>/dev/null)
  printf '%s' "$lines" | put temps
}

# ---------- system updates ----------
sample_apt() {
  local n last
  if [ ! -t 1 ]; then      # started by the schedule, not by hand
    [ "$up" -ge "$BOOT_GRACE" ] || return 0
    last=$(cut -d'|' -f2 "$OUT_DIR/apt" 2>/dev/null)
    if [[ "${last:-}" =~ ^[0-9]+$ ]] && [ $((NOW - last)) -lt "$UPDATES_EVERY" ]; then return 0; fi
  fi
  if command -v apt-get >/dev/null 2>&1; then
    n=$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')
    printf '%s|%s\n' "${n:-0}" "$NOW" | put apt
  fi
}

# ---------- the backup's cron line ----------
sample_schedule() {
  local line m h dom mon dow
  line=$(crontab -l 2>/dev/null | grep -v '^[[:space:]]*#' | grep 'homelab-backup' | head -1)
  [ -n "$line" ] || { : | put schedule; return 0; }
  read -r m h dom mon dow _ <<<"$line"
  printf '%s|%s|%s|%s|%s|%s\n' "$m" "$h" "$dom" "$mon" "$dow" "$NOW" | put schedule
}

# ---------- the drive pills on the Homepage dashboard ----------
# widgets.yaml has one pill per pool: label "Main pool" (disk /mnt/storage) and "Backup pool" (disk /mnt/backup).
# While a pool is not mounted the pill's label asks for the drive instead, and goes back when it is mounted.
# An older file with one "Drives" pill (disk: / and /mnt/storage) is turned into the new pills once.
homepage_dir() {   # prints the folder Homepage reads its settings from (remembered between runs)
  local d=""
  [ -r "$OUT_DIR/homepage-dir" ] && d=$(cat "$OUT_DIR/homepage-dir")
  if [ -z "$d" ] || [ ! -d "$d" ]; then
    d=$(timeout 10 docker inspect homepage --format '{{range .Mounts}}{{if eq .Destination "/app/config"}}{{.Source}}{{end}}{{end}}' 2>/dev/null)
    [ -n "$d" ] && [ -d "$d" ] && printf '%s\n' "$d" | put homepage-dir
  fi
  [ -n "$d" ] && [ -d "$d" ] && printf '%s\n' "$d"
}

sample_widgets() {
  command -v python3 >/dev/null 2>&1 || return 0
  local dir file main_ok=0 backup_ok=0
  dir=$(homepage_dir) || return 0
  file="$dir/widgets.yaml"; [ -w "$file" ] || return 0
  mountpoint -q "${HOMELAB_MAIN_POOL:-/mnt/storage}" 2>/dev/null && main_ok=1
  mountpoint -q "${HOMELAB_BACKUP_POOL:-/mnt/backup}" 2>/dev/null && backup_ok=1
  python3 - "$file" "$main_ok" "$backup_ok" <<'PY' || true
import re, sys

path, main_ok, backup_ok = sys.argv[1], sys.argv[2] == "1", sys.argv[3] == "1"
text = open(path).read()
lines = text.split("\n")
blocks, cur = [], []          # the file is a list: every top-level "- " starts a new item
for ln in lines:
    if ln.startswith("- ") and cur:
        blocks.append(cur)
        cur = []
    cur.append(ln)
blocks.append(cur)


def disks(b):
    """The disk paths a resources block shows (one 'disk: /x' or a list under 'disk:')."""
    out, grab = [], False
    for ln in b:
        m = re.match(r"^\s+disk:\s*(\S.*)?$", ln)
        if m:
            if m.group(1):
                out.append(m.group(1).strip())
                grab = False
            else:
                grab = True
            continue
        if grab:
            m = re.match(r"^\s+-\s+(\S+)\s*$", ln)
            if m:
                out.append(m.group(1))
                continue
            grab = False
    return out


def pill(label, path):
    return ["- resources:", "    label: " + label, "    disk: " + path, "    expanded: true", ""]


NET = ["- resources:", "    label: Network", "    network: true", ""]
out, has_main, has_backup = [], False, False
for b in blocks:
    if b[0].strip() == "- resources:" and "/mnt/backup" in disks(b):
        has_backup = True
for b in blocks:
    d = disks(b) if b[0].strip() == "- resources:" else []
    if "/mnt/storage" in d:
        old_style = len(d) > 1 or any(re.match(r"^\s+network:\s*true", ln) for ln in b)
        if old_style:                       # the old "Drives" pill: one pill per pool and a Network pill
            out += pill("Main pool", "/mnt/storage")
            if not has_backup:
                out += pill("Backup pool", "/mnt/backup")
                has_backup = True
            if any(re.match(r"^\s+network:\s*true", ln) for ln in b):
                out += NET
            has_main = True
            continue
        has_main = True
        if not has_backup:
            out += b[:-1] if b[-1] == "" else b
            if b[-1] == "":
                out.append("")
            out += pill("Backup pool", "/mnt/backup")
            has_backup = True
            continue
    out += b
new = "\n".join(out)


def relabel(txt, path, label):
    """Set the label of the resources block that shows 'path'."""
    parts = re.split(r"(?m)^(?=- )", txt)
    for i, part in enumerate(parts):
        if part.startswith("- resources:") and re.search(r"(?m)^\s+disk:\s*" + re.escape(path) + r"\s*$", part):
            parts[i] = re.sub(r"(?m)^(\s+label:).*$", lambda m: m.group(1) + " " + label, part, count=1)
    return "".join(parts)


new = relabel(new, "/mnt/storage", "Main pool" if main_ok else "Connect Main Drive")
new = relabel(new, "/mnt/backup", "Backup pool" if backup_ok else "Connect Backup Drive")
if new != text:
    open(path, "w").write(new)
PY
  return 0
}

if [ "${1:-}" = widgets ]; then sample_widgets; exit 0; fi

sample_temps
sample_apt
sample_schedule
sample_widgets

echo "Saved to $OUT_DIR:"
for f in temps apt schedule; do
  printf '  %s\n' "$f"
  if [ -s "$OUT_DIR/$f" ]; then sed 's/^/    /' "$OUT_DIR/$f"; else echo "    (nothing)"; fi
done
