ADOPT_IMAGES = {
    "adguard": ("adguard/adguardhome",), "beszel": ("henrygd/beszel",), "netdata": ("netdata/netdata",),
    "speedtest-tracker": ("linuxserver/speedtest-tracker",), "filebrowser": ("filebrowser/filebrowser",),
