def nc_installed():
    """True when Nextcloud has finished installing itself."""
    st, js, _ = http("GET", url("nextcloud", "/status.php"), timeout=10)
    return st == 200 and isinstance(js, dict) and js.get("installed") is True


FORCED_NC_KEYS = ("overwritehost", "overwriteprotocol")


def occ(*args):
    """Run Nextcloud's `occ` command inside its container."""
    return docker("exec", "-u", "www-data", "nextcloud", "php", "occ", *args, timeout=300)


def nc_system_config():
    """Nextcloud's whole system config as a dict, from one call (secret values are hidden by occ itself), or None when it cannot be read."""
    rc, txt = occ("config:list", "system")
    if rc != 0:
        return None
    try:
        data = json.loads(txt[txt.index("{"):])
        cfg = data.get("system")
        return cfg if isinstance(cfg, dict) else None
    except ValueError:
        return None


@step
class NextcloudReady(Step):
    id, group, title = "nextcloud-ready", "Logins and keys", "Nextcloud finished its first install"
    needs = ("stack-nextcloud",)

    def probe(self):
        return "done" if nc_installed() else "todo"

    def run(self):
        if Opt.dry:
            out("      would wait (2 to 15 minutes) for Nextcloud's first install to finish")
            return
        wait_for(nc_installed, "Nextcloud's first install (2 to 15 minutes)", 1500, every=10)


@step
class NextcloudConfig(Step):
    id, group, title = "nextcloud-config", "Logins and keys", "Nextcloud trusts this address and local servers (for Immich)"
    needs = ("nextcloud-ready",)

    def probe(self):
        cfg = nc_system_config()
        if cfg is not None:   # one call to Nextcloud answers all of it (each call into the container takes about 0.4 s)
            allow = str(cfg.get("allow_local_remote_servers", "")).lower()
            doms = "\n".join(str(d) for d in (cfg.get("trusted_domains") or []))
            forced = [k for k in FORCED_NC_KEYS if k in cfg]
            return "done" if "true" in allow and Ctx.fqdn in doms and Ctx.lan in doms and not forced else "todo"
        rc, txt = occ("config:system:get", "allow_local_remote_servers")
        rc2, doms = occ("config:system:get", "trusted_domains")
        forced = [k for k in FORCED_NC_KEYS if occ("config:system:get", k)[0] == 0]
        return "done" if rc == 0 and "true" in txt.lower() and Ctx.fqdn in doms and Ctx.lan in doms and not forced else "todo"

    def run(self):
        if Opt.dry:
            out("      would set trusted domains and allow_local_remote_servers in Nextcloud, and remove a forced address if one is saved")
            return
        for k in FORCED_NC_KEYS:   # a forced address would send every local request to the Tailscale address
            if occ("config:system:get", k)[0] == 0:
                occ("config:system:delete", k)
        for args in (["config:system:set", "allow_local_remote_servers", "--value=true", "--type=boolean"],
                     ["config:system:set", "trusted_domains", "1", "--value=" + Ctx.lan],
                     ["config:system:set", "trusted_domains", "2", "--value=" + Ctx.fqdn]):
            rc, txt = occ(*args)
            if rc != 0:
                raise Abort("occ %s failed: %s" % (args[0], txt.strip()[-200:]))


@step
class NextcloudRestoreDb(Step):
    id, group, title = "nextcloud-restore-db", "Logins and keys", "Nextcloud database loaded from your backup"
    needs = ("stack-nextcloud",)

    def applies(self):
        return bool(restore_choice().get("data"))

    def probe(self):
        return "done" if State.ran("nextcloud-restore-db") else "todo"

    def run(self):
        dumps = sorted(glob.glob(restore_choice()["path"] + "/db-dumps/nextcloud-*.sql.gz"))
        if not dumps:
            State.mark("nextcloud-restore-db")
            return
        dump = dumps[-1]
        if Opt.dry:
            out("      would load %s into the new Nextcloud database" % dump)
            return
        if not typed("RESTORE", "Type RESTORE to replace the new, empty Nextcloud database with %s" % os.path.basename(dump)):
            raise Abort("Not confirmed. Run `sudo homelab-setup refresh` when you want to load the dump.")
        docker("stop", "nextcloud", "nextcloud_cron")
        psql = ["exec", "-i", "nextcloud_db", "psql", "-U", "nextcloud", "-v", "ON_ERROR_STOP=1"]
        run(["docker"] + psql + ["-d", "postgres", "-c", "DROP DATABASE IF EXISTS nextcloud"], check=True)
        run(["docker"] + psql + ["-d", "postgres", "-c", "CREATE DATABASE nextcloud OWNER nextcloud"], check=True)
        with gzip.open(dump, "rt") as f:
            rc, txt = run(["docker"] + psql + ["-d", "nextcloud"], input_text=f.read(), timeout=1800)
        if rc != 0:
            raise Abort("Loading the dump failed: %s" % txt.strip()[-300:])
        docker("start", "nextcloud", "nextcloud_cron")
        State.mark("nextcloud-restore-db")


# ================================================================ Beszel
def beszel_first_run():
    """True while Beszel has no user yet."""
    st, js, _ = http("GET", url("beszel", "/api/beszel/first-run"), timeout=10)
    if st == 200 and isinstance(js, dict):
        return bool(js.get("firstRun"))
    return None


def beszel_login(email, pw):
    """Log in to Beszel and return its answer."""
    st, js, _ = http("POST", url("beszel", "/api/collections/users/auth-with-password"),
                     body={"identity": email, "password": pw}, timeout=20)
    return js.get("token") if st == 200 and isinstance(js, dict) else None


@step
class BeszelUser(Step):
    id, group, title = "beszel-user", "Logins and keys", "Beszel hub account created"
    needs = ("stack-beszel",)

    def probe(self):
        return "done" if beszel_first_run() is False else "todo"

    def help(self):
        return "Open %s and create the account with your email address and the admin password. Then run `sudo homelab-setup refresh`." % url("beszel")

    def run(self):
        need_email()
        if Opt.dry:
            out("      would create the Beszel hub account for the email address entered at install")
            return
        pw = need_password("to create the Beszel hub account")
        wait_for(lambda: beszel_first_run() is not None, "Beszel to answer", 120)
        bodies = [{"email": Ctx.email, "password": pw},
                  {"email": Ctx.email, "password": pw, "passwordConfirm": pw},
                  {"email": Ctx.email, "password": pw, "passwordConfirm": pw, "username": Ctx.admin.lower()}]
        for b in bodies:
            st, js, _ = http("POST", url("beszel", "/api/beszel/create-user"), body=b, timeout=30)
            if st in (200, 201, 204) and beszel_first_run() is False:
                return
        raise Abort("The Beszel account could not be created automatically. %s" % self.help())


@step
class BeszelAgentKey(Step):
    id, group, title = "beszel-agent-key", "Logins and keys", "Beszel agent key and token fetched from the hub"
    needs = ("beszel-user",)

    def probe(self):
        Secrets.load()
        if Secrets.get("BESZEL_KEY") and Secrets.get("BESZEL_TOKEN"):
            return "done"
        return "na" if Mode.existing else "todo"

    def run(self):
        if Opt.dry:
            out("      would ask the Beszel hub for its public key and a permanent agent token")
            return
        pw = need_password("to log in to the Beszel hub")
        tok = beszel_login(Ctx.email, pw)
        if not tok:
            raise Abort("The Beszel hub rejected the login for %s. Run `sudo homelab-setup fill`." % Ctx.email)
        hdr = {"Authorization": tok}
        st, js, _ = http("GET", url("beszel", "/api/beszel/info"), headers=hdr, timeout=20)
        if st != 200:
            st, js, _ = http("GET", url("beszel", "/api/beszel/getkey"), headers=hdr, timeout=20)
        key = js.get("key") if st == 200 and isinstance(js, dict) else None
        if not key:
            raise Abort("The Beszel hub did not give its public key (HTTP %s)." % st)
        want = rand_hex(16)
        st, js, _ = http("GET", url("beszel", "/api/beszel/universal-token?enable=1&permanent=1&token=" + want),
                         headers=hdr, timeout=20)
        token = js.get("token") if st == 200 and isinstance(js, dict) else None
        if not token:
            raise Abort("The Beszel hub did not give an agent token (HTTP %s)." % st)
        Secrets.set("BESZEL_KEY", key)
        Secrets.set("BESZEL_TOKEN", token)
# ================================================================ Homepage widgets: create the key, TEST it, then write it
def basic(user, pw):
    """Basic-authentication header for a user name and password."""
    return {"Authorization": "Basic " + base64.b64encode(("%s:%s" % (user, pw)).encode()).decode()}


def judge(st):
    """For an answer that was not a success: None when the service did not really answer (no connection, too slow, or an error
    of its own: it may be busy or restarting, so nothing can be said about the key), False when it answered and said no."""
    return None if st == 0 or st >= 500 else False


def verdict(st):
    """The result of a test whose success is HTTP 200: True, or what judge() says about any other answer."""
    return True if st == 200 else judge(st)


def v_adguard(v):
    """Test the AdGuard Home login with a live request. True, False (rejected) or None (no answer)."""
    st, _, _ = http("GET", url("adguard", "/control/status"), headers=basic(v["username"], v["password"]), timeout=10)
    return verdict(st)


def v_tailscale(v):
    """Test the Tailscale API key with a live request."""
    base = os.environ.get("HLS_TS_API", "https://api.tailscale.com")
    st, _, _ = http("GET", "%s/api/v2/device/%s" % (base, v["deviceid"]), headers=basic(v["key"], ""), timeout=20)
    return verdict(st)


def v_beszel(v):
    """Test the Beszel login with a live request."""
    silent = False
    for path in ("/api/collections/_superusers/auth-with-password", "/api/admins/auth-with-password"):
        st, js, _ = http("POST", url("beszel", path), body={"identity": v["username"], "password": v["password"]}, timeout=15)
        if st == 200 and isinstance(js, dict) and js.get("token"):
            return True
        silent = silent or judge(st) is None
    return None if silent else False


def v_netdata(v):
    """Test that Netdata answers."""
    st = http("GET", url("netdata", "/api/v1/info"), timeout=10)[0]
    return verdict(st)


def v_speedtest(v):
    """Test the Speedtest Tracker token with a live request."""
    st, _, _ = http("GET", url("speedtest", "/api/v1/results/latest"),
                    headers={"Authorization": "Bearer " + v["key"], "Accept": "application/json"}, timeout=30)
    if st in (401, 403):
        return False
    return None if st == 0 or st >= 500 else True


def v_portainer(v):
    """Test the Portainer key with a live request."""
    st, _, _ = http("GET", url("portainer", "/api/users/me"), headers={"X-API-Key": v["key"]}, timeout=10)
    if st != 200:
        return judge(st)
    st, _, _ = http("GET", url("portainer", "/api/endpoints/%s" % v["env"]), headers={"X-API-Key": v["key"]}, timeout=10)
    return verdict(st)


def v_filebrowser(v):
    """Test the FileBrowser login with a live request."""
    st, _, _ = http("POST", url("filebrowser", "/api/login"), body={"username": v["username"], "password": v["password"]}, timeout=10)
    return verdict(st)


def v_immich(v):
    """Test the Immich key with a live request."""
    st, _, _ = http("GET", url("immich", "/api/server/statistics"), headers={"x-api-key": v["key"]}, timeout=15)
    return verdict(st)


def v_nextcloud(v):
    """Test the Nextcloud token with a live request."""
    st, js, _ = http("GET", url("nextcloud", "/ocs/v2.php/apps/serverinfo/api/v1/info?format=json"),
                     headers={"NC-Token": v["key"], "OCS-APIRequest": "true", "Accept": "application/json"}, timeout=30)
    if st == 200:
        return isinstance(js, dict) and (js.get("ocs") or {}).get("meta", {}).get("statuscode") == 200
    return judge(st)


class WidgetStep(Step):
    group = "Homepage"
    unsure = False          # the last test got no answer from the service (the saved key was kept)

    def applies(self):
        return self.card != "adguard-card" or adguard_wanted()

    def __init__(self, sid, card, title, needs, fields, verify, auto=None, prompts=None, kind="auto", help_text="", pre=None, fill_text=""):
        self.id, self.card, self.title = sid, card, title
        self.needs = tuple(needs) + ("homepage-files",)
        self.fields, self.verify, self.auto = fields, verify, auto
        self.prompts = prompts or []
        self.kind = kind
        self.help_text = help_text
        self.fill_text = fill_text
        self.pre = pre or {}

    def values(self):
        v = {f: hp_get(self.card, f) for f in self.fields}
        for k, val in self.pre.items():
            v.setdefault(k, val)
        return v

    def probe(self):
        if not os.path.exists(hp_path()) or not hp_has_widget(self.card):
            return "todo"
        v = self.values()
        if any(is_placeholder(x) for x in v.values()):
            return "todo"
        key = "vf:" + self.id
        last = State.note(key)
        if last and time.time() - float(last) < 600 and not os.environ.get("HLS_NO_THROTTLE"):
            return "todo"           # tested and failed a few minutes ago: do not hammer the service
        ok = self.verify(v)
        if ok is None:
            # The service did not answer (busy, restarting). That says nothing about the key, so the step is NOT redone:
            # a login or key that is in the Homepage config stays as it is, and it is tested again next time.
            self.unsure = True
            return "done"
        self.unsure = False
        if not ok:
            State.note(key, str(time.time()))
            return "todo"
        if last:
            State.note(key, "")
        return "done"

    def detail(self):
        return "kept, the service did not answer just now" if self.unsure else "tested"

    @property
    def service_name(self):
        """The title without the part in brackets: 'AdGuard Home widget login'."""
        return self.title.split(" (")[0]

    def tested(self, v, patient=True):
        """True or False from the service. If it does not answer, wait for it (up to 2 minutes); if it still does not, stop."""
        ok = self.verify(v)
        if ok is None and patient and not Opt.dry:
            def answer():
                nonlocal ok
                ok = self.verify(v)
                return ok is not None
            try:
                wait_for(answer, "%s to answer" % self.service_name, 3 if FAKE else 120, every=5)
            except Abort:
                pass
        if ok is None:
            raise Abort("%s did not answer, so nothing was tested or written. It may be busy or still starting: wait a minute, then run `sudo homelab-setup refresh` again." % self.service_name)
        return ok

    def wait_alive(self):
        """Before asking for a password or changing anything: wait until the service answers at all (up to 2 minutes)."""
        svc = self.card[:-5]
        if svc not in PORTS or Opt.dry:
            return
        def alive():
            st = http("GET", url(svc, "/"), timeout=10)[0]
            return st != 0 and st < 500
        try:
            wait_for(alive, "%s to answer" % svc, 3 if FAKE else 120, every=5)
        except Abort:
            raise Abort("%s is not answering at %s right now. Nothing was changed and no password was asked. Wait a minute, then run `sudo homelab-setup refresh` again." % (self.service_name, url(svc))) from None

    def help(self):
        if self.help_text:
            return self.help_text
        return "This could not be created automatically. Run `sudo homelab-setup fill`."

    def fill_help(self):
        return self.fill_text or "Paste the value below, or skip it and run `sudo homelab-setup refresh` to let the installer try again."

    def prefill(self):
        """Values the person is not asked for in `fill` (a widget with such values overrides this)."""
        return {}

    def _write(self, v):
        if not self.tested(v):
            raise Abort("The new login or key failed its test against the service, so it was not written to the Homepage configuration.")
        hp_set_widget(self.card, v)
        State.note("vf:" + self.id, "")        # it just passed: never let an older failed test hide that

    def run(self):
        if self.auto is None:
            raise Abort(self.help())
        if Opt.dry:
            out("      would create and test the key for %s, then write it into the Homepage config" % self.card)
            return
        self.wait_alive()
        self._write(self.auto())

    def fill(self):
        cur = {}
        for f, label, hidden in self.prompts:
            cur[f] = ask_secret(label) if hidden else ask(label, hp_get(self.card, f) or "")
        for k, val in self.pre.items():
            cur.setdefault(k, val)
        cur.update(self.prefill())
        try:
            ok = self.tested(cur)
        except Abort as e:
            bad(str(e))
            return False
        if not ok:
            bad("The service rejected it during the test. Nothing was written. Check the value and try again.")
            return False
        hp_set_widget(self.card, cur)
        good("%s tested and saved in the Homepage config." % self.title)
        return True


