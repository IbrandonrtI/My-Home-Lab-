    return True


def un_rm(path):
    p = P(path)
    if not os.path.lexists(p):
        return False
    if Opt.dry:
        out("      would delete: %s" % path)
        return True
    if os.path.isdir(p) and not os.path.islink(p):
        shutil.rmtree(p)
    else:
        os.remove(p)
    return True


