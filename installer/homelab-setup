def http(method, url, body=None, headers=None, timeout=20, form=None, raw=False):
    """Send an HTTP request and return (status, parsed JSON or text, headers). Status 0 means the connection failed."""
    hdr = dict(headers or {})
    data = None
    if form is not None:
        boundary = "----hls" + rand_alnum(16)
        parts = []
        for k, v in form.items():
            parts.append("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n" % (boundary, k, v))
        parts.append("--%s--\r\n" % boundary)
        data = "".join(parts).encode()
        hdr["Content-Type"] = "multipart/form-data; boundary=%s" % boundary
    elif body is not None:
        data = json.dumps(body).encode()
        hdr.setdefault("Content-Type", "application/json")
    req = urllib.request.Request(url, data=data, method=method, headers=hdr)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            txt = r.read().decode("utf-8", "replace")
            st, hd = r.status, dict(r.headers)
    except urllib.error.HTTPError as e:
        txt = e.read().decode("utf-8", "replace") if e.fp else ""
        st, hd = e.code, dict(e.headers or {})
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as e:
        return 0, str(e), {}
    if raw:
        return st, txt, hd
    try:
        return st, json.loads(txt), hd
    except ValueError:
        return st, txt, hd


def wait_for(fn, what, timeout=300, every=3, quiet=False):
    """Call fn until it returns a true value or the timeout expires, then raise Abort."""
    end = time.time() + timeout
    n = 0
    while True:
        try:
            v = fn()
        except Abort:
            raise
        except Exception:
            v = None
        if v:
            if n and Live.active:
                Live.set_note("")
            return v
        if time.time() > end:
            raise Abort("Timed out after %d seconds waiting for %s." % (timeout, what))
        if not quiet and n == 0:
            if Live.active:
                Live.set_note("waiting for %s" % what)
            else:
                out("      waiting for %s ..." % what)
        n += 1
        time.sleep(every if not FAKE else 0.05)


def interactive():
    return sys.stdin.isatty()


def stdin_line():
    """Read one line from a pipe without reading ahead, so a program started later can read the rest."""
    buf = b""
    while True:
        ch = os.read(0, 1)
        if not ch:
            break
        buf += ch
        if ch == b"\n":
            break
    return buf.decode("utf-8", "replace")


def ask(prompt, default=""):
    if Opt.yes and default != "":
        return default
    with Live.pause():
        return _ask(prompt, default)


def _read_piped(label):
    sys.stdout.write(label)
    sys.stdout.flush()
    v = stdin_line()
    if v == "":
        raise EOFError
    out("")
    return v.rstrip("\n")


def _ask(prompt, default=""):
    label = "  %s%s: " % (prompt, (" [%s]" % default) if default else "")
    try:
        v = input(label) if interactive() else _read_piped(label)
    except EOFError:
        raise Abort("An answer is required for: %s (no input was available)." % prompt) from None
    return v.strip() or default


def ask_secret(prompt):
    with Live.pause():
        return _ask_secret(prompt)


def _ask_secret(prompt):
    label = "  %s: " % prompt
    try:
        return getpass.getpass(label) if interactive() else _read_piped(label)
    except EOFError:
        raise Abort("An answer is required for: %s (no input was available)." % prompt) from None


def yesno(prompt, default=False):
    if Opt.yes:
        return True
    v = ask(prompt + (" [Y/n]" if default else " [y/N]"), "").lower()
    if v == "":
        return default
    return v in ("y", "yes")


def typed(word, prompt):
    if Opt.yes:
        return True
    return ask(prompt).strip() == word
class State:
    """Non-secret facts: the answers given, the one-time actions that ran and what the user acknowledged."""
    data = {}
    readonly = False

    @classmethod
    def load(cls):
        try:
            cls.data = json.loads(read_file(STATE_FILE, "{}") or "{}")
        except ValueError:
            cls.data = {}
        cls.data.setdefault("answers", {})
        cls.data.setdefault("ran", {})
        cls.data.setdefault("ack", {})
        cls.data.setdefault("skip", {})
        cls.data.setdefault("notes", {})

    lock = threading.RLock()

    @classmethod
    def save(cls):
        if Opt.dry or cls.readonly:
            return
        with cls.lock:
            os.makedirs(STATE_DIR, exist_ok=True)
            write_file(STATE_FILE, json.dumps(cls.data, indent=1, sort_keys=True) + "\n", 0o600)

    @classmethod
    def exists(cls):
        return os.path.exists(STATE_FILE)

    @classmethod
    def ran(cls, key):
        return key in cls.data["ran"]

    @classmethod
    def mark(cls, key):
        cls.data["ran"][key] = time.strftime("%F %T")
        cls.save()

    @classmethod
    def note(cls, key, text=None):
        if text is None:
            return cls.data["notes"].get(key, "")
        if text:
            cls.data["notes"][key] = text
        else:
            cls.data["notes"].pop(key, None)
        cls.save()


class Secrets:
    """Generated passwords and keys, kept in one root-only file (mode 600). The typed admin password is never stored."""
    vals = {}

    @classmethod
    def load(cls):
        cls.vals = {}
        for line in read_file(SECRET_FILE).splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                cls.vals[k.strip()] = v.strip()

    @classmethod
    def get(cls, key, default=""):
        return cls.vals.get(key, default)

    @classmethod
    def set(cls, key, value):
        cls.vals[key] = value
        cls.save()

    @classmethod
    def save(cls):
        if Opt.dry:
            return
        os.makedirs(SECRET_DIR, exist_ok=True)
        os.chmod(SECRET_DIR, 0o700)
        body = ["# homelab-setup secrets (root only, mode 600). Copy these into a password manager.",
                "# Never commit this file to a repository and never share it."]
        body += ["%s=%s" % (k, cls.vals[k]) for k in sorted(cls.vals)]
        write_file(SECRET_FILE, "\n".join(body) + "\n", 0o600)


class Runtime:
    password = None
    background = False
    unattended = False
    hide = []


def need_password(why):
    """Ask for the shared admin password once per run, when a step needs it, and validate it before use."""
    if Runtime.password:
        return Runtime.password
    if Runtime.background or Runtime.unattended:
        raise NeedsPassword("This step needs the admin password, and the background job does not have it. Run `sudo homelab-setup finish` and type it there.")
    out("")
    say("This step needs the admin password (%s). It is used for this run only and is not saved." % why)
    for _ in range(3):
        pw = ask_secret("Admin password")
        problem = password_problem(pw)
        if problem:
            warn(problem)
            continue
        if Portainer.admin_state() == 204:
            if not Portainer.login(pw):
                warn("That is not the password of the Portainer admin account (%s). Enter the password chosen at the start of the installation." % Ctx.admin)
                continue
        elif ask_secret("Type it again") != pw:
            warn("The two entries did not match.")
            continue
        Runtime.password = pw
        return pw
    raise Abort("No matching admin password was entered. Setup stopped before configuring any further logins. Run `sudo homelab-setup refresh` to try again.")


def password_problem(pw):
    if len(pw) < 12:
        return "The password must be at least 12 characters (Portainer requires it)."
    if not re.fullmatch(r"[A-Za-z0-9]+", pw):
        return "Use letters and digits only. Other characters can break the stack files and the Homepage configuration."
    return ""
class Ctx:
    """Facts about this machine and the answers given at the start of the install."""
    user = uid = gid = home = ""
    lan = gateway = tz = hostname = ""
    admin = email = ""
    fqdn = tailnet = ts_id = ""
    repo = ""
    os_id = os_name = os_codename = os_version = ""

    @classmethod
    def detect(cls):
        a = State.data["answers"]
        cls.user = a.get("user") or detect_user()
        try:
            pw = pwd.getpwnam(cls.user)
            cls.uid, cls.gid, cls.home = pw.pw_uid, pw.pw_gid, pw.pw_dir
        except KeyError:
            cls.uid = cls.gid = 1000
            cls.home = "/home/" + cls.user
        if ROOT and not os.path.isabs(cls.home):
            cls.home = "/home/" + cls.user
        if FAKE:
            cls.uid, cls.gid, cls.home = 1000, 1000, "/home/" + cls.user
        cls.lan = a.get("lan") or detect_lan()
        cls.gateway = detect_gateway()
        cls.tz = a.get("tz") or detect_tz()
        cls.hostname = socket.gethostname()
        cls.admin = a.get("admin", "")
        cls.email = a.get("email", "")
        cls.repo = Opt.repo or State.data.get("repo") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        cls.refresh_tailscale()
        cls.read_os()

    @classmethod
    def read_os(cls):
        info = {}
        for line in read_file(P("/etc/os-release")).splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                info[k] = v.strip().strip('"')
        cls.os_id = info.get("ID", "")
        cls.os_name = info.get("PRETTY_NAME", cls.os_id)
        cls.os_version = info.get("VERSION_ID", "")
        cls.os_codename = info.get("UBUNTU_CODENAME") or info.get("VERSION_CODENAME", "")

    @classmethod
    def refresh_tailscale(cls):
        js = ts_status()
        cls.fqdn = cls.tailnet = cls.ts_id = ""
        if js and js.get("BackendState") == "Running" and not ts_cut_off(js):
            me = js.get("Self") or {}
            cls.fqdn = (me.get("DNSName") or "").rstrip(".")
            cls.ts_id = me.get("ID", "")
            if cls.fqdn.count(".") >= 2:
                cls.tailnet = cls.fqdn.split(".", 1)[1]


def detect_user():
    if os.environ.get("HLS_USER"):
        return os.environ["HLS_USER"]
    u = os.environ.get("SUDO_USER")
    if u and u != "root":
        return u
    try:
        names = [p.pw_name for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and os.path.isdir(p.pw_dir)]
    except Exception:
        names = []
    return names[0] if names else (os.environ.get("USER") or "root")


def detect_lan():
    if os.environ.get("HLS_LAN"):
        return os.environ["HLS_LAN"]
    rc, txt = run(["ip", "-4", "route", "get", "1.1.1.1"])
    m = re.search(r"\bsrc (\d+\.\d+\.\d+\.\d+)", txt)
    if m:
        return m.group(1)
    rc, txt = run(["hostname", "-I"])
    for tok in txt.split():
        if re.match(r"^(10|192\.168|172\.(1[6-9]|2\d|3[01]))\.", tok):
            return tok
    return ""


def detect_gateway():
    if os.environ.get("HLS_GATEWAY"):
        return os.environ["HLS_GATEWAY"]
    rc, txt = run(["ip", "-4", "route", "show", "default"])
    m = re.search(r"default via (\d+\.\d+\.\d+\.\d+)", txt)
    return m.group(1) if m else ""


def detect_tz():
    rc, txt = run(["timedatectl", "show", "-p", "Timezone", "--value"])
    if rc == 0 and txt.strip():
        return txt.strip()
    return read_file(P("/etc/timezone")).strip() or "UTC"


def geocode_city(query):
    base = os.environ.get("HLS_GEOCODE_API", "https://geocoding-api.open-meteo.com")
    st, js, _ = http("GET", base + "/v1/search?count=5&language=en&format=json&name=" + urllib.parse.quote(query), timeout=15)
    if st != 200 or not isinstance(js, dict):
        return None
    found = []
    for r in js.get("results") or []:
        try:
            found.append({"name": str(r["name"]), "region": str(r.get("admin1") or ""), "country": str(r.get("country") or ""),
                          "lat": float(r["latitude"]), "lon": float(r["longitude"])})
        except (KeyError, TypeError, ValueError):
            continue
    return found


def ip_location():
    """Find the time zone and city from the public IP address using a free lookup service; None when no service answers."""
    override = os.environ.get("HLS_IP_API")
    for base, kind in ([(override, "ipwho")] if override else [("https://ipwho.is", "ipwho"), ("https://ipapi.co", "ipapi")]):
        st, js, _ = http("GET", base + ("/" if kind == "ipwho" else "/json/"), timeout=8)
        if st != 200 or not isinstance(js, dict) or js.get("success") is False or js.get("error"):
            continue
        try:
            tz = js["timezone"]["id"] if isinstance(js.get("timezone"), dict) else str(js.get("timezone") or "")
            return {"tz": tz, "name": str(js["city"]), "region": str(js.get("region") or ""), "country": str(js.get("country") or js.get("country_name") or ""),
                    "lat": float(js["latitude"]), "lon": float(js["longitude"])}
        except (KeyError, TypeError, ValueError):
            continue
    return None


def weather_apply(text, w):
    m = re.search(r"(openmeteo:)(.*?)(\n- |\Z)", text, re.S)
    if not m:
        return None
    block = m.group(2)
    label = w["name"].replace("\\", "").replace('"', "")
    block = re.sub(r"(\n\s+label:).*", lambda x: '%s "%s"' % (x.group(1), label), block, count=1)
    block = re.sub(r"(\n\s+latitude:).*", lambda x: "%s %.4f" % (x.group(1), w["lat"]), block, count=1)
    block = re.sub(r"(\n\s+longitude:).*", lambda x: "%s %.4f" % (x.group(1), w["lon"]), block, count=1)
    return text[:m.start(2)] + block + text[m.end(2):]


def clock_apply(text, tz):
    m = re.search(r"(- datetime:)(.*?)(\n- |\Z)", text, re.S)
    if not m or not re.fullmatch(r"[A-Za-z0-9_+/-]{1,60}", tz or ""):
        return None
    block = m.group(2)
    if re.search(r"\n\s+timeZone:", block):
        block = re.sub(r"(\n\s+timeZone:).*", lambda x: "%s %s" % (x.group(1), tz), block, count=1)
    else:
        f = re.search(r"\n(\s+)format:[^\n]*", block)
        if f:
            block = block[:f.end()] + "\n%s  timeZone: %s" % (f.group(1), tz) + block[f.end():]
        else:
            block = block.rstrip("\n") + "\n    format:\n      timeZone: %s\n" % tz
    return text[:m.start(2)] + block + text[m.end(2):]


def ts_cut_off(js):
    """True when Tailscale still says it is running but the account no longer knows this machine (removed in the admin page) or its login has expired."""
    if (js.get("Self") or {}).get("Online") is False:
        return True
    return any(re.search(r"log ?in|logged out|key (has )?expired|node key|not authorized|needs? (to )?(re-?)?auth", str(h), re.I) for h in js.get("Health") or [])


def ts_status():
