def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def write_file(path, text, mode=None, owner=None):
    """Write a text file atomically with the given mode and owner; a dry run only reports it."""
    if Opt.dry:
        out("      would write: %s" % path)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp-hls"
    with open(tmp, "w") as f:
        f.write(text)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)
    if owner:
        chown(path, *owner)


def write_bytes(path, data, mode=None, owner=None):
    if Opt.dry:
        out("      would write: %s" % path)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp-hls"
    with open(tmp, "wb") as f:
        f.write(data)
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)
    if owner:
        chown(path, *owner)


def chown(path, uid, gid, recursive=False):
    if FAKE or Opt.dry:
        return
    try:
        if recursive and os.path.isdir(path):
            for dp, _dirs, fn in os.walk(path):
                os.chown(dp, uid, gid)
                for n in fn:
                    try:
                        os.chown(os.path.join(dp, n), uid, gid)
                    except OSError:
                        pass
        os.chown(path, uid, gid)
    except OSError:
        pass


def mkdirs(path, uid=None, gid=None, mode=0o755):
    if Opt.dry:
        if not os.path.isdir(path):
            out("      would create folder: %s" % path)
        return
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass
    if uid is not None:
        chown(path, uid, gid)


