def un_remove_serve(ports):
    for p in ports:
        rc, txt = act(["tailscale", "serve", "--https=%d" % p, "off"], timeout=60)
        if rc != 0 and not Opt.dry:
            warn("Tailscale would not remove port %d: %s" % (p, txt.strip()[-150:]))
