services:
  speedtest-tracker:
    image: lscr.io/linuxserver/speedtest-tracker:latest
    container_name: speedtest-tracker
    restart: unless-stopped
    ports:
      - "8088:80"
    environment:
      PUID: "1000"
      PGID: "1000"
      APP_KEY: "yours"
      APP_DEBUG: "false"
      APP_URL: "http://192.168.1.198:8088"
      DB_CONNECTION: sqlite